+# Built in radiance's tree, or standalone against an installed radiance
+# (`cmake -S arch/xlmroberta -B build -DCMAKE_PREFIX_PATH=<radiance prefix>`); see cmake/RadAddPlugin.cmake.
+if(NOT COMMAND rad_add_plugin)
+  cmake_minimum_required(VERSION 3.21)
+  project(xlmroberta LANGUAGES CXX)
+  find_package(radiance REQUIRED)
+  rad_plugin_defaults()
+endif()
+
+rad_add_plugin(xlmroberta architectures SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/xlmroberta.cpp)
diff --git a/arch/xlmroberta/xlmroberta.cpp b/arch/xlmroberta/xlmroberta.cpp
new file mode 100644
index 0000000000..7dccf72492
--- /dev/null
+++ b/arch/xlmroberta/xlmroberta.cpp
@@ -0,0 +1,445 @@
+/* xlmroberta -- XLM-RoBERTa (model_type xlm-roberta), the encoder behind BGE-M3 and
+ * BGE-reranker-v2-m3. bf16 weights and activations, with f32 norms and biases.
+ *
+ * An embedding model: it declares a pooled output (rad_declare_pooled) and no logits, so the
+ * engine runs it with no sampler and no KV cache and carries every input whole in one step.
+ *
+ * Shape (both BGE checkpoints):
+ *
+ *   24 layers, hidden 1024, 16 heads of 64, ffn 4096, vocab 250002, type vocab 1
+ *   post-norm block: a = out(attn(Wqkv h + b)) + b_out; h = LN1(h + a)
+ *                    m = fc2(gelu(fc1 h + b1)) + b2;    h = LN2(h + m)
+ *   separate query, key and value projections, fused into one [q|k|v] at convert time
+ *   non-causal, scale 1/sqrt(64) = 0.125, no rotary
+ *   embeddings: word + position + token_type, then LayerNorm. Position ids start at
+ *   pad_token_id + 1 = 2, so the plugin maps the table's rows from 2 on and looks up row p for
+ *   position p
+ *
+ * The pooled row depends on the checkpoint:
+ *
+ *   XLMRobertaModel          the first token's (<s>) hidden row, [n_embd]
+ *     with sparse_linear=1   then BGE-M3's sparse_linear logit of every position, [max_ctx]:
+ *                            row width n_embd + max_ctx, positions past the input zero. The
+ *                            logit is before BGE-M3's relu, and the client keeps the positive ones
+ *                            and takes the maximum per token id, which needs the token ids it
+ *                            sent. The head ships as sparse_linear.pt; renamed .pth, the
+ *                            checkpoint reader takes its tensors as sparse_linear.*
+ *   XLMRobertaForSequence-   the classification head over <s>, out_proj(tanh(dense h + b)) + b,
+ *   Classification           one f32 logit per input. out_proj runs in f32: in bf16 a logit near
+ *                            8 would be rounded to a multiple of 1/16
+ *
+ * The server L2-normalizes an embedding unless the request sets `normalize: false`, which both
+ * pooled forms need.
+ */
+#include <arch/rad_arch.h>
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace xlmroberta {
+
+using namespace rad::arch;
+
+/* RoBERTa's padding_idx: position ids count up from pad_token_id + 1. */
+constexpr int64_t kPositionBase = 2;
+
+struct Layer {
+    rad_weight w_qkv = 0, b_qkv = 0, w_out = 0, b_out = 0, w_norm1 = 0, b_norm1 = 0;
+    rad_weight w_fc1 = 0, b_fc1 = 0, w_fc2 = 0, b_fc2 = 0, w_norm2 = 0, b_norm2 = 0;
+    rad_op op_qkv = 0, op_attn = 0, op_out = 0, op_norm1 = 0, op_fc1 = 0, op_fc2 = 0, op_norm2 = 0;
+};
+
+struct Model {
+    Names nm{""};
+    Geom  g{};
+    bool  classifier = false;
+    bool  sparse = false;
+    int64_t width = 0;    /* the pooled row */
+
+    rad_buf b_x = 0, b_h = 0, b_o = 0, b_pe = 0, b_qkv = 0, b_att = 0, b_ff = 0;
+    rad_buf b_cls = 0, b_pooled = 0;
+    rad_buf b_ct = 0, b_cf = 0;
+    rad_buf b_sw = 0, b_swf = 0, b_lane = 0, b_tab = 0, b_sidx = 0;
+
+    rad_weight w_tok = 0, w_pos = 0, w_type = 0, w_emb_ln = 0, b_emb_ln = 0;
+    rad_weight w_cd = 0, b_cd = 0, w_co = 0, b_co = 0;
+    rad_weight w_sl = 0, b_sl = 0;
+
+    rad_op op_embed = 0, op_pos = 0, op_pos_add = 0, op_type = 0, op_emb_ln = 0, op_cls = 0;
+    rad_op op_cast = 0;
+    rad_op op_cd = 0, op_ct = 0, op_co = 0;
+    rad_op op_sl = 0, op_sl_cast = 0, op_lane = 0, op_tab = 0, op_sidx = 0, op_zero = 0;
+    rad_op op_scatter = 0;
+
+    std::vector<Layer> layers;
+};
+
+static Model g_model[MAX_SLOTS];
+
+static int probe(const RadModelMeta* meta, RadArchProbe* out) {
+    if (!meta || !out) return RAD_E_INVAL;
+    out->draft_depth = 0;
+    const char* mt = rad_meta_gets(meta, "model_type", nullptr);
+    if (mt && *mt && std::strcmp(mt, "xlm-roberta") && std::strcmp(mt, "xlmroberta")) {
+        fprintf(stderr, "radiance: xlmroberta: model_type '%s' is not xlm-roberta\n", mt);
+        return RAD_E_UNSUPPORTED;
+    }
+    return RAD_OK;
+}
+
+static int declare(RadBuilder* b, const RadModelMeta* meta, const RadBuildCtx* ctx) {
+    if (!b || !meta || !ctx) return RAD_E_INVAL;
+    if (ctx->rank < 0 || ctx->rank >= MAX_RANKS || rad_build_slot(ctx) >= MAX_SLOTS)
+        return RAD_E_INVAL;
+    if (ctx->world_size > 1) {
+        fprintf(stderr, "radiance: xlmroberta runs on one card (--tp 1); the model is 568M "
+                        "parameters\n");
+        return RAD_E_UNSUPPORTED;
+    }
+
+    Model& m = g_model[rad_build_slot(ctx)];
+    m = Model{};
+    m.nm = Names(ctx->scope);
+    RAD_ARCH_TRY(geom_from(m.g, meta, ctx, "bf16", RAD_BF16));
+    Geom&  g  = m.g;
+    Names& nm = m.nm;
+    const int64_t T = g.max_tok, E = g.n_embd, S = g.max_seqs;
+
+    const char* archs = rad_meta_gets(meta, "architectures", "");
+    m.classifier = std::strstr(archs, "ForSequenceClassification") != nullptr;
+    m.sparse = rad_meta_geti(meta, "sparse_linear", 0) != 0;
+    if (m.classifier && m.sparse) {
+        fprintf(stderr, "radiance: xlmroberta: sparse_linear is BGE-M3's head over the bare "
+                        "encoder; this checkpoint is a classifier\n");
+        return RAD_E_UNSUPPORTED;
+    }
+    if (!m.classifier && !std::strstr(archs, "XLMRobertaModel")) {
+        fprintf(stderr, "radiance: xlmroberta: architectures '%s'; this plugin serves "
+                        "XLMRobertaModel and XLMRobertaForSequenceClassification\n", archs);
+        return RAD_E_UNSUPPORTED;
+    }
+    const char* pet = rad_meta_gets(meta, "position_embedding_type", nullptr);
+    if (pet && *pet && std::strcmp(pet, "absolute")) {
+        fprintf(stderr, "radiance: xlmroberta: position_embedding_type '%s'; this plugin serves "
+                        "absolute positions\n", pet);
+        return RAD_E_UNSUPPORTED;
+    }
+    const char* act = rad_meta_gets(meta, "hidden_act", nullptr);
+    if (act && *act && std::strcmp(act, "gelu")) {
+        fprintf(stderr, "radiance: xlmroberta: hidden_act '%s'; this plugin serves exact gelu\n",
+                act);
+        return RAD_E_UNSUPPORTED;
+    }
+    if (rad_meta_geti(meta, "type_vocab_size", 1) != 1) {
+        fprintf(stderr, "radiance: xlmroberta: type_vocab_size %lld; this plugin adds the one "
+                        "token-type row\n", (long long)rad_meta_geti(meta, "type_vocab_size", 1));
+        return RAD_E_UNSUPPORTED;
+    }
+    if (rad_meta_geti(meta, "pad_token_id", 1) != kPositionBase - 1) {
+        fprintf(stderr, "radiance: xlmroberta: pad_token_id %lld; position ids start at "
+                        "pad_token_id + 1, and this plugin maps the table from row %lld\n",
+                (long long)rad_meta_geti(meta, "pad_token_id", 1), (long long)kPositionBase);
+        return RAD_E_UNSUPPORTED;
+    }
+    if (g.n_layer <= 0 || E <= 0 || g.n_head <= 0 || g.head_dim <= 0 || g.n_ff <= 0 ||
+        g.n_vocab <= 0 || g.n_head_kv != g.n_head || g.head_dim * g.n_head != E) {
+        fprintf(stderr, "radiance: xlmroberta: the container does not describe the model "
+                        "(layers %lld, hidden %lld, heads %lld of %lld, ffn %lld, vocab %lld)\n",
+                (long long)g.n_layer, (long long)E, (long long)g.n_head,
+                (long long)g.head_dim, (long long)g.n_ff, (long long)g.n_vocab);
+        return RAD_E_INVAL;
+    }
+    const int64_t n_pos = meta->n_ctx_train - kPositionBase;
+    if (n_pos <= 0 || g.max_ctx > n_pos) {
+        fprintf(stderr, "radiance: xlmroberta: --max-model-len %lld; the position table holds "
+                        "%lld positions\n", (long long)g.max_ctx, (long long)n_pos);
+        return RAD_E_UNSUPPORTED;
+    }
+    const int64_t L = g.max_ctx;
+    m.width = m.classifier ? 1 : m.sparse ? E + L : E;
+    const char* pre = m.classifier ? "roberta." : "";
+
+    m.b_x   = decl_b(b, nm.f("x"),    RAD_BF16, {T, E});
+    m.b_h   = decl_b(b, nm.f("h"),    RAD_BF16, {T, E});
+    m.b_o   = decl_b(b, nm.f("o"),    RAD_BF16, {T, E});
+    m.b_pe  = decl_b(b, nm.f("pe"),   RAD_BF16, {T, E});
+    m.b_qkv = decl_b(b, nm.f("qkv"),  RAD_BF16, {T, 3 * E});
+    m.b_att = decl_b(b, nm.f("attn"), RAD_BF16, {T, E});
+    m.b_ff  = decl_b(b, nm.f("ff"),   RAD_BF16, {T, g.n_ff});
+    m.b_cls = decl_b(b, nm.f("cls"),  RAD_BF16, {S, E});
+    m.b_pooled = decl_b(b, nm.f("pooled"), RAD_F32, {S, m.width}, RAD_BUF_PERSIST);
+    RAD_ARCH_TRY(rad_declare_pooled(b, m.b_pooled));
+
+    RAD_ARCH_TRY(map_copy(b, nm.f("token_embd.weight"),
+                          nm.ckpt("%sembeddings.word_embeddings.weight", pre)));
+    RAD_ARCH_TRY(map_rows(b, nm.f("position_embd.weight"),
+                          {{nm.ckpt("%sembeddings.position_embeddings.weight", pre),
+                            (int)kPositionBase, n_pos}}));
+    RAD_ARCH_TRY(map_copy(b, nm.f("token_type.weight"),
+                          nm.ckpt("%sembeddings.token_type_embeddings.weight", pre)));
+    RAD_ARCH_TRY(map_copy(b, nm.f("emb_ln.weight"), nm.ckpt("%sembeddings.LayerNorm.weight", pre)));
+    RAD_ARCH_TRY(map_copy(b, nm.f("emb_ln.bias"),   nm.ckpt("%sembeddings.LayerNorm.bias", pre)));
+    const int A = RAD_ACCESS_PER_TOKEN, N = RAD_SHARD_NONE;
+    m.w_tok    = decl_w(b, nm.f("token_embd.weight"), RAD_BF16, {g.n_vocab, E},
+                        RAD_ACCESS_VOCAB, N, grp_model());
+    m.w_pos    = decl_w(b, nm.f("position_embd.weight"), RAD_BF16, {n_pos, E}, A, N, grp_model());
+    m.w_type   = decl_w(b, nm.f("token_type.weight"), RAD_BF16, {1, E}, A, N, grp_model());
+    m.w_emb_ln = decl_w(b, nm.f("emb_ln.weight"), RAD_F32, {E}, A, N, grp_model());
+    m.b_emb_ln = decl_w(b, nm.f("emb_ln.bias"),   RAD_F32, {E}, A, N, grp_model());
+
+    auto layernorm_op = [&](rad_weight w, rad_weight bias) {
+        return RAD_OP(b, "layernorm",
+                      RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", E),
+                                 RAD_F64("eps", g.eps), RAD_STR("dtype", "bf16")),
+                      RAD_WEIGHTS(w, bias));
+    };
+    auto gemm_bias_op = [&](int64_t rows, int64_t Nout, int64_t K, rad_weight w, rad_weight bias,
+                            const char* dtype, const char* act_name) {
+        return RAD_OP(b, "gemm_nt_bias",
+                      RAD_PARAMS(RAD_RANGE("M", 1, rows), RAD_INT("N", Nout), RAD_INT("K", K),
+                                 RAD_STR("dtype", dtype), RAD_STR("act", act_name)),
+                      RAD_WEIGHTS(w, bias));
+    };
+    auto embed_op = [&](int64_t rows, rad_weight w) {
+        return RAD_OP(b, "embed_lookup",
+                      RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n_embd", E),
+                                 RAD_INT("n_vocab", rows), RAD_STR("dtype", "bf16"),
+                                 RAD_INT("vocab_offset", 0), RAD_F64("mult", 1.0)),
+                      RAD_WEIGHTS(w));
+    };
+    auto cast_op = [&](int64_t rows, int64_t n, const char* from, const char* to) {
+        return RAD_OP(b, "cast",
+                      RAD_PARAMS(RAD_RANGE("M", 1, rows), RAD_INT("n", n), RAD_STR("from", from),
+                                 RAD_STR("to", to)),
+                      RAD_NOWEIGHTS);
+    };
+
+    m.op_embed = rw(b, embed_op(g.n_vocab, m.w_tok), {}, {m.b_o});
+    m.op_pos = rw(b, embed_op(n_pos, m.w_pos), {}, {m.b_pe});
+    m.op_pos_add = rw(b, RAD_OP(b, "add",
+                                RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", E),
+                                           RAD_STR("dtype", "bf16")),
+                                RAD_NOWEIGHTS),
+                      {m.b_o, m.b_pe}, {m.b_o});
+    m.op_type = rw(b, RAD_OP(b, "table_add",
+                             RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", E), RAD_INT("L", 1),
+                                        RAD_STR("dtype", "bf16")),
+                             RAD_WEIGHTS(m.w_type)),
+                   {m.b_o}, {m.b_o});
+    m.op_emb_ln = rw(b, layernorm_op(m.w_emb_ln, m.b_emb_ln), {m.b_o}, {m.b_x});
+
+    m.layers.resize((size_t)g.n_layer);
+    for (int64_t l = 0; l < g.n_layer; ++l) {
+        Layer& y = m.layers[(size_t)l];
+        const long long ll = (long long)l;
+        const RadWeightGroup gl = grp_layer((int)l);
+        auto src = [&](const char* s) { return nm.ckpt("%sencoder.layer.%lld.%s", pre, ll, s); };
+
+        RAD_ARCH_TRY(map_concat(b, nm.f("blk.%lld.attn_qkv.weight", ll),
+                                {src("attention.self.query.weight"),
+                                 src("attention.self.key.weight"),
+                                 src("attention.self.value.weight")}));
+        RAD_ARCH_TRY(map_concat(b, nm.f("blk.%lld.attn_qkv.bias", ll),
+                                {src("attention.self.query.bias"), src("attention.self.key.bias"),
+                                 src("attention.self.value.bias")}));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.attn_out.weight", ll),
+                              src("attention.output.dense.weight")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.attn_out.bias", ll),
+                              src("attention.output.dense.bias")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.attn_norm.weight", ll),
+                              src("attention.output.LayerNorm.weight")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.attn_norm.bias", ll),
+                              src("attention.output.LayerNorm.bias")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_fc1.weight", ll),
+                              src("intermediate.dense.weight")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_fc1.bias", ll), src("intermediate.dense.bias")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_fc2.weight", ll), src("output.dense.weight")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_fc2.bias", ll),   src("output.dense.bias")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_norm.weight", ll),
+                              src("output.LayerNorm.weight")));
+        RAD_ARCH_TRY(map_copy(b, nm.f("blk.%lld.ffn_norm.bias", ll), src("output.LayerNorm.bias")));
+
+        y.w_qkv   = decl_w(b, nm.f("blk.%lld.attn_qkv.weight", ll), RAD_BF16, {3 * E, E}, A, N, gl);
+        y.b_qkv   = decl_w(b, nm.f("blk.%lld.attn_qkv.bias", ll),   RAD_F32, {3 * E}, A, N, gl);
+        y.w_out   = decl_w(b, nm.f("blk.%lld.attn_out.weight", ll), RAD_BF16, {E, E}, A, N, gl);
+        y.b_out   = decl_w(b, nm.f("blk.%lld.attn_out.bias", ll),   RAD_F32, {E}, A, N, gl);
+        y.w_norm1 = decl_w(b, nm.f("blk.%lld.attn_norm.weight", ll), RAD_F32, {E}, A, N, gl);
+        y.b_norm1 = decl_w(b, nm.f("blk.%lld.attn_norm.bias", ll),   RAD_F32, {E}, A, N, gl);
+        y.w_fc1   = decl_w(b, nm.f("blk.%lld.ffn_fc1.weight", ll), RAD_BF16, {g.n_ff, E}, A, N, gl);
+        y.b_fc1   = decl_w(b, nm.f("blk.%lld.ffn_fc1.bias", ll),   RAD_F32, {g.n_ff}, A, N, gl);
+        y.w_fc2   = decl_w(b, nm.f("blk.%lld.ffn_fc2.weight", ll), RAD_BF16, {E, g.n_ff}, A, N, gl);
+        y.b_fc2   = decl_w(b, nm.f("blk.%lld.ffn_fc2.bias", ll),   RAD_F32, {E}, A, N, gl);
+        y.w_norm2 = decl_w(b, nm.f("blk.%lld.ffn_norm.weight", ll), RAD_F32, {E}, A, N, gl);
+        y.b_norm2 = decl_w(b, nm.f("blk.%lld.ffn_norm.bias", ll),   RAD_F32, {E}, A, N, gl);
+
+        y.op_qkv = rw(b, gemm_bias_op(T, 3 * E, E, y.w_qkv, y.b_qkv, "bf16", "none"),
+                      {m.b_x}, {m.b_qkv});
+        y.op_attn = rw(b, RAD_OP(b, "attn_dense",
+                                 RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("head_dim", g.head_dim),
+                                            RAD_INT("gqa", 1), RAD_INT("causal", 0),
+                                            RAD_STR("dtype", "bf16"), RAD_F64("scale", 0.125),
+                                            RAD_INT("max_seqlen", T)),
+                                 RAD_NOWEIGHTS),
+                       {m.b_qkv}, {m.b_att});
+        y.op_out = rw(b, gemm_bias_op(T, E, E, y.w_out, y.b_out, "bf16", "none"),
+                      {m.b_att, m.b_x}, {m.b_x});
+        y.op_norm1 = rw(b, layernorm_op(y.w_norm1, y.b_norm1), {m.b_x}, {m.b_h});
+        y.op_fc1 = rw(b, gemm_bias_op(T, g.n_ff, E, y.w_fc1, y.b_fc1, "bf16", "gelu"),
+                      {m.b_h}, {m.b_ff});
+        y.op_fc2 = rw(b, gemm_bias_op(T, E, g.n_ff, y.w_fc2, y.b_fc2, "bf16", "none"),
+                      {m.b_ff, m.b_h}, {m.b_o});
+        y.op_norm2 = rw(b, layernorm_op(y.w_norm2, y.b_norm2), {m.b_o}, {m.b_x});
+
+        if (!y.op_qkv || !y.op_attn || !y.op_out || !y.op_norm1 || !y.op_fc1 || !y.op_fc2 ||
+            !y.op_norm2)
+            return RAD_E_INVAL;
+    }
+
+    m.op_cls = rw(b, RAD_OP(b, "gather_rows",
+                            RAD_PARAMS(RAD_RANGE("M", 1, S), RAD_INT("n", E),
+                                       RAD_STR("dtype", "bf16")),
+                            RAD_NOWEIGHTS),
+                  {m.b_x}, {m.b_cls});
+
+    if (m.classifier) {
+        RAD_ARCH_TRY(map_copy(b, nm.f("cls_dense.weight"), "classifier.dense.weight"));
+        RAD_ARCH_TRY(map_copy(b, nm.f("cls_dense.bias"),   "classifier.dense.bias"));
+        RAD_ARCH_TRY(map_copy(b, nm.f("cls_out.weight"),   "classifier.out_proj.weight"));
+        RAD_ARCH_TRY(map_copy(b, nm.f("cls_out.bias"),     "classifier.out_proj.bias"));
+        m.w_cd = decl_w(b, nm.f("cls_dense.weight"), RAD_BF16, {E, E}, A, N, grp_model());
+        m.b_cd = decl_w(b, nm.f("cls_dense.bias"),   RAD_F32, {E}, A, N, grp_model());
+        m.w_co = decl_w(b, nm.f("cls_out.weight"),   RAD_F32, {1, E}, A, N, grp_model());
+        m.b_co = decl_w(b, nm.f("cls_out.bias"),     RAD_F32, {1}, A, N, grp_model());
+        m.b_ct = decl_b(b, nm.f("cls_tanh"), RAD_BF16, {S, E});
+        m.b_cf = decl_b(b, nm.f("cls_f32"),  RAD_F32,  {S, E});
+        m.op_cd = rw(b, gemm_bias_op(S, E, E, m.w_cd, m.b_cd, "bf16", "tanh"), {m.b_cls}, {m.b_ct});
+        m.op_ct = rw(b, cast_op(S, E, "bf16", "f32"), {m.b_ct}, {m.b_cf});
+        m.op_co = rw(b, gemm_bias_op(S, 1, E, m.w_co, m.b_co, "f32", "none"), {m.b_cf},
+                     {m.b_pooled});
+        if (!m.op_cd || !m.op_ct || !m.op_co) return RAD_E_INVAL;
+    } else {
+        m.op_cast = rw(b, cast_op(S, E, "bf16", "f32"), {m.b_cls}, {m.b_pooled});
+        if (!m.op_cast) return RAD_E_INVAL;
+    }
+
+    /* The sparse logits reach the pooled row by position: lane_gather reads entry e's k-th row
+     * out of an iota table at e * width + k, which holds n_embd + e * width + k, so token t learns
+     * its element of the pooled buffer, and scatter_rows writes the logit there through a flat
+     * [max_seqs * width, 1] view. */
+    if (m.sparse) {
+        RAD_ARCH_TRY(map_copy(b, nm.f("sparse_linear.weight"), "sparse_linear.weight"));
+        RAD_ARCH_TRY(map_copy(b, nm.f("sparse_linear.bias"),   "sparse_linear.bias"));
+        m.w_sl = decl_w(b, nm.f("sparse_linear.weight"), RAD_BF16, {1, E}, A, N, grp_model());
+        m.b_sl = decl_w(b, nm.f("sparse_linear.bias"),   RAD_F32, {1}, A, N, grp_model());
+        m.b_sw   = decl_b(b, nm.f("sparse_logit"),     RAD_BF16, {T, 1});
+        m.b_swf  = decl_b(b, nm.f("sparse_logit_f32"), RAD_F32,  {T, 1});
+        m.b_lane = decl_b(b, nm.f("sparse_lane"),      RAD_I32,  {S});
+        m.b_tab  = decl_b(b, nm.f("sparse_tab"),       RAD_I32,  {S * m.width, 1});
+        m.b_sidx = decl_b(b, nm.f("sparse_idx"),       RAD_I32,  {T, 1});
+
+        auto iota_op = [&](int64_t rows, int64_t start) {
+            return RAD_OP(b, "iota",
+                          RAD_PARAMS(RAD_RANGE("M", 1, rows), RAD_INT("start", start),
+                                     RAD_INT("step", 1)),
+                          RAD_NOWEIGHTS);
+        };
+        m.op_sl = rw(b, gemm_bias_op(T, 1, E, m.w_sl, m.b_sl, "bf16", "none"), {m.b_x}, {m.b_sw});
+        m.op_sl_cast = rw(b, cast_op(T, 1, "bf16", "f32"), {m.b_sw}, {m.b_swf});
+        m.op_lane = rw(b, iota_op(S, 0), {}, {m.b_lane});
+        m.op_tab = rw(b, iota_op(S * m.width, E), {}, {m.b_tab});
+        m.op_sidx = rw(b, RAD_OP(b, "lane_gather",
+                                 RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", 1),
+                                            RAD_INT("stride", m.width), RAD_STR("dtype", "i32")),
+                                 RAD_NOWEIGHTS),
+                       {m.b_tab, m.b_lane}, {m.b_sidx});
+        m.op_zero = rw(b, RAD_OP(b, "fill",
+                                 RAD_PARAMS(RAD_RANGE("M", 1, S), RAD_INT("n", L),
+                                            RAD_STR("dtype", "f32")),
+                                 RAD_NOWEIGHTS),
+                       {}, {m.b_pooled});
+        m.op_scatter = rw(b, RAD_OP(b, "scatter_rows",
+                                    RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", 1),
+                                               RAD_STR("dtype", "f32")),
+                                    RAD_NOWEIGHTS),
+                          {m.b_swf, m.b_sidx}, {m.b_pooled});
+        if (!m.op_sl || !m.op_sl_cast || !m.op_lane || !m.op_tab || !m.op_sidx || !m.op_zero ||
+            !m.op_scatter)
+            return RAD_E_INVAL;
+    }
+
+    rad_note(b, "%s: %lld layers, hidden %lld, ffn %lld, %lld heads of %lld; post-norm, "
+                "absolute positions; pooled row %lld wide",
+             m.classifier ? "reranker" : m.sparse ? "BGE-M3 dense and sparse" : "embedding model",
+             (long long)g.n_layer, (long long)E, (long long)g.n_ff, (long long)g.n_head,
+             (long long)g.head_dim, (long long)m.width);
+    return RAD_OK;
+}
+
+static void step(RadCtx* c, const RadBatch* batch) {
+    const Model& m = g_model[rad_slot(c)];
+    const Geom& g = m.g;
+    const int64_t T = batch->n_tok, S = batch->n_seq, E = g.n_embd, L = g.max_ctx;
+    if (T <= 0 || S <= 0) return;
+    const RadOperand cu = praw(batch->cu_seqlens, RAD_I32, S + 1);
+
+    RAD_ISSUE(c, m.op_embed, praw(batch->token_ids, RAD_I32, T), RAD_W(m.w_tok), brows(m.b_o, T));
+    RAD_ISSUE(c, m.op_pos, praw(batch->positions, RAD_I32, T), RAD_W(m.w_pos), brows(m.b_pe, T));
+    RAD_ISSUE(c, m.op_pos_add, brows(m.b_o, T), brows(m.b_pe, T), brows(m.b_o, T));
+    RAD_ISSUE(c, m.op_type, brows(m.b_o, T), RAD_W(m.w_type), brows(m.b_o, T));
+    RAD_ISSUE(c, m.op_emb_ln, brows(m.b_o, T), RAD_W(m.w_emb_ln), RAD_W(m.b_emb_ln),
+              brows(m.b_x, T));
+
+    for (const Layer& y : m.layers) {
+        RAD_ISSUE_N(c, y.op_qkv, T, brows(m.b_x, T), RAD_W(y.w_qkv), RAD_W(y.b_qkv), RAD_NONE,
+                    brows(m.b_qkv, T));
+        RAD_ISSUE(c, y.op_attn, bcol(m.b_qkv, 0, E, T), bcol(m.b_qkv, E, E, T),
+                  bcol(m.b_qkv, 2 * E, E, T), cu, brows(m.b_att, T));
+        RAD_ISSUE_N(c, y.op_out, T, brows(m.b_att, T), RAD_W(y.w_out), RAD_W(y.b_out),
+                    brows(m.b_x, T), brows(m.b_x, T));
+        RAD_ISSUE(c, y.op_norm1, brows(m.b_x, T), RAD_W(y.w_norm1), RAD_W(y.b_norm1),
+                  brows(m.b_h, T));
+        RAD_ISSUE_N(c, y.op_fc1, T, brows(m.b_h, T), RAD_W(y.w_fc1), RAD_W(y.b_fc1), RAD_NONE,
+                    brows(m.b_ff, T));
+        RAD_ISSUE_N(c, y.op_fc2, T, brows(m.b_ff, T), RAD_W(y.w_fc2), RAD_W(y.b_fc2),
+                    brows(m.b_h, T), brows(m.b_o, T));
+        RAD_ISSUE(c, y.op_norm2, brows(m.b_o, T), RAD_W(y.w_norm2), RAD_W(y.b_norm2),
+                  brows(m.b_x, T));
+    }
+
+    RAD_ISSUE_N(c, m.op_cls, S, brows(m.b_x, T), praw(batch->cu_seqlens, RAD_I32, S),
+                brows(m.b_cls, S));
+
+    if (m.classifier) {
+        RAD_ISSUE_N(c, m.op_cd, S, brows(m.b_cls, S), RAD_W(m.w_cd), RAD_W(m.b_cd), RAD_NONE,
+                    brows(m.b_ct, S));
+        RAD_ISSUE_N(c, m.op_ct, S, brows(m.b_ct, S), brows(m.b_cf, S));
+        RAD_ISSUE_N(c, m.op_co, S, brows(m.b_cf, S), RAD_W(m.w_co), RAD_W(m.b_co), RAD_NONE,
+                    brows(m.b_pooled, S));
+        return;
+    }
+    RAD_ISSUE_N(c, m.op_cast, S, brows(m.b_cls, S), bcol(m.b_pooled, 0, E, S));
+    if (!m.sparse) return;
+
+    RAD_ISSUE_N(c, m.op_sl, T, brows(m.b_x, T), RAD_W(m.w_sl), RAD_W(m.b_sl), RAD_NONE,
+                brows(m.b_sw, T));
+    RAD_ISSUE_N(c, m.op_sl_cast, T, brows(m.b_sw, T), brows(m.b_swf, T));
+    RAD_ISSUE_N(c, m.op_lane, S, brows(m.b_lane, S));
+    RAD_ISSUE_N(c, m.op_tab, S * m.width, brows(m.b_tab, S * m.width));
+    RAD_ISSUE_N(c, m.op_sidx, T, brows(m.b_tab, S * m.width), brows(m.b_lane, S), cu,
+                brows(m.b_sidx, T));
+    RAD_ISSUE_N(c, m.op_zero, S, bcol(m.b_pooled, E, L, S));
+    RAD_ISSUE_N(c, m.op_scatter, T, brows(m.b_swf, T), brows(m.b_sidx, T),
+                praw2(rad_buf_ptr(c, m.b_pooled), RAD_F32, S * m.width, 1));
+}
+
+}  /* namespace xlmroberta */
+
+#ifndef RAD_ARCH_NO_EXPORTS
+RAD_ARCH_MULTI_INSTANCE()
+RAD_ARCH_PLUGIN(xlmroberta, "xlmroberta", "", "0.1.0",
+                "XLM-RoBERTa (BGE-M3, BGE-reranker-v2-m3): a bidirectional post-norm encoder with "
+                "absolute positions, pooled to its first token, BGE-M3's sparse logits, or a "
+                "classifier's logit; bf16")
+RAD_ARCH_PROBE(xlmroberta)
+#endif
