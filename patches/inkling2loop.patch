+    const int grc = ar_gather_of(a, c.rows, c.n, &G);
+    if (grc != RAD_OK) return grc;
+    if (G.ye && c.rows * G.top_k > r4d_moegather::kGatherSlots) return R4D_NO(RAD_E_UNSUPPORTED);
+    if (mode == 2) return RAD_OK;
+    if (c.chain)
+        hipLaunchKernelGGL(ar_conv_kernel<r4dchain>, dim3(nb), dim3(kPcThreads), 0,
+                           (hipStream_t)s, c, L, G);
+    else
+        hipLaunchKernelGGL(ar_conv_kernel<R4dUnchained>, dim3(nb), dim3(kPcThreads), 0,
+                           (hipStream_t)s, c, L, G);
+    return hipGetLastError() == hipSuccess ? RAD_OK : R4D_NO(RAD_E_DEVICE);
 }
