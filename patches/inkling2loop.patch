+/* ------------------------------------------------------------------ l2_clip */
+/* h = x * scale;  y = h * min(threshold / (|h| + eps), 1), over each run of head_dim elements
+ *
+ * A head whose L2 norm is above `threshold` is scaled down to it and a shorter one passes through.
+ * `scale` is one row of n gains, absent a row of ones; the sum of squares is f32 in ascending
+ * index order and y is rounded once.
+ *
+ * With `positions`, the rounded row is then scaled by its position's
+ * tau = 1 + log_alpha * ln(max((pos + 1) / log_floor, 1)), f32, and rounded again. */
+int ref_l2_clip(const RadArgs* a, RadStream) {
+    if (!a || a->n_t < 3 || !a->t[0].data || !a->t[2].data) return RAD_E_INVAL;
+    const RadTensor *x = &a->t[0], *y = &a->t[2];
+    const RadTensor* sc = t_in(a, 1);
+    const RadTensor* pos = a->n_t > 3 ? t_in(a, 3) : nullptr;
+    const int64_t n = p_int(a, "n", 0), hd = p_int(a, "head_dim", 0);
+    const float thr = p_f32(a, "threshold", 0.0f), eps = p_f32(a, "eps", 1e-6f);
+    const float alpha = p_f32(a, "log_alpha", 0.0f);
+    const int64_t floor_n = p_int(a, "log_floor", 0);
+    if (n <= 0 || hd <= 0 || n % hd != 0 || !(thr > 0.0f)) return RAD_E_SHAPE;
+    const int64_t rows = rows_of(x, n);
+    if (rows <= 0 || numel(y) < rows * n || (sc && numel(sc) != n)) return RAD_E_SHAPE;
+    if (pos && (floor_n <= 0 || numel(pos) < rows)) return RAD_E_SHAPE;
+
+    REF_PAR_FOR(rows * n)
+    for (int64_t r = 0; r < rows; ++r) {
+        const int64_t xb = rowoff(x, r, n), yb = rowoff(y, r, n);
+        const int64_t xs = laststride(x), ys = laststride(y);
