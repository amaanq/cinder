+                s.last = at;
+                counts.put(h, s);
+                prev_h = h;
+                have_prev = true;
+                if (periodic && cool == 0 && closing < 0) {
+                    if (fired == 0) {
+                        ban_tok = again;
+                        boost = cool = n;
+                        event = LoopBan;
+                    } else {
+                        closing = 0;
+                        event = LoopClose;
+                    }
+                    ++fired;
+                }
+            }
+        }
+        settle(sp);
+    }
