+int r4d_rad_l2_clip(const RadArgs* a, RadStream stream) {
+    const RadTensor* x = r4d_opt(a, 0);
+    const RadTensor* sc = r4d_opt(a, 1);
+    const RadTensor* y = r4d_opt(a, 2);
+    const RadTensor* pos = r4d_opt(a, 3);
+    if (!x || !y) return R4D_NO(RAD_E_INVAL);
+    if (x->dtype != RAD_BF16 || y->dtype != RAD_BF16 || (sc && sc->dtype != RAD_BF16) ||
+        (pos && pos->dtype != RAD_I32))
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), hd = r4d_geti_or(a, "head_dim", 0);
+    const long long floor_n = r4d_geti_or(a, "log_floor", 0);
+    ClipArgs A{};
+    A.thr = (float)r4d_getf(a, "threshold", 0.0);
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    A.alpha = (float)r4d_getf(a, "log_alpha", 0.0);
+    A.floor_n = (float)floor_n;
+    if (n <= 0 || hd <= 0 || n % hd || !(A.thr > 0.0f)) return R4D_NO(RAD_E_SHAPE);
+    if (n > kMaxRow) return R4D_NO(RAD_E_UNSUPPORTED);
+    long long M = 0, My = 0;
+    A.x_rs = r4d_rows_pitch(x, n, &M);
+    A.y_rs = r4d_rows_pitch(y, n, &My);
+    if (A.x_rs < 0 || A.y_rs < 0 || (sc && !r4d_contig(sc)) || (pos && !r4d_contig(pos)))
+        return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || My < M || (sc && r4d_numel(sc) != n)) return R4D_NO(RAD_E_SHAPE);
+    if (pos && (floor_n <= 0 || r4d_numel(pos) < M)) return R4D_NO(RAD_E_SHAPE);
+    A.x = (const uint16_t*)r4d_p(x);
+    A.sc = (const uint16_t*)r4d_p(sc);
+    A.y = (uint16_t*)r4d_wp(y);
+    A.pos = (const int*)r4d_p(pos);
+    A.n = (uint32_t)n; A.hd = (uint32_t)hd; A.M = (uint32_t)M;
+    const dim3 grid(r4d_cliff_rows((uint32_t)M, 1, kThr / kWave)), thr(kThr);
+    const size_t lds = (size_t)(n + 2 * (n / hd)) * sizeof(float);
+    if (r4d_geti_or(a, "chain", 0) != 0 && M <= 64)
+        return n % kCols ? R4D_EMIT(stream, (l2_clip_kernel<false, r4dchain>), grid, thr, lds, A)
+                         : R4D_EMIT(stream, (l2_clip_kernel<true, r4dchain>), grid, thr, lds, A);
+    return n % kCols ? R4D_EMIT(stream, (l2_clip_kernel<false, R4dUnchained>), grid, thr, lds, A)
+                     : R4D_EMIT(stream, (l2_clip_kernel<true, R4dUnchained>), grid, thr, lds, A);
+}
+
+int r4d_rad_depth_mix(const RadArgs* a, RadStream stream) {
+    const RadTensor* st = r4d_opt(a, 0);
+    const RadTensor* x = r4d_opt(a, 1);
+    const RadTensor* q = r4d_opt(a, 2);
+    const RadTensor* y = r4d_opt(a, 3);
+    if (!st || !x || !q || !y) return R4D_NO(RAD_E_INVAL);
+    if (st->dtype != RAD_BF16 || (x->dtype != RAD_BF16 && x->dtype != RAD_F32) ||
+        q->dtype != RAD_F32 || y->dtype != RAD_F32)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), S = r4d_geti_or(a, "states", 0);
+    const long long Q = r4d_geti_or(a, "queries", 0);
+    if (n <= 0 || S <= 0 || Q <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (S + 1 > kDmStates || Q > kDmQueries || n > kMaxRow || n % kCols)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    long long M = 0, Ms = 0, My = 0;
+    MixArgs A{};
+    A.x_rs = r4d_rows_pitch(x, n, &M);
+    A.st_rs = r4d_rows_pitch(st, S * n, &Ms);
+    A.y_rs = r4d_rows_pitch(y, Q * n, &My);
+    if (A.x_rs < 0 || A.st_rs < 0 || A.y_rs < 0 || !r4d_contig(q)) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Ms < M || My < M || r4d_numel(q) != Q * n) return R4D_NO(RAD_E_SHAPE);
+    A.st = (const uint16_t*)r4d_p(st);
+    A.x = r4d_p(x);
+    A.q = (const float*)r4d_p(q);
+    A.y = (float*)r4d_wp(y);
+    A.n = (uint32_t)n; A.S = (uint32_t)S; A.Q = (uint32_t)Q; A.M = (uint32_t)M;
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    const dim3 grid(r4d_cliff_rows((uint32_t)M, (uint32_t)Q, kThr / kWave), (uint32_t)Q);
+    const dim3 thr(kThr);
+    const bool xf = x->dtype == RAD_F32;
+    if (r4d_geti_or(a, "chain", 0) != 0 && M <= 64)
+        return xf ? R4D_EMIT(stream, (depth_mix_kernel<true, r4dchain>), grid, thr, 0, A)
+                  : R4D_EMIT(stream, (depth_mix_kernel<false, r4dchain>), grid, thr, 0, A);
+    if (M >= 256 && Q > 1) {
+        const dim3 rgrid(r4d_cliff_rows((uint32_t)M, 1, kThr / kWave));
+        return xf ? R4D_EMIT(stream, (depth_mix_kernel<true, R4dUnchained, true>), rgrid, thr, 0, A)
+                  : R4D_EMIT(stream, (depth_mix_kernel<false, R4dUnchained, true>), rgrid, thr, 0,
+                             A);
+    }
+    return xf ? R4D_EMIT(stream, (depth_mix_kernel<true, R4dUnchained>), grid, thr, 0, A)
+              : R4D_EMIT(stream, (depth_mix_kernel<false, R4dUnchained>), grid, thr, 0, A);
+}
+
+/* depth_mix's operands, then a (w, q, scale, out_bf16) site a query: rmsnorm_had_quant_i8g of
+ * query k's row of y at `norm_eps` and `wadd`, out_bf16 optional. */
+int r4d_rad_depth_mix_had_quant_i8g(const RadArgs* a, RadStream stream) {
+    const RadTensor* st = r4d_opt(a, 0);
+    const RadTensor* x = r4d_opt(a, 1);
+    const RadTensor* q = r4d_opt(a, 2);
+    const RadTensor* y = r4d_opt(a, 3);
+    if (!st || !x || !q || !y) return R4D_NO(RAD_E_INVAL);
+    if (st->dtype != RAD_BF16 || (x->dtype != RAD_BF16 && x->dtype != RAD_F32) ||
+        q->dtype != RAD_F32 || y->dtype != RAD_F32)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), S = r4d_geti_or(a, "states", 0);
+    const long long Q = r4d_geti_or(a, "queries", 0);
+    if (n <= 0 || S <= 0 || Q <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (S + 1 > kDmStates || Q > kDmQueries - 1 || n > kMaxRow || n % kCols || n % 128)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    if (r4d_geti_or(a, "group", 128) != 128) return R4D_NO(RAD_E_UNSUPPORTED);
+    long long M = 0, Ms = 0, My = 0;
+    MixArgs A{};
+    A.x_rs = r4d_rows_pitch(x, n, &M);
+    A.st_rs = r4d_rows_pitch(st, S * n, &Ms);
+    A.y_rs = r4d_rows_pitch(y, Q * n, &My);
+    if (A.x_rs < 0 || A.st_rs < 0 || A.y_rs < 0 || !r4d_contig(q)) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Ms < M || My < M || r4d_numel(q) != Q * n) return R4D_NO(RAD_E_SHAPE);
+    A.st = (const uint16_t*)r4d_p(st);
+    A.x = r4d_p(x);
+    A.q = (const float*)r4d_p(q);
+    A.y = (float*)r4d_wp(y);
+    A.n = (uint32_t)n; A.S = (uint32_t)S; A.Q = (uint32_t)Q; A.M = (uint32_t)M;
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    DmqArgs D{};
+    D.eps = (float)r4d_getf(a, "norm_eps", 1e-6);
+    D.wadd = (float)r4d_getf(a, "wadd", 0.0);
+    uint32_t wdt = 0;
+    for (long long k = 0; k < Q; ++k) {
+        const RadTensor* w = r4d_opt(a, 4 + 4 * (int)k);
+        const RadTensor* q8 = r4d_opt(a, 5 + 4 * (int)k);
+        const RadTensor* s8 = r4d_opt(a, 6 + 4 * (int)k);
+        const RadTensor* h = r4d_opt(a, 7 + 4 * (int)k);
+        if (!w || !q8 || !s8) return R4D_NO(RAD_E_INVAL);
+        if (k == 0) wdt = w->dtype;
+        if (w->dtype != wdt || (wdt != RAD_BF16 && wdt != RAD_F32) || q8->dtype != RAD_I8 ||
+            s8->dtype != RAD_F32 || (h && h->dtype != RAD_BF16))
+            return R4D_NO(RAD_E_DTYPE);
+        long long Mq = 0, Mss = 0, Mh = M;
+        DmqSite& T = D.s[k];
+        T.q8_rs = r4d_rows_pitch(q8, n, &Mq);
+        T.s8_rs = r4d_rows_pitch(s8, n / 128, &Mss);
+        T.h_rs = h ? r4d_rows_pitch(h, n, &Mh) : 0;
+        if (T.q8_rs < 0 || T.s8_rs < 0 || T.h_rs < 0) return R4D_NO(RAD_E_STRIDE);
+        if (r4d_numel(w) != n || Mq < M || Mss < M || Mh < M) return R4D_NO(RAD_E_SHAPE);
+        T.w = r4d_p(w);
+        T.q8 = (uint8_t*)r4d_wp(q8);
+        T.s8 = (float*)r4d_wp(s8);
+        T.h = h ? (uint16_t*)r4d_wp(h) : nullptr;
+    }
+    const dim3 grid(r4d_cliff_rows((uint32_t)M, (uint32_t)Q, kThr / kWave), (uint32_t)Q);
+    const dim3 thr(kThr);
+    const bool ch = r4d_geti_or(a, "chain", 0) != 0 && M <= 64;
+    const bool xf = x->dtype == RAD_F32, wf = wdt == RAD_F32;
+#define R4D_DMQ(xf_, wf_)                                                                        \
+    return ch ? R4D_EMIT(stream, (depth_mix_quant_kernel<xf_, wf_, r4dchain>), grid, thr, 0, A, D) \
+              : R4D_EMIT(stream, (depth_mix_quant_kernel<xf_, wf_, R4dUnchained>), grid, thr, 0,  \
+                         A, D)
+    if (xf) {
+        if (wf) R4D_DMQ(true, true);
+        R4D_DMQ(true, false);
+    }
+    if (wf) R4D_DMQ(false, true);
+    R4D_DMQ(false, false);
+#undef R4D_DMQ
+}
+
+int r4d_rad_gate_mix(const RadArgs* a, RadStream stream) {
+    const RadTensor* t[5];
+    for (int i = 0; i < 5; ++i) {
+        if (!(t[i] = r4d_opt(a, i))) return R4D_NO(RAD_E_INVAL);
+        if (t[i]->dtype != RAD_F32) return R4D_NO(RAD_E_DTYPE);
+    }
+    const long long n = r4d_geti_or(a, "n", 0);
+    if (n <= 0) return R4D_NO(RAD_E_SHAPE);
+    long long rows[5] = {};
+    long long rs[5];
+    for (int i = 0; i < 5; ++i)
+        if ((rs[i] = r4d_rows_pitch(t[i], n, &rows[i])) < 0) return R4D_NO(RAD_E_STRIDE);
+    const long long M = rows[4];
+    if (M <= 0 || rows[0] < M || rows[1] < M || rows[2] < M || rows[3] < M)
+        return R4D_NO(RAD_E_SHAPE);
+    GateArgs A{};
+    A.x = (const float*)r4d_p(t[0]); A.m = (const float*)r4d_p(t[1]);
+    A.f = (const float*)r4d_p(t[2]); A.g = (const float*)r4d_p(t[3]);
+    A.y = (float*)r4d_wp(t[4]);
+    A.x_rs = rs[0]; A.m_rs = rs[1]; A.f_rs = rs[2]; A.g_rs = rs[3]; A.y_rs = rs[4];
+    A.n = (uint32_t)n;
+    A.total = (uint64_t)M * (uint64_t)n;
+    const uint64_t blocks = (A.total + kThr - 1) / kThr;
+    return R4D_EMIT(stream, gate_mix_kernel, dim3((uint32_t)(blocks < 65536u ? blocks : 65536u)),
+                    dim3(kThr), 0, A);
+}
+
+/* One message gate's operands (x, m, down, forget, admit, r, y) checked into `out`. */
+static int mg_args(const RadTensor* const* t, const RadArgs* a, MgArgs* out) {
+    const RadTensor *x = t[0], *m = t[1], *dn = t[2], *fg = t[3], *ad = t[4], *r = t[5], *y = t[6];
+    if (x->dtype != RAD_F32 || m->dtype != RAD_F32 || dn->dtype != RAD_BF16 ||
+        fg->dtype != RAD_F32 || ad->dtype != RAD_F32 || r->dtype != RAD_BF16 || y->dtype != RAD_F32)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), k = r4d_geti_or(a, "rank", 0);
+    if (n <= 0 || k <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (n > kMaxRow || n % kCols || k > 64 || k % 16) return R4D_NO(RAD_E_UNSUPPORTED);
+    MgArgs A{};
+    long long M = 0, Mx = 0, Mm = 0, Mr = 0;
+    A.y_rs = r4d_rows_pitch(y, n, &M);
+    A.x_rs = r4d_rows_pitch(x, n, &Mx);
+    A.m_rs = r4d_rows_pitch(m, n, &Mm);
+    A.r_rs = r4d_rows_pitch(r, k, &Mr);
+    if (A.x_rs < 0 || A.m_rs < 0 || A.r_rs < 0 || A.y_rs < 0 || !r4d_contig(dn) ||
+        !r4d_contig(fg) || !r4d_contig(ad))
+        return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Mx < M || Mm < M || Mr < M || r4d_numel(dn) != 2 * n * k ||
+        r4d_numel(fg) != n * k || r4d_numel(ad) != n * k)
+        return R4D_NO(RAD_E_SHAPE);
+    if (!r4d_aligned(x->data, 16) || !r4d_aligned(m->data, 16) || !r4d_aligned(dn->data, 16) ||
+        !r4d_aligned(fg->data, 16) || !r4d_aligned(ad->data, 16) || !r4d_aligned(r->data, 8) ||
+        A.x_rs % 4 || A.m_rs % 4 || A.r_rs % 4)
+        return R4D_NO(RAD_E_ALIGN);
+    A.x = (const float*)r4d_p(x);
+    A.m = (const float*)r4d_p(m);
+    A.dn = (const uint16_t*)r4d_p(dn);
+    A.fg = (const float*)r4d_p(fg);
+    A.ad = (const float*)r4d_p(ad);
+    A.r = (uint16_t*)r4d_wp(r);
+    A.y = (float*)r4d_wp(y);
+    A.n = (uint32_t)n; A.k = (uint32_t)k; A.M = (uint32_t)M;
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    /* The rank launch's rows of 2n bf16 in at most 48 KiB of LDS. A prefill's workgroup forms
+     * every rank of as many rows as fit, so each row is read and normalised once, not once for
+     * each eight ranks: 1.38 ms a 2048-row gate before. */
+    const bool wide = M >= kMgWideRows;
+    A.rank_rows = (uint32_t)std::max(1LL, wide ? 12288 / n
+                                            : M <= kMgRows ? 1LL
+                                            : std::min((long long)kMgRankRows, 12288 / n));
+    A.jpb = M == 1 ? kMgJpb : kThr / kWave;
+    A.rpw = wide ? (uint32_t)((k + A.jpb - 1) / A.jpb) : 1;
+    A.mix_rows = M >= 2 * kMgWideRows ? 8 * kMgRows : kMgRows;
+    *out = A;
+    return RAD_OK;
+}
