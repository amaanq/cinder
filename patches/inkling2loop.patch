+            if (stop && keep == l) {
+                for (int64_t j = l; j < steps; ++j)
+                    st_int(out->dtype, out->data, rowoff(out, m, steps) + j * os, -1);
+                break;
+            }
+        }
+        st_int(kept->dtype, kept->data, offlin(kept, m), keep);
+    }
+    return RAD_OK;
+}
+
+/* ------------------------------------------------------ dspark_walk_step, dspark_walk_score */
+/* dspark_rnn_greedy a launch at a time, for ranks that each score a span of the vocabulary and
+ * all-gather the tile winners in between. The state between the ops is `walk`, f32, laid out as
+ * libr4d's walk scratch at the band's M (`M`) and the rows' M (m):
+ *
+ *   pre     [m, steps, 3 rank]  bias + proj . [hidden[l], ctx], from offset 0
+ *   state   [2, m, rank]        by position parity, after pre rounded up to 256 bytes
+ *   latent  [m, rank]           after state, the same way
+ *   debt    [m]                 after latent
+ *
+ * The tile winners are (score bits, id) i32 pairs, `slots` a sequence. A step reduces them to the
+ * greatest score, the lower id on a tie, and the next greatest of the others. */
+namespace {
+
+struct WalkLayout {
+    float *pre, *state, *latent, *debt;
+};
+
+bool walk_layout(const RadTensor* w, int64_t Mb, int64_t steps, int64_t R, WalkLayout* o) {
+    auto up = [](int64_t b) { return (b + 255) / 256 * 256; };
+    const int64_t pre_b = up(Mb * steps * 3 * R * 4), st_b = up(2 * Mb * R * 4);
+    const int64_t lat_b = up(Mb * R * 4), need = pre_b + st_b + lat_b + up(Mb * 4);
+    if (w->dtype != RAD_F32 || numel(w) * 4 < need) return false;
+    char* base = (char*)w->data;
+    o->pre = (float*)base;
+    o->state = (float*)(base + pre_b);
+    o->latent = (float*)(base + pre_b + st_b);
+    o->debt = (float*)(base + pre_b + st_b + lat_b);
+    return true;
+}
+
+}  // namespace
+
+/* dspark_walk_couple is the step with the token rad_dspark_couple_step's over the eight best of
+ * the gathered winners, as dspark_rnn_couple draws it, Q stored in state[l - 1][sequence]. */
+static int dspark_step(const RadArgs* a, bool couple) {
+    const int n_t = couple ? 13 : 10;
+    if (a->n_t < n_t) return RAD_E_INVAL;
+    const RadTensor *tiles = &a->t[0], *hidden = &a->t[1], *ctx = &a->t[2], *anchor = &a->t[3];
+    const RadTensor *proj = &a->t[4], *bias = &a->t[5], *embed = &a->t[6], *walk = &a->t[7];
+    const RadTensor *out = &a->t[8], *kept = &a->t[9];
+    for (int i = 0; i < n_t; ++i)
+        if (!a->t[i].data) return RAD_E_INVAL;
+    if (tiles->dtype != RAD_I32 || anchor->dtype != RAD_I32 || out->dtype != RAD_I32 ||
+        kept->dtype != RAD_I32)
+        return RAD_E_DTYPE;
+    const RadTensor *card = couple ? &a->t[10] : nullptr, *draw = couple ? &a->t[11] : nullptr;
+    const RadTensor *cstate = couple ? &a->t[12] : nullptr;
+    if (couple && (card->dtype != RAD_I32 || draw->dtype != RAD_U32 || cstate->dtype != RAD_U32))
+        return RAD_E_DTYPE;
+    const int64_t steps = p_int(a, "steps", 0), R = p_int(a, "rank", 0), n = p_int(a, "n", 0);
+    const int64_t l = p_int(a, "l", -1), slots = p_int(a, "slots", 0), Mb = p_int(a, "M", 0);
+    const int64_t astr = p_int(a, "anchor_stride", 1);
+    const float knee = p_f32(a, "knee", 0.0f), budget = p_f32(a, "budget", 0.0f);
+    const bool stop = !couple && p_int(a, "stop", 0) != 0;
+    if (steps <= 0 || R <= 0 || n <= 0 || l < 0 || l > steps || slots <= 0 || astr <= 0)
+        return RAD_E_SHAPE;
+    const int64_t M = rows_of(out, steps), width = 2 * R + 2 * n, n_embed = rows_of(embed, R);
+    WalkLayout W;
+    if (M <= 0 || M > Mb || numel(tiles) < M * 2 * slots || numel(hidden) < M * steps * n ||
+        numel(ctx) < M * n || numel(anchor) < (M - 1) * astr + 1 || numel(proj) != 3 * R * width ||
+        numel(bias) != 3 * R || n_embed <= 0 || numel(kept) < M ||
+        !walk_layout(walk, Mb, steps, R, &W))
+        return RAD_E_SHAPE;
+    const int64_t V = p_int(a, "n_vocab", 0);
+    const int64_t DW = (int64_t)RAD_MTP_COUPLE_DRAW_WORDS, SW = (int64_t)RAD_MTP_COUPLE_STATE_WORDS;
+    if (couple && (V <= 0 || numel(card) < M || numel(draw) < M * DW || cstate->rank != 3 ||
+                   cstate->shape[0] < steps || cstate->shape[1] < M || cstate->shape[2] != SW ||
+                   cstate->stride[2] != 1 || cstate->stride[1] % 2 || cstate->stride[0] % 2))
+        return RAD_E_SHAPE;
+
+    auto bf = [](float v) { return bf16_to_f32(f32_to_bf16(v)); };
+    const int64_t os = laststride(out);
+    for (int64_t m = 0; m < M; ++m) {
+        if (stop && l >= 2 && ld_int(kept->dtype, kept->data, offlin(kept, m)) < l - 1) {
+            st_int(out->dtype, out->data, rowoff(out, m, steps) + (l - 1) * os, -1);
+            continue;
+        }
+        int64_t prev;
+        if (l == 0) {
+            prev = ld_int(anchor->dtype, anchor->data, offlin(anchor, m * astr));
+            /* The projections of every position's row and the context, which no state reads. */
+            const int64_t cb = rowoff(ctx, m, n), cs = laststride(ctx);
+            for (int64_t ll = 0; ll < steps; ++ll) {
+                const int64_t hb = rowoff(hidden, m * steps + ll, n), hs = laststride(hidden);
+                for (int64_t o = 0; o < 3 * R; ++o) {
+                    const int64_t pb = rowoff(proj, o, width), ps = laststride(proj);
+                    float acc = ldt(bias, offlin(bias, o));
+                    for (int64_t i = 0; i < n; ++i)
+                        acc += ldt(hidden, hb + i * hs) * ldt(proj, pb + (2 * R + i) * ps);
+                    for (int64_t i = 0; i < n; ++i)
+                        acc += ldt(ctx, cb + i * cs) * ldt(proj, pb + (2 * R + n + i) * ps);
+                    W.pre[(m * steps + ll) * 3 * R + o] = acc;
+                }
+            }
+        } else {
+            float best = -INFINITY, next = -INFINITY;
+            int64_t bt = INT_MAX;
+            const int64_t tb = rowoff(tiles, m, 2 * slots), ts = laststride(tiles);
+            for (int64_t t = 0; t < slots; ++t) {
+                const uint32_t sb = (uint32_t)ld_int(tiles->dtype, tiles->data, tb + 2 * t * ts);
+                float sc;
+                std::memcpy(&sc, &sb, sizeof sc);
+                const int64_t tk = ld_int(tiles->dtype, tiles->data, tb + (2 * t + 1) * ts);
+                if (sc > best || (sc == best && tk < bt)) {
+                    next = best;
+                    best = sc;
+                    bt = tk;
+                } else if (sc > next) {
+                    next = sc;
+                }
+            }
+            prev = bt;
+            if (couple) {
+                std::vector<int64_t> order((size_t)slots);
+                for (int64_t i = 0; i < slots; ++i) order[(size_t)i] = i;
+                auto slot = [&](int64_t i, float* sc) {
+                    const uint32_t sb =
+                        (uint32_t)ld_int(tiles->dtype, tiles->data, tb + 2 * i * ts);
+                    std::memcpy(sc, &sb, sizeof *sc);
+                    return (int32_t)ld_int(tiles->dtype, tiles->data, tb + (2 * i + 1) * ts);
+                };
+                const int64_t k = std::min<int64_t>(8, slots);
+                std::partial_sort(order.begin(), order.begin() + k, order.end(),
+                                  [&](int64_t x, int64_t y) {
+                                      float sx, sy;
+                                      const int32_t tx = slot(x, &sx), ty = slot(y, &sy);
+                                      return sx > sy || (sx == sy && tx < ty);
+                                  });
+                int32_t ids[8];
+                float sc[8];
+                int n_win = 0;
+                for (int64_t i = 0; i < k; ++i) {
+                    float s;
+                    const int32_t id = slot(order[(size_t)i], &s);
+                    if (s != s) break;
+                    ids[n_win] = id;
+                    sc[n_win++] = s;
+                }
+                RadMtpCoupleDraw dr{};
+                std::memcpy(&dr, (const uint32_t*)draw->data + rowoff(draw, m, DW), sizeof dr);
+                RadMtpCoupleState stv{};
+                const int32_t at = (int32_t)ld_int(card->dtype, card->data, offlin(card, m));
+                prev = rad_dspark_couple_step(ids, sc, n_win, dr, dr.card == at, (int)l, V,
+                                              (int32_t)bt, &stv);
+                std::memcpy((uint32_t*)cstate->data + (l - 1) * cstate->stride[0] +
+                                m * cstate->stride[1],
+                            &stv, sizeof stv);
+            }
+            const int64_t pos = l - 1;
+            st_int(out->dtype, out->data, rowoff(out, m, steps) + pos * os, prev);
+            float debt = pos == 0 ? 0.0f : W.debt[m];
+            int64_t keep = pos == 0 ? steps : ld_int(kept->dtype, kept->data, offlin(kept, m));
+            const float short_by = knee - (best - next);
+            if (short_by > 0.0f) debt += short_by;
+            if (pos > 0 && pos < keep && debt > budget) keep = pos;
+            W.debt[m] = stop && keep < steps ? NAN : debt;
+            st_int(kept->dtype, kept->data, offlin(kept, m), keep);
+            if (stop && keep == pos)
+                st_int(out->dtype, out->data, rowoff(out, m, steps) + pos * os, -1);
+        }
+        if (l == steps) continue;
+
+        std::vector<float> in((size_t)(2 * R)), raw((size_t)(3 * R));
+        const bool prev_ok = prev >= 0 && prev < n_embed;
+        const int64_t eb = prev_ok ? rowoff(embed, prev, R) : 0, es = laststride(embed);
+        for (int64_t r = 0; r < R; ++r) {
+            in[(size_t)r] = l == 0 ? 0.0f : W.state[((l & 1) * M + m) * R + r];
+            in[(size_t)(R + r)] = prev_ok ? ldt(embed, eb + r * es) : 0.0f;
+        }
+        for (int64_t o = 0; o < 3 * R; ++o) {
+            const int64_t pb = rowoff(proj, o, width), ps = laststride(proj);
+            float acc = W.pre[(m * steps + l) * 3 * R + o];
+            for (int64_t i = 0; i < 2 * R; ++i) acc += in[(size_t)i] * ldt(proj, pb + i * ps);
+            raw[(size_t)o] = bf(acc);
+        }
+        for (int64_t r = 0; r < R; ++r) {
+            const float gate = bf(act_sigmoid(raw[(size_t)r]));
+            const float cand = bf(ref_tanh(raw[(size_t)(R + r)]));
+            const float keep = bf(gate * in[(size_t)r]);
+            const float update = bf(bf(1.0f - gate) * cand);
+            W.state[(((l + 1) & 1) * M + m) * R + r] = bf(keep + update);
+            W.latent[m * R + r] = bf(ref_tanh(raw[(size_t)(2 * R + r)]));
+        }
+    }
+    return RAD_OK;
+}
+
+int ref_dspark_walk_step(const RadArgs* a, RadStream) { return dspark_step(a, false); }
+
+int ref_dspark_walk_couple(const RadArgs* a, RadStream) { return dspark_step(a, true); }
+
+int ref_dspark_walk_score(const RadArgs* a, RadStream) {
+    if (a->n_t < 5) return RAD_E_INVAL;
+    const RadTensor *logits = &a->t[0], *walk = &a->t[1], *fold = &a->t[2], *fold_b = &a->t[3];
+    const RadTensor* tiles = &a->t[4];
+    for (int i = 0; i < 5; ++i)
+        if (!a->t[i].data) return RAD_E_INVAL;
+    if (tiles->dtype != RAD_I32) return RAD_E_DTYPE;
+    const bool stop = p_int(a, "stop", 0) != 0;
+    const int64_t steps = p_int(a, "steps", 0), R = p_int(a, "rank", 0);
+    const int64_t V = p_int(a, "n_vocab", 0), l = p_int(a, "l", -1), v0 = p_int(a, "v0", 0);
+    const int64_t slots = p_int(a, "slots", 0), Mb = p_int(a, "M", 0);
+    const float cap = p_f32(a, "cap", 0.0f);
+    if (steps <= 0 || R <= 0 || V <= 0 || l < 0 || l >= steps || slots * 64 < V || v0 < 0 ||
+        v0 % 64 || !(cap > 0.0f))
+        return RAD_E_SHAPE;
+    const int64_t M = rows_of(tiles, 2 * slots);
+    WalkLayout W;
+    if (M <= 0 || M > Mb || numel(logits) < M * steps * V || numel(fold) != V * R ||
+        numel(fold_b) != V || !walk_layout(walk, Mb, steps, R, &W))
+        return RAD_E_SHAPE;
+    int src = RAD_OK;
+    const RadTensor* fscale = fold_scale(a, 5, V, R, &src);
+    if (src != RAD_OK) return src;
+    const int32_t* ids = a->n_t > 6 && a->t[6].data ? (const int32_t*)a->t[6].data : nullptr;
+    if (ids && (a->t[6].dtype != RAD_I32 || numel(&a->t[6]) < v0 + V)) return RAD_E_SHAPE;
+
+    auto bf = [](float v) { return bf16_to_f32(f32_to_bf16(v)); };
+    const int64_t ts = laststride(tiles);
+    REF_PAR_FOR(M * V * R)
+    for (int64_t m = 0; m < M; ++m) {
+        if (stop && l >= 1 && std::isnan(W.debt[m])) continue;
+        const int64_t lb = rowoff(logits, m * steps + l, V), ls = laststride(logits);
+        const int64_t tb = rowoff(tiles, m, 2 * slots);
+        for (int64_t tile = 0; tile < slots; ++tile) {
+            const int64_t first = tile * 64, end = std::min<int64_t>(first + 64, V);
+            float best = -INFINITY;
+            int64_t best_token = v0 + first;
+            for (int64_t t = first; t < end; ++t) {
+                const float b = fold_bias(fold, fold_b, fscale, t, R, W.latent + m * R);
+                const float x = bf(bf(ldt(logits, lb + t * ls)) + bf(b));
+                const float score = bf(cap * ref_tanh(x / cap));
+                const int64_t token = ids ? ids[v0 + t] : v0 + t;
+                if (score > best || (score == best && token < best_token)) {
+                    best = score;
+                    best_token = token;
+                }
+            }
+            uint32_t sb;
+            std::memcpy(&sb, &best, sizeof sb);
+            st_int(tiles->dtype, tiles->data, tb + 2 * tile * ts, (int32_t)sb);
+            st_int(tiles->dtype, tiles->data, tb + (2 * tile + 1) * ts, best_token);
+        }
+    }
+    return RAD_OK;
+}
+
+int ref_dspark_rnn_greedy(const RadArgs* a, RadStream) { return dspark_walk(a, false); }
+
+int ref_dspark_rnn_couple(const RadArgs* a, RadStream) { return dspark_walk(a, true); }
