+/* act_mul into an f32 row, `a` and `b` each bf16 or f32; an f32 `b` is the output too, a column
+ * slice of the buffer `a` is not in. */
+void act_mul_f32_cases(const Plugin& pl) {
+    const RadKernelInfo* r = find(pl, "act_mul_f32");
+    if (!r) { ok("act_mul_f32", false, "row absent"); return; }
+    const int64_t M = 21, n = 1152, ld = 2 * n;
+    const float q = bfr(1.702f);
+    for (const char* act : { "silu", "gelu", "gelu_tanh", "sigmoid", "quick_gelu", "relu" })
+        for (int mix = 0; mix < 4; ++mix) {
+            const bool af = mix & 1, bf = mix & 2;
+            std::vector<float> a = randv((size_t)(M * ld), 6.0f), b = randv((size_t)(M * ld), 3.0f);
+            void* da = af ? up_f32(a) : up_bf16(a);
+            void* db = bf ? up_f32(b) : up_bf16(b);
+            void* dy = bf ? db : dalloc((size_t)(M * ld) * 4);
+            RadTensor ta = T(da, af ? RAD_F32 : RAD_BF16, { M, n });
+            RadTensor tb = T(bf ? (void*)((float*)db + n) : (void*)((uint16_t*)db + n),
+                             bf ? RAD_F32 : RAD_BF16, { M, n });
+            RadTensor ty = T((float*)dy + n, RAD_F32, { M, n });
+            ta.stride[0] = tb.stride[0] = ty.stride[0] = ld;
+            const std::string nm = fmt("act_mul_f32 %s(%s) * %s%s", act, af ? "f32" : "bf16",
+                                       bf ? "f32" : "bf16", bf ? ", in place" : "");
+            const int rc = launch(r, { ta, tb, ty }, { PI("M", M), PI("n", n), PS("act", act),
+                                                       PS("dtype", "f32") });
+            if (rc != RAD_OK) { ok(nm.c_str(), false, "rc " + std::to_string(rc)); continue; }
+            const std::vector<float> got = down_f32(dy, (size_t)(M * ld));
+            std::vector<float> have, want;
+            for (int64_t m = 0; m < M; ++m)
+                for (int64_t i = 0; i < n; ++i) {
+                    const float g = a[(size_t)(m * ld + i)];
+                    const double sg = 1.0 / (1.0 + std::exp(-(double)g));
+                    const double v = !std::strcmp(act, "silu") ? g * sg
+                                   : !std::strcmp(act, "gelu") ? gelu_erf(g)
+                                   : !std::strcmp(act, "gelu_tanh") ? gelu_tanh(g)
+                                   : !std::strcmp(act, "sigmoid") ? sg
+                                   : !std::strcmp(act, "relu") ? (g > 0 ? g : 0)
+                                   : 1.0 / (1.0 + std::exp(-(double)(g * q)));
+                    want.push_back((float)(v * b[(size_t)(m * ld + n + i)]));
+                    have.push_back(got[(size_t)(m * ld + n + i)]);
+                }
+            check_f32(nm + " numerics", have, want, 1e-5);
+        }
+}
