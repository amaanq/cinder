+            RAD_ARCH_TRY(rad_op_reads(b, L.op_attn_gq, &m.b_bias[L.local], 1));
+        RAD_ARCH_TRY(linear(L.lin_out, "attn_output", "self_attn.o_proj.linear.weight", E, q_dim,
+                            m.a_attn, m.b_o, RAD_SHARD_COL));
+        if (g.world > 1) L.op_attn_ar = all_reduce(m.b_o, g.wire_exact);
+        /* A block's first layer keeps its input as a block state and starts the stream again
+         * from its attention's output; the others add that output to their input. */
+        short_conv(L.attn_conv, E, 0, m.b_o, m.b_res, L.boundary ? 0 : m.b_x);
+        if (L.op_attn_ar) ar_conv(L.attn_conv, m.b_o, m.b_res, L.boundary ? 0 : m.b_x);
+        if (L.attn_conv.op_ar && L.lin_out.iqr &&
+            rad_op_declared(b, "gemm_nt_q_ar_causal_conv1d")) {
+            L.op_out_ar = rw(b, RAD_OP(b, "gemm_nt_q_ar_causal_conv1d",
+                                RAD_PARAMS(RAD_RANGE("M", 1, std::min<int64_t>(T, 8)),
+                                           RAD_INT("N", L.lin_out.N), RAD_INT("K", L.lin_out.K),
+                                           RAD_INT("group", RAD_FP8_BLOCK),
+                                           RAD_STR("dtype", L.lin_out.i8_rot ? "i8a8h" : "i8a8"),
+                                           RAD_INT("m_invariant", g.m_invariant),
+                                           RAD_INT("n", E), RAD_INT("width", width),
+                                           RAD_INT("world_size", g.world),
+                                           RAD_F64("div", std::sqrt((double)(width + 1))),
+                                           RAD_INT("chain", rad_chain_on())),
+                                RAD_WEIGHTS(L.lin_out.w, L.lin_out.ws, L.attn_conv.w)),
+                             {m.a_attn.q8, m.a_attn.s8}, {m.b_o, m.b_res});
+            if (L.op_out_ar && !L.boundary) RAD_ARCH_TRY(rad_op_reads(b, L.op_out_ar, &m.b_x, 1));
+        }
+        if (L.boundary) L.op_state = cast(E, g.dtype, g.dtype, m.b_x, m.b_states);
+
+        if (cal.records(l)) {
+            /* Named by the container's weights, which is how a quantiser asks for a Hessian. */
+            const std::string B = "blk." + std::to_string(l) + ".";
+            const std::string kt = L.local ? "" : "," + B + "attn_k_sconv_proj";
+            const std::string vt = L.local ? "" : "," + B + "attn_v_sconv_proj";
+            const std::string in[3][2] = {
+                { "attn_q", B + "attn_q," + B + "attn_rel," + B + "attn_sink," + B +
+                            "attn_output_gate" },
+                { "attn_k", B + "attn_k" + kt },
+                { "attn_v", B + "attn_v" + vt },
+            };
+            for (int i = 0; i < 3; ++i) {
+                L.cs[i] = (int)cal.sites.size();
+                RAD_ARCH_TRY(cal.site(b, g, l, B + in[i][0] + ".input", in[i][1], m.b_h, E, E));
+            }
+            L.cs_o = (int)cal.sites.size();
+            RAD_ARCH_TRY(cal.site(b, g, l, B + "attn_output.input", B + "attn_output", m.b_attn,
+                                  q_dim, q_dim));
+        }
+
+        L.op_ffn_mix  = depth_mix(T, L.n_state + (L.boundary ? 1 : 0), 1, L.w_ffn_query,
+                                  m.b_states, m.b_res, m.b_mix);
+        if (looped) gate(L.gate[3]);
+        L.op_ffn_norm = rmsnorm(T, L.w_ffn_norm, "f32", m.b_mix, h);
+        if (looped) RAD_ARCH_TRY(rad_op_reads(b, L.op_ffn_norm, &m.b_msg_mix, 1));
+
+        GlmRouter::Config rc;
+        rc.experts     = n_expert;
+        rc.top_k       = top_k;
+        rc.rows        = T;
+        rc.route_scale = route_scale;
+        const GlmRouter::Wire rwire{ h, m.b_logits_r, m.b_ids, m.b_ew };
+        const GlmRouter::Src rsrc{ nm.ckpt("%s.layers.%d.mlp.gate.weight", pre, l),
+                                   nm.ckpt("%s.layers.%d.mlp.gate.e_score_correction_bias", pre,
+                                           l) };
+        RAD_ARCH_TRY(L.router.declare(b, nm, g, l, nm.f("blk.%d.ffn_gate_inp", l), rc, rwire,
+                                      rsrc));
+        L.op_scatter = rw(b, RAD_OP(b, "moe_scatter",
+                              RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n_expert", n_expert),
+                                         RAD_INT("top_k", top_k), RAD_INT("expert_base", 0)),
+                              RAD_NOWEIGHTS),
+                          {m.b_ids}, {m.b_sorted, m.b_eoff, m.b_ecnt});
+        /* The selection and the sort in one launch, for a step whose slots fit the sort's one
+         * workgroup (1024). */
+        m.route_rows = std::min<int64_t>(T, 1024 / top_k);
+        if (rad_op_declared(b, "router_sigmoid_topk_scatter"))
+            L.op_route = rw(b, RAD_OP(b, "router_sigmoid_topk_scatter",
+                                RAD_PARAMS(RAD_RANGE("M", 1, m.route_rows),
+                                           RAD_INT("n_expert", n_expert), RAD_INT("top_k", top_k),
+                                           RAD_INT("norm", rc.norm),
+                                           RAD_F64("route_scale", route_scale),
+                                           RAD_STR("dtype", "f32")),
+                                RAD_WEIGHTS(L.router.correction)),
+                            {m.b_logits_r}, {m.b_ids, m.b_ew, m.b_sorted, m.b_eoff, m.b_ecnt});
+        if (L.op_route && rad_op_declared(b, "router_gemm_sigmoid_topk_scatter"))
+            L.op_route_gemm =
+                rw(b, RAD_OP(b, "router_gemm_sigmoid_topk_scatter",
+                          RAD_PARAMS(RAD_RANGE("M", 1, std::min<int64_t>(T, 8)), RAD_INT("K", E),
+                                     RAD_INT("n_expert", n_expert), RAD_INT("top_k", top_k),
+                                     RAD_INT("norm", rc.norm), RAD_F64("route_scale", route_scale),
+                                     RAD_STR("dtype", "f32")),
+                          RAD_WEIGHTS(L.router.projection, L.router.correction)),
+                   {h}, {m.b_logits_r, m.b_ids, m.b_ew, m.b_sorted, m.b_eoff, m.b_ecnt});
+        if (L.op_route_gemm && rad_op_declared(b, "rmsnorm_router_gemm_sigmoid_topk_scatter")) {
+            L.op_route_norm =
+                rw(b, RAD_OP(b, "rmsnorm_router_gemm_sigmoid_topk_scatter",
+                          RAD_PARAMS(RAD_RANGE("M", 1, std::min<int64_t>(T, 8)), RAD_INT("K", E),
+                                     RAD_INT("n_expert", n_expert), RAD_INT("top_k", top_k),
+                                     RAD_INT("norm", rc.norm), RAD_F64("route_scale", route_scale),
+                                     RAD_STR("dtype", "f32"), RAD_F64("eps", g.eps)),
+                          RAD_WEIGHTS(L.w_ffn_norm, L.router.projection, L.router.correction)),
+                   {m.b_mix}, {h, m.b_logits_r, m.b_ids, m.b_ew, m.b_sorted, m.b_eoff, m.b_ecnt});
+            if (looped && L.op_route_norm)
+                RAD_ARCH_TRY(rad_op_reads(b, L.op_route_norm, &m.b_msg_mix, 1));
+        }
+        /* The weight list is every expert's handle for `moe_gemm`, and for `moe_gemm_q` the even
+         * experts' codes, their scales, then the odd experts' codes and scales. */
+        auto expert_gemm = [&](Experts& x, int64_t N, int64_t K, const char* order, rad_buf in,
+                               rad_buf y) {
+            std::vector<rad_weight> table;
+            for (int q = 0; q < 2; ++q) {
+                const int64_t n = !x.group ? (q ? 0 : n_expert) : (n_expert + 1 - q) / 2;
+                for (int64_t i = 0; i < n; ++i) table.push_back(x.w[q] + (rad_weight)i);
+                for (int64_t i = 0; x.group && i < n; ++i)
+                    table.push_back(x.scale[q] + (rad_weight)i);
+            }
+            const RadParam ps[] = { RAD_RANGE("M", 1, T), RAD_INT("N", N), RAD_INT("K", K),
+                                    RAD_INT("n_expert", n_expert), RAD_INT("top_k", top_k),
+                                    RAD_STR("a_order", order),
+                                    RAD_STR("dtype", x.group ? x.dtype : g.dtype),
+                                    RAD_INT("group", x.group) };
+            x.op = rw(b, rad_decl_op(b, x.group ? "moe_gemm_q" : "moe_gemm", ps, x.group ? 8 : 7,
+                                     table.data(), (int)table.size()),
+                      {in, m.b_sorted, m.b_eoff}, {y});
+        };
+        expert_gemm(L.gate_up, 2 * n_ff, E, "token", h, m.b_egu);
+        /* softcap(gate) * sigmoid(gate) * softcap(up) in f32, rounded once. */
+        if (rad_op_declared(b, "capped_sigmoid_glu")) {
+            L.op_glu = rw(b, RAD_OP(b, "capped_sigmoid_glu",
+                              RAD_PARAMS(RAD_RANGE("M", 1, P), RAD_INT("n", n_ff),
+                                         RAD_F64("gate_cap", gate_cap),
+                                         RAD_F64("up_cap", up_cap), RAD_STR("dtype", "f32")),
+                              RAD_NOWEIGHTS),
+                          {m.b_egu}, {m.b_eff});
+        } else {
+            L.op_cap_gate = softcap(gate_cap);
+            L.op_cap_up   = softcap(up_cap);
+            L.op_act = rw(b, RAD_OP(b, "act_mul",
+                              RAD_PARAMS(RAD_RANGE("M", 1, P), RAD_INT("n", n_ff),
+                                         RAD_STR("act", "sigmoid"), RAD_STR("dtype", "f32")),
+                              RAD_NOWEIGHTS),
+                          {m.b_egu, m.b_cap}, {m.b_cap});
+            L.op_act_mul = rw(b, RAD_OP(b, "mul",
+                                  RAD_PARAMS(RAD_RANGE("M", 1, P), RAD_INT("n", n_ff),
+                                             RAD_STR("dtype", "f32")),
+                                  RAD_NOWEIGHTS),
+                              {m.b_cap}, {m.b_eff});
+        }
+        expert_gemm(L.down, E, n_ff, "sorted", m.b_eff, m.b_edn);
+        /* Its kernel takes every step, a decode band's in one grid and a prefill's in two. */
+        const int64_t ffn_rows = T;
+        const char* fdt = L.gate_up.dtype;
+        const bool fq = fdt && L.down.dtype && !std::strcmp(fdt, L.down.dtype) &&
+                        (!std::strcmp(fdt, "nvfp4a16") || !std::strcmp(fdt, "mxfp8a16"));
+        std::vector<rad_weight> table;
+        if (fq && ffn_rows >= 1 && rad_op_declared(b, "moe_ffn_q")) {
+            for (const Experts* x : { &L.gate_up, &L.down })
+                for (int q = 0; q < 2; ++q) {
+                    const int64_t n = (n_expert + 1 - q) / 2;
+                    for (int64_t i = 0; i < n; ++i) table.push_back(x->w[q] + (rad_weight)i);
+                    for (int64_t i = 0; i < n; ++i) table.push_back(x->scale[q] + (rad_weight)i);
+                }
+            const RadParam ps[] = { RAD_RANGE("M", 1, ffn_rows), RAD_INT("N", 2 * n_ff),
+                                    RAD_INT("K", E), RAD_INT("n_expert", n_expert),
+                                    RAD_INT("top_k", top_k), RAD_INT("group", L.gate_up.group),
+                                    RAD_STR("dtype", fdt), RAD_F64("gate_cap", gate_cap),
+                                    RAD_F64("up_cap", up_cap) };
+            L.op_ffn = rw(b, rad_decl_op(b, "moe_ffn_q", ps, 9, table.data(), (int)table.size()),
+                          { h, m.b_sorted, m.b_eoff }, { m.b_edn });
+            if (L.op_ffn && !rad_op_resolved(b, L.op_ffn)) L.op_ffn = 0;
+            L.ffn_rows = L.op_ffn ? ffn_rows : 0;
+        }
+        L.op_gather = rw(b, RAD_OP(b, "moe_gather",
+                             RAD_PARAMS(RAD_RANGE("M", 1, T), RAD_INT("n", E),
+                                        RAD_INT("top_k", top_k), RAD_STR("dtype", g.dtype),
+                                        RAD_STR("act", "none")),
+                             RAD_NOWEIGHTS),
+                         {m.b_edn, m.b_ew, m.b_sorted}, {m.b_o});
+        if (g.world > 1) L.op_ffn_ar = all_reduce(m.b_o, g.wire_exact);
+        short_conv(L.ffn_conv, E, 0, m.b_o, m.b_x, m.b_res);
+        if (L.op_ffn_ar) ar_conv(L.ffn_conv, m.b_o, m.b_x, m.b_res, true);
+        if (L.op_ffn && L.ffn_conv.op_ar_g && rad_op_declared(b, "moe_ffn_q_ar_causal_conv1d")) {
+            table.push_back(L.ffn_conv.w);
+            const RadParam ps[] = { RAD_RANGE("M", 1, std::min<int64_t>(T, 8)),
+                                    RAD_INT("N", 2 * n_ff), RAD_INT("K", E),
+                                    RAD_INT("n_expert", n_expert), RAD_INT("top_k", top_k),
+                                    RAD_INT("group", L.gate_up.group), RAD_STR("dtype", fdt),
+                                    RAD_F64("gate_cap", gate_cap), RAD_F64("up_cap", up_cap),
+                                    RAD_INT("n", E), RAD_INT("width", width),
+                                    RAD_INT("world_size", g.world),
+                                    RAD_F64("div", std::sqrt((double)(width + 1))),
+                                    RAD_INT("chain", rad_chain_on()) };
+            L.op_ffn_push = rw(b, rad_decl_op(b, "moe_ffn_q_ar_causal_conv1d", ps, 14,
+                                              table.data(), (int)table.size()),
+                               { h, m.b_sorted, m.b_eoff, m.b_ew, m.b_res },
+                               { m.b_edn, m.b_o, m.b_x });
+            if (L.op_ffn_push && !rad_op_resolved(b, L.op_ffn_push)) L.op_ffn_push = 0;
+        }
+        if (m.b_tap) {
+            L.op_tap     = cast(E, g.dtype, g.dtype, m.b_x, m.b_tap);
+            L.op_tap_ids = cast(top_k, "i32", "i32", m.b_ids, m.b_tap_ids);
+            L.op_tap_ew  = cast(top_k, "f32", "f32", m.b_ew, m.b_tap_ew);
+        }
+
+        /* Between passes: what the next one's messages read, and the stream back at the first
+         * looped layer's input, which that layer kept as a block state. */
+        if (l == m.core_end - 1 && m.n_pass > 1) {
+            m.op_bank    = cast(m.n_bank * E, g.dtype, g.dtype, m.b_states, m.b_bank);
+            m.op_prev    = cast(E, g.dtype, g.dtype, m.b_x, m.b_prev);
+            m.op_restart = cast(E, g.dtype, g.dtype, m.b_states, m.b_x);
+        }
+    }
+
+    auto gather = [&](int64_t n, rad_buf x, rad_buf y) {
+        return rw(b, RAD_OP(b, "gather_rows",
+                      RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows), RAD_INT("n", n),
+                                 RAD_STR("dtype", g.dtype)),
+                      RAD_NOWEIGHTS),
+                  {x}, {y});
+    };
+    m.op_gather        = gather(E, m.b_x, m.b_hout);
+    m.op_gather_states = gather(n_state * E, m.b_states, m.b_states_out);
+    m.op_final_mix = depth_mix(g.max_logit_rows, n_state, 1, m.w_final_query, m.b_states_out,
+                               m.b_hout, m.b_mix_out);
+    m.op_final_norm = rmsnorm(g.max_logit_rows, m.w_out_norm, "f32", m.b_mix_out, m.b_hout);
+    m.op_logits = rw(b, RAD_OP(b, "logits_gemm",
+                         RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows),
+                                    RAD_INT("n_vocab", m.n_head_vocab), RAD_INT("n_embd", E),
+                                    RAD_STR("dtype", g.dtype), RAD_INT("m_invariant", 1)),
+                         RAD_WEIGHTS(m.w_lm_head)),
+                     {m.b_hout}, {m.b_head});
+    m.op_cap = rw(b, RAD_OP(b, "logit_softcap",
+                      RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows), RAD_INT("n", m.n_head_vocab),
+                                 RAD_F64("cap", m.softcap), RAD_STR("dtype", "f32")),
+                      RAD_NOWEIGHTS),
+                  {m.b_head}, {m.b_logits});
+    if (m.n_head_vocab < g.n_vocab)
+        m.op_pad = rw(b, RAD_OP(b, "fill",
+                          RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows),
+                                     RAD_INT("n", g.n_vocab - m.n_head_vocab),
+                                     RAD_STR("dtype", "f32"),
+                                     RAD_F64("value", -std::numeric_limits<double>::infinity())),
+                          RAD_NOWEIGHTS),
+                      {}, {m.b_logits});
+
+    Dspark::Trunk tr{};
+    tr.x = m.b_x;
+    tr.states = m.b_states;
+    tr.mix = m.b_mix;
+    tr.n_state = n_state;
+    tr.tok = m.w_tok;
+    tr.tok_norm = m.w_tok_norm;
+    tr.final_query = m.w_final_query;
+    tr.out_norm = m.w_out_norm;
+    tr.lm_head = m.w_lm_head;
+    tr.n_head_vocab = m.n_head_vocab;
+    tr.softcap = m.softcap;
+    /* The drafter's anchor reads the whole table, so a rank sharding it gives the drafter its own
+     * unsharded copy. Its walk scores the vocabulary in spans of whole 64-id tiles, so its lm_head
+     * is its own span of the stored head (Dspark::span). */
+    if (m.ds.on && g.world > 1) {
+        tr.tok = decl_view(b, nm.f("dspark.token_embd.weight"), nm.f("token_embd.weight"), nullptr,
+                           RAD_BF16, {g.n_vocab_all, E}, RAD_ACCESS_VOCAB, RAD_SHARD_NONE,
+                           grp_model());
+        if (!tr.tok) return RAD_E_INVAL;
+        /* A drafter over its short tables reads no span of the whole head. */
+        if (!std::getenv("RADIANCE_INKLING2_DSPARK_SHORT")) {
+            int64_t lo = 0, hi = 0;
+            Dspark::span(head_all, g.rank, g.world, &lo, &hi);
+            tr.lm_head = decl_view(b, nm.f("dspark.output.weight"), nm.f("output.weight"), nullptr,
+                                   weight_codes_dtype(b, nm.f("output.weight"), RAD_BF16),
+                                   {hi - lo, E}, RAD_ACCESS_VOCAB, RAD_SHARD_ROW, grp_model());
+            if (!tr.lm_head) return RAD_E_INVAL;
+            RAD_ARCH_TRY(rad_weight_shard_span(b, tr.lm_head, lo, hi));
+        }
+        tr.n_head_vocab = head_all;
+    }
+    RAD_ARCH_TRY(m.ds.declare(b, nm, meta, ctx, g, tr, 2 * n_slot));
+
+    rad_note(b, "inkling2loop: %lld layers (%d local), %d to %d run %d times, %d state slots; "
+                "hidden %lld, %lld experts of %lld top %lld, vocab %lld in, %lld out",
+             (long long)g.n_layer, n_local, m.core_start, m.core_end - 1, m.n_pass, n_slot,
+             (long long)E, (long long)n_expert, (long long)n_ff, (long long)top_k,
+             (long long)g.n_vocab, (long long)m.n_head_vocab);
+    return RAD_OK;
+}
+
+/* One short convolution over `x`, left in `y`. The convolution is issued once per half of the
+ * step, as LFM2's is: the decode rows with `num_accepted`, which leaves the window where a partly
+ * rejected verify reads it back, and the prefill chunks without it. */
+static void short_conv(RadCtx* c, const Model& m, const RadBatch* batch, const ShortConv& sc,
+                       rad_kvgroup group, int state, rad_buf taps_from, rad_buf x, rad_buf y,
+                       rad_buf skip, rad_buf taps = 0, bool ar = false, bool gather = false,
+                       const Layer* out = nullptr, const Layer* moe = nullptr) {
+    const int64_t T = batch->n_tok, S = batch->n_seq;
+    const RadKVGroupBatch* cv = kv_batch(batch, group);
+    const int32_t* idx = cv ? cv->state_index : nullptr;
+    int64_t D = 0, DT = 0;
+    batch_split(batch, &D, &DT);
+    const rad_op op = ar ? (gather ? sc.op_ar_g : sc.op_ar) : sc.op_conv;
+    auto issue = [&](int64_t rows, int64_t first, int64_t n, const int32_t* accepted) {
+        const RadOperand cu = praw(batch->cu_seqlens + first, RAD_I32, n + 1);
+        const RadOperand slot = praw(idx ? idx + first : nullptr, RAD_I32, n);
+        const RadOperand init = praw(batch->ctx_lens + first, RAD_I32, n);
+        const RadOperand acc = accepted ? praw(accepted, RAD_I32, n) : RAD_NONE;
+        const RadOperand add = skip ? brows(skip, rows) : RAD_NONE;
+        if (sc.op_taps)
+            RAD_ISSUE_N(c, sc.op_conv, rows, brows(x, rows), RAD_W(sc.w),
+                        brows(taps ? taps : m.b_taps, rows), kv_cache(group, state), cu, slot,
+                        init, acc, brows(y, rows), add);
+        else if (out) {
+            const int64_t K = out->lin_out.K;
+            RAD_ISSUE_N(c, out->op_out_ar, rows, brows(m.a_attn.q8, rows),
+                        bcol(m.a_attn.s8, 0, K / m.a_attn.g8, rows), RAD_W(out->lin_out.w),
+                        RAD_W(out->lin_out.ws), brows(x, rows), RAD_W(sc.w),
+                        kv_cache(group, state), cu, slot, init, acc, brows(y, rows), add);
+        } else if (moe) {
+            const int64_t NE = m.n_expert, P = rows * m.top_k;
+            const Experts& gu = moe->gate_up;
+            const Experts& dn = moe->down;
+            RAD_ISSUE_N(c, moe->op_ffn_push, rows, brows(m.b_h, rows), brows(m.b_sorted, P),
+                        brows(m.b_eoff, NE + 1), RAD_WTAB(gu.w[0], (NE + 1) / 2),
+                        RAD_WTAB(gu.scale[0], (NE + 1) / 2), RAD_WTAB(gu.w[1], NE / 2),
+                        RAD_WTAB(gu.scale[1], NE / 2), RAD_WTAB(dn.w[0], (NE + 1) / 2),
+                        RAD_WTAB(dn.scale[0], (NE + 1) / 2), RAD_WTAB(dn.w[1], NE / 2),
+                        RAD_WTAB(dn.scale[1], NE / 2), brows(m.b_edn, P), brows(x, rows),
+                        RAD_W(sc.w), kv_cache(group, state), cu, slot, init, acc, brows(y, rows),
+                        add, brows(m.b_ew, rows));
+        } else if (gather)
+            RAD_ISSUE_N(c, op, rows, brows(x, rows), RAD_W(sc.w), kv_cache(group, state), cu, slot,
+                        init, acc, brows(y, rows), add, brows(m.b_edn, rows * m.top_k),
+                        brows(m.b_ew, rows), brows(m.b_sorted, rows * m.top_k));
+        else
+            RAD_ISSUE_N(c, op, rows, brows(x, rows), RAD_W(sc.w), kv_cache(group, state), cu, slot,
+                        init, acc, brows(y, rows), add);
+    };
+
+    if (sc.op_taps && !taps)
+        RAD_ISSUE(c, sc.op_taps, brows(taps_from, T), RAD_W(sc.w_taps), brows(m.b_taps, T));
+    if (D > 0) issue(DT, 0, D, batch->num_accepted);
+    if (S > D) issue(T, D, S - D, nullptr);
+}
+
+/* Whether this step issues `sc`'s convolution with the all-reduce in front of it: a two-rank LL
+ * message (r4d_ar_ll_2rank, 64 KiB) of one kind of row whose routed slots fit the gather's 64,
+ * which short_conv issues in one launch. */
+static bool ar_fused(const Model& m, const ShortConv& sc, const RadBatch* batch) {
+    if (!sc.op_ar) return false;
+    int64_t D = 0, DT = 0;
+    batch_split(batch, &D, &DT);
+    return batch->n_tok * m.g.n_embd * 2 <= 64 * 1024 && batch->n_tok * m.top_k <= 64 &&
+           (D == 0 || D == batch->n_seq);
+}
+
+/* `x` with message `site` of the pass before gated in: (1 - tanh(F r)) x + tanh(G r) msg, r the
+ * rank-`gate_rank` projection of the two, each normed with no gain. */
+static RadOperand gated(RadCtx* c, const Model& m, const Gate& gt, int site, RadOperand x,
+                        int64_t T) {
+    const int64_t E = m.g.n_embd;
+    RAD_ISSUE(c, gt.op, x, bcol(m.b_msg, site * E, E, T), RAD_W(gt.w_down), RAD_W(gt.w_forget),
+              RAD_W(gt.w_admit), brows(m.b_msg_rank, T), brows(m.b_msg_mix, T));
+    return brows(m.b_msg_mix, T);
+}
+
+/* `slot` is the state slot of this application of the layer, and `messages` says the pass before
+ * left some in `msg`. */
+static void attention(RadCtx* c, const Model& m, const Layer& L, int slot, bool messages,
+                      const RadBatch* batch) {
+    const Geom& g = m.g;
+    const int64_t T = batch->n_tok, E = g.n_embd;
+    const rad_kvgroup kv = L.local ? m.kv_local : m.kv_global;
+    const RadKVGroupBatch* kvb = kv_batch(batch, kv);
+    const int n_site = L.local ? 1 : 3;
+    const rad_buf h = m.b_h;
+
+    const bool mixq = L.op_mix_quant && !messages && L.cs[0] < 0 &&
+                      !(L.n_proj && T <= m.fused_rows) && T <= m.multi_rows;
+    if (L.op_in_mix && !mixq)
+        RAD_ISSUE(c, L.op_in_mix, bcol(m.b_states, 0, L.n_state * E, T), brows(m.b_x, T),
+                  RAD_W(L.w_in_query), bcol(m.b_mix, 0, n_site * E, T));
+    /* The input of q, k or v, normed into `to` and its int8 pair into `a`'s. A local layer norms
+     * one for all three, unless their messages tell them apart. */
+    auto site_x = [&](int site) {
+        const int i = L.local ? 0 : site;
+        return L.op_in_mix ? bcol(m.b_mix, i * E, E, T) : brows(m.b_x, T);
+    };
+    /* `gates`: the messages were gated in already, site s's into column s of msg_mix3. */
+    auto input = [&](int site, rad_buf to, const ActFP8& a, bool gates = false) {
+        if (site > 0 && L.local && !messages) return;
+        const int i = L.local ? 0 : site;
+        RadOperand x = site_x(site);
+        if (gates) x = bcol(m.b_msg_mix3, site * E, E, T);
+        else if (messages) x = gated(c, m, L.gate[site], site, x, T);
+        if (L.op_norm_quant[i]) {
+            RAD_ISSUE(c, L.op_norm_quant[i], x, RAD_NONE, RAD_W(L.w_norm[i]), brows(a.q8, T),
+                      brows(a.s8, T), brows(to, T));
+        } else {
+            RAD_ISSUE(c, L.op_norm[i], x, RAD_W(L.w_norm[i]), brows(to, T));
+            if (L.op_quant[i])
+                RAD_ISSUE(c, L.op_quant[i], brows(to, T), brows(a.q8, T), brows(a.s8, T));
+        }
+        if (L.cs[0] < 0) return;
+        CalibFull& cal = g_calib[rad_slot(c)];
+        for (int s = site; s < (L.local && !messages ? 3 : site + 1); ++s)
+            cal.tap(c, (size_t)L.cs[s], T);
+    };
+    const RadOperand pos = L.local ? RAD_NONE : praw(batch->positions, RAD_I32, T);
+    int64_t D = 0, DT = 0;
+    batch_split(batch, &D, &DT);
+    const bool prep = L.op_prep && (D == 0 || D == batch->n_seq);
+    const bool gq = L.op_attn_gq && !L.op_box && !L.op_attn_dense && T <= m.multi_rows;
+    const RadOperand bias =
+        gq && prep && m.b_bias[L.local] ? brows(m.b_bias[L.local], T) : RAD_NONE;
+    auto issue_prep = [&] {
+        const RadKVGroupBatch* cv = kv_batch(batch, m.kv_conv);
+        const int32_t* idx = cv ? cv->state_index : nullptr;
+        const int64_t S = batch->n_seq;
+        RAD_ISSUE(c, L.op_prep, brows(m.b_q, T), RAD_W(L.w_q_scale), brows(m.b_rel, T),
+                  RAD_W(L.w_rel_scale), pos, brows(m.b_lin, T), RAD_W(L.k.w),
+                  L.local ? RAD_NONE : brows(m.b_taps, T), kv_cache(m.kv_conv, 2 * slot),
+                  brows(m.b_lin_v, T), RAD_W(L.v.w), L.local ? RAD_NONE : brows(m.b_taps_v, T),
+                  kv_cache(m.kv_conv, 2 * slot + 1), praw(batch->cu_seqlens, RAD_I32, S + 1),
+                  praw(idx, RAD_I32, S), praw(batch->ctx_lens, RAD_I32, S),
+                  D && batch->num_accepted ? praw(batch->num_accepted, RAD_I32, S) : RAD_NONE,
+                  brows(m.b_k, T), brows(m.b_v, T),
+                  praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T), kv_cache(kv, slot),
+                  RAD_W(L.w_rel_proj), bias);
+    };
+
+    if (L.n_proj && T <= m.fused_rows) {
+        for (int i = 0; i < 3; ++i) input(i, m.b_h_site[i], m.a_h);
+        const bool one = L.local && !messages;
+        for (int p = 0; p < L.n_proj; ++p) {
+            const Layer::Proj& pj = L.proj[p];
+            RadOperand opd[19];
+            opd[0] = brows(h, T);
+            opd[1] = brows(m.b_h_site[one ? 0 : 1], T);
+            opd[2] = brows(m.b_h_site[one ? 0 : 2], T);
+            for (int j = 0; j < 8; ++j) {
+                const ProjSeg sg = proj_seg(L, m, j < pj.n ? pj.seg[j] : 0);
+                opd[3 + 2 * j] = j < pj.n ? RAD_W(sg.w) : RAD_NONE;
+                opd[4 + 2 * j] = j < pj.n ? brows(sg.y, T) : RAD_NONE;
+            }
+            rad_issue(c, pj.op, opd, 19, RAD_N_BATCH);
+        }
+        if (prep) {
+            issue_prep();
+        } else {
+            RAD_ISSUE(c, L.op_q_clip, brows(m.b_q, T), RAD_W(L.w_q_scale), brows(m.b_q, T), pos);
+            RAD_ISSUE(c, L.op_rel_clip, brows(m.b_rel, T), RAD_W(L.w_rel_scale),
+                      brows(m.b_rel, T), pos);
+            short_conv(c, m, batch, L.k, m.kv_conv, 2 * slot, 0, m.b_lin, m.b_k, 0, m.b_taps);
+            RAD_ISSUE(c, L.op_k_clip, brows(m.b_k, T), RAD_NONE, brows(m.b_k, T));
+            short_conv(c, m, batch, L.v, m.kv_conv, 2 * slot + 1, 0, m.b_lin_v, m.b_v, 0,
+                       m.b_taps_v);
+            RAD_ISSUE_N(c, L.op_v_norm, T * g.n_head_kv, brows(m.b_v, T), brows(m.b_v, T));
+            RAD_ISSUE(c, L.op_store, brows(m.b_k, T), brows(m.b_v, T),
+                      praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T), kv_cache(kv, slot));
+        }
+    } else if (L.op_qkvg && T <= m.multi_rows) {
+        /* k and v read their own sites where a global layer or the messages make them differ */
+        const bool own = messages || !L.local;
+        const ActFP8& ak = own ? m.a_hk : m.a_h;
+        const ActFP8& av = own ? m.a_hv : m.a_h;
+        const bool gates = messages && L.op_gates;
+        if (gates) {
+            RadOperand opd[21];
+            const int64_t rk = m.gate_rank;
+            for (int s = 0; s < 3; ++s) {
+                opd[7 * s] = site_x(s);
+                opd[7 * s + 1] = bcol(m.b_msg, s * E, E, T);
+                opd[7 * s + 2] = RAD_W(L.gate[s].w_down);
+                opd[7 * s + 3] = RAD_W(L.gate[s].w_forget);
+                opd[7 * s + 4] = RAD_W(L.gate[s].w_admit);
+                opd[7 * s + 5] = bcol(m.b_msg_rank3, s * rk, rk, T);
+                opd[7 * s + 6] = bcol(m.b_msg_mix3, s * E, E, T);
+            }
+            rad_issue(c, L.op_gates, opd, 21, RAD_N_BATCH);
+        }
+        if (mixq) {
+            RadOperand opd[16];
+            opd[0] = bcol(m.b_states, 0, L.n_state * E, T);
+            opd[1] = brows(m.b_x, T);
+            opd[2] = RAD_W(L.w_in_query);
+            opd[3] = bcol(m.b_mix, 0, n_site * E, T);
+            const rad_buf to[3] = { h, m.b_h_site[1], m.b_h_site[2] };
+            const ActFP8* as[3] = { &m.a_h, &ak, &av };
+            for (int s = 0; s < n_site; ++s) {
+                opd[4 + 4 * s] = RAD_W(L.w_norm[s]);
+                opd[5 + 4 * s] = brows(as[s]->q8, T);
+                opd[6 + 4 * s] = brows(as[s]->s8, T);
+                opd[7 + 4 * s] = brows(to[s], T);
+            }
+            rad_issue(c, L.op_mix_quant, opd, 4 + 4 * n_site, RAD_N_BATCH);
+        } else if (L.op_norm_sites && L.cs[0] < 0 && (gates || (!messages && !L.local))) {
+            RadOperand opd[15];
+            const RadOperand to[3] = { brows(h, T), brows(m.b_h_site[1], T),
+                                       brows(m.b_h_site[2], T) };
+            const ActFP8* as[3] = { &m.a_h, &ak, &av };
+            for (int s = 0; s < 3; ++s) {
+                opd[5 * s] = gates ? bcol(m.b_msg_mix3, s * E, E, T) : site_x(s);
+                opd[5 * s + 1] = RAD_W(L.w_norm[L.local ? 0 : s]);
+                opd[5 * s + 2] = brows(as[s]->q8, T);
+                opd[5 * s + 3] = brows(as[s]->s8, T);
+                opd[5 * s + 4] = to[s];
+            }
+            rad_issue(c, L.op_norm_sites, opd, 15, RAD_N_BATCH);
+        } else {
+            input(0, h, m.a_h, gates);
+            input(1, m.b_h_site[1], m.a_hk, gates);
+            input(2, m.b_h_site[2], m.a_hv, gates);
+        }
+        /* First, so its 208 one-wave workgroups are resident before gemm_nt_q_multi's 2048 waves
+         * fill the card. Issued after, they ran 2.8 us past it. */
+        const bool rst = L.op_rst && prep;
+        if (rst) {
+            RadOperand opd[19];
+            opd[0] = brows(h, T);
+            opd[1] = L.local ? RAD_NONE : brows(m.b_h_site[1], T);
+            opd[2] = L.local ? RAD_NONE : brows(m.b_h_site[2], T);
+            const int seg[4] = { 1, 2, 6, 7 };
+            for (int j = 0; j < 8; ++j) {
+                const bool on = j < 2 || (j < 4 && !L.local);
+                const ProjSeg sg = proj_seg(L, m, on ? seg[j] : 0);
+                opd[3 + 2 * j] = on ? RAD_W(sg.w) : RAD_NONE;
+                opd[4 + 2 * j] = on ? brows(sg.y, T) : RAD_NONE;
+            }
+            rad_issue(c, L.op_rst, opd, 19, RAD_N_BATCH);
+        }
+        const int64_t gk = E / m.a_h.g8;
+        RAD_ISSUE(c, L.op_qkvg, brows(m.a_h.q8, T), bcol(m.a_h.s8, 0, gk, T), RAD_W(L.lin_q.w),
+                  RAD_W(L.lin_q.ws), brows(m.b_q, T), brows(m.a_h.q8, T), bcol(m.a_h.s8, 0, gk, T),
+                  RAD_W(L.lin_gate.w), RAD_W(L.lin_gate.ws), brows(m.b_gate, T), brows(ak.q8, T),
+                  bcol(ak.s8, 0, gk, T), RAD_W(L.k.lin.w), RAD_W(L.k.lin.ws), brows(m.b_lin, T),
+                  brows(av.q8, T), bcol(av.s8, 0, gk, T), RAD_W(L.v.lin.w), RAD_W(L.v.lin.ws),
+                  brows(m.b_lin_v, T));
+        if (!prep)
+            RAD_ISSUE(c, L.op_q_clip, brows(m.b_q, T), RAD_W(L.w_q_scale), brows(m.b_q, T), pos);
+        if (rst) {
+            issue_prep();
+        } else {
+            if (L.op_rel_pick) {
+                L.lin_rel.step(c, m.a_h, m.b_rel_all, T);
+                RAD_ISSUE(c, L.op_rel_pick, bcol(m.b_rel_all, m.g.rank * m.rel_n, m.rel_n, T),
+                          brows(m.b_rel, T));
+            } else {
+                L.lin_rel.step(c, m.a_h, m.b_rel, T);
+            }
+            if (!prep)
+                RAD_ISSUE(c, L.op_rel_clip, brows(m.b_rel, T), RAD_W(L.w_rel_scale),
+                          brows(m.b_rel, T), pos);
+            RAD_ISSUE(c, L.op_sink, brows(h, T), RAD_W(L.w_sink), brows(m.b_sink, T));
+            if (prep) {
+                if (L.k.op_taps)
+                    RAD_ISSUE(c, L.k.op_taps, brows(own ? m.b_h_site[1] : h, T), RAD_W(L.k.w_taps),
+                              brows(m.b_taps, T));
+                if (L.v.op_taps)
+                    RAD_ISSUE(c, L.v.op_taps, brows(own ? m.b_h_site[2] : h, T), RAD_W(L.v.w_taps),
+                              brows(m.b_taps_v, T));
+                issue_prep();
+            } else {
+                short_conv(c, m, batch, L.k, m.kv_conv, 2 * slot, own ? m.b_h_site[1] : h, m.b_lin,
+                           m.b_k, 0);
+                RAD_ISSUE(c, L.op_k_clip, brows(m.b_k, T), RAD_NONE, brows(m.b_k, T));
+                short_conv(c, m, batch, L.v, m.kv_conv, 2 * slot + 1, own ? m.b_h_site[2] : h,
+                           m.b_lin_v, m.b_v, 0);
+                RAD_ISSUE_N(c, L.op_v_norm, T * g.n_head_kv, brows(m.b_v, T), brows(m.b_v, T));
+                RAD_ISSUE(c, L.op_store, brows(m.b_k, T), brows(m.b_v, T),
+                          praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T), kv_cache(kv, slot));
+            }
+        }
+    } else {
+        input(0, h, m.a_h);
+        L.lin_q.step(c, m.a_h, m.b_q, T);
+        RAD_ISSUE(c, L.op_q_clip, brows(m.b_q, T), RAD_W(L.w_q_scale), brows(m.b_q, T), pos);
+        if (L.op_rel_pick) {
+            L.lin_rel.step(c, m.a_h, m.b_rel_all, T);
+            RAD_ISSUE(c, L.op_rel_pick, bcol(m.b_rel_all, m.g.rank * m.rel_n, m.rel_n, T),
+                      brows(m.b_rel, T));
+        } else {
+            L.lin_rel.step(c, m.a_h, m.b_rel, T);
+        }
+        RAD_ISSUE(c, L.op_rel_clip, brows(m.b_rel, T), RAD_W(L.w_rel_scale), brows(m.b_rel, T),
+                  pos);
+        RAD_ISSUE(c, L.op_sink, brows(h, T), RAD_W(L.w_sink), brows(m.b_sink, T));
+        L.lin_gate.step(c, m.a_h, m.b_gate, T);
+
+        input(1, h, m.a_h);
+        L.k.lin.step(c, m.a_h, m.b_lin, T);
+        short_conv(c, m, batch, L.k, m.kv_conv, 2 * slot, h, m.b_lin, m.b_k, 0);
+        RAD_ISSUE(c, L.op_k_clip, brows(m.b_k, T), RAD_NONE, brows(m.b_k, T));
+        input(2, h, m.a_h);
+        L.v.lin.step(c, m.a_h, m.b_lin, T);
+        short_conv(c, m, batch, L.v, m.kv_conv, 2 * slot + 1, h, m.b_lin, m.b_v, 0);
+        RAD_ISSUE_N(c, L.op_v_norm, T * g.n_head_kv, brows(m.b_v, T), brows(m.b_v, T));
+        RAD_ISSUE(c, L.op_store, brows(m.b_k, T), brows(m.b_v, T),
+                  praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T), kv_cache(kv, slot));
+    }
+    if (gq) {
+        const RadOperand ao[15] = {
+            brows(m.b_q, T), kv_cache(kv, slot),
+            praw2(kvb ? kvb->block_table : nullptr, RAD_I32, batch->n_seq,
+                  kvb ? kvb->block_table_pitch : 0),
+            praw(kvb ? kvb->seqused : nullptr, RAD_I32, batch->n_seq), RAD_NONE, RAD_NONE,
+            praw(batch->cu_seqlens, RAD_I32, batch->n_seq + 1), brows(m.b_rel, T),
+            RAD_W(L.w_rel_proj), brows(m.b_sink, T), brows(m.b_attn, T), brows(m.b_gate, T),
+            brows(m.a_attn.q8, T), brows(m.a_attn.s8, T), bias };
+        rad_issue(c, L.op_attn_gq, ao, 15, batch->max_q_len);
+    } else {
+        const RadKVGroupBatch* boxb = L.op_box ? kv_batch(batch, m.kv_box) : nullptr;
+        const RadOperand box_table =
+            praw2(boxb ? boxb->block_table : nullptr, RAD_I32, batch->n_seq,
+                  boxb ? boxb->block_table_pitch : 0);
+        if (L.op_box)
+            RAD_ISSUE_N(c, L.op_box, T, kv_cache(kv, slot),
+                        praw2(kvb ? kvb->block_table : nullptr, RAD_I32, batch->n_seq,
+                              kvb ? kvb->block_table_pitch : 0),
+                        praw(kvb ? kvb->seqused : nullptr, RAD_I32, batch->n_seq),
+                        praw(batch->cu_seqlens, RAD_I32, batch->n_seq + 1),
+                        kv_cache(m.kv_box, slot), box_table);
+        const int64_t AD = L.op_attn_dense ? D : batch->n_seq, AT = L.op_attn_dense ? DT : T;
+        const int64_t pitch = kvb ? kvb->block_table_pitch : 0;
+        const int64_t bpitch = boxb ? boxb->block_table_pitch : 0;
+        const int32_t* table = kvb ? kvb->block_table : nullptr;
+        const int32_t* used = kvb ? kvb->seqused : nullptr;
+        if (AD > 0) {
+            const RadOperand attn_opd[] = {
+                brows(m.b_q, AT), kv_cache(kv, slot), praw2(table, RAD_I32, AD, pitch),
+                praw(used, RAD_I32, AD), RAD_NONE, RAD_NONE,
+                praw(batch->cu_seqlens, RAD_I32, AD + 1), brows(m.b_rel, AT),
+                RAD_W(L.w_rel_proj), brows(m.b_sink, AT), brows(m.b_attn, AT),
+                kv_cache(m.kv_box, slot),
+                praw2(boxb ? boxb->block_table : nullptr, RAD_I32, AD, bpitch),
+            };
+            rad_issue(c, L.op_attn, attn_opd, L.op_box ? 13 : 11,
+                      AD < batch->n_seq ? batch->max_q_len_decode : batch->max_q_len);
+        }
+        if (AD < batch->n_seq) {
+            const int64_t P = batch->n_seq - AD;
+            const RadOperand attn_opd[] = {
+                brows(m.b_q, T), kv_cache(kv, slot),
+                praw2(table ? table + AD * pitch : nullptr, RAD_I32, P, pitch),
+                praw(used ? used + AD : nullptr, RAD_I32, P), RAD_NONE, RAD_NONE,
+                praw(batch->cu_seqlens + AD, RAD_I32, P + 1), brows(m.b_rel, T),
+                RAD_W(L.w_rel_proj), brows(m.b_sink, T), brows(m.b_attn, T),
+            };
+            rad_issue(c, L.op_attn_dense, attn_opd, 11, AD > 0 ? g.max_tok : batch->max_q_len);
+        }
+    }
+
+    if (L.op_gate_quant && !gq) {
+        RAD_ISSUE(c, L.op_gate_quant, brows(m.b_gate, T), brows(m.b_attn, T),
+                  brows(m.a_attn.q8, T), brows(m.a_attn.s8, T), RAD_NONE);
+    } else if (!L.op_gate_quant) {
+        RAD_ISSUE(c, L.op_gate_mul, brows(m.b_gate, T), brows(m.b_attn, T), brows(m.b_gated, T));
+        RAD_ISSUE(c, L.op_gate_narrow, brows(m.b_gated, T), brows(m.b_attn, T));
+        if (L.op_quant_attn)
+            RAD_ISSUE(c, L.op_quant_attn, brows(m.b_attn, T), brows(m.a_attn.q8, T),
+                      brows(m.a_attn.s8, T));
+    }
+    if (L.cs_o >= 0) g_calib[rad_slot(c)].tap(c, (size_t)L.cs_o, T);
+    const bool ar = ar_fused(m, L.attn_conv, batch);
+    const bool push = ar && L.op_out_ar && T <= 8 && !L.lin_out.op_q;
+    if (!push) L.lin_out.step(c, m.a_attn, m.b_o, T);
+    if (L.op_attn_ar && !ar) RAD_ISSUE_N(c, L.op_attn_ar, T * E, brows(m.b_o, T), RAD_NONE);
+    short_conv(c, m, batch, L.attn_conv, m.kv_conv_x, 2 * slot, 0, m.b_o, m.b_res,
+               L.boundary ? 0 : m.b_x, 0, ar, false, push ? &L : nullptr);
+}
+
+/* One projection of the experts over `T` tokens' routing slots, `a` in the order its op names. */
+static void expert_gemm(RadCtx* c, const Model& m, const Experts& x, RadOperand a, int64_t T,
+                        rad_buf y) {
+    const int64_t NE = m.n_expert, P = T * m.top_k;
+    if (!x.group) {
+        RAD_ISSUE_N(c, x.op, T, a, RAD_WTAB(x.w[0], NE), brows(m.b_sorted, P),
+                    brows(m.b_eoff, NE + 1), brows(y, P));
+        return;
+    }
+    RAD_ISSUE_N(c, x.op, T, a, RAD_NONE, RAD_WTAB(x.w[0], (NE + 1) / 2),
+                RAD_WTAB(x.scale[0], (NE + 1) / 2), brows(m.b_sorted, P), brows(m.b_eoff, NE + 1),
+                RAD_WTAB(x.w[1], NE / 2), RAD_WTAB(x.scale[1], NE / 2), brows(y, P));
+}
+
+/* The experts' activation, between gate_up and down. */
+static void expert_glu(RadCtx* c, const Model& m, const Layer& L, int64_t P, int64_t F) {
+    if (L.op_glu) {
+        RAD_ISSUE_N(c, L.op_glu, P, bcol(m.b_egu, 0, F, P), bcol(m.b_egu, F, F, P),
+                    brows(m.b_eff, P));
+    } else {
+        RAD_ISSUE_N(c, L.op_cap_gate, P, bcol(m.b_egu, 0, F, P), bcol(m.b_cap, 0, F, P));
+        RAD_ISSUE_N(c, L.op_cap_up, P, bcol(m.b_egu, F, F, P), bcol(m.b_cap, F, F, P));
+        RAD_ISSUE_N(c, L.op_act, P, bcol(m.b_egu, 0, F, P), bcol(m.b_cap, 0, F, P),
+                    bcol(m.b_cap, 0, F, P));
+        RAD_ISSUE_N(c, L.op_act_mul, P, bcol(m.b_cap, 0, F, P), bcol(m.b_cap, F, F, P),
+                    brows(m.b_eff, P));
+    }
+}
+
+static void experts(RadCtx* c, const Model& m, const Layer& L, int l, int slot, bool messages,
+                    const RadBatch* batch) {
+    const Geom& g = m.g;
+    const int64_t T = batch->n_tok, E = g.n_embd, F = g.n_ff, K = m.top_k, NE = m.n_expert;
+    const int64_t P = T * K;
+    const int n_state = L.n_state + (L.boundary ? 1 : 0);
+    const rad_buf h = m.b_h;
+
+    RAD_ISSUE(c, L.op_ffn_mix, bcol(m.b_states, 0, n_state * E, T), brows(m.b_res, T),
+              RAD_W(L.w_ffn_query), bcol(m.b_mix, 0, E, T));
+    RadOperand x = bcol(m.b_mix, 0, E, T);
+    if (messages) x = gated(c, m, L.gate[3], 3, x, T);
+    /* The counts go straight into the core's row, which then needs no copy. */
+    int32_t* const counts = rad_route_counts(c, l, NE);
+    const RadOperand ecnt = counts ? praw(counts, RAD_I32, NE) : brows(m.b_ecnt, NE);
+    if (L.op_route_norm && T == 1) {
+        RAD_ISSUE_N(c, L.op_route_norm, T, x, RAD_W(L.w_ffn_norm), brows(h, T),
+                    RAD_W(L.router.projection), RAD_W(L.router.correction), brows(m.b_logits_r, T),
+                    brows(m.b_ids, T), brows(m.b_ew, T), brows(m.b_sorted, P),
+                    brows(m.b_eoff, NE + 1), ecnt);
+    } else if (L.op_route_gemm && T == 1) {
+        RAD_ISSUE(c, L.op_ffn_norm, x, RAD_W(L.w_ffn_norm), brows(h, T));
+        RAD_ISSUE_N(c, L.op_route_gemm, T, brows(h, T), RAD_W(L.router.projection),
+                    RAD_W(L.router.correction), brows(m.b_logits_r, T), brows(m.b_ids, T),
+                    brows(m.b_ew, T), brows(m.b_sorted, P), brows(m.b_eoff, NE + 1), ecnt);
+    } else if (L.op_route && T <= m.route_rows) {
+        RAD_ISSUE(c, L.op_ffn_norm, x, RAD_W(L.w_ffn_norm), brows(h, T));
+        L.router.project(c, 0, T);
+        RAD_ISSUE_N(c, L.op_route, T, brows(m.b_logits_r, T), RAD_W(L.router.correction),
+                    brows(m.b_ids, T), brows(m.b_ew, T), brows(m.b_sorted, P),
+                    brows(m.b_eoff, NE + 1), ecnt);
+    } else {
+        RAD_ISSUE(c, L.op_ffn_norm, x, RAD_W(L.w_ffn_norm), brows(h, T));
+        L.router.step(c, 0, T);
+        RAD_ISSUE(c, L.op_scatter, brows(m.b_ids, T), brows(m.b_sorted, P),
+                  brows(m.b_eoff, NE + 1), ecnt);
+    }
+    const bool ar = ar_fused(m, L.ffn_conv, batch);
+    const bool gather = ar && L.ffn_conv.op_ar_g;
+    const bool mpush = gather && L.op_ffn_push && T <= 8 && L.op_ffn && T <= L.ffn_rows;
+    if (mpush) {
+        /* op_ffn_push, from short_conv below */
+    } else if (L.op_ffn && T <= L.ffn_rows) {
+        const Experts& gu = L.gate_up;
+        const Experts& dn = L.down;
+        RAD_ISSUE_N(c, L.op_ffn, T, brows(h, T), brows(m.b_sorted, P), brows(m.b_eoff, NE + 1),
+                    RAD_WTAB(gu.w[0], (NE + 1) / 2), RAD_WTAB(gu.scale[0], (NE + 1) / 2),
+                    RAD_WTAB(gu.w[1], NE / 2), RAD_WTAB(gu.scale[1], NE / 2),
+                    RAD_WTAB(dn.w[0], (NE + 1) / 2), RAD_WTAB(dn.scale[0], (NE + 1) / 2),
+                    RAD_WTAB(dn.w[1], NE / 2), RAD_WTAB(dn.scale[1], NE / 2), brows(m.b_edn, P));
+    } else {
+        expert_gemm(c, m, L.gate_up, brows(h, T), T, m.b_egu);
+        expert_glu(c, m, L, P, F);
+        expert_gemm(c, m, L.down, brows(m.b_eff, P), T, m.b_edn);
+    }
+    if (!gather)
+        RAD_ISSUE_N(c, L.op_gather, T, brows(m.b_edn, P), brows(m.b_ew, T), brows(m.b_sorted, P),
+                    RAD_NONE, RAD_NONE, brows(m.b_o, T));
+    if (L.op_ffn_ar && !ar) RAD_ISSUE_N(c, L.op_ffn_ar, T * E, brows(m.b_o, T), RAD_NONE);
+
+    RadRouting rt{};
+    rt.expert_ids    = (const int32_t*)rad_buf_ptr(c, m.b_ids);
+    rt.expert_w      = (const float*)rad_buf_ptr(c, m.b_ew);
+    rt.expert_count  = counts ? counts : (const int32_t*)rad_buf_ptr(c, m.b_ecnt);
+    rt.sorted_tok    = (const int32_t*)rad_buf_ptr(c, m.b_sorted);
+    rt.expert_offset = (const int32_t*)rad_buf_ptr(c, m.b_eoff);
+    rt.top_k         = K;
+    rt.n_expert      = NE;
+    rad_route_report(c, l, &rt);
+
+    short_conv(c, m, batch, L.ffn_conv, m.kv_conv_x, 2 * slot + 1, 0, m.b_o, m.b_x, m.b_res, 0,
+               ar, gather, nullptr, mpush ? &L : nullptr);
+}
+
+/* Layer `l` in pass `pass` over the looped layers, 0 outside them. */
+static void layer(RadCtx* c, const Model& m, int l, int pass, const RadBatch* batch) {
+    const Layer& L = m.layers[(size_t)l];
+    const int64_t T = batch->n_tok, E = m.g.n_embd;
+    const int slot = state_slot(m, l, pass);
+    const bool messages = pass > 0;
+
+    if (messages)
+        RAD_ISSUE(c, L.op_msg, brows(m.b_bank, T), brows(m.b_prev, T), RAD_W(L.w_msg_query),
+                  brows(m.b_msg, T));
+    attention(c, m, L, slot, messages, batch);
+    if (L.boundary)
+        RAD_ISSUE(c, L.op_state, brows(m.b_x, T), bcol(m.b_states, L.n_state * E, E, T));
+    experts(c, m, L, l, slot, messages, batch);
+    if (L.op_tap) {
+        const int64_t K = m.top_k;
+        RAD_ISSUE(c, L.op_tap, brows(m.b_x, T), bcol(m.b_tap, slot * E, E, T));
+        RAD_ISSUE(c, L.op_tap_ids, brows(m.b_ids, T), bcol(m.b_tap_ids, slot * K, K, T));
+        RAD_ISSUE(c, L.op_tap_ew, brows(m.b_ew, T), bcol(m.b_tap_ew, slot * K, K, T));
+    }
+}
+
+static void step(RadCtx* c, const RadBatch* batch) {
+    const Model& m = g_model[rad_slot(c)];
+    if (batch->draft_pass && m.ds.on) {
+        if (batch->draft_pass > 0) m.ds.step(c, batch);
+        else                       m.ds.context(c, batch);
+        return;
+    }
+    if (batch->draft_pass || batch->spec_parent || batch->enc || batch->n_mm_rows > 0) {
+        rad_step_fail(c, "inkling2loop: this step asks for an encoder, a draft pass, a tree "
+                         "verify or media rows, and the program declares none of them");
+        return;
+    }
+    const int64_t T = batch->n_tok, R = batch->n_out, E = m.g.n_embd;
+    RAD_ISSUE(c, m.op_embed, praw(batch->token_ids, RAD_I32, T), RAD_W(m.w_tok), brows(m.b_x, T));
+    if (m.op_embed_ar) RAD_ISSUE_N(c, m.op_embed_ar, T * E, brows(m.b_x, T), RAD_NONE);
+    RAD_ISSUE(c, m.op_embed_norm, brows(m.b_x, T), RAD_W(m.w_tok_norm), brows(m.b_x, T));
+
+    int visit = 0;
+    auto run = [&](int l, int pass) {
+        m.ds.tap(c, visit++, T);
+        layer(c, m, l, pass, batch);
+    };
+    for (int l = 0; l < m.core_start; ++l) run(l, 0);
+    for (int pass = 0; pass < m.n_pass; ++pass) {
+        if (pass > 0) {
+            const int first = m.layers[(size_t)m.core_start].n_state;
+            RAD_ISSUE(c, m.op_bank, bcol(m.b_states, (first + 1) * E, m.n_bank * E, T),
+                      brows(m.b_bank, T));
+            RAD_ISSUE(c, m.op_prev, brows(m.b_x, T), brows(m.b_prev, T));
+            RAD_ISSUE(c, m.op_restart, bcol(m.b_states, first * E, E, T), brows(m.b_x, T));
+        }
+        for (int l = m.core_start; l < m.core_end; ++l) run(l, pass);
+    }
+    for (int l = m.core_end; l < (int)m.g.n_layer; ++l) run(l, 0);
+    m.ds.tap_final(c, T);
+    g_calib[rad_slot(c)].after_step(c, T);
+
+    if (R <= 0) return;
+    const RadOperand out = praw(batch->out_ids, RAD_I32, R);
+    RAD_ISSUE_N(c, m.op_gather, R, brows(m.b_x, T), out, brows(m.b_hout, R));
+    RAD_ISSUE_N(c, m.op_gather_states, R, brows(m.b_states, T), out, brows(m.b_states_out, R));
+    RAD_ISSUE_N(c, m.op_final_mix, R, brows(m.b_states_out, R), brows(m.b_hout, R),
+                RAD_W(m.w_final_query), brows(m.b_mix_out, R));
+    RAD_ISSUE_N(c, m.op_final_norm, R, brows(m.b_mix_out, R), RAD_W(m.w_out_norm),
+                brows(m.b_hout, R));
+    RAD_ISSUE_N(c, m.op_logits, R, brows(m.b_hout, R), RAD_W(m.w_lm_head), brows(m.b_head, R));
+    RAD_ISSUE_N(c, m.op_cap, R, brows(m.b_head, R), bcol(m.b_logits, 0, m.n_head_vocab, R));
+    if (m.op_pad)
+        RAD_ISSUE_N(c, m.op_pad, R,
+                    bcol(m.b_logits, m.n_head_vocab, m.g.n_vocab - m.n_head_vocab, R));
+}
+
+/* The speculation depth: the drafter's block less its anchor, the only depth it serves.
+ *
+ * Chained launches pay: every kernel of the decode step but the fixed-tap convolutions, the
+ * lm_head and the logits' pad has a chained form (libr4d's rad_kernel_chain). On one R9700 a
+ * 156-token prompt decodes at 52.2 tok/s unchained and 58.2 chained, a 7.7K one at 50.5 and
+ * 56.2. */
+static int probe(const RadModelMeta* meta, RadArchProbe* out) {
+    if (!meta || !out) return RAD_E_INVAL;
+    const int64_t block = dspark_block(meta);
+    out->draft_depth = block > 1 ? (int)(block - 1) : 0;
+    out->draft_depth_fixed = block > 1;
+    out->chain_pays = RAD_CHAIN_ALWAYS;
+    return RAD_OK;
+}
+
+/* ============================================================== the reply format
+ * A turn is a list of blocks, each `<|message_model|>KIND ... <|end_message|>`, and ends at
+ * `<|content_model_end_sampling|>`. The template renders no generation prompt, so the model writes
+ * every header itself:
+ *
+ *   <|message_model|><|content_thinking|> ...reasoning... <|end_message|>
+ *   <|message_model|><|content_text|> ...answer... <|end_message|>
+ *   <|message_model|>NAME<|content_invoke_tool_json|>{"name":"NAME","args":{...}}<|end_message|>
+ *
+ * The decoder renders only the control tokens named here. `<|content_text|>` is not, so an
+ * answer's header never reaches the parser and `reasoning_anywhere` drops its `<|end_message|>` as
+ * a close with no block open. The name between `<|message_model|>` and a call's opener is dropped
+ * by the decoder (block_header), as the release's response_template drops `[^<]*` there, and the
+ * call is read from the JSON wrapper as name and argument object. */
+static const RadChatFormat* chat_format(const RadModelMeta*) {
+    static const char* const triggers[] = { "<|content_invoke_tool_json|>" };
+    static const RadChatFormat f = [] {
+        RadChatFormat c{};
+        c.struct_size         = (uint32_t)sizeof(RadChatFormat);
+        c.name                = "plugin:inkling2";
+        c.reasoning_open      = "<|content_thinking|>";
+        c.reasoning_close     = "<|end_message|>";
+        c.reasoning_in_prompt = RAD_CHAT_THINK_NEVER;
+        c.reasoning_anywhere  = 1;
+        c.name_prefix         = "<|content_invoke_tool_json|>{\"name\":\"";
+        c.name_suffix         = "\",\"args\":";
+        c.call_end            = "}<|end_message|>";
+        c.args_form           = RAD_CHAT_ARGS_OBJECT;
+        c.triggers            = triggers;
+        c.n_triggers          = 1;
+        c.block_header        = "<|message_model|>";
+        return c;
+    }();
+    return &f;
+}
+
+}  /* namespace inkling2loop */
+
+#ifndef RAD_ARCH_NO_EXPORTS
+RAD_ARCH_PROBE(inkling2loop)
+/* Every per-instance state above is indexed by slot (rad_build_slot / rad_slot). */
+RAD_ARCH_MULTI_INSTANCE()
+RAD_ARCH_PLUGIN(inkling2loop, "inkling2loop", "", "0.1.0",
+                "Thinking Machines Inkling 2 Mini, bf16: the text model, its middle "
+                "layers looped with messages between the passes")
+RAD_ARCH_CHAT_FORMAT(inkling2loop)
+#endif
