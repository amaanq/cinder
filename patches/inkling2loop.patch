+#endif
diff --git a/libr4d/r4d_inkling.hip b/libr4d/r4d_inkling.hip
new file mode 100644
index 0000000000..ce5b45b1f6
--- /dev/null
+++ b/libr4d/r4d_inkling.hip
@@ -0,0 +1,3331 @@ namespace r4d_inkling {
+/* r4d_inkling.hip -- Inkling 2's ops with no other user: l2_clip, depth_mix, gate_mix,
+ * message_gate and attn_paged_rel_sink (libref/ref_elementwise.cpp and libref/ref_attn.cpp have
+ * the contracts; causal_conv1d_dyn is ple_conv's kernel, r4d_ple_conv_bf16.hip).
+ *
+ * A decode step issues each of them tens of times at one row, so the first three are one launch.
+ * l2_clip sums in libref's own order and gives its bytes: the terms go through LDS and one lane
+ * adds them in index order. depth_mix sums a row's columns across a workgroup, as rmsnorm_p
+ * does, and differs from libref in the last bits of its f32 sums; gate_mix differs by the
+ * device's tanhf, and attn_paged_rel_sink as its section says.
+ *
+ * Nothing here allocates or synchronises (docs/PLUGIN.md §5).
+ */
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+#include "r4d_plugin.h"
+#include "r4d_common.h"
+#include "r4d_chain.h"
+#include "r4d_dt16.h"
+#include "r4d_emit.h"
+#include "r4d_launch.h"
+#include "r4d_fwht.h"
+#include "r4d_q8.h"
+#include "r4d_keyed.h"
+
+#if defined(__HIP_DEVICE_COMPILE__) && defined(__AMDGCN_WAVEFRONT_SIZE) && __AMDGCN_WAVEFRONT_SIZE != 32
+#error "these kernels are written for wave32 (RDNA): build without -mwavefrontsize64"
+#endif
+
+namespace r4d_inkling {
+
+constexpr uint32_t kThr = 256;
+constexpr uint32_t kWave = 32;
+
+/* Columns of a row a thread holds in registers. A compute unit runs all of a workgroup's waves,
+ * so a row costs what its instructions add up to, and a load costs a wave the same whether it
+ * brings two bytes or sixteen. A row is one workgroup, kMaxRow columns at most. */
+constexpr uint32_t kCols = 16;
+constexpr long long kMaxRow = kThr * kCols;
+
+typedef uint32_t  u32_any __attribute__((aligned(1)));
+typedef r4d_u32x4 x4_any __attribute__((aligned(1)));
+typedef __attribute__((address_space(1))) u32_any*       g_wu32;
+typedef __attribute__((address_space(1))) const x4_any*  g_x4;
+typedef __attribute__((address_space(1))) x4_any*        g_wx4;
+typedef unsigned int r4d_u32x2 __attribute__((ext_vector_type(2)));
+typedef r4d_u32x2 x2_any __attribute__((aligned(1)));
+typedef __attribute__((address_space(1))) const x2_any*  g_x2;
+
+__device__ __forceinline__ float ld_bf16(const uint16_t* p) { return bf16w_lo(ldg_u16(p)); }
+
+/* Columns c0 .. c0 + kCols - 1 of a row of n: wide loads where the row holds them all, a load a
+ * column where it ends among them, zeros past it. WHOLE: n is a multiple of kCols, so there is no
+ * such column, and the kernel leaves out the code for it (a one-workgroup launch fetches all of its
+ * instructions cold). */
+template <bool WHOLE = false>
+__device__ __forceinline__ void ld_cols(const uint16_t* row, uint32_t c0, uint32_t n,
+                                        float (&v)[kCols]) {
+    if (c0 + kCols <= n) {
+#pragma unroll
+        for (uint32_t c = 0; c < kCols; c += 8) {
+            const r4d_u32x4 w = *(g_x4)(row + c0 + c);
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) {
+                v[c + 2 * e] = bf16w_lo(w[e]);
+                v[c + 2 * e + 1] = bf16w_hi(w[e]);
+            }
+        }
+        return;
+    }
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e) v[e] = !WHOLE && c0 + e < n ? ld_bf16(row + c0 + e) : 0.0f;
+}
+
+template <bool WHOLE = false>
+__device__ __forceinline__ void ld_cols(const float* row, uint32_t c0, uint32_t n,
+                                        float (&v)[kCols]) {
+    if (c0 + kCols <= n) {
+#pragma unroll
+        for (uint32_t c = 0; c < kCols; c += 4) {
+            const r4d_u32x4 w = *(g_x4)(row + c0 + c);
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) v[c + e] = __uint_as_float(w[e]);
+        }
+        return;
+    }
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e) v[e] = !WHOLE && c0 + e < n ? row[c0 + e] : 0.0f;
+}
+
+/* Those columns stored, none past the row; bf16 rounds as rad_f32_to_bf16 does. */
+template <bool WHOLE = false>
+__device__ __forceinline__ void st_cols(uint16_t* row, uint32_t c0, uint32_t n,
+                                        const float (&v)[kCols]) {
+    if (c0 + kCols <= n) {
+#pragma unroll
+        for (uint32_t c = 0; c < kCols; c += 8) {
+            r4d_u32x4 w;
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) w[e] = bf16x2_rne_nan(v[c + 2 * e], v[c + 2 * e + 1]);
+            *(g_wx4)(row + c0 + c) = w;
+        }
+        return;
+    }
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e)
+        if (!WHOLE && c0 + e < n) row[c0 + e] = (uint16_t)(bf16_hi_rne_nan(v[e]) >> 16);
+}
+
+template <bool WHOLE = false>
+__device__ __forceinline__ void st_cols(float* row, uint32_t c0, uint32_t n,
+                                        const float (&v)[kCols]) {
+    if (c0 + kCols <= n) {
+#pragma unroll
+        for (uint32_t c = 0; c < kCols; c += 4) {
+            r4d_u32x4 w;
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) w[e] = __float_as_uint(v[c + e]);
+            *(g_wx4)(row + c0 + c) = w;
+        }
+        return;
+    }
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e)
+        if (!WHOLE && c0 + e < n) row[c0 + e] = v[e];
+}
+
+/* libref's ref_exp, (float)exp((double)x), for the x <= 0 a softmax takes it at: the f64 library
+ * routine costs microseconds a wave here. x = k ln2 + r with |r| <= ln2 / 2, and e^r is its series
+ * to r^13 / 13! (under 1e-17 of the sum) by Horner in f64, so the one rounding to f32 meets
+ * libref's except where e^x lies within about 1e-16 of a rounding boundary. */
+__device__ __forceinline__ float exp_ref(float x) {
+    if (!(x >= -104.0f)) return x != x ? x : 0.0f;   /* under half the smallest f32 */
+    const double xd = (double)x;
+    const double kd = __builtin_rint(xd * 0x1.71547652b82fep+0);
+    const double r = __builtin_fma(-kd, 0x1.a39ef35793c76p-33,
+                                   __builtin_fma(-kd, 0x1.62e42feep-1, xd));
+    double fact = 6227020800.0, p = 1.0 / fact;
+#pragma unroll
+    for (int n = 13; n > 0; --n) { fact /= (double)n; p = __builtin_fma(p, r, 1.0 / fact); }
+    const double two_k = __builtin_bit_cast(double, (uint64_t)(1023 + (int)kd) << 52);
+    return (float)(p * two_k);
+}
+
+/* ------------------------------------------------------------------ l2_clip */
+/* ref_l2_clip. A workgroup a row: every thread leaves its columns' squares in LDS, lane h adds
+ * head h's in index order and leaves the head's factor, and every thread scales the columns it
+ * still holds, so `y` may be `x`. A head's squares sit hd + 1 floats after the one before, so the
+ * lanes' reads fall in distinct banks; at hd floats apart they all hit one bank. */
+struct ClipArgs {
+    const uint16_t* x;  long long x_rs;
+    const uint16_t* sc;
+    uint16_t*       y;  long long y_rs;
+    const int*      pos;
+    uint32_t n, hd, M;
+    float thr, eps, alpha, floor_n;
+};
+
+template <bool WHOLE>
+__device__ __forceinline__ void l2_clip_body(ClipArgs A) {
+    R4D_DYN_LDS(float, sq);
+    const uint32_t m = blockIdx.x, n = A.n, hd = A.hd, c0 = threadIdx.x * kCols;
+    if (m >= A.M) return;   /* a row the launch added past the full-card cliff (r4d_cliff_rows) */
+
+    float v[kCols];
+    ld_cols<WHOLE>(A.x + (size_t)m * A.x_rs, c0, n, v);
+    if (A.sc) {
+        float gain[kCols];
+        ld_cols<WHOLE>(A.sc, c0, n, gain);
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) v[e] *= gain[e];
+    }
+    const uint32_t heads = n / hd;
+    float* fac = sq + n + heads;
+    uint32_t head[kCols];
+    {
+        uint32_t h = c0 / hd, next = (h + 1) * hd;
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) {
+            while (c0 + e >= next) { ++h; next += hd; }
+            head[e] = h < heads ? h : 0;
+        }
+    }
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e)
+        if (c0 + e < n) sq[c0 + e + head[e]] = v[e] * v[e];
+    lds_barrier();
+    for (uint32_t h = threadIdx.x; h < heads; h += kThr) {
+        const float* s = sq + (size_t)h * (hd + 1);
+        float ss = 0.0f;
+        uint32_t i = 0;
+        for (; i + 16 <= hd; i += 16) {
+            float t[16];
+#pragma unroll
+            for (uint32_t e = 0; e < 16; ++e) t[e] = s[i + e];
+#pragma unroll
+            for (uint32_t e = 0; e < 16; ++e) ss += t[e];
+        }
+        for (; i < hd; ++i) ss += s[i];
+        fac[h] = fminf(A.thr / (sqrtf(ss) + A.eps), 1.0f);
+    }
+    lds_barrier();
+    if (c0 >= n) return;
+#pragma unroll
+    for (uint32_t e = 0; e < kCols; ++e) v[e] *= fac[head[e]];
+    if (A.pos) {
+        const float tau = 1.0f + A.alpha * logf(fmaxf((float)(A.pos[m] + 1) / A.floor_n, 1.0f));
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e)
+            v[e] = __uint_as_float(bf16_hi_rne_nan(v[e]) & 0xffff0000u) * tau;
+    }
+    st_cols<WHOLE>(A.y + (size_t)m * A.y_rs, c0, n, v);
+}
+
+template <bool WHOLE, class CH>
+__global__ __launch_bounds__(kThr) void l2_clip_kernel(ClipArgs A) {
+    if (CH::on) r4d_chain_wait();
+    l2_clip_body<WHOLE>(A);
+    if (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ depth_mix */
+/* ref_depth_mix. A workgroup a row, a thread holding its columns of the row's S + 1 vectors
+ * throughout. The block sums its threads' partial sums, a wave's lanes and then the waves in
+ * order (rmsnorm_p's partition): once for the squares, once for the Q * (S + 1) dot products
+ * against the normalised vectors. Query k's softmax over the S + 1 logits follows in libref's
+ * order, and every thread writes its columns of the Q outputs. */
+constexpr uint32_t kDmStates = 7;    /* S + 1: the block states and the current one */
+constexpr uint32_t kDmQueries = 4;
+constexpr uint32_t kDmSums = kDmStates * kDmQueries;
+
+struct MixArgs {
+    const uint16_t* st;  long long st_rs;
+    const void*     x;   long long x_rs;
+    const float*    q;
+    float*          y;   long long y_rs;
+    uint32_t n, S, Q, M;
+    float    eps;
+};
+
+/* Each v[c] that `live` names summed across the block and left in every thread. `part` is the
+ * call's own, so no barrier follows the reads. */
+template <uint32_t N, class Live>
+__device__ __forceinline__ void block_sums(float (&v)[N], float (*part)[N], Live live) {
+    const uint32_t lane = threadIdx.x & (kWave - 1), wave = threadIdx.x / kWave;
+#pragma unroll
+    for (uint32_t c = 0; c < N; ++c) {
+        if (!live(c)) continue;
+        const float s = r4d_wave_sum(v[c]);
+        if (lane == 0) part[wave][c] = s;
+    }
+    lds_barrier();
+#pragma unroll
+    for (uint32_t c = 0; c < N; ++c) {
+        if (!live(c)) continue;
+        v[c] = 0.0f;
+#pragma unroll
+        for (uint32_t w = 0; w < kThr / kWave; ++w) v[c] += part[w][c];
+    }
+}
+
+template <bool XF32, class CH>
+__device__ __forceinline__ void depth_mix_body(MixArgs A) {
+    __shared__ float norms[kThr / kWave][kDmStates];
+    __shared__ float dots[kThr / kWave][kDmSums];
+    __shared__ float wgt[kDmSums];
+    const uint32_t m = blockIdx.x, tid = threadIdx.x, c0 = tid * kCols;
+    const uint32_t n = A.n, S = A.S, Q = A.Q;
+    const uint16_t* sr = A.st + (size_t)m * A.st_rs;
+
+    /* Every load is issued before the first use, so the vectors and the queries cost one memory
+     * latency rather than one each; the queries, a weight, before the chain's wait. */
+    float v[kDmStates][kCols], qv[kDmQueries][kCols], inv[kDmStates];
+#pragma unroll
+    for (uint32_t k = 0; k < kDmQueries; ++k) {
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) qv[k][e] = 0.0f;
+        if (k < Q) ld_cols<true>(A.q + (size_t)k * n, c0, n, qv[k]);
+    }
+    if (CH::on) r4d_chain_wait();
+    if (m >= A.M) return;   /* a row the launch added past the full-card cliff (r4d_cliff_rows) */
+#pragma unroll
+    for (uint32_t s = 0; s < kDmStates; ++s) {
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) v[s][e] = 0.0f;
+        if (s < S) {
+            ld_cols<true>(sr + (size_t)s * n, c0, n, v[s]);
+        } else if (s == S) {
+            if (XF32) ld_cols<true>((const float*)A.x + (size_t)m * A.x_rs, c0, n, v[s]);
+            else ld_cols<true>((const uint16_t*)A.x + (size_t)m * A.x_rs, c0, n, v[s]);
+        }
+    }
+#pragma unroll
+    for (uint32_t s = 0; s < kDmStates; ++s) {
+        inv[s] = 0.0f;
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) inv[s] += v[s][e] * v[s][e];
+    }
+    block_sums(inv, norms, [&](uint32_t c) { return c <= S; });
+#pragma unroll
+    for (uint32_t s = 0; s < kDmStates; ++s) {
+        if (s > S) continue;
+        inv[s] = 1.0f / sqrtf(inv[s] / (float)n + A.eps);
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) v[s][e] *= inv[s];
+    }
+
+    float dot[kDmSums];
+#pragma unroll
+    for (uint32_t k = 0; k < kDmQueries; ++k) {
+#pragma unroll
+        for (uint32_t s = 0; s < kDmStates; ++s) {
+            float d = 0.0f;
+            if (k < Q && s <= S) {
+#pragma unroll
+                for (uint32_t e = 0; e < kCols; ++e) d += qv[k][e] * v[s][e];
+            }
+            dot[k * kDmStates + s] = d;
+        }
+    }
+    block_sums(dot, dots, [&](uint32_t c) { return c / kDmStates < Q && c % kDmStates <= S; });
+
+    /* Lane k * kDmStates + s forms query k's exponential of state s, each an f64 chain of its own
+     * in parallel, and lane k then adds them in libref's order. */
+    const uint32_t qk = tid / kDmStates, qs = tid % kDmStates;
+    if (qk < Q && qs <= S) {
+        const float scale = 1.0f / sqrtf((float)n);
+        float p = 0.0f, mx = -INFINITY;
+#pragma unroll
+        for (uint32_t s = 0; s < kDmStates; ++s) {
+            float d = 0.0f;
+#pragma unroll
+            for (uint32_t k = 0; k < kDmQueries; ++k) d = qk == k ? dot[k * kDmStates + s] : d;
+            const float l = s <= S ? d * scale : -INFINITY;
+            mx = l > mx ? l : mx;
+            p = s == qs ? l : p;
+        }
+        wgt[tid] = exp_ref(p - mx);
+    }
+    lds_barrier();
+    if (tid < Q) {
+        float sum = 0.0f, e[kDmStates];
+#pragma unroll
+        for (uint32_t s = 0; s < kDmStates; ++s) {
+            e[s] = wgt[tid * kDmStates + s];
+            if (s <= S) sum += e[s];
+        }
+#pragma unroll
+        for (uint32_t s = 0; s < kDmStates; ++s)
+            if (s <= S) wgt[tid * kDmStates + s] = e[s] / sum;
+    }
+    lds_barrier();
+
+    float* yr = A.y + (size_t)m * A.y_rs;
+#pragma unroll
+    for (uint32_t k = 0; k < kDmQueries; ++k) {
+        if (k >= Q || c0 >= n) continue;
+        float o[kCols];
+#pragma unroll
+        for (uint32_t e = 0; e < kCols; ++e) o[e] = 0.0f;
+#pragma unroll
+        for (uint32_t s = 0; s < kDmStates; ++s) {
+            if (s > S) continue;
+            const float w = wgt[k * kDmStates + s];
+#pragma unroll
+            for (uint32_t e = 0; e < kCols; ++e) o[e] += w * v[s][e];
+        }
+        st_cols<true>(yr + (size_t)k * n, c0, n, o);
+    }
+}
+
+/* Block (m, k) takes query k alone: a query's sums, softmax and output read no other query's.
+ * ROW: block m takes every query, as a prefill wants its states read once a row. */
+template <bool XF32, class CH, bool ROW = false>
+__global__ __launch_bounds__(kThr) void depth_mix_kernel(MixArgs A) {
+    if constexpr (!ROW) {
+        A.q += (size_t)blockIdx.y * A.n;
+        A.y += (size_t)blockIdx.y * A.n;
+        A.Q = 1;
+    }
+    depth_mix_body<XF32, CH>(A);
+    if (CH::on) r4d_chain_done();
+}
+
+/* depth_mix_had_quant_i8g's sites: the gain and outputs rmsnorm_had_quant_i8g writes from query
+ * k's row of y. */
+struct DmqSite {
+    const void* w;
+    uint16_t* h;
+    uint8_t* q8;
+    float* s8;
+    long long h_rs, q8_rs, s8_rs;
+};
+struct DmqArgs {
+    DmqSite s[kDmQueries - 1];
+    float eps, wadd;
+};
+
+/* Block (m, k) is depth_mix of query k alone, whose arithmetic is that query's in the full launch,
+ * then rmsnorm_had_quant_i8g of its row of y: the sum in kR4dSumLanes' partition, the wave sums
+ * in order, and q8_row_had_i8g over the bf16 output staged in LDS. */
+template <bool XF32, bool WF32, class CH>
+__global__ __launch_bounds__(kThr) void depth_mix_quant_kernel(MixArgs A, DmqArgs Q) {
+    __shared__ uint16_t s_h[kMaxRow];
+    __shared__ float s_part[kThr / kWave];
+    const uint32_t k = blockIdx.y, m = blockIdx.x, n = A.n, tid = threadIdx.x;
+    MixArgs B = A;
+    B.q += (size_t)k * n;
+    B.y += (size_t)k * n;
+    B.Q = 1;
+    depth_mix_body<XF32, CH>(B);
+    if (m < A.M) {
+        DmqSite S = Q.s[0];
+#pragma unroll
+        for (uint32_t j = 1; j < kDmQueries - 1; ++j)
+            if (k == j) S = Q.s[j];
+        const float* xr = B.y + (size_t)m * A.y_rs;
+        __syncthreads();
+        float ss = r4d_lanes_sumsq(xr, n, [](float v) { return v; });
+        ss = r4d_wave_sum(ss);
+        if ((tid & (kWave - 1)) == 0) s_part[tid / kWave] = ss;
+        __syncthreads();
+        float sum = 0.0f;
+#pragma unroll
+        for (uint32_t w = 0; w < kThr / kWave; ++w) sum += s_part[w];
+        const float rs = rsqrtf(sum / (float)n + Q.eps);
+        uint16_t* hr = S.h + (size_t)m * S.h_rs;
+        for (uint32_t i = tid; i < n; i += kThr) {
+            const float g = WF32 ? ((const float*)S.w)[i] : bf16_to_f32(((const uint16_t*)S.w)[i]);
+            const uint16_t h = f32_to_bf16(xr[i] * rs * (g + Q.wadd));
+            s_h[i] = h;
+            if (S.h) hr[i] = h;
+        }
+        __syncthreads();
+        q8_row_had_i8g<kThr>(s_h, (signed char*)S.q8 + (size_t)m * S.q8_rs,
+                             S.s8 + (size_t)m * S.s8_rs, n);
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ gate_mix */
+/* ref_gate_mix with the device's tanhf, flat over the M x n extent as binary_f32_kernel is. */
+struct GateArgs {
+    const float *x, *m, *f, *g;
+    float*      y;
+    long long   x_rs, m_rs, f_rs, g_rs, y_rs;
+    uint32_t    n;
+    uint64_t    total;
+};
+
+__global__ __launch_bounds__(kThr) void gate_mix_kernel(GateArgs A) {
+    for (uint64_t t = (uint64_t)blockIdx.x * kThr + threadIdx.x; t < A.total;
+         t += (uint64_t)gridDim.x * kThr) {
+        const uint64_t r = t / A.n;
+        const uint32_t i = (uint32_t)(t - r * A.n);
+        const float keep = 1.0f - tanhf(A.f[r * A.f_rs + i]);
+        const float admit = tanhf(A.g[r * A.g_rs + i]);
+        A.y[r * A.y_rs + i] = keep * A.x[r * A.x_rs + i] + admit * A.m[r * A.m_rs + i];
+    }
+}
+
+/* ------------------------------------------------------------------ message_gate */
+/* ref_message_gate in two launches: the rank state, then the blend. A workgroup takes a group of
+ * rows and reads its weights once for all of them; a row's sums do not depend on which rows share
+ * its workgroup, so prefill and decode give a row the same bytes.
+ *
+ *   rank   workgroup (j, g): wave w < jpb forms rank jpb j + w, lane l the 8-wide chunks
+ *          l, l + 32, ...
+ *          Its weight row is loaded first, then the group's [rmsnorm(x), rmsnorm(m)] is rounded
+ *          into LDS, each norm summed as depth_mix's, so the norms run under the weight's latency;
+ *   blend  workgroup (c, g): four lanes a column of 64, each a quarter of the rank, summed across
+ *          the four by xor. The weights and the rows' x and m are loaded before r. */
+constexpr uint32_t kMgRankRows = 2;
+/* Ranks a rank workgroup forms at one row: two spread a site's 64 ranks over 32 workgroups. At
+ * three verify rows, where each workgroup normalises every row, the 8 of a full workgroup and the
+ * two launches beat that and the fused launch by 0.40 ms a step at tp 2. */
+constexpr uint32_t kMgJpb = 2;
+constexpr uint32_t kMgWideRows = 512;
+constexpr uint32_t kMgRows = 8;
+constexpr uint32_t kMgCols = kThr / 4;
+constexpr uint32_t kMgChunks = 2 * kMaxRow / (kWave * 8);
+
+struct MgArgs {
+    const float*    x;   long long x_rs;
+    const float*    m;   long long m_rs;
+    const uint16_t* dn;
+    const float*    fg;
+    const float*    ad;
+    uint16_t*       r;   long long r_rs;
+    float*          y;   long long y_rs;
+    uint32_t n, k, M, rank_rows, mix_rows;
+    float    eps;
+    uint32_t jpb, rpw;   /* waves of a rank workgroup that form ranks, rpw each in turn */
+};
+
+template <class CH>
+__device__ __forceinline__ void msg_rank_body(MgArgs A, uint32_t bx, uint32_t by) {
+    R4D_DYN_LDS(uint32_t, us);   /* rank_rows rows of 2n bf16 */
+    __shared__ float part[kThr / kWave][2 * kMgRankRows];
+    const uint32_t m0 = by * A.rank_rows, tid = threadIdx.x, c0 = tid * kCols;
+    const uint32_t n = A.n, rows = min(A.rank_rows, A.M - m0);
+    const uint32_t wave = tid / kWave, j0 = (bx * A.jpb + wave) * A.rpw, lane = tid & (kWave - 1);
+    const bool own = wave < A.jpb && j0 < A.k;
+
+    r4d_u32x4 w[kMgChunks];
+    auto load_w = [&](uint32_t j) {
+        const uint16_t* wr = A.dn + (size_t)(own ? j : 0) * 2 * n;
+#pragma unroll
+        for (uint32_t t = 0; t < kMgChunks; ++t) {
+            const uint32_t i = lane * 8 + t * kWave * 8;
+            w[t] = own && i < 2 * n ? *(g_x4)(wr + i) : r4d_u32x4{};
+        }
+    };
+    load_w(j0);
+    if (CH::on) r4d_chain_wait();
+
+    for (uint32_t p = 0; p < rows; p += kMgRankRows) {
+        float v[2 * kMgRankRows][kCols], inv[2 * kMgRankRows];
+        const uint32_t pr = min(kMgRankRows, rows - p);
+#pragma unroll
+        for (uint32_t i = 0; i < 2 * kMgRankRows; ++i) {
+            inv[i] = 0.0f;
+            if (i / 2 >= pr) continue;
+            ld_cols<true>(i % 2 ? A.m + (size_t)(m0 + p + i / 2) * A.m_rs
+                                : A.x + (size_t)(m0 + p + i / 2) * A.x_rs,
+                          c0, n, v[i]);
+#pragma unroll
+            for (uint32_t e = 0; e < kCols; ++e) inv[i] += v[i][e] * v[i][e];
+        }
+        block_sums(inv, part, [&](uint32_t i) { return i / 2 < pr; });
+#pragma unroll
+        for (uint32_t i = 0; i < 2 * kMgRankRows; ++i) {
+            if (i / 2 >= pr) continue;
+            const float s = 1.0f / sqrtf(inv[i] / (float)n + A.eps);
+            uint32_t* dst = us + ((p + i / 2) * 2 * n + (i % 2) * n + c0) / 2;
+#pragma unroll
+            for (uint32_t e = 0; e < kCols; e += 2)
+                if (c0 + e < n) dst[e / 2] = bf16x2_rne_nan(v[i][e] * s, v[i][e + 1] * s);
+        }
+        lds_barrier();
+    }
+    if (!own) return;
+
+    for (uint32_t q = 0; q < A.rpw && j0 + q < A.k; ++q) {
+        if (q > 0) load_w(j0 + q);
+        for (uint32_t g = 0; g < rows; ++g) {
+            float acc = 0.0f;
+#pragma unroll
+            for (uint32_t t = 0; t < kMgChunks; ++t) {
+                const uint32_t i = lane * 8 + t * kWave * 8;
+                if (i >= 2 * n) continue;
+                const r4d_u32x4 u = *(const r4d_u32x4*)(us + (g * 2 * n + i) / 2);
+#pragma unroll
+                for (uint32_t e = 0; e < 4; ++e) {
+                    acc += bf16w_lo(w[t][e]) * bf16w_lo(u[e]);
+                    acc += bf16w_hi(w[t][e]) * bf16w_hi(u[e]);
+                }
+            }
+            const float s = r4d_wave_sum(acc);
+            if (lane == 0)
+                A.r[(size_t)(m0 + g) * A.r_rs + j0 + q] = (uint16_t)(bf16_hi_rne_nan(s) >> 16);
+        }
+    }
+}
+
+template <class CH>
+__global__ __launch_bounds__(kThr) void msg_rank_kernel(MgArgs A) {
+    msg_rank_body<CH>(A, blockIdx.x, blockIdx.y);
+    if (CH::on) r4d_chain_done();
+}
+
+/* A prefill's rank launch at rank 64 and 2 n up to 4608: kMgPartRows rows a workgroup, their u
+ * widened to f32 in LDS a third of 2 n at a time (a lane's eight of a chunk as two quads 512 bytes
+ * apart), each wave's kMgPartRanks ranks two at a time over every row. A (rank, row) sum is
+ * msg_rank_body's lane chain in the same chunk order, and its norms are msg_rank_body's, so the
+ * bytes are its with no unpack in the dot. Three rows keep the LDS and registers small enough for
+ * more workgroups a CU, 382 us at 2048 rows against 540 at ten. */
+constexpr uint32_t kMgPartRows = 3, kMgParts = 3, kMgPartChunks = 6, kMgPartRanks = 8;
+constexpr uint32_t kMgPartCols = kMgPartChunks * kWave * 8;
+__global__ __launch_bounds__(kThr) void msg_rank_part_kernel(MgArgs A) {
+    constexpr uint32_t R = kMgPartRows, W = kMgPartCols, QR = kMgPartRanks;
+    R4D_DYN_LDS(float, uf);   /* R rows of W f32, then each row's two scales */
+    float* sc = uf + R * W;
+    __shared__ float part[kThr / kWave][2 * kMgRankRows];
+    const uint32_t m0 = blockIdx.y * R, tid = threadIdx.x, c0 = tid * kCols;
+    const uint32_t n = A.n, rows = min(R, A.M - m0);
+    const uint32_t wave = tid / kWave, lane = tid & (kWave - 1);
+    const uint32_t j0 = (blockIdx.x * (kThr / kWave) + wave) * QR;
+
+#pragma unroll
+    for (uint32_t p = 0; p < R; p += kMgRankRows) {
+        if (p >= rows) break;
+        float v[2 * kMgRankRows][kCols], inv[2 * kMgRankRows];
+        const uint32_t pr = min(kMgRankRows, rows - p);
+#pragma unroll
+        for (uint32_t i = 0; i < 2 * kMgRankRows; ++i) {
+            inv[i] = 0.0f;
+            if (i / 2 >= pr) continue;
+            ld_cols<true>(i % 2 ? A.m + (size_t)(m0 + p + i / 2) * A.m_rs
+                                : A.x + (size_t)(m0 + p + i / 2) * A.x_rs,
+                          c0, n, v[i]);
+#pragma unroll
+            for (uint32_t e = 0; e < kCols; ++e) inv[i] += v[i][e] * v[i][e];
+        }
+        block_sums(inv, part, [&](uint32_t i) { return i / 2 < pr; });
+#pragma unroll
+        for (uint32_t i = 0; i < 2 * kMgRankRows; ++i)
+            if (tid == i && i / 2 < pr) sc[2 * p + i] = 1.0f / sqrtf(inv[i] / (float)n + A.eps);
+        lds_barrier();
+    }
+
+    float acc[QR][R];
+#pragma unroll
+    for (uint32_t q = 0; q < QR; ++q)
+#pragma unroll
+        for (uint32_t g = 0; g < R; ++g) acc[q][g] = 0.0f;
+    r4d_u32x4 w[2][kMgPartChunks];
+    auto load_w = [&](uint32_t pt, uint32_t qp, r4d_u32x4 (&b)[2][kMgPartChunks]) {
+#pragma unroll
+        for (uint32_t h = 0; h < 2; ++h) {
+            const uint16_t* wr = A.dn + (size_t)(j0 + qp + h) * 2 * n;
+#pragma unroll
+            for (uint32_t t = 0; t < kMgPartChunks; ++t) {
+                const uint32_t i = pt * W + lane * 8 + t * kWave * 8;
+                b[h][t] = i < 2 * n ? *(g_x4)(wr + i) : r4d_u32x4{};
+            }
+        }
+    };
+    for (uint32_t pt = 0; pt < kMgParts; ++pt) {
+        const uint32_t lo = pt * W;
+        load_w(pt, 0, w);
+        if (pt > 0) lds_barrier();
+#pragma unroll
+        for (uint32_t e4 = tid * 4; e4 < R * W; e4 += kThr * 4) {
+            const uint32_t g = e4 / W, o = e4 % W, col = lo + o;
+            if (g >= rows || col >= 2 * n) continue;
+            const bool xm = col >= n;
+            const float s = sc[2 * g + xm];
+            const r4d_u32x4 src = *(g_x4)((xm ? A.m + (size_t)(m0 + g) * A.m_rs + (col - n)
+                                              : A.x + (size_t)(m0 + g) * A.x_rs + col));
+            const uint32_t a = bf16x2_rne_nan(__uint_as_float(src[0]) * s,
+                                              __uint_as_float(src[1]) * s);
+            const uint32_t b = bf16x2_rne_nan(__uint_as_float(src[2]) * s,
+                                              __uint_as_float(src[3]) * s);
+            const uint32_t c = o % (kWave * 8);
+            *(float4*)(uf + g * W + o - c + (c % 8 / 4) * kWave * 4 + c / 8 * 4) =
+                make_float4(bf16w_lo(a), bf16w_hi(a), bf16w_lo(b), bf16w_hi(b));
+        }
+        lds_barrier();
+#pragma unroll
+        for (uint32_t qp = 0; qp < QR; qp += 2) {
+            if (qp > 0) load_w(pt, qp, w);
+#pragma unroll
+            for (uint32_t t = 0; t < kMgPartChunks; ++t) {
+                if (lo + lane * 8 + t * kWave * 8 >= 2 * n) continue;
+                float wl[2][8];
+#pragma unroll
+                for (uint32_t h = 0; h < 2; ++h)
+#pragma unroll
+                    for (uint32_t e = 0; e < 4; ++e) {
+                        wl[h][2 * e] = bf16w_lo(w[h][t][e]);
+                        wl[h][2 * e + 1] = bf16w_hi(w[h][t][e]);
+                    }
+#pragma unroll
+                for (uint32_t g = 0; g < R; ++g) {
+                    if (g >= rows) continue;
+                    const float* up = uf + g * W + t * kWave * 8 + lane * 4;
+                    const float4 u0 = *(const float4*)up, u1 = *(const float4*)(up + kWave * 4);
+                    const float u[8] = { u0.x, u0.y, u0.z, u0.w, u1.x, u1.y, u1.z, u1.w };
+#pragma unroll
+                    for (uint32_t e = 0; e < 8; ++e) {
+                        acc[qp][g] += wl[0][e] * u[e];
+                        acc[qp + 1][g] += wl[1][e] * u[e];
+                    }
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (uint32_t q = 0; q < QR; ++q)
+#pragma unroll
+        for (uint32_t g = 0; g < R; ++g) {
+            if (g >= rows) continue;
+            const float s = r4d_wave_sum(acc[q][g]);
+            if (lane == 0)
+                A.r[(size_t)(m0 + g) * A.r_rs + j0 + q] = (uint16_t)(bf16_hi_rne_nan(s) >> 16);
+        }
+}
+
+template <class CH>
+__device__ __forceinline__ void msg_mix_body(MgArgs A, uint32_t bx, uint32_t by) {
+    const uint32_t tid = threadIdx.x;
+    const uint32_t c = bx * kMgCols + tid / 4, q = tid & 3, per = A.k / 4;
+    const bool live = c < A.n;
+    const size_t wo = (size_t)(live ? c : 0) * A.k + q * per;
+
+    float f[16], g[16];
+#pragma unroll
+    for (uint32_t e = 0; e < 16; e += 4) {
+        r4d_u32x4 a{}, b{};
+        if (e < per) { a = *(g_x4)(A.fg + wo + e); b = *(g_x4)(A.ad + wo + e); }
+#pragma unroll
+        for (uint32_t i = 0; i < 4; ++i) {
+            f[e + i] = __uint_as_float(a[i]);
+            g[e + i] = __uint_as_float(b[i]);
+        }
+    }
+    if (CH::on) r4d_chain_wait();
+    for (uint32_t m0 = by * A.mix_rows; m0 < min(by * A.mix_rows + A.mix_rows, A.M);
+         m0 += kMgRows) {
+        const uint32_t rows = min(kMgRows, A.M - m0);
+        float xs[kMgRows], ms[kMgRows];
+#pragma unroll
+        for (uint32_t row = 0; row < kMgRows; ++row) {
+            const size_t mr = m0 + (row < rows ? row : 0);
+            xs[row] = live && q == 0 ? A.x[mr * A.x_rs + c] : 0.0f;
+            ms[row] = live && q == 0 ? A.m[mr * A.m_rs + c] : 0.0f;
+        }
+#pragma unroll
+        for (uint32_t row = 0; row < kMgRows; ++row) {
+            if (row >= rows) continue;
+            const uint16_t* rr = A.r + (size_t)(m0 + row) * A.r_rs + q * per;
+            float sf = 0.0f, sg = 0.0f;
+#pragma unroll
+            for (uint32_t e = 0; e < 16; e += 4) {
+                if (e >= per) continue;
+                const uint2 w = *(const uint2*)(rr + e);
+                const float v[4] = { bf16w_lo(w.x), bf16w_hi(w.x), bf16w_lo(w.y), bf16w_hi(w.y) };
+#pragma unroll
+                for (uint32_t i = 0; i < 4; ++i) {
+                    sf += f[e + i] * v[i];
+                    sg += g[e + i] * v[i];
+                }
+            }
+            sf = r4d_xor_sum<4>(sf);
+            sg = r4d_xor_sum<4>(sg);
+            if (!live || q != 0) continue;
+            A.y[(size_t)(m0 + row) * A.y_rs + c] =
+                (1.0f - tanhf(sf)) * xs[row] + tanhf(sg) * ms[row];
+        }
+    }
+}
+
+template <class CH>
+__global__ __launch_bounds__(kThr) void msg_mix_kernel(MgArgs A) {
+    msg_mix_body<CH>(A, blockIdx.x, blockIdx.y);
+    if (CH::on) r4d_chain_done();
+}
+
+/* The blend of a prefill at rank 64: a lane a column, holding its forget and admit rows, sums each
+ * quarter of the rank as msg_mix_body's lane does and folds the quarters in its xor order, so the
+ * bytes are msg_mix_body's at a quarter of its lanes. */
+constexpr uint32_t kMgWideRank = 64;
+__global__ __launch_bounds__(kThr) void msg_mix_wide_kernel(MgArgs A) {
+    constexpr uint32_t K = kMgWideRank, per = K / 4;
+    __shared__ uint2 rs[8 * kMgRows * K / 4];
+    const uint32_t c = blockIdx.x * kThr + threadIdx.x;
+    const uint32_t m0 = blockIdx.y * A.mix_rows, m1 = min(m0 + A.mix_rows, A.M);
+    const size_t wo = (size_t)min(c, A.n - 1) * K;
+    float f[K], g[K];
+#pragma unroll
+    for (uint32_t e = 0; e < K; e += 4) {
+        const r4d_u32x4 a = *(g_x4)(A.fg + wo + e), b = *(g_x4)(A.ad + wo + e);
+#pragma unroll
+        for (uint32_t i = 0; i < 4; ++i) {
+            f[e + i] = __uint_as_float(a[i]);
+            g[e + i] = __uint_as_float(b[i]);
+        }
+    }
+    for (uint32_t i = threadIdx.x; i < (m1 - m0) * (K / 4); i += kThr)
+        rs[i] = *(const uint2*)(A.r + (size_t)(m0 + i / (K / 4)) * A.r_rs + i % (K / 4) * 4);
+    lds_barrier();
+    if (c >= A.n) return;
+    for (uint32_t m = m0; m < m1; ++m) {
+        const float xs = A.x[(size_t)m * A.x_rs + c], ms = A.m[(size_t)m * A.m_rs + c];
+        const uint2* rr = rs + (m - m0) * (K / 4);
+        float sf[4], sg[4];
+#pragma unroll
+        for (uint32_t q = 0; q < 4; ++q) {
+            sf[q] = 0.0f;
+            sg[q] = 0.0f;
+#pragma unroll
+            for (uint32_t e = 0; e < per; e += 4) {
+                const uint2 w = rr[(q * per + e) / 4];
+                const float v[4] = { bf16w_lo(w.x), bf16w_hi(w.x), bf16w_lo(w.y), bf16w_hi(w.y) };
+#pragma unroll
+                for (uint32_t i = 0; i < 4; ++i) {
+                    sf[q] += f[q * per + e + i] * v[i];
+                    sg[q] += g[q * per + e + i] * v[i];
+                }
+            }
+        }
+        const float tf = (sf[0] + sf[2]) + (sf[1] + sf[3]), tg = (sg[0] + sg[2]) + (sg[1] + sg[3]);
+        A.y[(size_t)m * A.y_rs + c] = (1.0f - tanhf(tf)) * xs + tanhf(tg) * ms;
+    }
+}
+
+/* ------------------------------------------------------------------ capped_sigmoid_glu */
+/* The experts' activation, flat over the M x n extent: the two logit_softcap legs into f32, the
+ * sigmoid act_mul and the f32 mul rounded to bf16, each product formed as its kernel forms it. */
+struct GluArgs {
+    const uint16_t* g;  long long g_rs;
+    const uint16_t* u;  long long u_rs;
+    uint16_t*       y;  long long y_rs;
+    uint32_t n;
+    uint64_t total;
+    float    gcap, ucap;
+};
+
+template <class CH>
+__global__ __launch_bounds__(kThr) void capped_glu_kernel(GluArgs A) {
+    if (CH::on) r4d_chain_wait();
+    for (uint64_t t = (uint64_t)blockIdx.x * kThr + threadIdx.x; t < A.total;
+         t += (uint64_t)gridDim.x * kThr) {
+        const uint64_t r = t / A.n;
+        const uint32_t i = (uint32_t)(t - r * A.n);
+        const float g = bf16_to_f32(A.g[r * A.g_rs + i]), u = bf16_to_f32(A.u[r * A.u_rs + i]);
+        const float cg = A.gcap * tanhf(g / A.gcap), cu = A.ucap * tanhf(u / A.ucap);
+        const float a = 1.0f / (1.0f + expf(-g));
+        const float ag = a * cg;
+        A.y[r * A.y_rs + i] = f32_to_bf16(ag * cu);
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ attn_qkv_prep */
+/* What lies between the attention's input projections and its kernel, in one launch of 128-thread
+ * workgroups: a (row, head) of q clipped, a row of the relative states clipped, and a kv head of k
+ * and of v, its channels convolved token by token through the conv state, then clipped (k) or
+ * normed (v) a row at a time and stored to the paged cache. Each step computes what its own kernel
+ * computes: l2_clip_body's products and its one lane's sum in index order, ple_conv_body's taps in
+ * order and its window write-back, rmsnorm_p's wave sums added in wave order, kv_store's copy (KV8:
+ * kv_store_i8's codes against the head's f16 absmax / 127, a half of the slot a workgroup). */
+constexpr uint32_t kPrepThr = 128;
+constexpr int kPrepMaxW = 8;
+constexpr int kPrepMaxHeads = 24;
+constexpr int kRsMaxRel = 16;
+constexpr int kBiasPad = 8;      /* entries either side of a bias row, for a block's eight */
+constexpr int kBiasHeads = 4;    /* heads of a row a workgroup of rel_bias_kernel takes */
+
+/* rel_bias_body's sums for heads h0 .. h0 + kBiasHeads - 1 of row `tok` at distances d .. d + 7,
+ * `rs` those heads' relative states (kRsMaxRel apart, zero past d_rel) and `pw` the projection's
+ * columns d .. d + 7 a row of it. */
+__device__ __forceinline__ void rel_bias_group(const float* rs, const r4d_u32x4 (&pw)[kRsMaxRel],
+                                               int tok, int h0, int heads, int extent, int d,
+                                               uint16_t* bias, long long bias_rs) {
+    float acc[kBiasHeads][8] = {};
+#pragma unroll
+    for (int c = 0; c < kRsMaxRel; ++c) {
+#pragma unroll
+        for (int g = 0; g < kBiasHeads; ++g) {
+            const float r = rs[g * kRsMaxRel + c];
+#pragma unroll
+            for (int e = 0; e < 8; ++e)
+                acc[g][e] += r * ((e & 1) ? bf16w_hi(pw[c][e >> 1]) : bf16w_lo(pw[c][e >> 1]));
+        }
+    }
+#pragma unroll
+    for (int g = 0; g < kBiasHeads; ++g) {
+        if (h0 + g >= heads) continue;
+        r4d_u32x4 w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) w[e] = bf16x2_rne_nan(acc[g][7 - 2 * e], acc[g][6 - 2 * e]);
+        *(g_wx4)(bias + ((size_t)tok * heads + h0 + g) * bias_rs + kBiasPad + extent - 8 - d) = w;
+    }
+}
+
+/* The projection's columns d .. d + 7 of its first d_rel rows, zero past them. */
+__device__ __forceinline__ void rel_bias_cols(const uint16_t* proj, long long proj_rs, int d_rel,
+                                              int d, r4d_u32x4 (&pw)[kRsMaxRel]) {
+#pragma unroll
+    for (int c = 0; c < kRsMaxRel; ++c) {
+        const bool in = c < d_rel;
+        pw[c] = *(g_x4)(proj + (in ? (size_t)c * proj_rs + d : 0));
+        if (!in) pw[c] = r4d_u32x4{ 0u, 0u, 0u, 0u };
+    }
+}
+
+struct PrepArgs {
+    uint16_t*       q;     long long q_rs;
+    const uint16_t* q_sc;
+    uint16_t*       rel;   long long rel_rs;
+    const uint16_t* rel_sc;
+    const int*      pos;
+    const uint16_t* x[2];  long long x_rs[2];      /* k's and v's projections */
+    const void*     w[2];  long long w_rs[2];      /* f32 [n, width], or bf16 [width, n] (dyn) */
+    const uint16_t* dyn[2]; long long dyn_rs[2];
+    uint16_t*       cs[2];
+    long long       cs_slot, cs_ch, cs_tok, state_len;
+    const int*      cu;
+    const int*      cidx;
+    const int*      hini;
+    const int*      nacc;
+    uint16_t*       y[2];  long long y_rs[2];      /* k and v */
+    const int*      slot;
+    uint8_t*        kv;    long long kv_blocks;
+    /* attn_paged_rel_sink's bias rows, computed by the rel rows when `bias` is set. */
+    const uint16_t* proj;  long long proj_rs;
+    uint16_t*       bias;  long long bias_rs;
+    int   extent;
+    int   M, n_seq, heads, kv_heads, hd, d_rel, wid, block_size;
+    float qk_thr, rel_thr, clip_eps, norm_eps, div, alpha, floor_n;
+};
+
+/* A row's per-position factor, as l2_clip_body forms it. */
+__device__ __forceinline__ float prep_tau(const PrepArgs& A, int m) {
+    return 1.0f + A.alpha * logf(fmaxf((float)(A.pos[m] + 1) / A.floor_n, 1.0f));
+}
+
+/* l2_clip_body's tail for one element: the clip, then the position's factor. */
+__device__ __forceinline__ uint16_t prep_clip_store(float v, float fac, bool pos, float tau) {
+    v *= fac;
+    if (pos) v = __uint_as_float(bf16_hi_rne_nan(v) & 0xffff0000u) * tau;
+    return (uint16_t)(bf16_hi_rne_nan(v) >> 16);
+}
+
+/* One channel of k or v (`kind`) at token t of sequence s: ple_conv_body at dilation 1 with no
+ * bias, silu or residual, `div` set and no skip, its output rounded into y. */
+template <bool DYN>
+__device__ __forceinline__ void prep_conv_row(const PrepArgs& A, int kind, uint32_t c, int s,
+                                              int32_t t) {
+    const int wid = A.wid, hist = wid - 1;
+    const long long xld = A.x_rs[kind], yld = A.y_rs[kind];
+    float wt[kPrepMaxW];
+#pragma unroll
+    for (int j = 0; j < kPrepMaxW; ++j) {
+        if (j >= wid)           wt[j] = 0.0f;
+        else if constexpr (DYN) wt[j] = bf16_to_f32(((const uint16_t*)A.w[kind])[(size_t)(hist - j) * A.w_rs[kind] + c]);
+        else                    wt[j] = ((const float*)A.w[kind])[(size_t)c * A.w_rs[kind] + j];
+    }
+    const int32_t bos = A.cu[s];
+    const int32_t slot = A.cidx ? A.cidx[s] : s;
+    if (slot < 0) return;
+    const bool warm = A.cs[kind] && (!A.hini || A.hini[s] != 0);
+    const long long off = A.nacc ? (long long)A.nacc[s] - 1 : 0;
+    const uint16_t* __restrict__ xc = A.x[kind] + (size_t)bos * xld + c;
+    const uint16_t* __restrict__ hc =
+        warm ? A.cs[kind] + (size_t)slot * A.cs_slot + (size_t)c * A.cs_ch + off * A.cs_tok
+             : nullptr;
+    const uint16_t* __restrict__ dc =
+        DYN ? A.dyn[kind] + (size_t)bos * A.dyn_rs[kind] + (size_t)(c / (uint32_t)A.hd) * wid
+            : nullptr;
+    float acc = 0.0f;
+#pragma unroll
+    for (int j = 0; j < kPrepMaxW; ++j) {
+        if (j < wid) {
+            const int32_t src = t - hist + j;
+            const float v = src >= 0 ? bf16_to_f32(xc[(size_t)src * xld])
+                                     : (hc ? bf16_to_f32(hc[(src + hist) * A.cs_tok]) : 0.0f);
+            if constexpr (DYN)
+                acc += v * (wt[j] + bf16_to_f32(dc[(size_t)t * A.dyn_rs[kind] + hist - j]));
+            else
+                acc += v * wt[j];
+        }
+    }
+    const float own = bf16_to_f32(xc[(size_t)t * xld]);
+    const float z = bf16_to_f32(f32_to_bf16((acc + own) / A.div));
+    const float out = z + 0.0f;
+    A.y[kind][(size_t)(bos + t) * yld + c] = f32_to_bf16(out);
+}
+
+__device__ __forceinline__ void prep_state(const PrepArgs& A, int kind, uint32_t c) {
+    const int hist = A.wid - 1;
+    const long long xld = A.x_rs[kind];
+    for (int s = 0; s < A.n_seq; ++s) {
+        const int32_t bos = A.cu[s], slen = A.cu[s + 1] - bos;
+        if (slen <= 0) continue;
+        const int32_t slot = A.cidx ? A.cidx[s] : s;
+        if (slot < 0) continue;
+        const bool warm = !A.hini || A.hini[s] != 0;
+        const long long off = A.nacc ? (long long)A.nacc[s] - 1 : 0;
+        const uint16_t* __restrict__ xc = A.x[kind] + (size_t)bos * xld + c;
+        uint16_t* __restrict__ dst = A.cs[kind] + (size_t)slot * A.cs_slot + (size_t)c * A.cs_ch;
+        const uint16_t* __restrict__ hc = warm ? dst + off * A.cs_tok : nullptr;
+        uint16_t keep[kPrepMaxW];
+        if (A.nacc) {
+#pragma unroll
+            for (int i = 0; i + 1 < kPrepMaxW; ++i)
+                if (i + 1 < hist) keep[i] = hc ? hc[(size_t)(i + 1) * A.cs_tok] : (uint16_t)0;
+#pragma unroll
+            for (int i = 0; i + 1 < kPrepMaxW; ++i)
+                if (i + 1 < hist) dst[(size_t)i * A.cs_tok] = keep[i];
+            for (int32_t t = 0; t < slen && (long long)hist - 1 + t < A.state_len; ++t)
+                dst[(size_t)(hist - 1 + t) * A.cs_tok] = xc[(size_t)t * xld];
+            continue;
+        }
+#pragma unroll
+        for (int i = 0; i < kPrepMaxW; ++i) {
+            if (i < hist) {
+                const int32_t src = slen - hist + i;
+                keep[i] = src >= 0 ? xc[(size_t)src * xld]
+                                   : (hc ? hc[(src + hist) * A.cs_tok] : (uint16_t)0);
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < kPrepMaxW; ++i)
+            if (i < hist) dst[(size_t)i * A.cs_tok] = keep[i];
+    }
+}
+
+/* A card's (kind, kv head) arrivals at qkv_prep, which the last row's block reads and zeroes. */
+__device__ unsigned g_prep_rows[2 * 64];
+
+template <bool KV8, class CH>
+__global__ __launch_bounds__(kPrepThr) void qkv_prep_kernel(PrepArgs A) {
+    __shared__ float sq[3 * kPrepThr];
+    __shared__ float fac[3 * kPrepThr / 16 + 1];
+    __shared__ float part[kPrepThr / kWave];
+    __shared__ float amax[kPrepThr / kWave];
+    __shared__ float rsb[kPrepMaxHeads * kRsMaxRel];
+    if (CH::on) r4d_chain_wait();
+    const int tid = (int)threadIdx.x, hd = A.hd;
+    int b = (int)blockIdx.x;
+    const bool pos = A.pos != nullptr;
+
+    if (b < A.M * A.heads) {   /* q: a (row, head), a column a thread */
+        const int m = b / A.heads, h = b - m * A.heads;
+        uint16_t* row = A.q + (size_t)m * A.q_rs + (size_t)h * hd;
+        float v = 0.0f;
+        if (tid < hd) {
+            v = bf16_to_f32(row[tid]) * bf16_to_f32(A.q_sc[(size_t)h * hd + tid]);
+            sq[tid] = v * v;
+        }
+        lds_barrier();
+        if (tid == 0) {
+            float ss = 0.0f;
+            for (int i = 0; i < hd; ++i) ss += sq[i];
+            fac[0] = fminf(A.qk_thr / (sqrtf(ss) + A.clip_eps), 1.0f);
+        }
+        lds_barrier();
+        if (tid < hd) row[tid] = prep_clip_store(v, fac[0], pos, pos ? prep_tau(A, m) : 1.0f);
+    } else if ((b -= A.M * A.heads) < A.M) {   /* the relative states: a row, columns strided */
+        const int m = b, nr = A.heads * A.d_rel;
+        uint16_t* row = A.rel + (size_t)m * A.rel_rs;
+        float v[3];
+#pragma unroll
+        for (int k = 0; k < 3; ++k) {
+            const int col = tid + k * (int)kPrepThr;
+            v[k] = 0.0f;
+            if (col < nr) {
+                v[k] = bf16_to_f32(row[col]) * bf16_to_f32(A.rel_sc[col]);
+                sq[col] = v[k] * v[k];
+            }
+        }
+        if (A.bias)
+            for (int i = tid; i < kPrepMaxHeads * kRsMaxRel; i += (int)kPrepThr)
+                if (i % kRsMaxRel >= A.d_rel || i / kRsMaxRel >= A.heads) rsb[i] = 0.0f;
+        lds_barrier();
+        if (tid < A.heads) {
+            float ss = 0.0f;
+            for (int i = 0; i < A.d_rel; ++i) ss += sq[tid * A.d_rel + i];
+            fac[tid] = fminf(A.rel_thr / (sqrtf(ss) + A.clip_eps), 1.0f);
+        }
+        lds_barrier();
+        const float tau = pos ? prep_tau(A, m) : 1.0f;
+#pragma unroll
+        for (int k = 0; k < 3; ++k) {
+            const int col = tid + k * (int)kPrepThr;
+            if (col >= nr) continue;
+            const uint16_t o = prep_clip_store(v[k], fac[col / A.d_rel], pos, tau);
+            row[col] = o;
+            if (A.bias) rsb[(col / A.d_rel) * kRsMaxRel + col % A.d_rel] = bf16_to_f32(o);
+        }
+        if (A.bias) {
+            lds_barrier();
+            /* A head group at a time, as rel_bias_kernel's workgroups take them. One projection
+             * load shared by every group took all 256 VGPRs, spilled, and hung the first decode. */
+#pragma unroll 1
+            for (int h0 = 0; h0 < A.heads; h0 += kBiasHeads) {
+#pragma unroll 1
+                for (int d0 = 8 * tid; d0 < A.extent; d0 += 8 * (int)kPrepThr) {
+                    const int d = min(d0, A.extent - 8);
+                    r4d_u32x4 pw[kRsMaxRel];
+                    rel_bias_cols(A.proj, A.proj_rs, A.d_rel, d, pw);
+                    rel_bias_group(rsb + h0 * kRsMaxRel, pw, m, h0, A.heads, A.extent, d,
+                                   A.bias, A.bias_rs);
+                }
+            }
+        }
+    } else if ((b -= A.M) < 2 * A.kv_heads * A.M) {   /* k or v: (kv head, row), a channel a thread */
+        const int m = b % A.M, kh = b / A.M;
+        const int kind = kh / A.kv_heads, hk = kh - kind * A.kv_heads;
+        const uint32_t c = (uint32_t)(hk * hd + tid);
+        int seq = 0;
+        while (seq + 1 < A.n_seq && A.cu[seq + 1] <= m) ++seq;
+        if (tid < hd && m >= A.cu[seq] && m < A.cu[seq + 1]) {
+            if (A.dyn[kind]) prep_conv_row<true>(A, kind, c, seq, m - A.cu[seq]);
+            else             prep_conv_row<false>(A, kind, c, seq, m - A.cu[seq]);
+        }
+        const size_t slot_bytes = KV8 ? 2 * (size_t)hd + 4 : 4 * (size_t)hd;
+        const size_t head_step = (size_t)A.block_size * slot_bytes;
+        do {
+            uint16_t* yr = A.y[kind] + (size_t)m * A.y_rs[kind] + c;
+            const float v = tid < hd ? bf16_to_f32(*yr) : 0.0f;
+            uint16_t out = 0;
+            if (kind == 0) {
+                if (tid < hd) sq[tid] = v * v;
+                lds_barrier();
+                if (tid == 0) {
+                    float ss = 0.0f;
+                    for (int i = 0; i < hd; ++i) ss += sq[i];
+                    fac[0] = fminf(A.qk_thr / (sqrtf(ss) + A.clip_eps), 1.0f);
+                }
+                lds_barrier();
+                out = prep_clip_store(v, fac[0], false, 1.0f);
+            } else {
+                float ss = 0.0f;
+                ss += v * v;
+                ss = r4d_wave_sum(ss);
+                if ((tid & (kWave - 1)) == 0) part[tid / kWave] = ss;
+                lds_barrier();
+                float tot = 0.0f;
+#pragma unroll
+                for (uint32_t w = 0; w < kPrepThr / kWave; ++w) tot += part[w];
+                const float s = rsqrtf(tot / (float)hd + A.norm_eps);
+                out = f32_to_bf16(v * s);
+            }
+            lds_barrier();
+            /* kv_i8_quant's scale and code, every thread a column of the head. */
+            uint16_t sc16 = 0;
+            uint8_t code = 0;
+            if constexpr (KV8) {
+                const float of = tid < hd ? bf16_to_f32(out) : 0.0f;
+                const float am = r4d_wave_max(fabsf(of));
+                if ((tid & (kWave - 1)) == 0) amax[tid / kWave] = am;
+                lds_barrier();
+                float mx = 0.0f;
+#pragma unroll
+                for (uint32_t w = 0; w < kPrepThr / kWave; ++w) mx = fmaxf(mx, amax[w]);
+                const __fp16 h16 = (__fp16)fminf(mx / 127.0f, 515.0f);
+                const float sc = (float)h16;
+                const float r = sc > 0.0f ? rintf(of / sc) : 0.0f;
+                code = (uint8_t)(int8_t)(int)fminf(fmaxf(r, -127.0f), 127.0f);
+                sc16 = __builtin_bit_cast(uint16_t, h16);
+            }
+            if (tid >= hd) continue;
+            *yr = out;
+            const int32_t sl = A.slot[m];
+            if (sl < 0 || (long long)(sl / A.block_size) >= A.kv_blocks) continue;
+            const uint32_t blk = (uint32_t)sl / (uint32_t)A.block_size;
+            const uint32_t boff = (uint32_t)sl % (uint32_t)A.block_size;
+            uint8_t* row = A.kv + (size_t)blk * A.kv_heads * head_step + (size_t)hk * head_step +
+                           (size_t)boff * slot_bytes;
+            if constexpr (KV8) {
+                row[(size_t)kind * hd + tid] = code;
+                if (tid == 0) *(uint16_t*)(row + 2 * (size_t)hd + 2 * kind) = sc16;
+            } else {
+                ((uint16_t*)row)[(size_t)kind * hd + tid] = out;
+            }
+        } while (false);
+        if (A.cs[kind]) {
+            __shared__ unsigned last;
+            lds_barrier();
+            if (tid == 0) {
+                const unsigned n = __hip_atomic_fetch_add(&g_prep_rows[kh], 1u, __ATOMIC_ACQ_REL,
+                                                          __HIP_MEMORY_SCOPE_AGENT);
+                last = n + 1 == (unsigned)A.M;
+                if (last) __hip_atomic_store(&g_prep_rows[kh], 0u, __ATOMIC_RELAXED,
+                                             __HIP_MEMORY_SCOPE_AGENT);
+            }
+            lds_barrier();
+            if (last && tid < hd) {
+                __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+                prep_state(A, kind, c);
+            }
+        }
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ attn_paged_rel_sink */
+/* ref_attn_paged_rel_sink at head_dim HD over the paged cache (kv_cache[n_blocks, kv_heads, 16,
+ * slot], K then V a slot), bf16 or int8 (KvSlot), with the matrix cores.
+ *
+ * A wave holds sixteen queries of one sequence and kv head (lane c the query, whole rows, each
+ * with its gqa heads) and walks the keys a paged block at a time: S^T = K Q^T leaves lane (c, h)
+ * the scores of keys 8h .. 8h + 7, and O^T = V^T P^T adds the block's values onto the columns
+ * 8h .. 8h + 7 of every sixteen, V going through LDS to be read a column a lane.
+ *
+ * A row's keys are cut into spans, counted in blocks from its first: kNearSpans of kSpanNear
+ * blocks, then kSpanFar blocks each. A span reads its keys once, keeping a running maximum, sum
+ * of exponentials and value sum (online_block), and a row folds its spans' onto its sink's in
+ * span order (fold_span), so a row has the same bytes from either form:
+ *
+ *   rel_sink_span_kernel  a wave takes one span of its rows (blockIdx.y) and leaves the span's
+ *                         three in scratch, and rel_sink_merge_kernel folds a row's. A decode's
+ *                         form: its keys are spread over the card and no wave waits on more than
+ *                         a span of them.
+ *   rel_sink_tile_kernel  a workgroup of kTileWaves waves takes its rows' every span, the waves
+ *                         sharing each block's K and V through LDS. A prefill's form.
+ *
+ * The bias is libref's (rel_bias_kernel: its sum in index order, rounded), and the scores and the
+ * probabilities round where libref rounds them. The dot product, the denominator and the value
+ * sums add in another order and the exponential is the card's, so the output differs from
+ * libref's in its last bits. */
+constexpr int kBlock = 16;
+
+struct RelSinkArgs {
+    const uint16_t* q;      long long q_rs;
+    const uint8_t*  kv;     long long kv_bs, kv_hs;   /* strides in bytes */
+    const int*      bt;
+    const int*      su;
+    const int*      cu;
+    const uint16_t* rel;    long long rel_rs;
+    const uint16_t* proj;   long long proj_rs;
+    const uint16_t* sinks;  long long sink_rs;
+    uint16_t*       out;    long long out_rs;
+    int   n_seq, q_len, rows, kv_heads, gqa, max_blocks, window, d_rel, extent;
+    float scale;
+    /* attn_paged_rel_sink_gate_had_quant: gate_had_quant_i8g's codes of sigmoid(gate) * out */
+    const uint16_t* gate;   long long gate_rs;
+    uint8_t*        q8;     long long q8_rs;
+    float*          s8;     long long s8_rs;
+};
+
+/* gate_had_quant_i8g at act sigmoid_f32 over head hq of token tok, the lane's four columns of the
+ * attention's bf16 output `xb`: gate_quant_fp8_body's rounding, rotation and int8 group, the head
+ * one 128-column group. */
+__device__ __forceinline__ void gate_quant_head(const RelSinkArgs& A, int tok, int hq, int lane,
+                                                const uint16_t (&xb)[4]) {
+    const size_t c0 = (size_t)hq * 128 + 4 * lane;
+    const uint16_t* gr = A.gate + (size_t)tok * A.gate_rs + c0;
+    float v[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const uint16_t h = f32_to_bf16(1.0f / (1.0f + expf(-bf16_to_f32(gr[j]))) *
+                                       bf16_to_f32(xb[j]));
+        v[j] = bf16_to_f32(h);
+    }
+    r4d_fwht_wave<128>(v, lane);
+    float m = fmaxf(fmaxf(fabsf(v[0]), fabsf(v[1])), fmaxf(fabsf(v[2]), fabsf(v[3])));
+    m = fmaxf(m, r4d_xor_lane<16>(m));
+    m = fmaxf(m, r4d_xor_lane<8>(m));
+    m = fmaxf(m, r4d_xor_lane<4>(m));
+    m = fmaxf(m, r4d_xor_lane<2>(m));
+    m = fmaxf(m, r4d_xor_lane<1>(m));
+    const float sc = m > 0.0f ? m * (1.0f / q8_top<true>()) : 1.0f;
+    if (lane == 0) A.s8[(size_t)tok * A.s8_rs + hq] = sc;
+    *(uint32_t*)(A.q8 + (size_t)tok * A.q8_rs + c0) =
+        q8_pack4<true>(v[0], v[1], v[2], v[3], 1.0f / sc);
+}
+
+constexpr int kTq = 16;          /* queries a wave holds */
+constexpr int kSpanNear = 8;     /* blocks a span, a row's first kNearSpans spans */
+constexpr int kNearSpans = 8;
+constexpr int kSpanFar = 32;     /* and its later ones */
+constexpr int kTileWaves = 8;
+constexpr float kLog2e = 1.44269504089f;
+static_assert((kSpanNear & (kSpanNear - 1)) == 0 && (kSpanFar & (kSpanFar - 1)) == 0 &&
+              kSpanNear * kNearSpans % kSpanFar == 0, "span_start's masks");
+
+/* Two floats as an f16 pair, each rounded to nearest even. */
+__device__ __forceinline__ uint32_t f16x2(float a, float b) {
+    return (uint32_t)__builtin_bit_cast(uint16_t, (_Float16)a) |
+           ((uint32_t)__builtin_bit_cast(uint16_t, (_Float16)b) << 16);
+}
+
+/* A cache slot: HD bf16 of K then HD of V, or (I8) HD int8 codes of each and then the token's f16
+ * scales, K's low, V's high (kv_store_i8). Raw is eight elements as loaded; bf16 makes K the
+ * QK operand and f16 makes V the PV operand. A code is exact in either, so a key's score is its
+ * codes' dot times its K scale and its values enter at its probability times its V scale. A bf16
+ * V is exact in f16 too: v_norm leaves a head's V at unit RMS, so no element passes 12. The int8
+ * slot is 4-byte aligned, so its loads are too. */
+template <int HD, bool I8> struct KvSlot;
+template <int HD> struct KvSlot<HD, false> {
+    static constexpr int ESZ = 2, BYTES = 4 * HD;
+    typedef r4d_u32x4 Raw;
+    static __device__ __forceinline__ Raw load(const uint8_t* p) { return *(g_x4)p; }
+    static __device__ __forceinline__ r4d_u32x4 bf16(Raw r) { return r; }
+    static __device__ __forceinline__ r4d_u32x4 f16(Raw r) {
+        r4d_u32x4 w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) w[e] = f16x2(bf16w_lo(r[e]), bf16w_hi(r[e]));
+        return w;
+    }
+};
+template <int HD> struct KvSlot<HD, true> {
+    static constexpr int ESZ = 1, BYTES = 2 * HD + 4;
+    typedef r4d_u32x2 Raw;
+    static __device__ __forceinline__ Raw load(const uint8_t* p) { return *(g_x2)p; }
+    static __device__ __forceinline__ uint32_t pair(uint32_t w) {
+        const float a = (float)(int8_t)(w & 0xffu), b = (float)(int8_t)((w >> 8) & 0xffu);
+        return (__float_as_uint(a) >> 16) | (__float_as_uint(b) & 0xffff0000u);
+    }
+    static __device__ __forceinline__ r4d_u32x4 bf16(Raw r) {
+        r4d_u32x4 w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) w[e] = pair(r[e >> 1] >> (16 * (e & 1)));
+        return w;
+    }
+    static __device__ __forceinline__ r4d_u32x4 f16(Raw r) {
+        r4d_u32x4 w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            const uint32_t u = r[e >> 1] >> (16 * (e & 1));
+            w[e] = f16x2((float)(int8_t)(u & 0xffu), (float)(int8_t)((u >> 8) & 0xffu));
+        }
+        return w;
+    }
+};
+__device__ __forceinline__ float f16_lo(uint32_t w) {
+    return (float)__builtin_bit_cast(_Float16, (uint16_t)(w & 0xffffu));
+}
+
+/* Spans `blocks` blocks from a row's first make. */
+__host__ __device__ __forceinline__ int span_count(int blocks) {
+    const int near = kSpanNear * kNearSpans;
+    if (blocks <= 0) return 0;
+    return blocks <= near ? (blocks + kSpanNear - 1) / kSpanNear
+                          : kNearSpans + (blocks - near + kSpanFar - 1) / kSpanFar;
+}
+/* Span sp's first block, from the row's first. */
+__device__ __forceinline__ int span_lo(int sp) {
+    return sp < kNearSpans ? sp * kSpanNear : kSpanNear * kNearSpans + (sp - kNearSpans) * kSpanFar;
+}
+/* True at the first block of every span but the first, `rel` blocks from the row's first. */
+__device__ __forceinline__ bool span_start(int rel) {
+    return rel > 0 && (rel & ((rel < kSpanNear * kNearSpans ? kSpanNear : kSpanFar) - 1)) == 0;
+}
+
+struct TileArgs {
+    uint16_t* bias;  long long bias_rs;   /* [rows, heads, kBiasPad + extent + kBiasPad], by key */
+    float*    stats;                      /* [rows, heads, nspan, 2]: maximum, sum */
+    float*    part;                       /* [rows, heads, nspan, HD] */
+    int       nspan, wave_rows, wg_queries;
+    /* attn_paged_rel_sink_sparse: a (row, kv head)'s kept blocks in order, `nlist` of them,
+     * which spans of list_span cut in place of the table's. Null for every key. */
+    const int* list;  int list_pitch, list_span;
+    const int* nlist;
+    /* A query's spans landed, which the span kernel's merge waves wait on and zero. Null where
+     * rel_sink_merge_kernel folds them. */
+    unsigned*  done;
+};
+
+/* A kept list's span: kListSpan blocks, so a step over a few thousand kept blocks still spreads
+ * across the card, or up to a wave's worth where the scratch holds no more spans. */
+constexpr int kListSpan = 8;
+__host__ __device__ __forceinline__ int list_spans(int n, int per) { return (n + per - 1) / per; }
+
+struct TileRows {
+    int s, len, off, used;   /* the sequence, its rows, the first of them in q, its keys */
+    int r0, last, q0;        /* the workgroup's rows of it, and (wg_queries) its first query */
+    int jF, jL, jend;        /* the first key of r0 and of last, and one past last's keys */
+};
+
+struct TileLane {
+    bool            live;
+    int             tok, hq, pos, j0, j1;
+    const uint16_t* bias;
+};
+
+__device__ __forceinline__ int tile_lo(const RelSinkArgs& A, int pos) {
+    return A.window > 0 ? max(pos - A.window + 1, 0) : 0;
+}
+
+/* Rows wg * rows_wg and on of sequence s, rows_wg at most. */
+__device__ __forceinline__ void tile_rows_of(const RelSinkArgs& A, int rows_wg, int s, int wg,
+                                             TileRows& R, int qwg = 0) {
+    R.s = s;
+    R.len = __builtin_amdgcn_readfirstlane(r4d_q_len(A.cu, s, A.q_len));
+    R.off = __builtin_amdgcn_readfirstlane(r4d_q_off(A.cu, s, A.q_len));
+    R.used = __builtin_amdgcn_readfirstlane(A.su[s]);
+    R.q0 = wg * qwg;
+    R.r0 = qwg ? R.q0 / A.gqa : wg * rows_wg;
+    R.last = min(qwg ? (R.q0 + qwg - 1) / A.gqa + 1 : R.r0 + rows_wg, R.len) - 1;
+    const int base = R.used - R.len;
+    R.jF = tile_lo(A, base + R.r0);
+    R.jL = tile_lo(A, base + R.last);
+    R.jend = min(base + R.last + 1, A.max_blocks * kBlock);
+}
+
+/* Workgroup `wg`'s rows, rows_wg of one sequence; false past the launch's. */
+__device__ __forceinline__ bool tile_rows(const RelSinkArgs& A, int rows_wg, int wg, TileRows& R,
+                                          int qwg = 0) {
+    const int unit = qwg ? qwg : rows_wg, mul = qwg ? A.gqa : 1;
+    int s = 0;
+    if (A.cu) {
+        for (; s < A.n_seq; ++s) {
+            const int n = (__builtin_amdgcn_readfirstlane(r4d_q_len(A.cu, s, 0)) * mul + unit - 1) /
+                          unit;
+            if (wg < n) break;
+            wg -= n;
+        }
+    } else {
+        const int per = (A.q_len * mul + unit - 1) / unit;
+        s = wg / per;
+        wg -= s * per;
+    }
+    if (s >= A.n_seq) return false;
+    tile_rows_of(A, rows_wg, s, wg, R, qwg);
+    return true;
+}
+
+/* Spans the workgroup's rows reach: the last row's last block, from the first row's first. */
+__device__ __forceinline__ int tile_spans(const TileRows& R) {
+    return R.jend > R.jF ? span_count((R.jend - 1) / kBlock - R.jF / kBlock + 1) : 0;
+}
+
+/* The query of lane column c in wave `wv` of the workgroup; a dead lane reads the first row's. */
+__device__ __forceinline__ TileLane tile_lane(const RelSinkArgs& A, const TileArgs& T,
+                                              const TileRows& R, int kvh, int wv, int c) {
+    TileLane Ln;
+    const int qi = R.q0 + wv * kTq + c, rw = c / A.gqa;
+    const int row = T.wg_queries ? qi / A.gqa : R.r0 + wv * T.wave_rows + rw;
+    Ln.live = (T.wg_queries || rw < T.wave_rows) && row <= R.last;
+    const int rr = Ln.live ? row : R.r0;
+    Ln.tok = R.off + rr;
+    Ln.hq = kvh * A.gqa + (!Ln.live ? 0 : T.wg_queries ? qi - row * A.gqa : c - rw * A.gqa);
+    Ln.pos = R.used - R.len + rr;
+    Ln.j0 = tile_lo(A, Ln.pos);
+    Ln.j1 = min(Ln.pos + 1, A.max_blocks * kBlock);
+    if (!Ln.live || Ln.j1 < Ln.j0) Ln.j1 = Ln.j0;
+    Ln.bias = T.bias + ((size_t)Ln.tok * A.kv_heads * A.gqa + Ln.hq) * T.bias_rs;
+    return Ln;
+}
+
+template <int HD>
+__device__ __forceinline__ void tile_query(const RelSinkArgs& A, const TileLane& Ln, int h,
+                                           DT16<0>::frag* qf) {
+    const uint16_t* qp = A.q + (size_t)Ln.tok * A.q_rs + (size_t)Ln.hq * HD + 8 * h;
+#pragma unroll
+    for (int g = 0; g < HD / 16; ++g) {
+        const r4d_u32x4 u = *(g_x4)(qp + 16 * g);
+        qf[g] = DT16<0>::mk(make_uint2(u[0], u[1]), make_uint2(u[2], u[3]));
+    }
+}
+
+/* `f` through a bf16 store and load, for a value the card computed from bf16 operands. Its NaN
+ * is the card's own or an operand's, the low half zero either way, and the plain rounding keeps
+ * such a NaN where it would carry another into the exponent. */
+__device__ __forceinline__ float rd_bf16(float f) {
+    return __uint_as_float(bf16_hi_rne(f) & 0xffff0000u);
+}
+
+/* The lane's bias word for keys k0 .. k0 + 7, clamped into its row where they are out of reach. */
+__device__ __forceinline__ r4d_u32x4 tile_bias(const RelSinkArgs& A, const TileLane& Ln, int k0) {
+    const int far = Ln.pos - k0;
+    return *(g_x4)(Ln.bias + min(max(kBiasPad + A.extent - 1 - far, 0), A.extent + kBiasPad));
+}
+
+/* The lane's eight scores from the dot products `s` of the keys from k0 and their bias word `w`,
+ * with libref's roundings; -inf at a key outside [ja, ja + nj) and where the block is `gone`. */
+__device__ __forceinline__ void tile_scores(const RelSinkArgs& A, const TileLane& Ln, v8f s,
+                                            int k0, int ja, uint32_t nj, bool gone,
+                                            const r4d_u32x4& w, float (&sc)[8]) {
+#pragma unroll
+    for (int e = 0; e < 8; ++e) sc[e] = rd_bf16(rd_bf16(s[e]) * A.scale);
+
+    const int far = Ln.pos - k0;
+    if (wave_any(Ln.live && far >= 0 && far - 7 < A.extent)) {
+#pragma unroll
+        for (int e = 0; e < 8; ++e) {
+            const float be = (e & 1) ? bf16w_hi(w[e >> 1]) : bf16w_lo(w[e >> 1]);
+            sc[e] = (uint32_t)(far - e) < (uint32_t)A.extent ? rd_bf16(sc[e] + be) : sc[e];
+        }
+    }
+
+    if (gone || wave_any(Ln.live && (k0 < ja || (uint32_t)(k0 + 8 - ja) > nj))) {
+#pragma unroll
+        for (int e = 0; e < 8; ++e)
+            sc[e] = !gone && (uint32_t)(k0 + e - ja) < nj ? sc[e] : -INFINITY;
+    }
+}
+
+/* I8: a probability times its V scale (a head's absmax / 127, about 0.02) times 2^8 stays in
+ * f16's normal range down to probabilities of 1e-4; the row's output takes the 2^-8 back. */
+constexpr float kVsUp = 256.0f, kVsDown = 1.0f / 256.0f;
+
+/* A block's scores onto a span's running maximum m, the lane's half of its sum l and its value
+ * sums acc, unnormalised against m: what the block raises m by rescales l and acc first, then its
+ * probabilities, as the f16 P operand (I8, times their keys' V scales and kVsUp), add V^T P^T,
+ * `vread(g)` V^T's f16 fragment g. PyTorch rounds a probability normalised, which no single
+ * pass can; over 512 positions of a 12K prompt this form's KL against it is 0.0069 (bf16 cache)
+ * and 0.0077 (int8), the two-pass form's 0.0050 and 0.0069. The tile and the span kernel run a
+ * lane's keys through this in the same order, so a span's (m, l, acc) has the same bytes from
+ * either. */
+template <int NC, bool I8, class VR, bool CLEAN = false>
+__device__ __forceinline__ void online_block(float& m, float& l, v8f (&acc)[NC],
+                                             const float (&sc)[8], const float (&vs)[8], VR vread) {
+    float tm = sc[0];
+#pragma unroll
+    for (int e = 1; e < 8; ++e) tm = fmaxf(tm, sc[e]);
+    tm = fmaxf(tm, swap16(tm));
+    if (wave_any(tm > m)) {
+        const bool up = tm > m;
+        const float corr = !up ? 1.0f : m == -INFINITY ? 0.0f : ex2((m - tm) * kLog2e);
+        l *= corr;
+#pragma unroll
+        for (int g = 0; g < NC; ++g)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) acc[g][e] *= corr;
+        m = up ? tm : m;
+    }
+    uint32_t pw[4];
+    float ls = 0.0f;
+    /* CLEAN: vs holds the V scales times kVsUp, zero where a key has no value. Below a finite m, a
+     * -inf score's exponential is v_exp_f32's 0 and its product with a scale 0, as the selects
+     * give. */
+    if (CLEAN && !wave_any(m == -INFINITY)) {
+#pragma unroll
+        for (int e = 0; e < 8; e += 2) {
+            const float pa = ex2((sc[e] - m) * kLog2e), pb = ex2((sc[e + 1] - m) * kLog2e);
+            ls += pa;
+            ls += pb;
+            pw[e >> 1] = I8 ? f16x2(pa * vs[e], pb * vs[e + 1]) : f16x2(pa, pb);
+        }
+    } else {
+#pragma unroll
+        for (int e = 0; e < 8; e += 2) {
+            float pa = sc[e] == -INFINITY ? 0.0f : ex2((sc[e] - m) * kLog2e);
+            float pb = sc[e + 1] == -INFINITY ? 0.0f : ex2((sc[e + 1] - m) * kLog2e);
+            ls += pa;
+            ls += pb;
+            if constexpr (I8 && CLEAN) {
+                pa *= vs[e];
+                pb *= vs[e + 1];
+            } else if constexpr (I8) {
+                pa = pa != 0.0f ? pa * (vs[e] * kVsUp) : 0.0f;
+                pb = pb != 0.0f ? pb * (vs[e + 1] * kVsUp) : 0.0f;
+            }
+            pw[e >> 1] = f16x2(pa, pb);
+        }
+    }
+    l += ls;
+    const DT16<1>::frag pf = DT16<1>::mk(make_uint2(pw[0], pw[1]), make_uint2(pw[2], pw[3]));
+#pragma unroll
+    for (int g = 0; g < NC; ++g) acc[g] = DT16<1>::wmma(vread(g), pf, acc[g]);
+}
+
+/* Where V's column `col` starts in LDS, a column `stride` values: every other eight columns
+ * sixteen values on. A wave stores two runs of eight columns, a key a lane, and unshifted the
+ * two runs' stores would meet in the same LDS banks. */
+constexpr int kColShift = 16;
+__device__ __forceinline__ int v_col(int col, int stride) {
+    return col * stride + ((col >> 3) & 1) * kColShift;
+}
+
+/* A span's (m, l, acc) onto the row's running (M, L, O), spans in order from the sink's (its
+ * logit, 1, 0): `a` weights the row's terms and `b` the span's. The merge and the tile kernel both
+ * fold through this, element by element, so a row has the same bytes from either. */
+struct Fold { float a, b; bool take; };
+__device__ __forceinline__ Fold fold_span(float& M, float& L, float m, float l, bool on) {
+    Fold f;
+    f.take = on && m != -INFINITY;
+    const float mx = fmaxf(M, m);
+    f.a = ex2((M - mx) * kLog2e);
+    f.b = ex2((m - mx) * kLog2e);
+    const float sum = __builtin_fmaf(L, f.a, l * f.b);
+    L = f.take ? sum : L;
+    M = f.take ? mx : M;
+    return f;
+}
+__device__ __forceinline__ float fold_val(const Fold& f, float o, float x) {
+    return f.take ? __builtin_fmaf(o, f.a, x * f.b) : o;
+}
+
+/* Lane (c, h)'s columns 16g + 8h .. + 7 of its query's row of `out`, rounded. */
+template <int HD>
+__device__ __forceinline__ void tile_store(const RelSinkArgs& A, const TileLane& Ln, int h,
+                                           const v8f* o) {
+    if (!Ln.live) return;
+    uint16_t* op = A.out + (size_t)Ln.tok * A.out_rs + (size_t)Ln.hq * HD + 8 * h;
+#pragma unroll
+    for (int g = 0; g < HD / 16; ++g) {
+        r4d_u32x4 w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) w[e] = bf16x2_rne_nan(o[g][2 * e], o[g][2 * e + 1]);
+        *(g_wx4)(op + 16 * g) = w;
+    }
+}
+
+/* The scales of keys 8h .. 8h + 7 of a block whose key c lane c holds (its scale word `w`): K's
+ * at half 0, V's at 1. */
+__device__ __forceinline__ void key_scales(uint32_t w, int h, int half, float (&sc)[8]) {
+#pragma unroll
+    for (int e = 0; e < 8; ++e) {
+        const uint32_t a = (uint32_t)__builtin_amdgcn_readlane((int)w, e);
+        const uint32_t b = (uint32_t)__builtin_amdgcn_readlane((int)w, 8 + e);
+        sc[e] = f16_lo((h ? b : a) >> (16 * half));
+    }
+}
+
+/* bias[query][kBiasPad + extent - 1 - dist] = rd(rel[query] . rel_proj[:, dist]), so a block's
+ * keys are a run of it in key order. A workgroup takes kBiasHeads heads of a row and a thread
+ * eight distances, whose projection columns it loads once for all of the heads; the last eight
+ * of an extent that is no multiple of eight overlap the eight before. */
+__device__ __forceinline__ void rel_bias_body(RelSinkArgs A, TileArgs T) {
+    __shared__ __align__(16) float rs[kBiasHeads * kRsMaxRel];
+    const int heads = A.kv_heads * A.gqa, groups = (heads + kBiasHeads - 1) / kBiasHeads;
+    const int tok = (int)(blockIdx.x / (uint32_t)groups), tid = (int)threadIdx.x;
+    const int h0 = ((int)blockIdx.x - tok * groups) * kBiasHeads;
+    if (tok >= A.rows) return;   /* past the cliff (r4d_cliff_rows) */
+    if (tid < kBiasHeads * kRsMaxRel) {
+        const int hq = h0 + tid / kRsMaxRel, c = tid % kRsMaxRel;
+        const bool in = hq < heads && c < A.d_rel;
+        const float r = ld_bf16(A.rel + (size_t)tok * A.rel_rs + (in ? (size_t)hq * A.d_rel + c : 0));
+        rs[tid] = in ? r : 0.0f;
+    }
+    lds_barrier();
+
+    for (int d0 = 8 * tid; d0 < A.extent; d0 += 8 * (int)blockDim.x) {
+        const int d = min(d0, A.extent - 8);
+        /* The columns stay packed and every head's sums are taken together: unpacked to f32 for
+         * each head in turn they took all 256 VGPRs and spilled to scratch. */
+        r4d_u32x4 pw[kRsMaxRel];
+        rel_bias_cols(A.proj, A.proj_rs, A.d_rel, d, pw);
+        rel_bias_group(rs, pw, tok, h0, heads, A.extent, d, T.bias, T.bias_rs);
+    }
+}
+
+template <class CH>
+__global__ __launch_bounds__(kThr) void rel_bias_kernel(RelSinkArgs A, TileArgs T) {
+    if (CH::on) r4d_chain_wait();
+    rel_bias_body(A, T);
+    if (CH::on) r4d_chain_done();
+}
+
+/* One span of the wave's rows, its keys once: the span's (m, l) to `stats` and its value sums to
+ * `part`, which rel_sink_merge_kernel folds. SP walks a kept list's blocks (T.list); the dense
+ * form leaves the list's code out, which took Inkling 2 Mini's tp 2 decode from 117.4 to 118.0
+ * tok/s. */
+template <int HD, bool I8, bool SP>
+__device__ __forceinline__ void rel_sink_span_body(RelSinkArgs A, TileArgs T) {
+    typedef DT16<0> D;
+    typedef KvSlot<HD, I8> KS;
+    typedef typename KS::Raw Raw;
+    constexpr int NC = HD / 16, VSTR = kBlock + kColShift;
+    __shared__ __align__(16) uint16_t sV[HD * VSTR];
+
+    const int lane = (int)threadIdx.x, c = lane & 15, h = lane >> 4;
+    const int kvh = (int)(blockIdx.x % (uint32_t)A.kv_heads), sp = (int)blockIdx.y;
+    TileRows R;
+    if (!tile_rows(A, T.wave_rows, (int)(blockIdx.x / (uint32_t)A.kv_heads), R)) return;
+    const int lcell = (R.off + R.r0) * A.kv_heads + kvh;
+    const int* lrow = SP ? T.list + (size_t)lcell * T.list_pitch : nullptr;
+    const int nl = lrow ? __builtin_amdgcn_readfirstlane(T.nlist[lcell]) : 0;
+    const int nsp = min(lrow ? list_spans(nl, T.list_span) : tile_spans(R), T.nspan);
+    if (sp >= nsp) return;
+    const TileLane Ln = tile_lane(A, T, R, kvh, 0, c);
+
+    /* The span's blocks over the wave's rows, and the lane's keys of it. A kept list's span holds
+     * its own blocks only, so a lane's keys are all of its row's. */
+    const int b0 = Ln.j0 / kBlock, tb0 = R.jF / kBlock + span_lo(sp);
+    int nt, ja;
+    uint32_t nj;
+    const int l0 = sp * T.list_span;
+    if (lrow) {
+        nt = min(nl - l0, T.list_span);
+        ja = Ln.j0;
+        nj = (uint32_t)max(Ln.j1 - Ln.j0, 0);
+    } else {
+        nt = min((R.jend - 1) / kBlock, R.jL / kBlock + span_lo(sp + 1) - 1) - tb0 + 1;
+        ja = max(Ln.j0, (b0 + span_lo(sp)) * kBlock);
+        nj = (uint32_t)max(min(Ln.j1, (b0 + span_lo(sp + 1)) * kBlock) - ja, 0);
+    }
+
+    const size_t query = (size_t)Ln.tok * A.kv_heads * A.gqa + Ln.hq, cell = query * T.nspan;
+    const int* btr = A.bt + (size_t)R.s * A.max_blocks;
+    const uint8_t* kvs = A.kv + (size_t)kvh * A.kv_hs + (size_t)c * KS::BYTES;
+    const uint8_t* kvp = kvs + 8 * h * KS::ESZ;
+
+    /* Lane t the span's block t, so a block's page costs no load of its own. */
+    const int lb = lrow && lane < nt ? lrow[l0 + lane] : tb0 + lane;
+    const int blks = lane < nt ? btr[lb] : -1;
+    auto page = [&](int t) {
+        return t < (int)kWave ? __builtin_amdgcn_readlane(blks, t)
+                              : __builtin_amdgcn_readfirstlane(btr[tb0 + t]);
+    };
+    auto blk = [&](int t) { return lrow ? __builtin_amdgcn_readlane(lb, t) : tb0 + t; };
+    /* Block t's K (or V) as the lane's sixteen-column runs: key c, columns 16g + 8h .. + 7. */
+    auto fetch = [&](int t, int col0, Raw (&reg)[NC]) {
+        const uint8_t* kp = kvp + (size_t)max(page(t), 0) * A.kv_bs + col0 * KS::ESZ;
+#pragma unroll
+        for (int g = 0; g < NC; ++g) reg[g] = KS::load(kp + 16 * g * KS::ESZ);
+    };
+    /* I8: key c's scale word of block t. */
+    auto fetch_sc = [&](int t) -> uint32_t {
+        if constexpr (!I8) return 0u;
+        return *(const uint32_t*)(kvs + (size_t)max(page(t), 0) * A.kv_bs + 2 * HD);
+    };
+
+    D::frag qf[NC];
+    tile_query<HD>(A, Ln, h, qf);
+    Raw kc[NC], kn[NC], vc[NC], vn[NC];
+    uint32_t swc = fetch_sc(0), swn = 0u;
+    fetch(0, 0, kc);
+    fetch(0, HD, vc);
+    r4d_u32x4 bc = tile_bias(A, Ln, blk(0) * kBlock + 8 * h), bn = bc;
+    float m = -INFINITY, l = 0.0f;
+    v8f acc[NC] = {};
+    for (int t = 0; t < nt; ++t) {
+        /* V a column a row; zero where the block is missing or no row has written the key. */
+        const bool zero = page(t) < 0 || blk(t) * kBlock + c >= R.jend;
+#pragma unroll
+        for (int g = 0; g < NC; ++g) {
+            const r4d_u32x4 v = KS::f16(vc[g]);
+#pragma unroll
+            for (int e = 0; e < 8; ++e)
+                sV[v_col(16 * g + 8 * h + e, VSTR) + c] =
+                    zero ? (uint16_t)0 : (uint16_t)(v[e >> 1] >> (16 * (e & 1)));
+        }
+        v8f s = {};
+#pragma unroll
+        for (int g = 0; g < NC; ++g) {
+            const r4d_u32x4 k = KS::bf16(kc[g]);
+            s = D::wmma(D::mk(make_uint2(k[0], k[1]), make_uint2(k[2], k[3])), qf[g], s);
+        }
+        float vs[8] = {};
+        if constexpr (I8) {
+            float ks[8];
+            key_scales(swc, h, 0, ks);
+            key_scales(swc, h, 1, vs);
+#pragma unroll
+            for (int e = 0; e < 8; ++e) s[e] *= ks[e];
+        }
+        const int pg = page(t);
+        if (t + 1 < nt) {
+            fetch(t + 1, 0, kn);
+            fetch(t + 1, HD, vn);
+            swn = fetch_sc(t + 1);
+            bn = tile_bias(A, Ln, blk(t + 1) * kBlock + 8 * h);
+        }
+        float sc[8];
+        tile_scores(A, Ln, s, blk(t) * kBlock + 8 * h, ja, nj, pg < 0, bc, sc);
+        online_block<NC, I8>(m, l, acc, sc, vs, [&](int g) {
+            const r4d_u32x4 u = *(const r4d_u32x4*)&sV[v_col(16 * g + c, VSTR) + 8 * h];
+            return DT16<1>::mk(make_uint2(u[0], u[1]), make_uint2(u[2], u[3]));
+        });
+#pragma unroll
+        for (int g = 0; g < NC; ++g) {
+            kc[g] = kn[g];
+            vc[g] = vn[g];
+        }
+        swc = swn;
+        bc = bn;
+    }
+    l += swap16(l);
+
+    if (!Ln.live) return;
+    if (h == 0) {
+        T.stats[(cell + sp) * 2] = m;
+        T.stats[(cell + sp) * 2 + 1] = l;
+    }
+    float* pp = T.part + (cell + sp) * HD + 8 * h;
+#pragma unroll
+    for (int g = 0; g < NC; ++g) {
+        union { v8f f; r4d_u32x4 w[2]; } u;
+        u.f = acc[g];
+        *(g_wx4)(pp + 16 * g) = u.w[0];
+        *(g_wx4)(pp + 16 * g + 4) = u.w[1];
+    }
+    if (T.done) {
+        __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent");
+        if (h == 0)
+            __hip_atomic_fetch_add(&T.done[query], 1u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+    }
+}
+
+/* A query's spans folded in span order from its sink, sixteen spans' loads ahead: a wave a (row,
+ * head), a lane four columns. */
+template <int HD, bool I8>
+__device__ __forceinline__ void rel_sink_merge_body(RelSinkArgs A, TileArgs T, uint32_t q) {
+    static_assert(HD == 4 * kWave, "a lane four columns");
+    const int heads = A.kv_heads * A.gqa, lane = (int)threadIdx.x;
+    if (q >= (uint32_t)(A.rows * heads)) return;
+    const int tok = (int)(q / (uint32_t)heads), hq = (int)q - tok * heads;
+    const int s = __builtin_amdgcn_readfirstlane(r4d_q_seq(A.cu, A.n_seq, A.q_len, tok));
+    int nsp;
+    if (T.list) {
+        nsp = min(list_spans(T.nlist[tok * A.kv_heads + hq / A.gqa], T.list_span), T.nspan);
+    } else {
+        const int row = tok - __builtin_amdgcn_readfirstlane(r4d_q_off(A.cu, s, A.q_len));
+        TileRows R;
+        tile_rows_of(A, T.wave_rows, s, row / T.wave_rows, R);
+        nsp = min(tile_spans(R), T.nspan);
+    }
+    if (T.done) {
+        if (lane == 0) {
+            while (__hip_atomic_load(&T.done[q], __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) <
+                   (unsigned)nsp)
+                __builtin_amdgcn_s_sleep(1);
+            __hip_atomic_store(&T.done[q], 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+        }
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+    }
+
+    const size_t cell = (size_t)q * T.nspan;
+    const float* pp = T.part + cell * HD + 4 * lane;
+    float M = ld_bf16(A.sinks + (size_t)tok * A.sink_rs + hq), L = 1.0f, o[4] = {};
+    for (int i0 = 0; i0 < nsp; i0 += 16) {
+        r4d_u32x4 w[16];
+        float ms[16], ls[16];
+#pragma unroll
+        for (int u = 0; u < 16; ++u) {
+            const size_t sp = (size_t)min(i0 + u, nsp - 1);
+            w[u] = *(g_x4)(pp + sp * HD);
+            ms[u] = T.stats[(cell + sp) * 2];
+            ls[u] = T.stats[(cell + sp) * 2 + 1];
+        }
+#pragma unroll
+        for (int u = 0; u < 16; ++u) {
+            const Fold f = fold_span(M, L, ms[u], ls[u], i0 + u < nsp);
+#pragma unroll
+            for (int e = 0; e < 4; ++e) o[e] = fold_val(f, o[e], __uint_as_float(w[u][e]));
+        }
+    }
+    const float inv = (I8 ? kVsDown : 1.0f) / L;
+    uint16_t* op = A.out + (size_t)tok * A.out_rs + (size_t)hq * HD + 4 * lane;
+    const uint32_t w0 = bf16x2_rne_nan(o[0] * inv, o[1] * inv);
+    const uint32_t w1 = bf16x2_rne_nan(o[2] * inv, o[3] * inv);
+    *(g_wu32)op = w0;
+    *(g_wu32)(op + 2) = w1;
+    if (A.q8) {
+        const uint16_t xb[4] = { (uint16_t)w0, (uint16_t)(w0 >> 16), (uint16_t)w1,
+                                 (uint16_t)(w1 >> 16) };
+        gate_quant_head(A, tok, hq, lane, xb);
+    }
+}
+
+/* The tile kernel's rows through gate_quant_head, a wave a (row, head). */
+template <class CH>
+__global__ __launch_bounds__(kWave) void rel_sink_gate_quant_kernel(RelSinkArgs A) {
+    if (CH::on) r4d_chain_wait();
+    const int heads = A.kv_heads * A.gqa, lane = (int)threadIdx.x;
+    if (blockIdx.x < (uint32_t)(A.rows * heads)) {
+        const int tok = (int)(blockIdx.x / (uint32_t)heads), hq = (int)blockIdx.x - tok * heads;
+        const uint16_t* op = A.out + (size_t)tok * A.out_rs + (size_t)hq * 128 + 4 * lane;
+        const uint16_t xb[4] = { op[0], op[1], op[2], op[3] };
+        gate_quant_head(A, tok, hq, lane, xb);
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+template <int HD, bool I8, class CH>
+__global__ __launch_bounds__(kWave) void rel_sink_merge_kernel(RelSinkArgs A, TileArgs T) {
+    if (CH::on) r4d_chain_wait();
+    rel_sink_merge_body<HD, I8>(A, T, blockIdx.x);
+    if (CH::on) r4d_chain_done();
+}
+
+/* Rows y < nspan are rel_sink_span_kernel's, the rest merge waves a query each. They are the
+ * grid's last workgroups, so every span they wait on has been dispatched ahead of them. */
+template <int HD, bool I8, bool SP, class CH>
+__global__ __launch_bounds__(kWave) void rel_sink_span_kernel(RelSinkArgs A, TileArgs T) {
+    if (CH::on) r4d_chain_wait();
+    if (blockIdx.y < (uint32_t)T.nspan)
+        rel_sink_span_body<HD, I8, SP>(A, T);
+    else if (T.done)
+        rel_sink_merge_body<HD, I8>(A, T, (blockIdx.y - T.nspan) * gridDim.x + blockIdx.x);
+    if (CH::on) r4d_chain_done();
+}
+
+template <int HD, bool I8>
+__device__ __forceinline__ void rel_sink_tile_body(RelSinkArgs A, TileArgs T) {
+    typedef DT16<0> D;
+    typedef KvSlot<HD, I8> KS;
+    typedef typename KS::Raw Raw;
+    constexpr int NC = HD / 16;
+    constexpr int RT = 4;   /* blocks staged a round, a pass of the workgroup each */
+    constexpr int KSTR = HD + 8, VSTR = RT * kBlock + kColShift;
+    static_assert(HD % 16 == 0 && kTileWaves * kWave == kBlock * 16, "a block a pass");
+    __shared__ __align__(16) uint16_t sK[RT * kBlock * KSTR];
+    __shared__ __align__(16) uint16_t sV[HD * VSTR];
+    __shared__ __align__(16) float sS[RT * 2 * kBlock];   /* I8: K, then V times kVsUp, by key */
+
+    const int tid = (int)threadIdx.x, lane = tid & 31, c = lane & 15, h = lane >> 4;
+    const int wv = __builtin_amdgcn_readfirstlane(tid >> 5);
+    const int kvh = (int)(blockIdx.x % (uint32_t)A.kv_heads);
+    TileRows R;
+    if (!tile_rows(A, kTileWaves * T.wave_rows, (int)(blockIdx.x / (uint32_t)A.kv_heads), R,
+                   T.wg_queries))
+        return;
+    const TileLane Ln = tile_lane(A, T, R, kvh, wv, c);
+    const bool wave_live = wave_any(Ln.live) != 0;
+    const int b0 = Ln.j0 / kBlock, tb0 = R.jF / kBlock;
+    const int tb1 = R.jend > R.jF ? (R.jend - 1) / kBlock : tb0 - 1;
+    const uint32_t nj = (uint32_t)(Ln.j1 - Ln.j0);
+
+    D::frag qf[NC];
+    tile_query<HD>(A, Ln, h, qf);
+    const int* btr = A.bt + (size_t)R.s * A.max_blocks;
+    /* The thread's eight elements of a block's K: key tid % 16, columns 8 (tid / 16) .. + 7. */
+    const int skey = tid & 15, scol = 8 * (tid >> 4);
+    const uint8_t* kvs = A.kv + (size_t)kvh * A.kv_hs + (size_t)skey * KS::BYTES;
+    const uint8_t* kvp = kvs + scol * KS::ESZ;
+
+    /* A round's pages, -1 past the workgroup's blocks, and its K (col0 0) or V (col0 HD). */
+    auto pages = [&](int br, int (&pg)[RT]) {
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl) {
+            const int blk = btr[min(br + tl, tb1)];
+            pg[tl] = br + tl <= tb1 ? blk : -1;
+        }
+    };
+    auto fetch = [&](const int (&pg)[RT], int col0, Raw (&reg)[RT]) {
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl)
+            reg[tl] = KS::load(kvp + (size_t)max(pg[tl], 0) * A.kv_bs + col0 * KS::ESZ);
+    };
+    /* I8: the round's scale words, a key's in its first column's thread. */
+    auto fetch_sc = [&](const int (&pg)[RT], uint32_t (&sw)[RT]) {
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl)
+            sw[tl] = I8 && scol == 0
+                         ? *(const uint32_t*)(kvs + (size_t)max(pg[tl], 0) * A.kv_bs + 2 * HD)
+                         : 0u;
+    };
+    /* Into LDS: K as bf16 (and I8 its scales), V a column a row, zero where the block is missing
+     * or no row has written the key. */
+    auto put_k = [&](int br, const int (&pg)[RT], const Raw (&reg)[RT], const uint32_t (&sw)[RT]) {
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl) {
+            *(r4d_u32x4*)&sK[(tl * kBlock + skey) * KSTR + scol] = KS::bf16(reg[tl]);
+            if (I8 && scol == 0) {
+                const bool zero = pg[tl] < 0 || (br + tl) * kBlock + skey >= R.jend;
+                sS[(2 * tl) * kBlock + skey] = f16_lo(sw[tl]);
+                sS[(2 * tl + 1) * kBlock + skey] = zero ? 0.0f : f16_lo(sw[tl] >> 16) * kVsUp;
+            }
+        }
+    };
+    auto put_v = [&](int br, const int (&pg)[RT], const Raw (&reg)[RT]) {
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl) {
+            const bool zero = pg[tl] < 0 || (br + tl) * kBlock + skey >= R.jend;
+            const r4d_u32x4 v = KS::f16(reg[tl]);
+#pragma unroll
+            for (int e = 0; e < 8; ++e)
+                sV[v_col(scol + e, VSTR) + tl * kBlock + skey] =
+                    zero ? (uint16_t)0 : (uint16_t)(v[e >> 1] >> (16 * (e & 1)));
+        }
+    };
+    /* I8: the K (half 0) or V (half 1) scales of the lane's keys of round slot tl. */
+    auto lds_scales = [&](int tl, int half, float (&sc)[8]) {
+        const float* p = &sS[(2 * tl + half) * kBlock + 8 * h];
+#pragma unroll
+        for (int e = 0; e < 8; ++e) sc[e] = p[e];
+    };
+    /* The lane's scores of block b, round slot tl; `gone` where its page is missing. */
+    auto scores = [&](int tl, int b, bool gone, float (&sc)[8]) {
+        const uint16_t* kr = &sK[(tl * kBlock + c) * KSTR];
+        v8f s = {};
+#pragma unroll
+        for (int g = 0; g < NC; ++g) {
+            const r4d_u32x4 u = *(const r4d_u32x4*)(kr + 16 * g + 8 * h);
+            s = D::wmma(D::mk(make_uint2(u[0], u[1]), make_uint2(u[2], u[3])), qf[g], s);
+        }
+        if constexpr (I8) {
+            float ks[8];
+            lds_scales(tl, 0, ks);
+#pragma unroll
+            for (int e = 0; e < 8; ++e) s[e] *= ks[e];
+        }
+        tile_scores(A, Ln, s, b * kBlock + 8 * h, Ln.j0, nj, gone,
+                    tile_bias(A, Ln, b * kBlock + 8 * h), sc);
+    };
+
+    /* One sweep: a round's K and V in LDS, each block onto the lane's span, and a span folded
+     * onto the row where the next begins. The next round's K and V are in flight under a round's
+     * arithmetic, and its pages a round further ahead. */
+    float M = ld_bf16(A.sinks + (size_t)Ln.tok * A.sink_rs + Ln.hq), L = 1.0f;
+    float m = -INFINITY, l = 0.0f;
+    v8f acc[NC] = {}, tot[NC] = {};
+    auto fold = [&](bool on) {
+        const Fold f = fold_span(M, L, m, l + swap16(l), on);
+#pragma unroll
+        for (int g = 0; g < NC; ++g) {
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                tot[g][e] = fold_val(f, tot[g][e], acc[g][e]);
+                acc[g][e] = on ? 0.0f : acc[g][e];
+            }
+        }
+        m = on ? -INFINITY : m;
+        l = on ? 0.0f : l;
+    };
+    int pg[RT], pgn[RT];
+    Raw kr[RT], vr[RT];
+    uint32_t sw[RT];
+    pages(tb0, pg);
+    fetch(pg, 0, kr);
+    fetch(pg, HD, vr);
+    fetch_sc(pg, sw);
+    for (int br = tb0; br <= tb1; br += RT) {
+        put_k(br, pg, kr, sw);
+        put_v(br, pg, vr);
+        int gone = 0;
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl) gone |= (pg[tl] < 0) << tl;
+        gone = __builtin_amdgcn_readfirstlane(gone);
+        pages(br + RT, pgn);
+        lds_barrier();
+        fetch(pgn, 0, kr);
+        fetch(pgn, HD, vr);
+        fetch_sc(pgn, sw);
+        for (int tl = 0; tl < RT && br + tl <= tb1 && wave_live; ++tl) {
+            const bool bd = span_start(br + tl - b0);
+            if (wave_any(bd)) fold(bd);
+            float sc[8], vs[8] = {};
+            scores(tl, br + tl, (gone >> tl) & 1, sc);
+            if constexpr (I8) lds_scales(tl, 1, vs);
+            auto vread = [&](int g) {
+                const r4d_u32x4 u =
+                    *(const r4d_u32x4*)&sV[v_col(16 * g + c, VSTR) + tl * kBlock + 8 * h];
+                return DT16<1>::mk(make_uint2(u[0], u[1]), make_uint2(u[2], u[3]));
+            };
+            online_block<NC, I8, decltype(vread), true>(m, l, acc, sc, vs, vread);
+        }
+        lds_barrier();
+#pragma unroll
+        for (int tl = 0; tl < RT; ++tl) pg[tl] = pgn[tl];
+    }
+    if (wave_live) fold(true);
+    const float inv = (I8 ? kVsDown : 1.0f) / L;
+#pragma unroll
+    for (int g = 0; g < NC; ++g)
+#pragma unroll
+        for (int e = 0; e < 8; ++e) tot[g][e] *= inv;
+    tile_store<HD>(A, Ln, h, tot);
+}
+
+template <int HD, bool I8, class CH>
+/* Six waves a SIMD fits three workgroups a WGP; the register allocator's own choice, 254 VGPRs,
+ * fits two. */
+__global__ __launch_bounds__(kTileWaves * kWave) __attribute__((amdgpu_waves_per_eu(6, 6)))
+void rel_sink_tile_kernel(RelSinkArgs A, TileArgs T) {
+    if (CH::on) r4d_chain_wait();
+    rel_sink_tile_body<HD, I8>(A, T);
+    if (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ Quest page selection */
+/* libref's ref_kv_page_box and ref_attn_paged_rel_sink_sparse (libref/ref_attn.cpp). A page box
+ * is a kv head's elementwise K range over a page as int8 bounds lo_d s <= K_d <= hi_d s under one
+ * f32 step s; each row of a decode or verify step scores each far page by the bound max over the
+ * kv head's query heads of s / 2 sum_d q_d (lo_d + hi_d) + |q_d| (hi_d - lo_d), keeps the best
+ * sparse_budget / box_page of them with the first page and the recent ones, and the span kernel
+ * reads the row's kept blocks in order, as a one-row step at its position would. The score is
+ * one product of [q, |q|] and [lo + hi, hi - lo] on the matrix cores, which sums in another order
+ * than libref's, so a near tie may keep another page; the selection breaks exact ties to the
+ * lower page. */
+constexpr int kScoreWaves = 4;   /* pages a workgroup scores: 16 a wave */
+constexpr int kSelThr = 1024;
+
+struct SparseArgs {
+    const uint8_t* box;   long long box_ps, box_hs;   /* bytes */
+    const int*      pt;   int pt_pitch;
+    float*          score;  int score_pitch;
+    int*            list;   int list_pitch;
+    int*            nlist;
+    int box_page, per, kpages, reach;
+};
+
+/* Row t's sequence, its position and its first recent page. */
+__device__ __forceinline__ void sparse_row(const RelSinkArgs& A, const SparseArgs& S, int t,
+                                           int& s, int& pos, int& pr) {
+    s = __builtin_amdgcn_readfirstlane(r4d_q_seq(A.cu, A.n_seq, A.q_len, t));
+    const int r0 = __builtin_amdgcn_readfirstlane(r4d_q_off(A.cu, s, A.q_len));
+    const int n = __builtin_amdgcn_readfirstlane(r4d_q_len(A.cu, s, A.q_len));
+    pos = __builtin_amdgcn_readfirstlane(A.su[s]) - n + t - r0;
+    pr = max(pos - S.reach, 0) / S.box_page;
+}
+
+/* A box's step: its largest |K| over 126, so every bound fits int8 with a code to spare. */
+constexpr float kBoxStep = 1.0f / 126.0f;
+
+struct PageBoxArgs {
+    const uint8_t* kv;  long long kv_bs, kv_hs;   /* bytes */
+    const int* bt;      int bt_pitch;
+    const int* su;      const int* cu;
+    int n_seq, q_len, page, kblock;
+    uint8_t* box;       long long box_ps, box_hs;   /* bytes */
+    const int* pt;      int pt_pitch;
+};
+
+/* A workgroup a (completed page, kv head), a thread a column: the column's range, the page's
+ * largest |K| through LDS, then lo the largest code with lo s <= the minimum and hi the smallest
+ * with hi s >= the maximum, found by comparison so the device's division does not decide them. */
+template <int HD, bool I8, class CH>
+__global__ __launch_bounds__(HD) void page_box_kernel(PageBoxArgs A) {
+    __shared__ float wmax[HD / kWave];
+    if (CH::on) r4d_chain_wait();
+    int w = (int)blockIdx.x, s = 0, n = 0, used = 0;
+    for (; s < A.n_seq; ++s) {
+        n = __builtin_amdgcn_readfirstlane(r4d_q_len(A.cu, s, A.q_len));
+        used = __builtin_amdgcn_readfirstlane(A.su[s]);
+        const int c = n > 0 ? used / A.page - (used - n) / A.page : 0;
+        if (w < c) break;
+        w -= c;
+    }
+    const int h = (int)blockIdx.y, d = (int)threadIdx.x;
+    const int p = (used - n) / A.page + w;
+    const int phys = s < A.n_seq ? A.pt[(size_t)s * A.pt_pitch + p] : -1;
+    if (phys >= 0) {
+        constexpr int SLOT = I8 ? 2 * HD + 4 : 4 * HD;
+        float lo = INFINITY, hi = -INFINITY;
+        for (int j = p * A.page; j < (p + 1) * A.page; ++j) {
+            const int blk = A.bt[(size_t)s * A.bt_pitch + j / A.kblock];
+            if (blk < 0) continue;
+            const uint8_t* row = A.kv + (size_t)blk * A.kv_bs + (size_t)h * A.kv_hs +
+                                 (size_t)(j % A.kblock) * SLOT;
+            float x;
+            if constexpr (I8)
+                x = (float)(int8_t)row[d] * f16_lo(*(const uint16_t*)(row + 2 * HD));
+            else
+                x = bf16w_lo(*(const uint16_t*)(row + 2 * d));
+            lo = fminf(lo, x);
+            hi = fmaxf(hi, x);
+        }
+        float mx = lo == INFINITY ? 0.0f : fmaxf(fabsf(lo), fabsf(hi));
+#pragma unroll
+        for (int o = 16; o >= 1; o >>= 1)
+            mx = fmaxf(mx, __int_as_float(__builtin_amdgcn_ds_bpermute(
+                               ((d % (int)kWave) ^ o) << 2, __float_as_int(mx))));
+        if (d % kWave == 0) wmax[d / kWave] = mx;
+        lds_barrier();
+        mx = wmax[0];
+#pragma unroll
+        for (int i = 1; i < HD / (int)kWave; ++i) mx = fmaxf(mx, wmax[i]);
+        const float st = mx * kBoxStep;
+        int ql = 0, qh = 0;
+        if (st > 0.0f && lo != INFINITY) {
+            ql = min(max((int)floorf(lo / st), -127), 127);
+            while (ql < 127 && (float)(ql + 1) * st <= lo) ++ql;
+            while (ql > -127 && (float)ql * st > lo) --ql;
+            qh = min(max((int)ceilf(hi / st), -127), 127);
+            while (qh > -127 && (float)(qh - 1) * st >= hi) --qh;
+            while (qh < 127 && (float)qh * st < hi) ++qh;
+        }
+        uint8_t* o = A.box + (size_t)phys * A.box_ps + (size_t)h * A.box_hs;
+        o[d] = (uint8_t)(int8_t)ql;
+        o[HD + d] = (uint8_t)(int8_t)qh;
+        if (d == 0) *(float*)(o + 2 * HD) = st;
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* A wave sixteen far pages of one (sequence, kv head), each of its rows in turn: D = Q' B^T over
+ * 2 * HD columns, Q' the row's query heads [q, |q|] (sixteen a tile, read where q lies) and B the
+ * pages' boxes as [lo + hi, hi - lo] (exact in bf16), read once for every row, leaves lane (c, h)
+ * queries 8h .. 8h + 7 of page c, and the row's score of the page is their maximum over the tiles,
+ * each times its step over 2. A box is bytes in a bf16 group. No LDS, so a compute unit holds as
+ * many workgroups as its waves allow. */
+template <int HD, class CH>
+__global__ __launch_bounds__(kScoreWaves * kWave) void sparse_score_kernel(RelSinkArgs A,
+                                                                           SparseArgs S) {
+    typedef DT16<0> D;
+    constexpr int KS = 2 * HD / 16;   /* k steps */
+    if (CH::on) r4d_chain_wait();
+    const int s = (int)blockIdx.z, kvh = (int)blockIdx.y, tid = (int)threadIdx.x;
+    const int r0 = __builtin_amdgcn_readfirstlane(r4d_q_off(A.cu, s, A.q_len));
+    const int n = __builtin_amdgcn_readfirstlane(r4d_q_len(A.cu, s, A.q_len));
+    const int pos0 = __builtin_amdgcn_readfirstlane(A.su[s]) - n;
+    const int pr = n > 0 ? max(pos0 + n - 1 - S.reach, 0) / S.box_page : 0;
+    const int nq = A.gqa;
+    const int lane = tid % kWave, c = lane & 15, h = lane >> 4;
+    const int p = 1 + ((int)blockIdx.x * kScoreWaves + tid / kWave) * 16 + c;
+    if (pr - 1 > S.kpages && wave_any(p < pr)) {
+        const int phys = p < pr ? S.pt[(size_t)s * S.pt_pitch + p] : -1;
+        D::frag bf[KS];
+        const uint8_t* bp = S.box + (size_t)max(phys, 0) * S.box_ps + (size_t)kvh * S.box_hs;
+        const float half_step = phys >= 0 ? 0.5f * *(const float*)(bp + 2 * HD) : 0.0f;
+#pragma unroll
+        for (int g = 0; g < KS / 2; ++g) {
+            const uint32_t* lw = (const uint32_t*)(bp + 16 * g + 8 * h);
+            const uint32_t* hw = (const uint32_t*)(bp + HD + 16 * g + 8 * h);
+            const uint32_t l0 = phys >= 0 ? lw[0] : 0u, l1 = phys >= 0 ? lw[1] : 0u;
+            const uint32_t h0 = phys >= 0 ? hw[0] : 0u, h1 = phys >= 0 ? hw[1] : 0u;
+            uint32_t cw[4], rw[4];
+#pragma unroll
+            for (int e = 0; e < 4; ++e) {
+                const uint32_t lu = e < 2 ? l0 : l1, hu = e < 2 ? h0 : h1;
+                const int sh = 16 * (e & 1);
+                const int la = (int8_t)(lu >> sh), lb = (int8_t)(lu >> (sh + 8));
+                const int ha = (int8_t)(hu >> sh), hb = (int8_t)(hu >> (sh + 8));
+                cw[e] = (__float_as_uint((float)(la + ha)) >> 16) |
+                        (__float_as_uint((float)(lb + hb)) & 0xffff0000u);
+                rw[e] = (__float_as_uint((float)(ha - la)) >> 16) |
+                        (__float_as_uint((float)(hb - lb)) & 0xffff0000u);
+            }
+            bf[g] = D::mk(make_uint2(cw[0], cw[1]), make_uint2(cw[2], cw[3]));
+            bf[KS / 2 + g] = D::mk(make_uint2(rw[0], rw[1]), make_uint2(rw[2], rw[3]));
+        }
+        for (int r = 0; r < n; ++r) {
+            const int t = r0 + r, pr_r = max(pos0 + r - S.reach, 0) / S.box_page;
+            if (pr_r - 1 <= S.kpages) continue;
+            float best = -INFINITY;
+            for (int q0 = 0; q0 < nq; q0 += 16) {
+                const int j = min(q0 + c, nq - 1);
+                const uint16_t* qp =
+                    A.q + (size_t)t * A.q_rs + (size_t)(kvh * A.gqa + j) * HD + 8 * h;
+                v8f acc = {};
+#pragma unroll
+                for (int g = 0; g < KS; ++g) {
+                    r4d_u32x4 u = *(g_x4)(qp + (16 * g) % HD);
+                    if (g >= KS / 2)
+#pragma unroll
+                        for (int e = 0; e < 4; ++e) u[e] &= 0x7fff7fffu;
+                    acc = D::wmma(D::mk(make_uint2(u[0], u[1]), make_uint2(u[2], u[3])), bf[g],
+                                  acc);
+                }
+#pragma unroll
+                for (int e = 0; e < 8; ++e)
+                    if (q0 + 8 * h + e < nq) best = fmaxf(best, acc[e] * half_step);
+            }
+            best = fmaxf(best, swap16(best));
+            if (h == 0 && p < pr_r)
+                S.score[(size_t)(t * A.kv_heads + kvh) * S.score_pitch + p] =
+                    phys >= 0 ? best : -INFINITY;
+        }
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* Orders floats as unsigned integers, -0 with +0. */
+__device__ __forceinline__ uint32_t score_key(float f) {
+    const uint32_t u = __float_as_uint(f == 0.0f ? 0.0f : f);
+    return (u >> 31) ? ~u : u | 0x80000000u;
+}
+
+/* Exclusive prefix sum of `v` over the workgroup, in thread order; `tot` the whole sum. `sh`
+ * holds a word a wave. */
+__device__ __forceinline__ int block_scan(int* sh, int v, int& tot) {
+    const int tid = (int)threadIdx.x, lane = tid % kWave, w = tid / kWave;
+    int inc = v;
+#pragma unroll
+    for (int o = 1; o < (int)kWave; o <<= 1) {
+        const int x = __builtin_amdgcn_ds_bpermute(max(lane - o, 0) << 2, inc);
+        if (lane >= o) inc += x;
+    }
+    if (lane == kWave - 1) sh[w] = inc;
+    lds_barrier();
+    int base = 0;
+    tot = 0;
+    for (int i = 0; i < kSelThr / (int)kWave; ++i) {
+        base += i < w ? sh[i] : 0;
+        tot += sh[i];
+    }
+    lds_barrier();
+    return base + inc - v;
+}
+
+/* A workgroup a (kv head, sequence): the kept blocks, in order. The budget's smallest score is
+ * found a byte at a time from the top (the first 256 threads a histogram bin each), and the pages
+ * above it and as many at it as the budget leaves, the lowest first, are kept. */
+template <class CH>
+__global__ __launch_bounds__(kSelThr) void sparse_select_kernel(RelSinkArgs A, SparseArgs S) {
+    __shared__ uint32_t hist[256];
+    __shared__ int wsum[kSelThr / kWave];
+    __shared__ uint32_t pick[2];
+    static_assert(kSelThr >= 256, "a thread a histogram bin");
+    if (CH::on) r4d_chain_wait();
+    const int kvh = (int)blockIdx.x, t = (int)blockIdx.y, tid = (int)threadIdx.x;
+    int s, pos, pr;
+    sparse_row(A, S, t, s, pos, pr);
+    const int nblk = min((pos + kBlock) / kBlock, A.max_blocks);
+    const size_t cell = (size_t)(t * A.kv_heads + kvh);
+    int* out = S.list + cell * S.list_pitch;
+    if (pr - 1 <= S.kpages) {
+        for (int b = tid; b < nblk; b += kSelThr) out[b] = b;
+        if (tid == 0) S.nlist[cell] = nblk;
+        if (CH::on) r4d_chain_done();
+        return;
+    }
+    const float* sc = S.score + cell * S.score_pitch + 1;
+    const int nf = pr - 1, chunk = (nf + kSelThr - 1) / kSelThr;
+    const int i0 = min(tid * chunk, nf), i1 = min(i0 + chunk, nf);
+
+    uint32_t prefix = 0, mask = 0, rem = (uint32_t)S.kpages;
+    int tot = 0;
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        if (tid < 256) hist[tid] = 0;
+        lds_barrier();
+        for (int i = tid; i < nf; i += kSelThr) {
+            const uint32_t k = score_key(sc[i]);
+            if ((k & mask) == prefix) atomicAdd(&hist[(k >> shift) & 255u], 1u);
+        }
+        lds_barrier();
+        const int hv = tid < 256 ? (int)hist[255 - tid] : 0;
+        const int inc = block_scan(wsum, hv, tot) + hv;
+        if (inc >= (int)rem && inc - hv < (int)rem) {
+            pick[0] = prefix | ((uint32_t)(255 - tid) << shift);
+            pick[1] = rem - (uint32_t)(inc - hv);
+        }
+        lds_barrier();
+        prefix = pick[0];
+        rem = pick[1];
+        mask |= 255u << shift;
+        lds_barrier();
+    }
+
+    int gt = 0, eq = 0;
+    for (int i = i0; i < i1; ++i) {
+        const uint32_t k = score_key(sc[i]);
+        gt += k > prefix;
+        eq += k == prefix;
+    }
+    const int eq_before = block_scan(wsum, eq, tot);
+    const int take_eq = min(max((int)rem - eq_before, 0), eq);
+    const int at = block_scan(wsum, gt + take_eq, tot);
+
+    const int per = S.per;
+    int o = per + at * per, seen = 0;
+    for (int i = i0; i < i1; ++i) {
+        const uint32_t k = score_key(sc[i]);
+        const bool take = k > prefix || (k == prefix && seen++ < take_eq);
+        if (!take) continue;
+        for (int b = 0; b < per; ++b) out[o + b] = (i + 1) * per + b;
+        o += per;
+    }
+    if (tid < per) out[tid] = tid;
+    const int rc = per + S.kpages * per;
+    for (int b = pr * per + tid; b < nblk; b += kSelThr) out[rc + b - pr * per] = b;
+    if (tid == 0) S.nlist[cell] = rc + nblk - pr * per;
+    if (CH::on) r4d_chain_done();
+}
