+/* logit_softcap from a bf16 column slice into an f32 one (a gated feed-forward capping each half
+ * of its bf16 projection into an f32 buffer), the columns beside the slice left alone. */
+void softcap_bf16_f32_case(const Plugin& pl) {
+    const RadKernelInfo* r = find(pl, "logit_softcap_f32");
+    if (!r) { ok("logit_softcap_f32 from bf16", false, "row absent"); return; }
+    const int64_t M = 33, n = 1152, ld = 2 * n;
+    const double cap = 4.0;
+    std::vector<float> x = randv((size_t)(M * ld), 12.0f);
+    void* dx = up_bf16(x);
+    void* dy = up_f32(std::vector<float>((size_t)(M * ld), -7.5f));
+    RadTensor tx = T((uint16_t*)dx + n, RAD_BF16, { M, n });
+    RadTensor ty = T((float*)dy + n, RAD_F32, { M, n });
+    tx.stride[0] = ty.stride[0] = ld;
+    const int rc = launch(r, { tx, ty }, { PI("M", M), PI("n", n), PF("cap", cap),
+                                           PS("dtype", "f32") });
+    if (rc != RAD_OK) { ok("logit_softcap_f32 from bf16", false, "rc " + std::to_string(rc)); return; }
+    const std::vector<float> got = down_f32(dy, (size_t)(M * ld));
+    std::vector<float> have, want;
+    bool spilled = false;
+    for (int64_t m = 0; m < M; ++m)
+        for (int64_t i = 0; i < ld; ++i) {
+            const float g = got[(size_t)(m * ld + i)];
+            if (i < n) { spilled = spilled || g != -7.5f; continue; }
+            have.push_back(g);
+            want.push_back((float)(cap * std::tanh((double)x[(size_t)(m * ld + i)] / cap)));
+        }
+    check_f32("logit_softcap_f32 from a bf16 column slice numerics", have, want, 1e-5);
+    ok("logit_softcap_f32 leaves the columns beside the slice alone", !spilled);
+}
