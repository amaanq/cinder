+                                             RAD_INT("stop", stop), RAD_STR("dtype", "bf16"),
+                                             RAD_INT("fold_i8", fold_i8)),
+                                  score_w, w_ids ? 4 : 2 + (int)fold_i8),
+                              {dlog, walk}, {wins_part});
+            if (!op_wscore[l]) return RAD_E_INVAL;
+        }
+        if (g.world > 1) op_wgather = rw(b, RAD_OP(b, "all_gather",
+                            RAD_PARAMS(RAD_INT("world_size", g.world),
+                                       RAD_RANGE("numel", 2 * slots, g.max_seqs * 2 * slots),
+                                       RAD_STR("dtype", "f32"), RAD_INT("row", 2 * slots)),
+                            RAD_NOWEIGHTS),
+                        {wins_part}, {wins});
+        if (g.world > 1 && !op_wgather) return RAD_E_INVAL;
+    }
+
+    RadDrafterDecl drf{};
+    drf.name           = "dspark";
+    drf.kind           = RAD_DRAFT_BLOCK;
+    drf.depth          = bc->max_spec;
+    drf.block          = block;
+    drf.proposal       = tokens;
+    drf.proposal_pitch = steps;
+    drf.mask_token     = mask_id;
+    RAD_ARCH_TRY(rad_declare_drafter(b, &drf));
+    RAD_ARCH_TRY(rad_drafter_kept(b, kept));
+    rad_note(b, "inkling2loop: DSpark drafter, %lld layers at %d..%d (%d local, window %lld), "
+                "%lld heads / %lld kv x %lld, ffn %lld, %d taps; a block of %lld proposes %lld "
+                "tokens through a rank-%lld recurrent head",
+             (long long)g.n_layer, base, base + (int)g.n_layer - 1, n_local, (long long)swa,
+             (long long)g.n_head, (long long)g.n_head_kv, (long long)hd, (long long)F, n_tap,
+             (long long)block, (long long)steps, (long long)rank);
+    return RAD_OK;
+}
+
+inline void Dspark::tap(RadCtx* c, int v, int64_t T) const {
+    if (!on) return;
+    const int64_t E = g.n_embd;
+    for (int i = 0; i + 1 < n_tap; ++i)
+        if (visit[i] == v)
+            RAD_ISSUE(c, op_tap, brows(t.x, T), bcol(src, i * E, E, T));
+}
+
+inline void Dspark::tap_final(RadCtx* c, int64_t T) const {
+    if (!on) return;
+    const int64_t E = g.n_embd;
+    RAD_ISSUE(c, op_final_mix, bcol(t.states, 0, t.n_state * E, T), brows(t.x, T),
+              RAD_W(t.final_query), bcol(t.mix, 0, E, T));
+    RAD_ISSUE(c, op_final_norm, bcol(t.mix, 0, E, T), RAD_W(t.out_norm),
+              bcol(src, (n_tap - 1) * E, E, T));
+}
+
+inline void Dspark::context(RadCtx* c, const RadBatch* batch) const {
+    const int64_t T = batch->n_tok;
+    if (T <= 0) return;
+    const RadKVGroupBatch* kvb = kv_batch(batch, kv);
+    const RadOperand slot = praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T);
+    const RadOperand pos = praw(batch->positions, RAD_I32, T);
+    const int64_t L = g.n_layer;
+    for (int i = 0; i < (int)L; ++i) {
+        RAD_ISSUE(c, op_cmix[i], brows(src, T), RAD_W(w_fuse[i]), RAD_W(w_cnorm[i]),
+                  brows(ctx, T));
+        RAD_ISSUE(c, op_ck[i], brows(ctx, T), RAD_W(w_kc[i]), brows(ck, T));
+        RAD_ISSUE(c, op_cv[i], brows(ctx, T), RAD_W(w_vc[i]), brows(cv, T));
+        RAD_ISSUE_N(c, op_ckn[i], T * g.n_head_kv, brows(ck, T), RAD_W(w_kcn[i]), brows(ck, T));
+        RAD_ISSUE(c, op_crope, brows(ck, T), pos);
+        RAD_ISSUE(c, op_cstore, brows(ck, T), brows(cv, T), slot, kv_cache(kv, base + i));
+    }
+    RAD_ISSUE(c, op_cmix[L], brows(src, T), RAD_W(w_fuse[L]), RAD_W(w_mnorm), brows(frnn, T));
+}
+
+inline void Dspark::step(RadCtx* c, const RadBatch* batch) const {
+    const int64_t T = batch->n_tok, S = batch->n_out, n = batch->n_seq;
+    if (T <= 0 || S <= 0) return;
+    if (!batch->anchor_rows) {
+        rad_step_fail(c, "inkling2loop: the drafter's query pass carries no anchor rows "
+                         "(RadBatch::anchor_rows), where its recurrent head reads the context");
+        return;
+    }
+    const RadKVGroupBatch* kvb = kv_batch(batch, kv);
+    const RadOperand slot = praw(kvb ? kvb->slot_mapping : nullptr, RAD_I32, T);
+    const RadOperand pos = praw(batch->positions, RAD_I32, T);
+    const RadOperand ids = praw(batch->token_ids, RAD_I32, T);
+    auto lin = [&](rad_op op, rad_weight w, rad_weight ws, RadOperand in, RadOperand out) {
+        if (ws) RAD_ISSUE(c, op, in, RAD_NONE, RAD_W(w), RAD_W(ws), out, RAD_NONE, RAD_NONE);
+        else RAD_ISSUE(c, op, in, RAD_W(w), out);
+    };
+
+    RAD_ISSUE(c, op_embed, ids, RAD_W(t.tok), brows(x, T));
+    RAD_ISSUE(c, op_enorm, brows(x, T), RAD_W(t.tok_norm), brows(x, T));
+    RAD_ISSUE(c, op_fill, ids, RAD_W(w_mask), brows(x, T));
+    RAD_ISSUE(c, op_in0, brows(x, T), RAD_W(w_in[0]), brows(h, T));
+    for (int i = 0; i < (int)g.n_layer; ++i) {
+        if (i > 0)
+            RAD_ISSUE(c, op_in[i], brows(o, T), brows(x, T), RAD_W(w_in[i]), brows(h, T),
+                      brows(x, T));
+        lin(op_q[i], w_q[i], w_q_s[i], brows(h, T), brows(q, T));
+        lin(op_k[i], w_k[i], w_k_s[i], brows(h, T), brows(k, T));
+        lin(op_v[i], w_v[i], w_v_s[i], brows(h, T), brows(v, T));
+        /* The block's own K and V go past `seqused`, which is how every row sees its block; the
+         * next context pass overwrites them. */
+        if (op_qkr[i]) {
+            RAD_ISSUE_N(c, op_qkr[i], T, brows(q, T), brows(k, T), brows(v, T), pos,
+                        RAD_W(w_qn[i]), RAD_W(w_kn[i]), slot, kv_cache(kv, base + i));
+        } else {
+            RAD_ISSUE_N(c, op_qn[i], T * g.n_head, brows(q, T), RAD_W(w_qn[i]), brows(q, T));
+            RAD_ISSUE_N(c, op_kn[i], T * g.n_head_kv, brows(k, T), RAD_W(w_kn[i]), brows(k, T));
+            RAD_ISSUE(c, op_qrope, brows(q, T), pos);
+            RAD_ISSUE(c, op_krope, brows(k, T), pos);
+            RAD_ISSUE(c, op_store, brows(k, T), brows(v, T), slot, kv_cache(kv, base + i));
+        }
+        RAD_ISSUE_N(c, local[i] ? op_attn_local : op_attn_full, batch->max_q_len, brows(q, T),
+                    kv_cache(kv, base + i),
+                    praw2(kvb ? kvb->block_table : nullptr, RAD_I32, n,
+                          kvb ? kvb->block_table_pitch : 0),
+                    praw(kvb ? kvb->seqused : nullptr, RAD_I32, n), RAD_NONE, RAD_NONE,
+                    praw(batch->cu_seqlens, RAD_I32, n + 1), brows(attn, T));
+        lin(op_o[i], w_o[i], w_o_s[i], brows(attn, T), brows(o, T));
+        if (op_ar) RAD_ISSUE_N(c, op_ar, T * g.n_embd, brows(o, T), RAD_NONE);
+        RAD_ISSUE(c, op_post[i], brows(o, T), brows(x, T), RAD_W(w_post[i]), brows(h, T),
+                  brows(x, T));
+        lin(op_gu[i], w_gu[i], w_gu_s[i], brows(h, T), brows(gu, T));
+        RAD_ISSUE(c, op_act, brows(gu, T), brows(ff, T));
+        lin(op_dn[i], w_dn[i], w_dn_s[i], brows(ff, T), brows(o, T));
+        if (op_ar) RAD_ISSUE_N(c, op_ar, T * g.n_embd, brows(o, T), RAD_NONE);
+    }
+    RAD_ISSUE(c, op_norm, brows(o, T), brows(x, T), RAD_W(w_norm), brows(h, T), brows(x, T));
+
+    RAD_ISSUE_N(c, op_sel, S, brows(h, T), praw(batch->out_ids, RAD_I32, S), brows(hsel, S));
+    RAD_ISSUE_N(c, op_fsel, n, RAD_B(frnn), praw(batch->anchor_rows, RAD_I32, n), brows(fsel, n));
+    const RadOperand card = praw(batch->seq_ids, RAD_I32, n);
+    auto wstep = [&](int l) {
+        if (couple_draws)
+            RAD_ISSUE_N(c, op_wstep[l], n, brows(wins, n), brows(hsel, S), brows(fsel, n), ids,
+                        RAD_W(w_proj), RAD_W(w_pbias), RAD_W(w_embed), RAD_B(walk),
+                        brows(tokens, n), brows(kept, n), card, brows(couple_draws, n),
+                        RAD_B(couple_state));
+        else
+            RAD_ISSUE_N(c, op_wstep[l], n, brows(wins, n), brows(hsel, S), brows(fsel, n), ids,
+                        RAD_W(w_proj), RAD_W(w_pbias), RAD_W(w_embed), RAD_B(walk),
+                        brows(tokens, n), brows(kept, n));
+    };
+    const RadOperand fold_s = w_fold_s ? RAD_W(w_fold_s) : RAD_NONE;
+    /* The first step reads the anchor and the context, not the logits, so it goes ahead of them
+     * and its launches can overlap the lm_head pass. */
+    if (phased) wstep(0);
+    RAD_ISSUE_N(c, op_logits, S, brows(hsel, S), RAD_W(w_head), brows(dlog, S));
+    if (!phased && couple_draws) {
+        RAD_ISSUE_N(c, op_walk, n, brows(dlog, S), brows(hsel, S), brows(fsel, n), ids,
+                    RAD_W(w_proj), RAD_W(w_pbias), RAD_W(w_embed), RAD_W(w_fold),
+                    RAD_W(w_fold_b), brows(tile_score, n), brows(tile_token, n), brows(tokens, n),
+                    brows(kept, n), card, brows(couple_draws, n), RAD_B(couple_state), fold_s,
+                    w_ids ? RAD_W(w_ids) : RAD_NONE);
+        return;
+    }
+    if (!phased) {
+        RAD_ISSUE_N(c, op_walk, n, brows(dlog, S), brows(hsel, S), brows(fsel, n), ids,
+                    RAD_W(w_proj), RAD_W(w_pbias), RAD_W(w_embed), RAD_W(w_fold),
+                    RAD_W(w_fold_b), brows(tile_score, n), brows(tile_token, n), brows(tokens, n),
+                    brows(kept, n), fold_s, w_ids ? RAD_W(w_ids) : RAD_NONE);
+        return;
+    }
+    for (int l = 0; l <= (int)block - 1; ++l) {
+        if (l > 0) wstep(l);
+        if (l == (int)block - 1) break;
+        RAD_ISSUE_N(c, op_wscore[l], n, brows(dlog, S), RAD_B(walk), RAD_W(w_fold),
+                    RAD_W(w_fold_b), brows(wins_part, n), fold_s,
+                    w_ids ? RAD_W(w_ids) : RAD_NONE);
+        if (op_wgather)
+            RAD_ISSUE_N(c, op_wgather, n * 2 * slots, brows(wins_part, n), brows(wins, n));
+    }
+}
+
+}  /* namespace inkling2loop */
+
+#endif /* INKLING2LOOP_DSPARK_H */
diff --git a/arch/inkling2loop/inkling2loop.cpp b/arch/inkling2loop/inkling2loop.cpp
new file mode 100644
index 0000000000..d77ef39502
--- /dev/null
+++ b/arch/inkling2loop/inkling2loop.cpp
@@ -0,0 +1,2081 @@ static bool tap_on() {
+/* inkling2loop -- Thinking Machines' Inkling 2 Mini (`inkling2_loop`): bf16 weights, the experts
+ * in bf16 or as released, the attention's large linears and the lm_head in bf16 or quantised by
+ * a recipe.
+ *
+ * The text model: the embedding, the layers below `loop_config.core_start` once, the layers up
+ * to `core_end` `num_passes` times, the rest once, then a mix of the block states, the final norm,
+ * the lm_head and its softcap. The vision tower is not declared; the DSpark drafter is, when the
+ * container carries it and the serve speculates (dspark.h).
+ *
+ * ============================== ONE LAYER ==============================
+ *
+ * Layers come in blocks of `n_layers_per_attn_res_block`; a block's first layer appends its input
+ * to the token's block states. A layer reads its inputs through `depth_mix`, a softmax over the
+ * block states and the current state against a learned query:
+ *
+ *   attention   q, k and v from the mixed input (layer 0: the embedding itself), each head of q
+ *               and k clipped in L2, v normed with no gain; k and v pass a short causal
+ *               convolution first. Scores add a bias by backward distance that the query row
+ *               projects, and a sink logit it projects too. The output is gated by a sigmoid of
+ *               the input, projected, and convolved.
+ *   residual    the block's first layer starts the stream again from its attention output; the
+ *               others add it to their input. f32 from here to the layer's end.
+ *   experts     top-8 of 128 by sigmoid routing over the mixed residual, each
+ *               down(softcap(g) * sigmoid(g) * softcap(u)), then convolved and added.
+ *
+ * A local layer (`local_layer_ids`) attends within `sliding_window_size`, mixes one input and
+ * convolves k and v with fixed taps. A global one attends to everything, mixes and norms q, k and
+ * v apart, and adds taps projected from each token to the convolution's.
+ *
+ * The reference rounds to bf16 wherever it stores a bf16 tensor, and the buffers here follow it:
+ * what it keeps in f32 (the mixes, the gate, the residual) is an f32 buffer, and each cast is one
+ * of its stores. A convolution's f32 sum and scale stay inside its op, which stores the rounded
+ * result.
+ *
+ * ============================== THE LOOP ==============================
+ *
+ * Every pass over the looped layers starts again from the output of the layers before them. A pass
+ * after the first reads the one before through messages: each layer mixes the earlier pass's block
+ * states past its first and its output (`depth_mix` again, four queries a layer) into one message
+ * each for q, k, v and the experts' input. A message enters its input through `message_gate`,
+ * whose two gates are projections of a rank-`gate_rank` state of the normed input and message.
+ * Each application of a layer keeps its own keys, values and convolution windows: the first pass in
+ * the layer's slot, pass p > 0 in slot n_layer + (p - 1) * (core_end - core_start) + (l -
+ * core_start), which is the reference's cache layout.
+ *
+ * The embedding has `vocab_size` rows (201024) and the lm_head `unpadded_vocab_size` (200058, the
+ * tokenizer's size). The core samples over `vocab_size` columns, so the logits row is that wide
+ * and the columns the head does not produce hold -inf.
+ *
+ * ============================== THE EXPERTS ==============================
+ *
+ * The release stores a layer's experts as NVIDIA ModelOpt wrote them: NVFP4 (e2m1 codes, an E4M3
+ * scale per 16 inputs, one f32 scale an expert) in most layers and MXFP8 (E4M3 values, a power of
+ * two per 32 inputs) in the last few. A container holds them as stored and `moe_gemm_q` reads
+ * them at `nvfp4a16` and `mxfp8a16`; a bf16 dump of the transformers model takes `moe_gemm`. The
+ * release's `hf_quant_config.json` also asks for the experts' inputs quantised on the same grids
+ * (`required_activation_quantization`). The transformers reference multiplies bf16 inputs, and so
+ * does this.
+ *
+ * ============================== THE DENSE LINEARS ==============================
+ *
+ * q, k, v, the relative-position, output-gate and output projections are LinearFP8s
+ * (arch/common/rad_fp8.h): bf16 as converted, or a rotated int8 grid (`i8*bf16[1x128]/fwht128`,
+ * IQ8R, or an IQR form, docs/IQR.md) served at i8a8h. With a rotated layer 0 q every norm in
+ * front of them and the gated attention output are quantised once by had_quant_act_i8g, and the
+ * linears read those codes. The sink (24 rows, and an int8 linear takes rows in 16s), the
+ * convolutions' taps and the message gates stay bf16. The lm_head is whatever logits_gemm reads,
+ * bf16 or int8 with a bf16 scale a (row, 128).
+ *
+ * ============================== TENSOR PARALLEL ==============================
+ *
+ * A rank holds its share of the attention heads (q, k, v, the relative states, the sinks, the
+ * output gate and the k and v convolutions, which are per channel), of every expert's
+ * intermediate width, and of the vocabulary. Everything over the stream (the mixes, the messages,
+ * the norms, the router, the two convolutions over the stream) is replicated. The output
+ * projection and the experts' down projection leave partial sums in `branch`, and an all-reduce
+ * a branch completes it before its convolution: two a layer application, 96 a step. Neither
+ * merges into the next: what follows each sum reads it through a softmax mix and a norm.
+ */
+#include <arch/rad_arch.h>
+#include <arch/rad_block_glm_router.h>
+#include <arch/rad_calib_full.h>
+#include <arch/rad_fp8.h>
+
+#include "dspark.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace inkling2loop {
+
+using namespace rad::arch;
+
+/* A short causal convolution and what follows it: y = (conv(x) + x) / sqrt(taps + 1), computed
+ * in f32 and rounded to bf16, then added to a skip row where one follows. `lin` and `taps` are k's
+ * or v's projections in front of it. */
+struct ShortConv {
+    LinearFP8  lin{};
+    rad_weight w_taps = 0, w = 0;
+    rad_op op_taps = 0, op_conv = 0;
+    rad_op op_ar = 0;   /* the all-reduce of `x` in front of the convolution, in its launch */
+    rad_op op_ar_g = 0; /* and moe_gather in front of that */
+};
+
+/* What admits a message into one input of a looped layer. */
+struct Gate {
+    rad_weight w_down = 0, w_forget = 0, w_admit = 0;
+    rad_op     op = 0;
+};
+
+/* One projection of a layer's experts. bf16: `w[0]` is the first of n_expert consecutive handles.
+ * Block-scaled: `w[q]` and `scale[q]` are the first codes and scale views of the experts of parity
+ * q, a run each, the two tables `moe_gemm_q` takes. */
+struct Experts {
+    rad_weight  w[2] = {}, scale[2] = {};
+    rad_op      op = 0;
+    int64_t     group = 0;         /* inputs a scale covers, 0 for bf16 */
+    const char* dtype = nullptr;   /* `moe_gemm_q`'s name for the form */
+};
+
+struct Layer {
+    bool local = false, boundary = false;
+    /* Block states the attention's mix reads; the experts' reads one more in a block's first
+     * layer. */
+    int  n_state = 0;
+
+    rad_weight w_in_query = 0, w_norm[3] = {}, w_q_scale = 0;
+    rad_weight w_rel_scale = 0, w_rel_proj = 0, w_sink = 0;
+    LinearFP8  lin_q{}, lin_rel{}, lin_gate{}, lin_out{};
+    rad_weight w_ffn_query = 0, w_ffn_norm = 0;
+    Experts    gate_up{}, down{};
+    rad_weight w_msg_query = 0;
+    ShortConv  k{}, v{}, attn_conv{}, ffn_conv{};
+    Gate       gate[4]{};   /* q, k, v, the experts */
+    GlmRouter  router{};
+
+    rad_op op_in_mix = 0, op_norm[3] = {}, op_quant[3] = {}, op_q_clip = 0, op_rel_clip = 0;
+    rad_op op_norm_quant[3] = {};   /* op_norm and op_quant in one launch, where it resolves */
+    rad_op op_norm_sites = 0;       /* the three op_norm_quant in one launch, for op_qkvg */
+    rad_op op_mix_quant = 0;        /* op_in_mix and its sites' op_norm_quant, for op_qkvg */
+    rad_op op_rst = 0;              /* lin_rel, op_sink and the taps in one launch, for op_prep */
+    rad_op op_gate_quant = 0;       /* op_gate_mul, op_gate_narrow and op_quant_attn */
+    rad_op op_attn_gq = 0;          /* op_attn and op_gate_quant in one op, at decode heights */
+    rad_op op_gates = 0;            /* gate[0..2] as one message_gate_sites, for op_qkvg */
+    rad_op op_sink = 0, op_k_clip = 0, op_v_norm = 0, op_store = 0, op_attn = 0, op_box = 0;
+    rad_op op_attn_dense = 0;
+    rad_op op_gate_mul = 0, op_gate_narrow = 0, op_quant_attn = 0, op_attn_ar = 0, op_state = 0;
+    rad_op op_ffn_mix = 0, op_ffn_norm = 0, op_scatter = 0, op_route = 0, op_cap_gate = 0;
+    rad_op op_route_gemm = 0;   /* the router's projection, selection and sort in one launch */
+    rad_op op_route_norm = 0;   /* and op_ffn_norm in front of it */
+    rad_op op_cap_up = 0, op_act = 0, op_act_mul = 0, op_glu = 0, op_gather = 0, op_ffn_ar = 0;
+    /* gate_up, the activation and down in one launch, for steps of up to `ffn_rows` tokens. */
+    rad_op op_ffn = 0;
+    int64_t ffn_rows = 0;
+    rad_op op_msg = 0, op_tap = 0, op_tap_ids = 0, op_tap_ew = 0, op_rel_pick = 0;
+    /* The calibration inputs of q (with rel and the gate), k, v and the output, -1 where this run
+     * records none. Every application of a looped layer adds to its stored weights' one Hessian. */
+    int cs[3] = { -1, -1, -1 }, cs_o = -1;
+    /* Steps of up to `fused_rows` tokens: q, the relative states, the sinks, the gate, k and v
+     * (and a global layer's taps) in a few launches, from a site input each. */
+    struct Proj {
+        rad_op op = 0;
+        int    n = 0, seg[8] = {};
+    } proj[4];
+    int n_proj = 0;
+    rad_op op_prep = 0;   /* the clips, the convolutions, v's norm and the store */
+    rad_op op_qkvg = 0;   /* q, the gate, k and v as one gemm_nt_q_multi, to `multi_rows` */
+    rad_op op_out_ar = 0;   /* lin_out and attn_conv's op_ar in one op, to 8 rows */
+    rad_op op_ffn_push = 0;   /* op_ffn and ffn_conv's op_ar_g in one op, to 8 rows */
+};
+
+struct Model {
+    Names   nm{""};
+    Geom    g{};
+    int64_t n_head_vocab = 0, n_expert = 0, top_k = 0;
+    int     core_start = 0, core_end = 0, n_pass = 0;
+    int     n_bank = 0;   /* block states of a pass that the next one's messages read */
+    int64_t route_rows = 0;   /* the most tokens op_route sorts */
+    int64_t rel_n = 0;        /* this rank's relative-state columns, its heads' */
+    double  softcap = 0.0;
+
+    rad_kvgroup kv_local = 0, kv_global = 0, kv_conv = 0, kv_conv_x = 0;
+    /* RADIANCE_INKLING2_SPARSE=TOKENS: the global layers' decode and verify steps attend to a
+     * Quest selection of that many tokens of far pages (attn_paged_rel_sink_sparse) besides the
+     * first page and the last RADIANCE_INKLING2_SPARSE_LAST (default 2048) tokens, from K boxes
+     * of RADIANCE_INKLING2_SPARSE_PAGE (default 16) tokens kept in `kv_box`. Approximate. */
+    rad_kvgroup kv_box = 0;
+    int64_t sparse_budget = 0, sparse_last = 0, sparse_page = 0;
+
+    rad_buf b_x = 0, b_states = 0, b_mix = 0, b_h = 0, b_q = 0, b_lin = 0, b_taps = 0;
+    rad_buf b_k = 0, b_v = 0, b_rel = 0, b_rel_all = 0, b_sink = 0, b_attn = 0, b_gate = 0;
+    rad_buf b_gated = 0, b_o = 0, b_res = 0;
+    rad_buf b_logits_r = 0, b_ids = 0, b_ew = 0, b_sorted = 0, b_eoff = 0, b_ecnt = 0;
+    rad_buf b_egu = 0, b_cap = 0, b_eff = 0, b_edn = 0;
+    rad_buf b_bank = 0, b_prev = 0, b_msg = 0, b_msg_rank = 0, b_msg_mix = 0;
+    rad_buf b_tap = 0, b_tap_ids = 0, b_tap_ew = 0;
+    rad_buf b_h_site[3] = {}, b_lin_v = 0, b_taps_v = 0;
+    rad_buf b_bias[2] = {};   /* attn_qkv_prep's bias rows for the attention, global and local */
+    int64_t fused_rows = 0;   /* the most tokens the fused ops take, 0 without them */
+    rad_buf b_hout = 0, b_states_out = 0, b_mix_out = 0, b_head = 0, b_logits = 0;
+    ActFP8  a_h{}, a_attn{};   /* `h` and `attn_out`, the dense linears' inputs */
+    ActFP8  a_hk{}, a_hv{};    /* k's and v's own inputs beside `h`, for op_qkvg */
+    int64_t multi_rows = 0;
+    rad_buf b_msg_rank3 = 0, b_msg_mix3 = 0;   /* the three sites' gates side by side */
+    int64_t gate_rank = 0;
+
+    rad_weight w_tok = 0, w_tok_norm = 0, w_final_query = 0, w_out_norm = 0, w_lm_head = 0;
+    rad_op op_embed = 0, op_embed_ar = 0, op_embed_norm = 0, op_bank = 0, op_prev = 0;
+    rad_op op_restart = 0;
+    rad_op op_gather = 0, op_gather_states = 0, op_final_mix = 0, op_final_norm = 0;
+    rad_op op_logits = 0, op_cap = 0, op_pad = 0;
+
+    std::vector<Layer> layers;
+    Dspark ds{};
+};
+
+static Model g_model[MAX_SLOTS];
+/* --calib-dir (rad_calib_full.h), apart from Model because a tap adds to it from step. */
+static CalibFull g_calib[MAX_SLOTS];
+
+/* RADIANCE_INKLING2_TAP keeps the output of every application of a layer in `layer_out`, and the
+ * experts it chose and their weights in `route_ids` and `route_weights`, one a state slot side by
+ * side, for RADIANCE_DUMP_BUF to read against a reference trace. */
+static bool tap_on() {
+    static const bool on = std::getenv("RADIANCE_INKLING2_TAP") != nullptr;
+    return on;
+}
+
+/* The state slot of layer `l` in pass `pass`. */
+static int state_slot(const Model& m, int l, int pass) {
+    if (pass == 0) return l;
+    return (int)m.g.n_layer + (pass - 1) * (m.core_end - m.core_start) + (l - m.core_start);
+}
+
+/* One projection of layer `l`'s experts, `what` naming it, as the container or the checkpoint
+ * holds expert 0: [N, K] an expert on this rank, in movement slot `slot` of its expert. A rank
+ * takes a slice of every expert's intermediate width: gate_up's rows of each of its two halves
+ * (`parts`), down's columns. */
+static int declare_experts(RadBuilder* b, Names& nm, Experts& x, int l, const char* what, int slot,
+                           int64_t n_expert, int64_t N, int64_t K, bool parts) {
+    const int shard = parts ? RAD_SHARD_ROW : RAD_SHARD_COL;
+    const int64_t half[2] = { N / 2, N / 2 };
+    const int64_t* rp = parts ? half : nullptr;
+    const int n_rp = parts ? 2 : 0;
+    auto name = [&](int64_t e, const char* plane) {
+        return nm.f("blk.%d.%s.%lld.%s", l, what, (long long)e, plane);
+    };
+    RadEncoding enc{};
+    char form[160] = "bf16";
+    if (weight_enc(b, name(0, "weight"), &enc)) rad_enc_format(&enc, form, sizeof form);
+    const bool nvfp4 = !std::strcmp(form, "fp4_e2m1*fp8_e4m3[1x16]*f32[*x*]");
+    const bool mxfp8 = !std::strcmp(form, "fp8_e4m3*e8m0[1x32]");
+    if (!nvfp4 && !mxfp8 && std::strcmp(form, "bf16") != 0) {
+        fprintf(stderr, "radiance: inkling2loop: '%s' is stored as %s; the experts are served as "
+                        "bf16, as NVFP4 (fp4_e2m1*fp8_e4m3[1x16]*f32[*x*]) or as MXFP8 "
+                        "(fp8_e4m3*e8m0[1x32])\n", name(0, "weight"), form);
+        return RAD_E_UNSUPPORTED;
+    }
+    if (!nvfp4 && !mxfp8) {
+        for (int64_t e = 0; e < n_expert; ++e) {
+            const rad_weight h = decl_w_n(b, name(e, "weight"), RAD_BF16, {N, K},
+                                          RAD_ACCESS_CONDITIONAL, shard,
+                                          grp_expert_slot(l, (int)e, slot), 0, rp, n_rp);
+            if (!h) return RAD_E_INVAL;
+            if (e == 0) x.w[0] = h;
+        }
+        return RAD_OK;
+    }
+    x.group = nvfp4 ? 16 : 32;
+    x.dtype = nvfp4 ? "nvfp4a16" : "mxfp8a16";
+    for (int q = 0; q < 2; ++q)
+        for (int64_t e = q; e < n_expert; e += 2) {
+            const rad_weight h = decl_view(b, name(e, "weight"), nullptr, "codes",
+                                           nvfp4 ? RAD_FP4E2M1 : RAD_F8E4M3, {N, K},
+                                           RAD_ACCESS_CONDITIONAL, shard,
+                                           grp_expert_slot(l, (int)e, slot), rp, n_rp);
+            if (!h) return RAD_E_INVAL;
+            if (e == q) x.w[q] = h;
+        }
+    /* NVFP4's scale view takes both levels, so it is declared at the weight's extents. */
+    for (int q = 0; q < 2; ++q)
+        for (int64_t e = q; e < n_expert; e += 2) {
+            const rad_weight h =
+                nvfp4 ? decl_view(b, name(e, "scale"), name(e, "weight"), "scale,scale.1",
+                                  RAD_F8E4M3, {N, K}, RAD_ACCESS_CONDITIONAL, shard,
+                                  grp_expert_slot(l, (int)e, slot), rp, n_rp)
+                      : decl_view(b, name(e, "scale"), name(e, "weight"), "scale", RAD_E8M0,
+                                  {N, K / x.group}, RAD_ACCESS_CONDITIONAL, shard,
+                                  grp_expert_slot(l, (int)e, slot), rp, n_rp);
+            if (!h) return RAD_E_INVAL;
+            if (e == q) x.scale[q] = h;
+        }
+    return RAD_OK;
+}
+
+/* Projection i of a layer's attention input, in the order q, the relative states, the sinks, the
+ * gate, k, v and a global layer's two taps: its weight and output. */
+struct ProjSeg {
+    rad_weight w;
+    rad_buf    y;
+};
+static ProjSeg proj_seg(const Layer& L, const Model& m, int i) {
+    switch (i) {
+    case 0: return { L.lin_q.w, m.b_q };
+    case 1: return { L.lin_rel.w, m.b_rel };
+    case 2: return { L.w_sink, m.b_sink };
+    case 3: return { L.lin_gate.w, m.b_gate };
+    case 4: return { L.k.lin.w, m.b_lin };
+    case 5: return { L.v.lin.w, m.b_lin_v };
+    case 6: return { L.k.w_taps, m.b_taps };
+    default: return { L.v.w_taps, m.b_taps_v };
+    }
+}
+
+static int declare(RadBuilder* b, const RadModelMeta* meta, const RadBuildCtx* ctx) {
+    if (!b || !meta || !ctx || ctx->rank < 0 || ctx->rank >= MAX_RANKS ||
+        rad_build_slot(ctx) >= MAX_SLOTS)
+        return RAD_E_INVAL;
+
+    Model& m = g_model[rad_build_slot(ctx)];
+    m = Model{};
+    m.nm = Names(ctx->scope);
+    Names& nm = m.nm;
+    RAD_ARCH_TRY(geom_from(m.g, meta, ctx, "bf16", RAD_BF16));
+    Geom& g = m.g;
+    g.m_invariant = 1;
+
+    const int64_t E = g.n_embd, n_expert = meta->n_expert;
+    const int64_t d_rel      = meta_text_geti(meta, "d_rel", 0);
+    const int64_t rel_extent = meta_text_geti(meta, "rel_extent", 0);
+    const int64_t window     = meta_text_geti(meta, "sliding_window_size", 0);
+    const int64_t width      = meta_text_geti(meta, "sconv_kernel_size", 0);
+    const int64_t per_block  = meta_text_geti(meta, "n_layers_per_attn_res_block", 0);
+    const int64_t top_k      = meta_text_geti(meta, "num_experts_per_tok", 0);
+    const int64_t log_floor  = meta_text_geti(meta, "log_scaling_n_floor", 0);
+    const double log_alpha   = meta_text_getf(meta, "log_scaling_alpha", 0.0);
+    const int64_t core_start = meta_text_geti(meta, "loop_config.core_start", -1);
+    const int64_t core_end   = meta_text_geti(meta, "loop_config.core_end", -1);
+    const int64_t n_pass     = meta_text_geti(meta, "loop_config.num_passes", 0);
+    const int64_t gate_rank  = meta_text_geti(meta, "loop_config.gate_rank", 0);
+    const double qk_clip     = meta_text_getf(meta, "qk_l2_clip_threshold", 0.0);
+    const double rel_clip    = meta_text_getf(meta, "rel_l2_clip_threshold", 0.0);
+    const double gate_cap    = meta_text_getf(meta, "mlp_gate_softcap", 0.0);
+    const double up_cap      = meta_text_getf(meta, "mlp_up_softcap", 0.0);
+    const double route_scale = meta_text_getf(meta, "route_scale", 0.0);
+    const bool released =
+        rad_meta_gets(meta, "imported_quantization_config.quant_method", nullptr) != nullptr;
+    const int64_t head_all = meta_text_geti(meta, "unpadded_vocab_size", g.n_vocab_all);
+    m.n_head_vocab = std::min(g.vocab_off + g.n_vocab, head_all) - g.vocab_off;
+    m.softcap      = meta_text_getf(meta, "final_logit_softcapping", 0.0);
+    if (d_rel <= 0 || rel_extent <= 0 || window <= 0 || width < 2 || per_block <= 0 ||
+        gate_rank <= 0 || n_expert <= 0 || top_k <= 0 || top_k > n_expert || core_start <= 0 ||
+        core_end > g.n_layer || core_start % per_block != 0 || core_end % per_block != 0 ||
+        core_end - core_start < 2 * per_block || n_pass <= 0 ||
+        head_all <= 0 || head_all > g.n_vocab_all || !(m.softcap > 0.0) ||
+        !(qk_clip > 0.0) || !(rel_clip > 0.0) || !(gate_cap > 0.0) || !(up_cap > 0.0) ||
+        !(route_scale > 0.0) || log_floor <= 0 || !(log_alpha >= 0.0)) {
+        fprintf(stderr, "radiance: inkling2loop: the container's text_config lacks or misstates "
+                        "d_rel, rel_extent, sliding_window_size, sconv_kernel_size, "
+                        "n_layers_per_attn_res_block, loop_config, n_routed_experts, "
+                        "num_experts_per_tok, route_scale, the clip thresholds, the softcaps, "
+                        "the log scaling or unpadded_vocab_size\n");
+        return RAD_E_FORMAT;
+    }
+    if (m.n_head_vocab <= 0) {
+        fprintf(stderr, "radiance: inkling2loop: rank %d's vocabulary rows [%lld, %lld) are all "
+                        "past the lm_head's %lld; run fewer ranks\n", g.rank,
+                (long long)g.vocab_off, (long long)(g.vocab_off + g.n_vocab), (long long)head_all);
+        return RAD_E_UNSUPPORTED;
+    }
+    m.n_expert   = n_expert;
+    m.top_k      = top_k;
+    m.core_start = (int)core_start;
+    m.core_end   = (int)core_end;
+    m.n_pass     = (int)n_pass;
+    /* The reference hands a pass the block states after its first block. A loop of one block has
+     * none, and `depth_mix` takes at least one, so the check above refuses it. */
+    m.n_bank     = (int)((core_end - core_start) / per_block) - 1;
+
+    std::vector<int> local_ids((size_t)g.n_layer);
+    const int n_local = parse_layer_ids(meta_text_gets(meta, "local_layer_ids", ""), g.n_layer,
+                                        local_ids.data(), (int)local_ids.size());
+    m.layers.assign((size_t)g.n_layer, Layer{});
+    for (int i = 0; i < n_local; ++i) m.layers[(size_t)local_ids[(size_t)i]].local = true;
+    for (int l = 0; l < (int)g.n_layer; ++l) {
+        m.layers[(size_t)l].boundary = l % per_block == 0;
+        m.layers[(size_t)l].n_state  = (int)((l + per_block - 1) / per_block);
+    }
+
+    const int64_t T = g.max_tok, P = T * top_k;
+    const int64_t q_dim = g.q_dim(), kv_dim = g.kv_dim(), n_ff = g.n_ff;
+    const int64_t n_state = (g.n_layer + per_block - 1) / per_block;
+    const int n_slot = (int)g.n_layer + (m.n_pass - 1) * (m.core_end - m.core_start);
+
+    /* ---- the caches, a layer of each for every state slot s. The paged ones hold k and v, the
+     * local layers' recycled below the window. A convolution keeps its last width - 1 inputs: k's
+     * and v's in one group, at layers 2s and 2s + 1, and the two over the stream in another, the
+     * attention's at 2s and the experts' at 2s + 1. Their inputs are bf16 tensors of the
+     * reference, so bf16 holds them. */
+    RadKVGroupDecl kd{};
+    kd.kind      = RAD_KV_WINDOW;
+    kd.dtype     = rad_kv_cache_dtype(ctx, RAD_BF16);
+    kd.window    = window;
+    kd.n_head_kv = g.n_head_kv;
+    kd.head_dim  = g.head_dim;
+    m.kv_local = rad_decl_kv_group(b, nm.f("kv_local"), &kd);
+    kd.kind   = RAD_KV_FULL;
+    kd.window = 0;
+    m.kv_global = rad_decl_kv_group(b, nm.f("kv_global"), &kd);
+    g.kv_dtype = rad_dtype_name(kd.dtype);
+    if (const char* sb = std::getenv("RADIANCE_INKLING2_SPARSE")) {
+        const char* sl = std::getenv("RADIANCE_INKLING2_SPARSE_LAST");
+        const char* sp = std::getenv("RADIANCE_INKLING2_SPARSE_PAGE");
+        m.sparse_budget = std::atoll(sb);
+        m.sparse_last = sl ? std::atoll(sl) : 2048;
+        m.sparse_page = sp ? std::atoll(sp) : 16;
+        if (m.sparse_budget <= 0 || m.sparse_last < 0 || m.sparse_page < 16 || m.sparse_page % 16)
+            return RAD_E_INVAL;
+    }
+
+    RadKVGroupDecl cd{};
+    cd.kind       = RAD_KV_CONV;
+    cd.dtype      = RAD_BF16;
+    cd.n_head_kv  = 1;
+    cd.head_dim   = kv_dim;
+    cd.conv_width = width;
+    m.kv_conv = rad_decl_kv_group(b, nm.f("kv_conv"), &cd);
+    cd.head_dim = E;
+    m.kv_conv_x = rad_decl_kv_group(b, nm.f("kv_conv_x"), &cd);
+    if (!m.kv_local || !m.kv_global || !m.kv_conv || !m.kv_conv_x) return RAD_E_INVAL;
+
+    m.b_x      = decl_b(b, nm.f("x"),          RAD_BF16, {T, E});
+    m.b_states = decl_b(b, nm.f("states"),     RAD_BF16, {T, n_state * E});
+    m.b_mix    = decl_b(b, nm.f("mix"),        RAD_F32,  {T, 3 * E});
+    m.b_h      = decl_b(b, nm.f("h"),          RAD_BF16, {T, E});
+    m.b_q      = decl_b(b, nm.f("attn_q"),     RAD_BF16, {T, q_dim});
+    m.b_lin    = decl_b(b, nm.f("attn_kv_in"), RAD_BF16, {T, kv_dim});
+    m.b_taps   = decl_b(b, nm.f("attn_taps"),  RAD_BF16, {T, g.n_head_kv * width});
+    m.b_k      = decl_b(b, nm.f("attn_k"),     RAD_BF16, {T, kv_dim});
+    m.b_v      = decl_b(b, nm.f("attn_v"),     RAD_BF16, {T, kv_dim});
+    m.b_rel    = decl_b(b, nm.f("attn_rel"),   RAD_BF16, {T, g.n_head * d_rel});
+    m.b_sink   = decl_b(b, nm.f("attn_sink"),  RAD_BF16, {T, g.n_head});
+    m.b_attn   = decl_b(b, nm.f("attn_out"),   RAD_BF16, {T, q_dim});
+    m.b_gate   = decl_b(b, nm.f("attn_gate"),  RAD_BF16, {T, q_dim});
+    m.b_gated  = decl_b(b, nm.f("attn_gated"), RAD_F32,  {T, q_dim});
+    m.b_o      = decl_b(b, nm.f("branch"),     RAD_BF16, {T, E});
+    m.b_res    = decl_b(b, nm.f("residual"),   RAD_F32,  {T, E});
+    m.b_logits_r = decl_b(b, nm.f("router_logits"),  RAD_F32, {T, n_expert});
+    m.b_ids    = decl_b(b, nm.f("expert_ids"),       RAD_I32, {T, top_k});
+    m.b_ew     = decl_b(b, nm.f("expert_weights"),   RAD_F32, {T, top_k});
+    m.b_sorted = decl_b(b, nm.f("expert_sorted"),    RAD_I32, {P});
+    m.b_eoff   = decl_b(b, nm.f("expert_offsets"),   RAD_I32, {n_expert + 1});
+    /* PERSIST: rad_route_report hands the counts to a reader that is not a declared op. */
+    m.b_ecnt   = decl_b(b, nm.f("expert_counts"),    RAD_I32, {n_expert}, RAD_BUF_PERSIST);
+    m.b_egu    = decl_b(b, nm.f("expert_gate_up"),   RAD_BF16, {P, 2 * n_ff});
+    m.b_cap    = decl_b(b, nm.f("expert_capped"),    RAD_F32,  {P, 2 * n_ff});
+    m.b_eff    = decl_b(b, nm.f("expert_ff"),        RAD_BF16, {P, n_ff});
+    m.b_edn    = decl_b(b, nm.f("expert_down"),      RAD_BF16, {P, E});
+    m.b_bank       = decl_b(b, nm.f("msg_bank"),   RAD_BF16, {T, m.n_bank * E});
+    m.b_prev       = decl_b(b, nm.f("msg_prev"),   RAD_BF16, {T, E});
+    m.b_msg        = decl_b(b, nm.f("msg"),        RAD_F32,  {T, 4 * E});
+    m.b_msg_rank   = decl_b(b, nm.f("msg_rank"),   RAD_BF16, {T, gate_rank});
+    m.gate_rank    = gate_rank;
+    m.b_msg_mix    = decl_b(b, nm.f("msg_mix"),    RAD_F32,  {T, E});
+    if (rad_op_declared(b, "gemm_nt_multi")) {
+        m.fused_rows  = std::min<int64_t>(T, 64);
+        m.b_h_site[0] = m.b_h;
+        m.b_h_site[1] = decl_b(b, nm.f("h_k"),        RAD_BF16, {T, E});
+        m.b_h_site[2] = decl_b(b, nm.f("h_v"),        RAD_BF16, {T, E});
+        m.b_lin_v     = decl_b(b, nm.f("attn_v_in"),  RAD_BF16, {T, kv_dim});
+        m.b_taps_v    = decl_b(b, nm.f("attn_v_taps"), RAD_BF16, {T, g.n_head_kv * width});
+    }
+    if (tap_on()) {
+        m.b_tap = decl_b(b, nm.f("layer_out"), RAD_BF16, {T, n_slot * E}, RAD_BUF_PERSIST);
+        m.b_tap_ids = decl_b(b, nm.f("route_ids"), RAD_I32, {T, n_slot * top_k}, RAD_BUF_PERSIST);
+        m.b_tap_ew  = decl_b(b, nm.f("route_weights"), RAD_F32, {T, n_slot * top_k},
+                             RAD_BUF_PERSIST);
+    }
+    m.b_hout       = decl_b(b, nm.f("h_out"),      RAD_BF16, {g.max_logit_rows, E});
+    m.b_states_out = decl_b(b, nm.f("states_out"), RAD_BF16, {g.max_logit_rows, n_state * E});
+    m.b_mix_out    = decl_b(b, nm.f("mix_out"),    RAD_F32,  {g.max_logit_rows, E});
+    m.b_head   = decl_b(b, nm.f("head"),   RAD_F32,  {g.max_logit_rows, m.n_head_vocab});
+    m.b_logits = decl_b(b, nm.f("logits"), RAD_F32,  {g.max_logit_rows, g.n_vocab});
+    RAD_ARCH_TRY(rad_declare_logits(b, m.b_logits));
+
+    const int n_visit = m.core_start + m.n_pass * (m.core_end - m.core_start) +
+                        ((int)g.n_layer - m.core_end);
+    RAD_ARCH_TRY(m.ds.declare_taps(b, nm, meta, ctx, g, n_visit, m.b_x));
+
+    const char* pre = "model.language_model";
+    RAD_ARCH_TRY(map_copy(b, nm.f("token_embd.weight"), nm.ckpt("%s.embed_tokens.weight", pre)));
+    RAD_ARCH_TRY(map_copy(b, nm.f("token_embd_norm.weight"),
+                          nm.ckpt("%s.embed_tokens.embed_norm.weight", pre)));
+    RAD_ARCH_TRY(map_copy(b, nm.f("output_norm.weight"), nm.ckpt("%s.norm.weight", pre)));
+    RAD_ARCH_TRY(map_copy(b, nm.f("output.weight"), nm.ckpt("lm_head.weight")));
+    m.w_tok = decl_w(b, nm.f("token_embd.weight"), RAD_BF16, {g.n_vocab, E}, RAD_ACCESS_VOCAB,
+                     RAD_SHARD_ROW, grp_model());
+    m.w_tok_norm = decl_w(b, nm.f("token_embd_norm.weight"), RAD_F32, {E}, RAD_ACCESS_PER_TOKEN,
+                          RAD_SHARD_NONE, grp_model());
+    m.w_out_norm = decl_w(b, nm.f("output_norm.weight"), RAD_F32, {E}, RAD_ACCESS_PER_TOKEN,
+                          RAD_SHARD_NONE, grp_model());
+    m.w_lm_head = decl_w(b, nm.f("output.weight"),
+                         weight_codes_dtype(b, nm.f("output.weight"), RAD_BF16),
+                         {m.n_head_vocab, E}, RAD_ACCESS_VOCAB, RAD_SHARD_ROW, grp_model());
+    if (!m.w_tok || !m.w_lm_head) return RAD_E_INVAL;
+    if (g.world > 1) {
+        if (g.n_vocab_all % g.world)
