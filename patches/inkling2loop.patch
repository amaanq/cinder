+/* ------------------------------------------------------------------ l2_clip */
+/* h = x * scale;  y = h * min(threshold / (|h| + eps), 1), over each run of head_dim elements;
+ * with `positions`, then times 1 + log_alpha * ln(max((pos + 1) / log_floor, 1)), as libref. */
+AVX_KERNEL(l2_clip) {
+    if (!a || a->n_t < 3 || !a->t[0].data || !a->t[2].data) return RAD_E_INVAL;
+    const RadTensor *x = &a->t[0], *y = &a->t[2];
+    const RadTensor* sc = a->t[1].data ? &a->t[1] : nullptr;
+    const RadTensor* pos = a->n_t > 3 ? rad_arg_in(a, 3) : nullptr;
+    const int64_t n = p_int(a, "n", 0), hd = p_int(a, "head_dim", 0);
+    const float thr = p_f32(a, "threshold", 0.0f), eps = p_f32(a, "eps", 1e-6f);
+    const float alpha = p_f32(a, "log_alpha", 0.0f);
+    const int64_t floor_n = p_int(a, "log_floor", 0);
+    if (n <= 0 || hd <= 0 || n % hd != 0 || !(thr > 0.0f)) return RAD_E_SHAPE;
+    const int64_t rows = rows_of(x, n);
+    if (rows <= 0 || numel(y) < rows * n || (sc && numel(sc) != n)) return RAD_E_SHAPE;
+    if (pos && (floor_n <= 0 || numel(pos) < rows)) return RAD_E_SHAPE;
+
+    float* gain = (float*)scratch_raw((size_t)n * sizeof(float));
+    for (int64_t i = 0; i < n; ++i) gain[i] = sc ? ldt(sc, offlin(sc, i)) : 1.0f;
+
+    AVX_PARALLEL_FOR_IF(rows * n >= AVX_PAR_MIN)
+    for (int64_t r = 0; r < rows; ++r) {
+        float* sx = scratch_f32((size_t)n);
+        float* sy = scratch_f32_b((size_t)n);
+        const float* v = in_row(x, rowoff(x, r, n), n, sx);
+        for (int64_t i = 0; i < n; ++i) sy[i] = v[i] * gain[i];
+        for (int64_t h = 0; h < n; h += hd) {
+            const float f = std::fmin(thr / (std::sqrt(row_sumsq(sy + h, hd)) + eps), 1.0f);
+            for (int64_t i = h; i < h + hd; ++i) sy[i] *= f;
+        }
+        if (pos) {
+            const float t = (float)(ldi(pos, offlin(pos, r)) + 1) / (float)floor_n;
+            const float tau = 1.0f + alpha * std::log(std::fmax(t, 1.0f));
+            for (int64_t i = 0; i < n; ++i) sy[i] = narrow1(y->dtype, sy[i]) * tau;
+        }
+        out_row(y, rowoff(y, r, n), n, sy);
+    }
+    return RAD_OK;
+}
