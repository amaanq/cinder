+/* ------------------------------------------------------------------ depth_mix */
+/* A token's earlier states and its current one, mixed by learned queries: row r's `states` runs of
+ * n in `states` and then its row of `x` are each normalised with no gain,
+ * u_s = v_s * rsqrt(mean(v_s^2) + eps), and query k's output is sum_s p_s u_s with
+ * p = softmax_s(q[k] . u_s / sqrt(n)). The values are the normalised rows, not the stored ones.
+ * f32 throughout, every sum in ascending index order, y rounded once. */
+int ref_depth_mix(const RadArgs* a, RadStream) {
+    if (!have(a, 4)) return RAD_E_INVAL;
+    const RadTensor *st = &a->t[0], *x = &a->t[1], *q = &a->t[2], *y = &a->t[3];
+    const int64_t n = p_int(a, "n", 0), S = p_int(a, "states", 0), Q = p_int(a, "queries", 0);
+    const float eps = p_f32(a, "eps", 1e-6f);
+    if (n <= 0 || S <= 0 || Q <= 0) return RAD_E_SHAPE;
+    const int64_t rows = rows_of(x, n);
+    if (rows <= 0 || numel(st) < rows * S * n || numel(q) != Q * n || numel(y) < rows * Q * n)
+        return RAD_E_SHAPE;
+    const float scale = 1.0f / std::sqrt((float)n);
+
+    REF_PAR_REGION(rows * (S + 1) * n * (Q + 1))
+    {
+        float* const u = ws_get((size_t)((S + 1) * n + S + 1));
+        float* const p = u + (S + 1) * n;
+        REF_FOR
+        for (int64_t r = 0; r < rows; ++r) {
+            const int64_t sb = rowoff(st, r, S * n), ss = laststride(st);
+            const int64_t xb = rowoff(x, r, n), xs = laststride(x);
+            for (int64_t s = 0; s <= S; ++s) {
+                auto at = [&](int64_t i) {
+                    return s < S ? ldt(st, sb + (s * n + i) * ss) : ldt(x, xb + i * xs);
+                };
+                float sq = 0.0f;
+                for (int64_t i = 0; i < n; ++i) { const float v = at(i); sq += v * v; }
+                const float inv = 1.0f / std::sqrt(sq / (float)n + eps);
+                for (int64_t i = 0; i < n; ++i) u[s * n + i] = at(i) * inv;
+            }
+            for (int64_t k = 0; k < Q; ++k) {
+                const int64_t qb = rowoff(q, k, n), qs = laststride(q);
+                float mx = -INFINITY, sum = 0.0f;
+                for (int64_t s = 0; s <= S; ++s) {
+                    float dot = 0.0f;
+                    for (int64_t i = 0; i < n; ++i) dot += ldt(q, qb + i * qs) * u[s * n + i];
+                    p[s] = dot * scale;
+                    if (p[s] > mx) mx = p[s];
+                }
+                for (int64_t s = 0; s <= S; ++s) { p[s] = ref_exp(p[s] - mx); sum += p[s]; }
+                const int64_t yb = rowoff(y, r, Q * n), ys = laststride(y);
+                for (int64_t i = 0; i < n; ++i) {
+                    float acc = 0.0f;
+                    for (int64_t s = 0; s <= S; ++s) acc += p[s] / sum * u[s * n + i];
+                    stt(y, yb + (k * n + i) * ys, acc);
+                }
+            }
+        }
+    }
+    return RAD_OK;
