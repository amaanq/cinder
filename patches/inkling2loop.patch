+/* causal_conv1d with f32 taps into an f32 sum over bf16 rows: a decode-shaped step that reads the
+ * window a prefill-shaped one left. */
+void causal_conv_f32_case(const Plugin& pl) {
+    const RadKernelInfo* r = find(pl, "causal_conv1d_bf16");
+    if (!r) { ok("causal_conv1d_bf16 f32 taps", false, "row absent"); return; }
+    const int64_t n = 2304, wid = 4, hist = wid - 1, T0 = 40, T1 = 2;
+    std::vector<float> x = randv((size_t)((T0 + T1) * n), 3.0f), w = randv((size_t)(n * wid), 1.0f);
+    void* dx = up_bf16(x);
+    void* dw = up_f32(w);
+    void* dcs = dalloc((size_t)(n * (hist + T1)) * 2);
+    void* dy = dalloc((size_t)((T0 + T1) * n) * 4);
+    for (int step = 0; step < 2; ++step) {
+        const int64_t rows = step ? T1 : T0, first = step ? T0 : 0;
+        void* cu = up_i32({ 0, (int32_t)rows });
+        void* idx = up_i32({ 0 });
+        void* init = up_i32({ step });
+        void* acc = up_i32({ (int32_t)1 });
+        const int rc = launch(r, { T((uint16_t*)dx + first * n, RAD_BF16, { rows, n }),
+                                   T(dw, RAD_F32, { n, wid }),
+                                   T(dcs, RAD_BF16, { 1, n, hist + T1 }), T(cu, RAD_I32, { 2 }),
+                                   T(idx, RAD_I32, { 1 }), T(init, RAD_I32, { 1 }),
+                                   T(step ? acc : nullptr, RAD_I32, { 1 }),
+                                   T((float*)dy + first * n, RAD_F32, { rows, n }) },
+                              { PI("M", rows), PI("n", n), PI("width", wid), PS("dtype", "bf16") });
+        if (rc != RAD_OK) { ok("causal_conv1d_bf16 f32 taps", false, "rc " + std::to_string(rc)); return; }
+    }
+    const std::vector<float> got = down_f32(dy, (size_t)((T0 + T1) * n));
+    std::vector<float> want(got.size());
+    for (int64_t t = 0; t < T0 + T1; ++t)
+        for (int64_t c = 0; c < n; ++c) {
+            double acc = 0;
+            for (int64_t j = 0; j < wid; ++j) {
+                const int64_t src = t - hist + j;
+                if (src >= 0) acc += (double)x[(size_t)(src * n + c)] * w[(size_t)(c * wid + j)];
+            }
+            want[(size_t)(t * n + c)] = (float)acc;
+        }
+    check_f32("causal_conv1d_bf16 with f32 taps into f32, across two steps", got, want, 1e-6);
+}
