+namespace r4d_inkling {
+
+/* Up to three gates' launches as one pair: grid z picks the gate, each block running the one
+ * gate's body, so each output is its own launch's bytes. */
+constexpr uint32_t kMgSites = 3;
+struct MgSites {
+    MgArgs s[kMgSites];
+};
+__device__ __forceinline__ MgArgs mg_site(const MgSites& S, uint32_t z) {
+    MgArgs A = S.s[0];
+#pragma unroll
+    for (uint32_t j = 1; j < kMgSites; ++j)
+        if (z == j) A = S.s[j];
+    return A;
+}
+template <class CH>
+__global__ __launch_bounds__(kThr) void msg_rank_sites_kernel(MgSites S) {
+    msg_rank_body<CH>(mg_site(S, blockIdx.z), blockIdx.x, blockIdx.y);
+    if (CH::on) r4d_chain_done();
+}
+template <class CH>
+__global__ __launch_bounds__(kThr) void msg_mix_sites_kernel(MgSites S) {
+    msg_mix_body<CH>(mg_site(S, blockIdx.z), blockIdx.x, blockIdx.y);
+    if (CH::on) r4d_chain_done();
+}
+
+/* The rank and blend launches of `ns` sites as one: block b < nr is rank block b (x fastest, then
+ * the row group, then the site), and block nr + b blend block b, after the last rank block arrives
+ * at ctr[0]. No rank block waits, and every blend block is dispatched after every rank block, so
+ * a waiting blend block holds no slot a rank block needs. The blend's last arrival at ctr[1]
+ * leaves both zero. Each block's arithmetic is its own launch's. */
+struct MgFuse {
+    uint32_t rx, ry, mx, my, nr, nb;
+    unsigned* ctr;
+};
+template <class CH>
+__global__ __launch_bounds__(kThr) void msg_gate_kernel(MgSites S, MgFuse F) {
+    const uint32_t tid = threadIdx.x;
+    if (blockIdx.x < F.nr) {
+        const uint32_t b = blockIdx.x;
+        msg_rank_body<CH>(mg_site(S, b / (F.rx * F.ry)), b % F.rx, b / F.rx % F.ry);
+        __threadfence();
+        __syncthreads();
+        if (tid == 0)
+            __hip_atomic_fetch_add(&F.ctr[0], 1u, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
+    } else {
+        const uint32_t b = blockIdx.x - F.nr;
+        if (CH::on) r4d_chain_wait();
+        if (tid == 0)
+            while (__hip_atomic_load(&F.ctr[0], __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) < F.nr)
+                __builtin_amdgcn_s_sleep(1);
+        __syncthreads();
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+        msg_mix_body<R4dUnchained>(mg_site(S, b / (F.mx * F.my)), b % F.mx, b / F.mx % F.my);
+        __syncthreads();
+        if (tid == 0 &&
+            __hip_atomic_fetch_add(&F.ctr[1], 1u, __ATOMIC_ACQ_REL, __HIP_MEMORY_SCOPE_AGENT) + 1u ==
+                F.nb) {
+            __hip_atomic_store(&F.ctr[0], 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+            __hip_atomic_store(&F.ctr[1], 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+        }
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+}  /* namespace r4d_inkling */
+
+static MgFuse mg_fuse(dim3 rank, dim3 mix, uint32_t ns, unsigned* ctr) {
+    MgFuse F{ rank.x, rank.y, mix.x, mix.y, 0, 0, ctr };
+    F.nr = rank.x * rank.y * ns;
+    F.nb = mix.x * mix.y * ns;
+    return F;
+}
+/* msg_gate_kernel's two arrival counters, keyed by the blend's output; null runs the two
+ * launches. */
+static unsigned* mg_fuse_ctr(RadStream stream, const MgArgs& A) {
+    return r4d::keyed_block(r4d::Keyed::MsgGate, stream, A.y, 2 * sizeof(unsigned));
+}
+
+extern "C" {
+
+int r4d_rad_message_gate(const RadArgs* a, RadStream stream) {
+    const RadTensor* t[7];
+    for (int i = 0; i < 7; ++i)
+        if (!(t[i] = r4d_opt(a, i))) return R4D_NO(RAD_E_INVAL);
+    MgArgs A{};
+    const int arc = mg_args(t, a, &A);
+    if (arc != RAD_OK) return arc;
+    const long long n = A.n, k = A.k, M = A.M;
+    const size_t lds = (size_t)A.rank_rows * 2 * n * sizeof(uint16_t);
+    const dim3 rank_grid((uint32_t)((k + A.jpb * A.rpw - 1) / (A.jpb * A.rpw)),
+                         (uint32_t)((M + A.rank_rows - 1) / A.rank_rows));
+    const dim3 mix_grid((uint32_t)((n + kMgCols - 1) / kMgCols),
+                        (uint32_t)((M + A.mix_rows - 1) / A.mix_rows));
+    if (r4d_geti_or(a, "chain", 0) != 0 && M <= 64) {
+        MgSites S{};
+        S.s[0] = A;
+        if (unsigned* ctr = A.M == 1 ? mg_fuse_ctr(stream, A) : nullptr) {
+            const MgFuse F = mg_fuse(rank_grid, mix_grid, 1, ctr);
+            return R4D_EMIT(stream, msg_gate_kernel<r4dchain>, dim3(F.nr + F.nb),
+                            dim3(kThr), lds, S, F);
+        }
+        const int rc = R4D_EMIT(stream, msg_rank_kernel<r4dchain>, rank_grid, dim3(kThr), lds, A);
+        if (rc != RAD_OK) return rc;
+        return R4D_EMIT(stream, msg_mix_kernel<r4dchain>, mix_grid, dim3(kThr), 0, A);
+    }
+    const bool part = M >= kMgWideRows && k == kMgWideRank &&
+                      2 * n <= (long long)(kMgParts * kMgPartCols);
+    const int rc =
+        part ? R4D_EMIT(stream, msg_rank_part_kernel,
+                        dim3(kMgWideRank / (kThr / kWave * kMgPartRanks),
+                             (uint32_t)((M + kMgPartRows - 1) / kMgPartRows)),
+                        dim3(kThr),
+                        (size_t)(kMgPartRows * kMgPartCols + 2 * kMgPartRows) * sizeof(float), A)
+             : R4D_EMIT(stream, msg_rank_kernel<R4dUnchained>, rank_grid, dim3(kThr), lds, A);
+    if (rc != RAD_OK) return rc;
+    if (M >= kMgWideRows && k == kMgWideRank)
+        return R4D_EMIT(stream, msg_mix_wide_kernel,
+                        dim3((uint32_t)((n + kThr - 1) / kThr), mix_grid.y), dim3(kThr), 0, A);
+    return R4D_EMIT(stream, msg_mix_kernel<R4dUnchained>, mix_grid, dim3(kThr), 0, A);
+}
+
+/* message_gate_sites: message_gate's seven operands a site, up to three sites of one n, rank and
+ * M, in one rank launch and one blend launch. */
+int r4d_rad_message_gate_sites(const RadArgs* a, RadStream stream) {
+    MgSites S{};
+    uint32_t ns = 0;
+    for (; ns < kMgSites && r4d_opt(a, 7 * (int)ns); ++ns) {
+        const RadTensor* t[7];
+        for (int i = 0; i < 7; ++i)
+            if (!(t[i] = r4d_opt(a, 7 * (int)ns + i))) return R4D_NO(RAD_E_INVAL);
+        const int rc = mg_args(t, a, &S.s[ns]);
+        if (rc != RAD_OK) return rc;
+        if (S.s[ns].M != S.s[0].M) return R4D_NO(RAD_E_SHAPE);
+    }
+    if (ns == 0) return R4D_NO(RAD_E_INVAL);
+    const MgArgs& A = S.s[0];
+    const size_t lds = (size_t)A.rank_rows * 2 * A.n * sizeof(uint16_t);
+    const dim3 rank_grid((A.k + A.jpb * A.rpw - 1) / (A.jpb * A.rpw),
+                         (A.M + A.rank_rows - 1) / A.rank_rows, ns);
+    const dim3 mix_grid((A.n + kMgCols - 1) / kMgCols, (A.M + A.mix_rows - 1) / A.mix_rows, ns);
+    if (r4d_geti_or(a, "chain", 0) != 0 && A.M <= 64) {
+        if (unsigned* ctr = A.M == 1 ? mg_fuse_ctr(stream, A) : nullptr) {
+            const MgFuse F = mg_fuse(rank_grid, mix_grid, ns, ctr);
+            return R4D_EMIT(stream, msg_gate_kernel<r4dchain>, dim3(F.nr + F.nb),
+                            dim3(kThr), lds, S, F);
+        }
+        const int rc = R4D_EMIT(stream, msg_rank_sites_kernel<r4dchain>, rank_grid, dim3(kThr), lds,
+                                S);
+        if (rc != RAD_OK) return rc;
+        return R4D_EMIT(stream, msg_mix_sites_kernel<r4dchain>, mix_grid, dim3(kThr), 0, S);
+    }
+    const int rc = R4D_EMIT(stream, msg_rank_sites_kernel<R4dUnchained>, rank_grid, dim3(kThr),
+                            lds, S);
+    if (rc != RAD_OK) return rc;
+    return R4D_EMIT(stream, msg_mix_sites_kernel<R4dUnchained>, mix_grid, dim3(kThr), 0, S);
+}
+
+int r4d_rad_capped_sigmoid_glu(const RadArgs* a, RadStream stream) {
+    const RadTensor* g = r4d_opt(a, 0);
+    const RadTensor* u = r4d_opt(a, 1);
+    const RadTensor* y = r4d_opt(a, 2);
+    if (!g || !u || !y) return R4D_NO(RAD_E_INVAL);
+    if (g->dtype != RAD_BF16 || u->dtype != RAD_BF16 || y->dtype != RAD_BF16)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0);
+    GluArgs A{};
+    A.gcap = (float)r4d_getf(a, "gate_cap", 0.0);
+    A.ucap = (float)r4d_getf(a, "up_cap", 0.0);
+    if (n <= 0 || !(A.gcap > 0.0f) || !(A.ucap > 0.0f)) return R4D_NO(RAD_E_SHAPE);
+    long long M = 0, Mg = 0, Mu = 0;
+    A.y_rs = r4d_rows_pitch(y, n, &M);
+    A.g_rs = r4d_rows_pitch(g, n, &Mg);
+    A.u_rs = r4d_rows_pitch(u, n, &Mu);
+    if (A.y_rs < 0 || A.g_rs < 0 || A.u_rs < 0) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Mg < M || Mu < M) return R4D_NO(RAD_E_SHAPE);
+    A.g = (const uint16_t*)r4d_p(g);
+    A.u = (const uint16_t*)r4d_p(u);
+    A.y = (uint16_t*)r4d_wp(y);
+    A.n = (uint32_t)n;
+    A.total = (uint64_t)M * (uint64_t)n;
+    const uint64_t blocks = (A.total + kThr - 1) / kThr;
+    const dim3 grid((uint32_t)(blocks < 65536u ? blocks : 65536u)), thr(kThr);
+    if (r4d_geti_or(a, "chain", 0) != 0 && M <= 512)
+        return R4D_EMIT(stream, capped_glu_kernel<r4dchain>, grid, thr, 0, A);
+    return R4D_EMIT(stream, capped_glu_kernel<R4dUnchained>, grid, thr, 0, A);
+}
+
+/* Operand indices, from oQkvPrep in r4d_rows.cpp. */
+enum { QP_Q = 0, QP_QSC, QP_REL, QP_RELSC, QP_POS, QP_KX, QP_KW, QP_KDYN, QP_KCS, QP_VX, QP_VW,
+       QP_VDYN, QP_VCS, QP_CU, QP_CIDX, QP_HINIT, QP_NACC, QP_K, QP_V, QP_SLOT, QP_KV, QP_PROJ,
+       QP_BIAS };
+
+int r4d_rad_attn_qkv_prep(const RadArgs* a, RadStream stream) {
+    const RadTensor* q = r4d_opt(a, QP_Q);
+    const RadTensor* qsc = r4d_opt(a, QP_QSC);
+    const RadTensor* rel = r4d_opt(a, QP_REL);
+    const RadTensor* rsc = r4d_opt(a, QP_RELSC);
+    const RadTensor* pos = r4d_opt(a, QP_POS);
+    const RadTensor* cu = r4d_opt(a, QP_CU);
+    const RadTensor* cidx = r4d_opt(a, QP_CIDX);
+    const RadTensor* hini = r4d_opt(a, QP_HINIT);
+    const RadTensor* nacc = r4d_opt(a, QP_NACC);
+    const RadTensor* slot = r4d_opt(a, QP_SLOT);
+    const RadTensor* kv = r4d_opt(a, QP_KV);
+    if (!q || !qsc || !rel || !rsc || !cu || !slot || !kv) return R4D_NO(RAD_E_INVAL);
+    const long long heads = r4d_geti_or(a, "n_head", 0), kvh = r4d_geti_or(a, "n_head_kv", 0);
+    const long long hd = r4d_geti_or(a, "head_dim", 0), d_rel = r4d_geti_or(a, "d_rel", 0);
+    const long long wid = r4d_geti_or(a, "width", 0), bs = r4d_geti_or(a, "block_size", 0);
+    const bool dyn = r4d_geti_or(a, "dyn", 0) != 0;
+    if (hd != (long long)kPrepThr || heads <= 0 || kvh <= 0 || d_rel <= 0 || bs <= 0 ||
+        wid < 2 || wid > kPrepMaxW)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    if (heads * d_rel > 3 * (long long)kPrepThr || heads > 3 * (long long)kPrepThr / 16)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    PrepArgs A{};
+    long long M = 0, Mr = 0;
+    A.q_rs = r4d_rows_pitch(q, heads * hd, &M);
+    A.rel_rs = r4d_rows_pitch(rel, heads * d_rel, &Mr);
+    if (A.q_rs < 0 || A.rel_rs < 0 || !r4d_contig(qsc) || !r4d_contig(rsc) || !r4d_contig(cu) ||
+        !r4d_contig(slot) || !r4d_contig(kv))
+        return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || M > 64 || Mr < M || r4d_numel(qsc) != heads * hd ||
+        r4d_numel(rsc) != heads * d_rel || r4d_numel(slot) < M)
+        return R4D_NO(RAD_E_SHAPE);
+    for (const RadTensor* t : { q, qsc, rel, rsc })
+        if (t->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+    if (const RadTensor* bias = r4d_opt(a, QP_BIAS)) {
+        const RadTensor* proj = r4d_opt(a, QP_PROJ);
+        const long long ext = r4d_geti_or(a, "rel_extent", 0);
+        long long rp = 0;
+        if (!proj) return R4D_NO(RAD_E_INVAL);
+        if (proj->dtype != RAD_BF16 || bias->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+        if (ext < 8 || ext % 8 || d_rel > kRsMaxRel) return R4D_NO(RAD_E_UNSUPPORTED);
+        A.proj_rs = r4d_rows_pitch(proj, ext, &rp);
+        if (A.proj_rs < 0 || A.proj_rs % 8 || !r4d_contig(bias)) return R4D_NO(RAD_E_STRIDE);
+        if (rp != d_rel || r4d_numel(bias) < M * heads * (ext + 2 * kBiasPad))
+            return R4D_NO(RAD_E_SHAPE);
+        if (!r4d_aligned(proj->data, 16) || !r4d_aligned(bias->data, 16))
+            return R4D_NO(RAD_E_ALIGN);
+        A.proj = (const uint16_t*)r4d_p(proj);
+        A.bias = (uint16_t*)r4d_wp(bias);
+        A.bias_rs = ext + 2 * kBiasPad;
+        A.extent = (int)ext;
+    }
+    for (const RadTensor* t : { cu, cidx, hini, nacc, slot, pos })
+        if (t && t->dtype != RAD_I32) return R4D_NO(RAD_E_DTYPE);
+    const bool kv8 = kv->dtype == RAD_I8;
+    if ((!kv8 && kv->dtype != RAD_BF16) || kv->rank != 4 || kv->shape[1] != kvh ||
+        kv->shape[2] != bs || kv->shape[3] != (kv8 ? 2 * hd + 4 : 2 * hd))
+        return R4D_NO(RAD_E_SHAPE);
+    const long long n = kvh * hd;
+    long long cs_shape[3] = {};
+    for (int kind = 0; kind < 2; ++kind) {
+        const RadTensor* x = r4d_opt(a, kind ? QP_VX : QP_KX);
+        const RadTensor* w = r4d_opt(a, kind ? QP_VW : QP_KW);
+        const RadTensor* dy = r4d_opt(a, kind ? QP_VDYN : QP_KDYN);
+        const RadTensor* cs = r4d_opt(a, kind ? QP_VCS : QP_KCS);
+        const RadTensor* y = r4d_opt(a, kind ? QP_V : QP_K);
+        if (!x || !w || !cs || !y || (dyn != (dy != nullptr))) return R4D_NO(RAD_E_INVAL);
+        if (x->dtype != RAD_BF16 || y->dtype != RAD_BF16 || (dy && dy->dtype != RAD_BF16) ||
+            w->dtype != (dyn ? RAD_BF16 : RAD_F32) || (cs->data && cs->dtype != RAD_BF16))
+            return R4D_NO(RAD_E_DTYPE);
+        long long Mx = 0, My = 0, Md = 0, wr = 0;
+        A.x_rs[kind] = r4d_rows_pitch(x, n, &Mx);
+        A.y_rs[kind] = r4d_rows_pitch(y, n, &My);
+        A.w_rs[kind] = dyn ? r4d_rows_pitch(w, n, &wr) : r4d_rows_pitch(w, wid, &wr);
+        A.dyn_rs[kind] = dy ? r4d_rows_pitch(dy, kvh * wid, &Md) : 0;
+        if (A.x_rs[kind] < 0 || A.y_rs[kind] < 0 || A.w_rs[kind] < 0 || A.dyn_rs[kind] < 0)
+            return R4D_NO(RAD_E_STRIDE);
+        if (Mx != M || My < M || wr < (dyn ? wid : n) || (dy && Md < M)) return R4D_NO(RAD_E_SHAPE);
+        if (cs->data) {
+            if (cs->rank != 3 || r4d_dim(cs, 1) < n || r4d_dim(cs, 2) < wid - 1)
+                return R4D_NO(RAD_E_SHAPE);
+            const long long sh[3] = { r4d_stride(cs, 0), r4d_stride(cs, 1), r4d_stride(cs, 2) };
+            if (kind && (sh[0] != cs_shape[0] || sh[1] != cs_shape[1] || sh[2] != cs_shape[2] ||
+                         r4d_dim(cs, 2) != A.state_len))
+                return R4D_NO(RAD_E_UNSUPPORTED);
+            cs_shape[0] = sh[0]; cs_shape[1] = sh[1]; cs_shape[2] = sh[2];
+            A.state_len = r4d_dim(cs, 2);
+            A.cs[kind] = (uint16_t*)r4d_wp(cs);
+        } else if (kind && A.cs[0]) {
+            return R4D_NO(RAD_E_UNSUPPORTED);
+        }
+        A.x[kind] = (const uint16_t*)r4d_p(x);
+        A.w[kind] = r4d_p(w);
+        A.dyn[kind] = (const uint16_t*)r4d_p(dy);
+        A.y[kind] = (uint16_t*)r4d_wp(y);
+    }
+    A.cs_slot = cs_shape[0]; A.cs_ch = cs_shape[1]; A.cs_tok = cs_shape[2];
+    A.q = (uint16_t*)r4d_wp(q);
+    A.q_sc = (const uint16_t*)r4d_p(qsc);
+    A.rel = (uint16_t*)r4d_wp(rel);
+    A.rel_sc = (const uint16_t*)r4d_p(rsc);
+    A.pos = (const int*)r4d_p(pos);
+    A.cu = (const int*)r4d_p(cu);
+    A.cidx = (const int*)r4d_p(cidx);
+    A.hini = (const int*)r4d_p(hini);
+    A.nacc = (const int*)r4d_p(nacc);
+    A.slot = (const int*)r4d_p(slot);
+    A.kv = (uint8_t*)r4d_wp(kv);
+    A.kv_blocks = kv->shape[0];
+    A.M = (int)M;
+    A.n_seq = (int)(r4d_numel(cu) - 1);
+    A.heads = (int)heads; A.kv_heads = (int)kvh; A.hd = (int)hd; A.d_rel = (int)d_rel;
+    A.wid = (int)wid; A.block_size = (int)bs;
+    A.qk_thr = (float)r4d_getf(a, "qk_clip", 0.0);
+    A.rel_thr = (float)r4d_getf(a, "rel_clip", 0.0);
+    A.clip_eps = (float)r4d_getf(a, "clip_eps", 1e-6);
+    A.norm_eps = (float)r4d_getf(a, "eps", 1e-6);
+    A.div = (float)r4d_getf(a, "div", 0.0);
+    A.alpha = (float)r4d_getf(a, "log_alpha", 0.0);
+    A.floor_n = (float)r4d_geti_or(a, "log_floor", 0);
+    if (A.n_seq <= 0 || !(A.qk_thr > 0.0f) || !(A.rel_thr > 0.0f) || !(A.div > 0.0f) ||
+        (pos && !(A.floor_n > 0.0f)) || (pos && r4d_numel(pos) < M))
+        return R4D_NO(RAD_E_SHAPE);
+    if (2 * kvh > 64) return R4D_NO(RAD_E_UNSUPPORTED);
+    const dim3 grid((uint32_t)(M * heads + M + 2 * kvh * M)), thr(kPrepThr);
+    const bool chain = r4d_geti_or(a, "chain", 0) != 0;
+    if (kv8)
+        return chain ? R4D_EMIT(stream, (qkv_prep_kernel<true, r4dchain>), grid, thr, 0, A)
+                     : R4D_EMIT(stream, (qkv_prep_kernel<true, R4dUnchained>), grid, thr, 0, A);
+    return chain ? R4D_EMIT(stream, (qkv_prep_kernel<false, r4dchain>), grid, thr, 0, A)
+                 : R4D_EMIT(stream, (qkv_prep_kernel<false, R4dUnchained>), grid, thr, 0, A);
+}
+
+}  /* extern "C" */
+
+/* Operand indices, from oAttnPagedRel in r4d_rows.cpp. */
+enum { RS_Q = 0, RS_KV, RS_BT, RS_SEQ, RS_KDS, RS_VDS, RS_CU, RS_REL, RS_PROJ, RS_SINKS, RS_OUT };
+
+/* attn_paged_rel_sink's operands at head_dim HD into `A`; `jcap` the keys the block table spans. */
+static int rel_sink_args(const RadArgs* a, int HD, RelSinkArgs& A, long long* jcap) {
+    const RadTensor* q = r4d_opt(a, RS_Q);
+    const RadTensor* kv = r4d_opt(a, RS_KV);
+    const RadTensor* bt = r4d_opt(a, RS_BT);
+    const RadTensor* su = r4d_opt(a, RS_SEQ);
+    const RadTensor* cu = r4d_opt(a, RS_CU);
+    const RadTensor* rel = r4d_opt(a, RS_REL);
+    const RadTensor* proj = r4d_opt(a, RS_PROJ);
+    const RadTensor* sinks = r4d_opt(a, RS_SINKS);
+    const RadTensor* o = r4d_opt(a, RS_OUT);
+    if (!q || !kv || !bt || !su || !rel || !proj || !sinks || !o) return R4D_NO(RAD_E_INVAL);
+    if (r4d_opt(a, RS_KDS) || r4d_opt(a, RS_VDS) || r4d_geti_or(a, "causal", 1) != 1)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    const bool i8 = kv->dtype == RAD_I8;
+    const long long slot = i8 ? 2 * HD + 4 : 2 * HD, esz = i8 ? 1 : 2;
+    if (q->dtype != RAD_BF16 || (!i8 && kv->dtype != RAD_BF16) || rel->dtype != RAD_BF16 ||
+        proj->dtype != RAD_BF16 || sinks->dtype != RAD_BF16 || o->dtype != RAD_BF16 ||
+        bt->dtype != RAD_I32 || su->dtype != RAD_I32 || (cu && cu->dtype != RAD_I32))
+        return R4D_NO(RAD_E_DTYPE);
+
+    const long long gqa = r4d_geti_or(a, "gqa", 1), window = r4d_geti_or(a, "window", 0);
+    const long long d_rel = r4d_geti_or(a, "d_rel", 0), extent = r4d_geti_or(a, "rel_extent", 0);
+    if (r4d_geti_or(a, "head_dim", 0) != HD || gqa <= 0 || window < 0 || d_rel <= 0 || extent <= 0)
+        return R4D_NO(RAD_E_SHAPE);
+    if (d_rel > kRsMaxRel) return R4D_NO(RAD_E_UNSUPPORTED);
+    if (kv->rank != 4 || bt->rank != 2 || kv->shape[2] != kBlock || kv->shape[3] != slot)
+        return R4D_NO(RAD_E_SHAPE);
+    if (kv->stride[3] != 1 || kv->stride[2] != slot || !r4d_contig(bt) || !r4d_contig(su) ||
+        (cu && !r4d_contig(cu)))
+        return R4D_NO(RAD_E_STRIDE);
+
+    const long long n_seq = bt->shape[0], kv_heads = kv->shape[1], q_heads = gqa * kv_heads;
+    long long rows = 0, heads = 0, ro = 0, rr = 0, rk = 0, rp = 0;
+    if (!r4d_head_rows(q, HD, &rows, &heads, &A.q_rs)) return R4D_NO(RAD_E_STRIDE);
+    A.out_rs = r4d_rows_pitch(o, q_heads * HD, &ro);
+    A.rel_rs = r4d_rows_pitch(rel, q_heads * d_rel, &rr);
+    A.sink_rs = r4d_rows_pitch(sinks, q_heads, &rk);
+    A.proj_rs = r4d_rows_pitch(proj, extent, &rp);
+    if (A.out_rs < 0 || A.rel_rs < 0 || A.sink_rs < 0 || A.proj_rs < 0)
+        return R4D_NO(RAD_E_STRIDE);
+    if (n_seq <= 0 || rows <= 0 || heads != q_heads || ro < rows || rr < rows || rk < rows ||
+        rp != d_rel || r4d_numel(su) != n_seq || (cu && r4d_numel(cu) != n_seq + 1) ||
+        (!cu && rows % n_seq))
+        return R4D_NO(RAD_E_SHAPE);
+    /* The int8 slot's scale word is read whole, so its rows are 4-byte aligned. */
+    const int kv_align = i8 ? 4 : 16;
+    if (!r4d_aligned(q->data, 16) || (A.q_rs * 2) % 16 || !r4d_aligned(kv->data, kv_align) ||
+        (kv->stride[0] * esz) % kv_align || (kv->stride[1] * esz) % kv_align)
+        return R4D_NO(RAD_E_ALIGN);
+    if (rows * q_heads > INT32_MAX) return R4D_NO(RAD_E_UNSUPPORTED);
+
+    *jcap = bt->shape[1] * kBlock;
+    A.q = (const uint16_t*)r4d_p(q);
+    A.kv = (const uint8_t*)r4d_p(kv);
+    A.kv_bs = kv->stride[0] * esz;
+    A.kv_hs = kv->stride[1] * esz;
+    A.bt = (const int*)r4d_p(bt);
+    A.su = (const int*)r4d_p(su);
+    A.cu = (const int*)r4d_p(cu);
+    A.rel = (const uint16_t*)r4d_p(rel);
+    A.proj = (const uint16_t*)r4d_p(proj);
+    A.sinks = (const uint16_t*)r4d_p(sinks);
+    A.out = (uint16_t*)r4d_wp(o);
+    A.n_seq = (int)n_seq;
+    A.q_len = (int)(rows / n_seq);
+    A.rows = (int)rows;
+    A.kv_heads = (int)kv_heads;
+    A.gqa = (int)gqa;
+    A.max_blocks = (int)bt->shape[1];
+    A.window = (int)window;
+    A.d_rel = (int)d_rel;
+    A.extent = (int)extent;
+    A.scale = (float)r4d_getf(a, "scale", 1.0f / std::sqrt((float)HD));
+    return RAD_OK;
+}
+
+/* Rows a launch may cut by span, and the scratch it may fill doing it: the spans' statistics and
+ * value sums, without which the launch runs rel_sink_tile_kernel. A launch whose rows have one
+ * span runs rel_sink_tile_kernel too, one launch for the span form's two. */
+constexpr long long kSplitRows = 64;
+constexpr long long kMergeHeads = 128;
+constexpr int64_t   kSplitBytes = 96LL << 20;
+
+/* Blocks a wave's rows reach from the first row's first key where no row has more than `keys`
+ * keys. The rows start within wave_rows keys of each other, so a window is a block longer for
+ * the wave than for a row. */
+static int tile_blocks(long long keys, long long window, long long wave_rows) {
+    long long blocks = (keys + kBlock - 1) / kBlock;
+    if (window > 0) blocks = std::min(blocks, (window + wave_rows - 2) / kBlock + 2);
+    return (int)std::max(1LL, blocks);
+}
+
+static int64_t tile_bias_bytes(long long rows, long long heads, long long extent) {
+    return (rows * heads * (extent + 2 * kBiasPad) * (int64_t)sizeof(uint16_t) + 15) & ~15LL;
+}
+
+static int64_t tile_span_bytes(long long rows, long long heads, long long nspan, int HD) {
+    return rows * heads * nspan * (HD + 2) * (int64_t)sizeof(float);
+}
+
+/* attn_paged_rel_sink_sparse's selection: its parameters, and the scratch after the spans'. */
+struct SparseGeom {
+    long long page = 0, per = 0, kpages = 0, reach = 0;
+    long long list_pitch = 0;   /* the most blocks a (row, kv head) keeps */
+};
+static bool sparse_geom(const RadArgs* a, long long rows, SparseGeom& G) {
+    const long long budget = r4d_geti_or(a, "sparse_budget", 0);
+    G.page = r4d_geti_or(a, "box_page", 0);
+    if (budget <= 0 || G.page <= 0 || G.page % kBlock) return false;
+    G.per = G.page / kBlock;
+    G.kpages = budget / G.page;
+    G.reach = std::max(r4d_geti_or(a, "sparse_last", 0), r4d_geti_or(a, "rel_extent", 0));
+    /* A sequence keeping all its blocks has pr - 1 <= kpages, so fewer than (kpages + 2) pages
+     * end before its reach; one keeping a selection keeps as many or fewer. */
+    G.list_pitch = ((G.kpages + 2) * G.page + G.reach + rows + kBlock - 1) / kBlock + 2;
+    return true;
+}
+static int64_t sparse_bytes(long long seqs, long long kvh, long long score_pitch,
+                            long long list_pitch) {
+    return seqs * kvh * (score_pitch + list_pitch + 1) * (int64_t)sizeof(int32_t);
+}
+
+/* The bias rows of the band's longest launch, and the spans of its widest launch cut by span;
+ * for the sparse op, a score plane and a kept list a (row, kv head) as well. */
+extern "C" int64_t r4d_rad_attn_rel_sink_scratch(const RadArgs* a) {
+    enum { HD = 128 };
+    const long long rows = std::max(1LL, r4d_geti_or(a, "q_len", 1));
+    const long long gqa = r4d_geti_or(a, "gqa", 1), heads = r4d_geti_or(a, "n_head", 0);
+    const long long max_ctx = r4d_geti_or(a, "max_ctx", 0);
+    if (heads <= 0 || max_ctx <= 0 || gqa <= 0 || gqa > kTq) return R4D_NO(RAD_E_INVAL);
+    const int blocks = tile_blocks(max_ctx + rows + kBlock, r4d_geti_or(a, "window", 0), kTq / gqa);
+    const long long cut = std::min(rows, kSplitRows);
+    int64_t bytes = tile_bias_bytes(rows, heads, r4d_geti_or(a, "rel_extent", 0)) +
+                    std::min(tile_span_bytes(cut, heads, span_count(blocks), HD), kSplitBytes);
+    SparseGeom G;
+    if (sparse_geom(a, cut, G)) {
+        const long long pitch = (max_ctx + rows + 2 * kBlock + G.page - 1) / G.page + 1;
+        bytes += sparse_bytes(cut, heads / gqa, pitch, G.list_pitch);
+    }
+    return bytes;
+}
+
+/* `S`: attn_paged_rel_sink_sparse's boxes and selection, its scratch fields unset; null for the
+ * dense op. A step the span form cuts keeps the selection's blocks, any other runs dense. */
+template <bool I8, class CH>
+static int rel_sink_emit(const RadArgs* a, RadStream stream, const RelSinkArgs& A,
+                         long long jcap, SparseArgs* S = nullptr, uint16_t* bias = nullptr) {
+    enum { HD = 128 };
+    const long long heads = (long long)A.kv_heads * A.gqa;
+    const long long keys = a->kv_used_max_h > 0 && a->kv_used_max_h < jcap ? a->kv_used_max_h : jcap;
+    const int64_t bias_bytes = tile_bias_bytes(A.rows, heads, A.extent);
+    if (!a->scratch || a->scratch_bytes < bias_bytes) return R4D_NO(RAD_E_SCRATCH);
+
+    TileArgs T{};
+    T.bias = bias ? bias : (uint16_t*)a->scratch;
+    T.bias_rs = A.extent + 2 * kBiasPad;
+    T.wave_rows = kTq / A.gqa;
+    T.nspan = span_count(tile_blocks(keys, A.window, T.wave_rows));
+    /* A launch whose keys all fit the kept list keeps every block: the dense form does that in
+     * fewer launches, and the host bound says when. */
+    if (S && (A.window != 0 || A.rows > kSplitRows ||
+              (a->kv_used_max_h > 0 &&
+               a->kv_used_max_h < (long long)(S->kpages + 2) * S->box_page + S->reach)))
+        S = nullptr;
+    int64_t sel_bytes = 0;
+    if (S) {
+        const long long score_pitch = (jcap + S->box_page - 1) / S->box_page + 1;
+        sel_bytes = sparse_bytes(A.rows, A.kv_heads, score_pitch, S->list_pitch);
+        int per = kListSpan, nspan = list_spans((int)S->list_pitch, per);
+        auto fits = [&] {
+            return bias_bytes + tile_span_bytes(A.rows, heads, nspan, HD) + sel_bytes <=
+                   a->scratch_bytes;
+        };
+        while (!fits() && per < (int)kWave) {
+            per *= 2;
+            nspan = list_spans((int)S->list_pitch, per);
+        }
+        if (nspan > 1 && fits()) {
+            T.nspan = nspan;
+            T.list_span = per;
+            T.wave_rows = 1;
+            S->score_pitch = (int)score_pitch;
+        } else {
+            S = nullptr;
+            sel_bytes = 0;
+        }
+    }
+    const int64_t span_bytes = tile_span_bytes(A.rows, heads, T.nspan, HD);
+    const int64_t spare = a->scratch_bytes - bias_bytes - span_bytes - sel_bytes;
+    T.stats = (float*)((char*)a->scratch + bias_bytes);
+    T.part = T.stats + A.rows * heads * T.nspan * 2;
+    if (S) {
+        S->score = T.part + A.rows * heads * T.nspan * HD;
+        S->list = (int*)(S->score + (size_t)A.rows * A.kv_heads * S->score_pitch);
+        S->nlist = S->list + (size_t)A.rows * A.kv_heads * S->list_pitch;
+        T.list = S->list;
+        T.list_pitch = S->list_pitch;
+        T.nlist = S->nlist;
+    }
+
+    const uint32_t kvh = (uint32_t)A.kv_heads;
+    const uint32_t bias_groups = (uint32_t)((heads + kBiasHeads - 1) / kBiasHeads);
+    const uint32_t bias_waves = (uint32_t)std::min<long long>(kThr / kWave, (A.extent + 255) / 256);
+    int r = bias ? RAD_OK
+                 : R4D_EMIT(stream, rel_bias_kernel<CH>,
+                            dim3(r4d_cliff_rows((uint32_t)A.rows, bias_groups, bias_waves) *
+                                 bias_groups),
+                            dim3(bias_waves * kWave), 0, A, T);
+    if (r != RAD_OK) return r;
+
+    /* Workgroups of `rows_wg` rows of a sequence, an upper bound where the rows are ragged. */
+    auto groups = [&](long long rows_wg) {
+        return (uint32_t)(A.cu ? (A.rows + rows_wg - 1) / rows_wg + A.n_seq
+                               : A.n_seq * ((A.q_len + rows_wg - 1) / rows_wg));
+    };
+    if (!S && (T.nspan == 1 || A.rows > kSplitRows || spare < 0)) {
+        RelSinkArgs At = A;
+        At.q8 = nullptr;
+        TileArgs Tt = T;
+        Tt.wg_queries = kTq % A.gqa ? kTileWaves * kTq : 0;
+        const long long qwg = Tt.wg_queries;
+        const uint32_t tg = !qwg ? groups((long long)kTileWaves * T.wave_rows)
+                            : (uint32_t)(A.cu ? (A.rows * A.gqa + qwg - 1) / qwg + A.n_seq
+                                              : A.n_seq * ((A.q_len * A.gqa + qwg - 1) / qwg));
+        r = R4D_EMIT(stream, (rel_sink_tile_kernel<HD, I8, CH>),
+                     dim3(r4d_cliff_rows(tg, kvh, kTileWaves) * kvh),
+                     dim3(kTileWaves * kWave), 0, At, Tt);
+        if (r == RAD_OK && A.q8)
+            r = R4D_EMIT(stream, (rel_sink_gate_quant_kernel<CH>),
+                         dim3((uint32_t)(A.rows * heads)), dim3(kWave), 0, A);
+        return r;
+    }
+
+    if (S) {
+        r = R4D_EMIT(stream, (sparse_score_kernel<HD, CH>),
+                     dim3((uint32_t)((S->score_pitch + 16 * kScoreWaves - 1) / (16 * kScoreWaves)),
+                          kvh, (uint32_t)A.n_seq),
+                     dim3(kScoreWaves * kWave), 0, A, *S);
+        if (r == RAD_OK)
+            r = R4D_EMIT(stream, (sparse_select_kernel<CH>), dim3(kvh, (uint32_t)A.rows),
+                         dim3(kSelThr), 0, A, *S);
+        if (r != RAD_OK) return r;
+    }
+    /* The merge waves wait on spans, so the whole grid must be resident at once: past that, a
+     * dispatcher that placed them first would leave the spans no room. */
+    static const long long resident = [] {
+#if !defined(__HIP__)
+        return 0LL;
+#else
+        int dev = 0, wgp = 0, dense = 0, list = 0;
+        if (hipGetDevice(&dev) != hipSuccess ||
+            hipDeviceGetAttribute(&wgp, hipDeviceAttributeMultiprocessorCount, dev) != hipSuccess ||
+            hipOccupancyMaxActiveBlocksPerMultiprocessor(
+                &dense, (const void*)rel_sink_span_kernel<HD, I8, false, CH>, kWave, 0) != hipSuccess ||
+            hipOccupancyMaxActiveBlocksPerMultiprocessor(
+                &list, (const void*)rel_sink_span_kernel<HD, I8, true, CH>, kWave, 0) != hipSuccess)
+            return 0LL;
+        return (long long)wgp * std::min(dense, list);
+#endif
+    }();
+    const uint32_t gx = groups(T.wave_rows) * kvh, queries = (uint32_t)(A.rows * heads);
+    const long long merge_rows = (queries + gx - 1) / gx;
+    if (queries <= kSplitRows * kMergeHeads && (long long)gx * (T.nspan + merge_rows) <= resident)
+        T.done = r4d::keyed_block(r4d::Keyed::RelSink, stream, A.out,
+                                  (size_t)kSplitRows * kMergeHeads * sizeof(unsigned));
+    const dim3 grid(gx, (uint32_t)(T.nspan + (T.done ? merge_rows : 0))), wave(kWave);
+    r = T.list ? R4D_EMIT(stream, (rel_sink_span_kernel<HD, I8, true, CH>), grid, wave, 0, A, T)
+               : R4D_EMIT(stream, (rel_sink_span_kernel<HD, I8, false, CH>), grid, wave, 0, A, T);
+    if (r == RAD_OK && !T.done)
+        r = R4D_EMIT(stream, (rel_sink_merge_kernel<HD, I8, CH>), dim3((uint32_t)(A.rows * heads)),
+                     wave, 0, A, T);
+    return r;
+}
+
+template <bool I8, bool GQ = false>
+static int rel_sink_h128(const RadArgs* a, RadStream stream) {
+    RelSinkArgs A{};
+    long long jcap = 0;
+    const int rc = rel_sink_args(a, 128, A, &jcap);
+    if (rc != RAD_OK) return rc;
+    if (A.gqa > kTq) return R4D_NO(RAD_E_UNSUPPORTED);
+    if ((r4d_opt(a, RS_KV)->dtype == RAD_I8) != I8) return R4D_NO(RAD_E_DTYPE);
+    if constexpr (GQ) {
+        const RadTensor* g = r4d_opt(a, RS_OUT + 1);
+        const RadTensor* q8 = r4d_opt(a, RS_OUT + 2);
+        const RadTensor* s8 = r4d_opt(a, RS_OUT + 3);
+        const long long n = (long long)A.kv_heads * A.gqa * 128;
+        if (!g || !q8 || !s8) return R4D_NO(RAD_E_INVAL);
+        if (g->dtype != RAD_BF16 || q8->dtype != RAD_I8 || s8->dtype != RAD_F32)
+            return R4D_NO(RAD_E_DTYPE);
+        if (r4d_geti_or(a, "group", 128) != 128 || !r4d_gets(a, "act") ||
+            std::strcmp(r4d_gets(a, "act"), "sigmoid_f32") != 0)
+            return R4D_NO(RAD_E_UNSUPPORTED);
+        long long gm = 0, qm = 0, sm = 0;
+        A.gate_rs = r4d_rows_pitch(g, n, &gm);
+        A.q8_rs = r4d_rows_pitch(q8, n, &qm);
+        A.s8_rs = r4d_rows_pitch(s8, n / 128, &sm);
+        if (A.gate_rs < 0 || A.q8_rs < 0 || A.s8_rs < 0 || A.q8_rs % 4)
+            return R4D_NO(RAD_E_STRIDE);
+        if (gm < A.rows || qm < A.rows || sm < A.rows) return R4D_NO(RAD_E_SHAPE);
+        A.gate = (const uint16_t*)g->data;
+        A.q8 = (uint8_t*)q8->data;
+        A.s8 = (float*)s8->data;
+    }
+    /* attn_qkv_prep's bias rows, in place of rel_bias_kernel's. */
+    uint16_t* bias = nullptr;
+    if (const RadTensor* bt = GQ ? r4d_opt(a, RS_OUT + 4) : nullptr) {
+        if (bt->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+        if (!r4d_contig(bt)) return R4D_NO(RAD_E_STRIDE);
+        if (r4d_numel(bt) < (long long)A.rows * A.kv_heads * A.gqa * (A.extent + 2 * kBiasPad))
+            return R4D_NO(RAD_E_SHAPE);
+        if (!r4d_aligned(bt->data, 16)) return R4D_NO(RAD_E_ALIGN);
+        bias = (uint16_t*)r4d_wp(bt);
+    }
+    return r4d_geti_or(a, "chain", 0) != 0 && A.rows <= 64
+               ? rel_sink_emit<I8, r4dchain>(a, stream, A, jcap, nullptr, bias)
+               : rel_sink_emit<I8, R4dUnchained>(a, stream, A, jcap, nullptr, bias);
+}
+
+extern "C" int r4d_rad_attn_rel_sink_h128_bf16(const RadArgs* a, RadStream stream) {
+    return rel_sink_h128<false>(a, stream);
+}
