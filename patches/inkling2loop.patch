+        /* u, then the rank state, x and m widened, and y. */
+        float* u = scratch_f32((size_t)(5 * n + k));
+        float* rk = u + 2 * n;
+        float* xm = rk + k;
+        float* sy = xm + 2 * n;
+        float* sw = scratch_f32_b((size_t)std::max(2 * n, 2 * k));
+        const RadTensor* in[2] = { X, M };
+        for (int h = 0; h < 2; ++h) {
+            const float* v = in_row(in[h], rowoff(in[h], r, n), n, xm + h * n);
+            if (v != xm + h * n) std::memcpy(xm + h * n, v, (size_t)n * sizeof(float));
