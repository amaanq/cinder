+/* The NVFP4 and MXFP8 grouped MoE GEMMs against an f64 host product over the decoded experts.
+ *
+ * rad-kbench reaches these rows only with `a_scale` present, since libref describes the operand
+ * for every dtype, and Inkling 2 issues them without one. So the form without is checked here,
+ * stacked and through pointer tables, and the form with one beside it. The routing is
+ * moe_gemm_bf16_case's, dropped slots included. */
+static void moe_gemm_a16_case(const Plugin& pl, bool nv, int64_t Mtok, const MoeBf16Shape& sh) {
+    const char* const row = nv ? "moe_gemm_nvfp4a16" : "moe_gemm_mxfp8a16";
+    const RadKernelInfo* r = find(pl, row);
+    const std::string what = std::string(row) + " vs an f64 host product (" + sh.name + ", " +
+                             std::to_string(Mtok) + " tokens)";
+    if (!r) { ok(what.c_str(), false, "row absent"); return; }
+
+    const int64_t N = sh.N, K = sh.K, E = sh.ne, top_k = sh.top_k, Tr = Mtok * top_k;
+    const int64_t group = nv ? 16 : 32, ng = K / group;
+    uint64_t rs = 0x9E3779B97F4A7C15ull ^ (uint64_t)(N * 131 + K * 7 + E + Mtok + (nv ? 1 : 0));
+    auto rnd  = [&]() { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; };
+    auto unif = [&]() { return ((double)(rnd() >> 11) + 0.5) * (1.0 / 9007199254740992.0); };
+
+    std::vector<double> logp((size_t)E);
+    for (int64_t e = 0; e < E; ++e)
+        logp[(size_t)e] = 1.0 * std::sqrt(-2.0 * std::log(unif())) * std::cos(6.283185307 * unif());
+    std::vector<std::vector<int32_t>> by_e((size_t)E);
+    std::vector<std::pair<double, int>> sc((size_t)E);
+    const int64_t kept = Mtok > 4 ? Mtok - 3 : Mtok;
+    for (int64_t t = 0; t < kept; ++t) {
+        for (int64_t e = 0; e < E; ++e)
+            sc[(size_t)e] = { logp[(size_t)e] - std::log(-std::log(unif())), (int)e };
+        std::partial_sort(sc.begin(), sc.begin() + top_k, sc.end(),
+                          [](const std::pair<double, int>& x, const std::pair<double, int>& y) {
+                              return x.first > y.first;
+                          });
+        for (int64_t j = 0; j < top_k; ++j)
+            by_e[(size_t)sc[(size_t)j].second].push_back((int32_t)(t * top_k + j));
+    }
+    std::vector<int32_t> off((size_t)(E + 1), 0), sorted;
+    sorted.reserve((size_t)Tr);
+    for (int64_t e = 0; e < E; ++e) {
+        off[(size_t)(e + 1)] = off[(size_t)e] + (int32_t)by_e[(size_t)e].size();
+        sorted.insert(sorted.end(), by_e[(size_t)e].begin(), by_e[(size_t)e].end());
+    }
+    const int64_t live = off[(size_t)E];
+    sorted.resize((size_t)Tr, -1);
+
+    /* An expert's codes are [N][K] row-major, and its scale entry what the layout hook stores:
+     * NVFP4's f32 level and then an E4M3 per (row, 16 of K), MXFP8's E8M0 per (row, 32 of K).
+     * The even experts' entries come first and the odd ones' after, a stacked table a class. */
+    const int64_t AR = sh.srt ? Tr : Mtok, ne0 = (E + 1) / 2;
+    auto slot = [&](int64_t e) { return (size_t)((e & 1) ? ne0 + e / 2 : e / 2); };
+    const size_t wb = (size_t)(nv ? N * K / 2 : N * K);
+    const size_t sb = (size_t)(nv ? R4D_NVFP4_LEVEL_BYTES + N * ng : N * ng);
+    std::vector<uint16_t> ah((size_t)(AR * K));
+    std::vector<float> ash((size_t)(AR * ng));
+    std::vector<uint8_t> wh((size_t)E * wb), swh((size_t)E * sb);
+    for (auto& v : ah) v = h_to_bf16((float)((double)(int64_t)(rnd() % 2001) - 1000.0) / 700.0f);
+    for (auto& v : ash) v = 0.25f + (float)unif();
+    for (auto& v : wh) {
+        v = (uint8_t)rnd();
+        if (!nv && (v & 0x7fu) == 0x7fu) v ^= 1u;
+    }
+    for (int64_t e = 0; e < E; ++e) {
+        uint8_t* s = &swh[slot(e) * sb];
+        if (nv) {
+            const float level = (float)(0.002 + 0.01 * unif());
+            std::memcpy(s, &level, sizeof level);
+            s += R4D_NVFP4_LEVEL_BYTES;
+        }
+        for (int64_t i = 0; i < N * ng; ++i)
+            s[i] = nv ? (uint8_t)(0x20u + rnd() % 0x30u) : (uint8_t)(123u + rnd() % 9u);
+    }
+    auto weight = [&](int64_t e, int64_t n, int64_t k) {
+        const uint8_t* w = &wh[slot(e) * wb];
+        const uint8_t* s = &swh[slot(e) * sb];
+        if (!nv)
+            return (double)h_e4m3(w[n * K + k]) * (double)rad_e8m0_to_f32(s[n * ng + k / group]);
+        float level;
+        std::memcpy(&level, s, sizeof level);
+        const uint8_t code = (uint8_t)(w[n * (K / 2) + k / 2] >> (4 * (k & 1)) & 0xfu);
+        return (double)rad_fp4e2m1_to_f32(code) *
+               (double)h_e4m3(s[R4D_NVFP4_LEVEL_BYTES + n * ng + k / group]) * (double)level;
+    };
+
+    /* Every output element with and without the activation's scale, and the sum of its terms'
+     * magnitudes, which bounds what an f32 accumulation in another order can move. */
+    std::vector<double> ref[2], mag[2];
+    for (int v = 0; v < 2; ++v) {
+        ref[v].assign((size_t)(Tr * N), 0.0);
+        mag[v].assign((size_t)(Tr * N), 0.0);
+    }
+    st_par_for(live * N, [&](int64_t x) {
+        const int64_t i = x / N, n = x % N;
+        const int32_t f = sorted[(size_t)i];
+        int64_t e = 0;
+        while (e + 1 < E && off[(size_t)(e + 1)] <= i) ++e;
+        const int64_t arow = sh.srt ? i : f / top_k;
+        double acc[2] = { 0.0, 0.0 }, am[2] = { 0.0, 0.0 };
+        for (int64_t k = 0; k < K; ++k) {
+            const double p = (double)h_bf16(ah[(size_t)(arow * K + k)]) * weight(e, n, k);
+            const double sa = (double)ash[(size_t)(arow * ng + k / group)];
+            acc[0] += p;
+            am[0] += std::fabs(p);
+            acc[1] += p * sa;
+            am[1] += std::fabs(p) * sa;
+        }
+        for (int v = 0; v < 2; ++v) {
+            ref[v][(size_t)x] = acc[v];
+            mag[v][(size_t)x] = am[v];
+        }
+    });
+
+    void* d_w  = dalloc(wh.size());
+    void* d_sw = dalloc(swh.size());
+    void* d_a  = dalloc(ah.size() * 2);
+    void* d_as = dalloc(ash.size() * 4);
+    void* d_s  = dalloc((size_t)Tr * 4);
+    void* d_o  = dalloc((size_t)(E + 1) * 4);
+    void* d_y  = dalloc((size_t)(Tr * N) * 2);
+    void* d_tab = dalloc((size_t)E * 2 * sizeof(void*));
+    if (!d_w || !d_sw || !d_a || !d_as || !d_s || !d_o || !d_y || !d_tab) {
+        ok(what.c_str(), false, "alloc failed");
+        dfree_all();
+        return;
+    }
+    /* The pointer tables: the codes' entries, then the scales'. */
+    std::vector<const void*> tab((size_t)E * 2);
+    for (int64_t at = 0; at < E; ++at) {
+        tab[(size_t)at] = (const char*)d_w + (size_t)at * wb;
+        tab[(size_t)(E + at)] = (const char*)d_sw + (size_t)at * sb;
+    }
+    st_memcpy(d_w, wh.data(), wh.size(), hipMemcpyHostToDevice);
+    st_memcpy(d_sw, swh.data(), swh.size(), hipMemcpyHostToDevice);
+    st_memcpy(d_tab, tab.data(), tab.size() * sizeof(void*), hipMemcpyHostToDevice);
+    st_memcpy(d_a, ah.data(), ah.size() * 2, hipMemcpyHostToDevice);
+    st_memcpy(d_as, ash.data(), ash.size() * 4, hipMemcpyHostToDevice);
+    st_memcpy(d_s, sorted.data(), sorted.size() * 4, hipMemcpyHostToDevice);
+    st_memcpy(d_o, off.data(), off.size() * 4, hipMemcpyHostToDevice);
+
+    std::vector<RadParam> ps = {
+        PI("M", Mtok), PI("N", N), PI("K", K), PI("n_expert", E), PI("top_k", top_k),
+        PI("group", group), PS("a_order", sh.srt ? "sorted" : "token"),
+        PS("dtype", nv ? "nvfp4a16" : "mxfp8a16"),
+    };
+    const uint32_t wdt = nv ? (uint32_t)RAD_FP4E2M1 : (uint32_t)RAD_F8E4M3;
+    const uint32_t sdt = nv ? (uint32_t)R4D_DT_NVFP4_S : (uint32_t)RAD_E8M0;
+    static const char* const kPass[] = { "stacked", "pointer tables", "stacked, a_scale present" };
+    std::vector<uint16_t> got((size_t)(Tr * N));
+    for (int pass = 0; pass < 3; ++pass) {
+        const int v = pass == 2;
+        std::vector<RadTensor> ts = {
+            T(d_a, RAD_BF16, { AR, K }), T(d_as, RAD_F32, { AR, ng }),
+            T(d_w, wdt, { ne0, N, K }), T(d_sw, sdt, { ne0, N, ng }),
+            T(d_s, RAD_I32, { Tr }), T(d_o, RAD_I32, { E + 1 }),
+            T((char*)d_w + (size_t)ne0 * wb, wdt, { E / 2, N, K }),
+            T((char*)d_sw + (size_t)ne0 * sb, sdt, { E / 2, N, ng }),
+            T(d_y, RAD_BF16, { Tr, N }),
+        };
+        if (!v) absent(ts[1]);
+        if (pass == 1) {
+            const void** dt = (const void**)d_tab;
+            ts[2].data = dt;
+            ts[6].data = dt + ne0;
+            ts[3].data = dt + E;
+            ts[7].data = dt + E + ne0;
+            for (const int k : { 2, 3, 6, 7 }) ts[(size_t)k].stride[0] = 0;
+        }
+        RadArgs a;
+        std::memset(&a, 0, sizeof(a));
+        a.t = ts.data(); a.n_t = (int)ts.size();
+        a.p = ps.data(); a.n_p = (int)ps.size();
+        const int64_t need = r->scratch ? r->scratch(&a) : 0;
+        void* d_map = need > 0 ? dalloc((size_t)need) : nullptr;
+        a.scratch = d_map;
+        a.scratch_bytes = need;
+        {
+            std::vector<uint16_t> junk((size_t)(Tr * N), 0x7f7fu);
+            st_memcpy(d_y, junk.data(), junk.size() * 2, hipMemcpyHostToDevice);
+        }
+        const std::string label = what + " " + kPass[pass];
+        const int rc = r->launch(&a, nullptr);
+        st_stream_sync(nullptr);
+        if (rc != RAD_OK) { ok(label.c_str(), false, "launch rc=" + std::to_string(rc)); continue; }
+        st_memcpy(got.data(), d_y, got.size() * 2, hipMemcpyDeviceToHost);
+
+        double rel_max = 0.0, num = 0.0, den = 0.0;
+        int64_t bad = 0;
+        std::string firstbad;
+        for (int64_t x = 0; x < Tr * N; ++x) {
+            const double want = ref[v][(size_t)x];
+            const double gf = (double)h_bf16(got[(size_t)x]);
+            /* Half a bf16 ulp of the value, and a K-term f32 sum's rounding over its terms. NaN
+             * is a miss, and a dropped slot must read exactly zero. */
+            const double err = std::fabs(gf - want);
+            const double tol = 0.004 * std::fabs(want) + 4e-4 * mag[v][(size_t)x];
+            num += err * err;
