+/* A fold row's bias, fold_b[t] + fold[t] . latent. With `scale` (an int8 fold's bf16 scale per
+ * 128 of a row) the codes are summed a scale group at a time and the group's sum is scaled, as
+ * libr4d's walk does. */
+static float fold_bias(const RadTensor* fold, const RadTensor* fold_b, const RadTensor* scale,
+                       int64_t t, int64_t R, const float* latent) {
+    const int64_t fb = rowoff(fold, t, R), fs = laststride(fold);
+    float b = ldt(fold_b, offlin(fold_b, t));
+    if (!scale) {
+        for (int64_t r = 0; r < R; ++r) b += latent[r] * ldt(fold, fb + r * fs);
+        return b;
