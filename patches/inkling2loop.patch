+    sp.answer_reserve = (int32_t)i64;
+    names("answer_reserve_tokens", i64 >= 0);
+
+    i64 = sp.loop_guard;
+    if (!get_int(b, "loop_guard", &i64, err)) return RAD_E_INVAL;
+    if (!in_range("loop_guard", (double)i64)) return RAD_E_INVAL;
+    sp.loop_guard = (int32_t)i64;
+    names("loop_guard", i64 > 0);
+
+    i64 = sp.answer_after_close;
+    if (!get_int(b, "answer_max_after_close", &i64, err)) return RAD_E_INVAL;
+    if (!in_range("answer_max_after_close", (double)i64)) return RAD_E_INVAL;
+    sp.answer_after_close = (int32_t)i64;
+    names("answer_max_after_close", i64 >= 0);
+
