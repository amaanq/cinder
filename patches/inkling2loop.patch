+/* The norms over f32 rows (rmsnorm_f32 with a gain, rmsnorm_p_f32 without), into bf16 and into
+ * f32, the row a column slice. */
+void norm_f32_cases(const Plugin& pl, bool gain) {
+    const char* name = gain ? "rmsnorm_f32" : "rmsnorm_p_f32";
+    const RadKernelInfo* r = find(pl, name);
+    if (!r) { ok(name, false, "row absent"); return; }
+    const int64_t M = 9, n = 2304, ld = 2 * n;
+    const float eps = 1e-6f;
+    std::vector<float> x = randv((size_t)(M * ld), 30.0f), w = randv((size_t)n, 1.0f);
+    void* dx = up_f32(x);
+    void* dw = up_f32(w);
+    for (const bool yf : { false, true }) {
+        void* dy = dalloc((size_t)(M * n) * (yf ? 4 : 2));
+        RadTensor tx = T((float*)dx + n, RAD_F32, { M, n });
+        tx.stride[0] = ld;
+        std::vector<RadTensor> ts = { tx };
+        if (gain) ts.push_back(T(dw, RAD_F32, { n }));
+        ts.push_back(T(dy, yf ? RAD_F32 : RAD_BF16, { M, n }));
+        const int rc = launch(r, ts, { PI("M", M), PI("n", n), PF("eps", (double)eps),
+                                       PS("dtype", "f32") });
+        const std::string nm = fmt("%s -> %s", name, yf ? "f32" : "bf16");
+        if (rc != RAD_OK) { ok(nm.c_str(), false, "rc " + std::to_string(rc)); continue; }
+        std::vector<float> want((size_t)(M * n));
+        for (int64_t m = 0; m < M; ++m) {
+            const float* xr = x.data() + m * ld + n;
+            double ss = 0;
+            for (int64_t i = 0; i < n; ++i) ss += (double)xr[i] * xr[i];
+            const double s = 1.0 / std::sqrt(ss / (double)n + eps);
+            for (int64_t i = 0; i < n; ++i)
+                want[(size_t)(m * n + i)] = (float)((double)xr[i] * s * (gain ? w[(size_t)i] : 1.0f));
+        }
+        if (yf) check_f32(nm + " numerics", down_f32(dy, want.size()), want, 1e-5);
+        else    check(nm + " numerics", down_bf16(dy, want.size()), want, 1e-2);
+    }
+}
