+/* ---- moe_gemm_nvfp4a16 and moe_gemm_mxfp8a16 (r4d_moe_a16.hip). The codes and MXFP8's exponents
+ * are read row-major as stored. NVFP4's scale view takes both levels, and its entry is the
+ * expert's f32 followed by the E4M3 plane unchanged: one size an expert, which the joined form of
+ * abi/rad_planes.h under a core dtype is not for a stacked table. */
+namespace {
+
+/* moe_a16_kernel's weight tile, rows by K. */
+constexpr long long kA16Tile = 16, kA16Block = 64;
+
+bool nvfp4_enc(const RadEncoding* e) {
+    if (!e || !rad_enc_is(e, "affine") || e->transform[0] || e->n_planes != 3) return false;
+    if (e->plane[0].dtype != RAD_FP4E2M1 || e->plane[0].block[1] != 1) return false;
+    const int s = rad_enc_find(e, "scale"), s1 = rad_enc_find(e, "scale.1");
+    return s >= 0 && e->plane[s].dtype == RAD_F8E4M3 && e->plane[s].kind == RAD_PLANE_TILED &&
+           e->plane[s].block[0] == 1 && e->plane[s].block[1] == 16 && s1 >= 0 &&
+           e->plane[s1].dtype == RAD_F32 && e->plane[s1].kind == RAD_PLANE_TILED &&
+           e->plane[s1].block[0] == 0 && e->plane[s1].block[1] == 0;
+}
+
+int moe_a16_layout(const RadParam* p, int n_p, int operand, const RadEncoding* enc, const int* sel,
+                   const RadTensor* pl, int n, RadLayout* out) {
+    if (!pl) return RAD_E_INVAL;
+    MoeView v;
+    const int rc = moe_view(p, n_p, operand, &v);
+    if (rc != RAD_OK) return rc;
+    if (v.operand != Q_B && v.operand != Q_BSCALE) return RAD_E_UNSUPPORTED;
+    const char* d = r4d_pgets(v.p, v.n, "dtype");
+    const bool nv = d && std::strcmp(d, "nvfp4a16") == 0;
+    const long long N = r4d_pgeti_or(v.p, v.n, "N", 0), K = r4d_pgeti_or(v.p, v.n, "K", 0);
+    const long long group = nv ? 16 : R4D_MXFP4_GROUP;
+    if (N <= 0 || K <= 0 || K % group) return RAD_E_SHAPE;
+    if (nv ? !nvfp4_enc(enc) : !r4d_enc::affine(enc, RAD_F8E4M3, RAD_E8M0, 1, group))
+        return RAD_E_DTYPE;
+    if (v.operand == Q_B) {
+        if (!selects(enc, sel, n, "codes") || !dims(pl[0], N, K)) return RAD_E_SHAPE;
+        if (!nv) return RAD_E_UNSUPPORTED;
+        if (!out) return RAD_E_INVAL;
+        if (N % kA16Tile || K % kA16Block) return RAD_E_SHAPE;
+        fill(out, "r4d.nvfp4.tile", RAD_FP4E2M1, N, K, N * K / 2);
+        return RAD_OK;
+    }
+    if (!nv)
+        return selects(enc, sel, n, "scale") && dims(pl[0], N, K / group) ? RAD_E_UNSUPPORTED
+                                                                           : RAD_E_SHAPE;
+    if (!out) return RAD_E_INVAL;
+    if (!selects(enc, sel, n, "scale", "scale.1") || !dims(pl[0], N, K / group) ||
+        !dims(pl[1], 1, 1))
+        return RAD_E_SHAPE;
+    if (N % kA16Tile || K % kA16Block) return RAD_E_SHAPE;
+    fill(out, "r4d.nvfp4.s.tile", R4D_DT_NVFP4_S, N, K / group,
+         R4D_NVFP4_LEVEL_BYTES + N * (K / group));
+    return RAD_OK;
+}
+
+/* r4d.nvfp4.tile: for each tile of 16 rows and each 64 of K, the 512 bytes moe_a16_kernel's wave
+ * reads, lane L's 16 at 16 L: the four words of row L % 16 at byte 32 kb + 4 (L / 16) + 8 s, one
+ * a WMMA step s. r4d.nvfp4.s.tile: the expert's f32, then for each tile and 64 of K the rows'
+ * four scales in row order, 64 bytes. Each wave's walk down K is then one contiguous stream. */
+void a16_tile_codes(const uint8_t* src, uint8_t* dst, long long N, long long K) {
+    const long long rb = K / 2, nkb = K / kA16Block;
+    for (long long t = 0; t < N / kA16Tile; ++t)
+        for (long long kb = 0; kb < nkb; ++kb)
+            for (int lane = 0; lane < 32; ++lane)
+                for (int st = 0; st < 4; ++st)
+                    std::memcpy(dst + ((t * nkb + kb) * 32 + lane) * 16 + st * 4,
+                                src + (t * kA16Tile + lane % 16) * rb + kb * 32 + (lane / 16) * 4 +
+                                    st * 8,
+                                4);
+}
+void a16_tile_scales(const uint8_t* src, uint8_t* dst, long long N, long long K) {
+    const long long rb = K / 16, nkb = K / kA16Block;
+    for (long long t = 0; t < N / kA16Tile; ++t)
+        for (long long kb = 0; kb < nkb; ++kb)
+            for (int r = 0; r < kA16Tile; ++r)
+                std::memcpy(dst + ((t * nkb + kb) * kA16Tile + r) * 4,
+                            src + (t * kA16Tile + r) * rb + kb * 4, 4);
+}
+
+}  /* namespace */
+
+extern "C" int r4d_rad_layout_moe_a16(const RadParam* p, int n_p, int operand,
+                                      const RadEncoding* enc, const int* sel, const RadTensor* pl,
+                                      int n, RadLayout* out) {
+    return moe_a16_layout(p, n_p, operand, enc, sel, pl, n, out);
+}
+extern "C" int r4d_rad_relayout_moe_a16(const RadParam* p, int n_p, int operand,
+                                        const RadEncoding* enc, const int* sel,
+                                        const RadTensor* pl, int n, void* dst, int64_t dst_bytes) {
+    RadLayout L;
+    const int rc = moe_a16_layout(p, n_p, operand, enc, sel, pl, n, &L);
+    if (rc != RAD_OK) return rc;
+    if (dst_bytes != L.bytes || !pl[0].data) return RAD_E_SHAPE;
+    const long long N = L.shape[0], K = L.dtype == RAD_FP4E2M1 ? L.shape[1] : L.shape[1] * 16;
+    if (L.dtype == RAD_FP4E2M1) {
+        a16_tile_codes((const uint8_t*)pl[0].data, (uint8_t*)dst, N, K);
+        return RAD_OK;
+    }
+    if (!pl[1].data) return RAD_E_SHAPE;
+    std::memcpy(dst, pl[1].data, R4D_NVFP4_LEVEL_BYTES);
+    a16_tile_scales((const uint8_t*)pl[0].data, (uint8_t*)dst + R4D_NVFP4_LEVEL_BYTES, N, K);
+    return RAD_OK;
+}
+
+/* moe_ffn_q's tables (r4d_moe_a16.hip): operands 3-6 are gate_up's, laid out as moe_gemm_q's 2,
+ * 3, 6 and 7 at [N, K], and 7-10 down's at [K, N / 2]. */
+namespace {
+int ffn_view(const RadParam* p, int n_p, int operand, MoeView* v) {
+    if (n_p < 0 || n_p > 30 || (n_p > 0 && !p) || operand < 3 || operand > 10)
+        return RAD_E_UNSUPPORTED;
+    static const int kQ[4] = { 2, 3, 6, 7 };
+    const bool down = operand >= 7;
+    const long long N = r4d_pgeti_or(p, n_p, "N", 0), K = r4d_pgeti_or(p, n_p, "K", 0);
+    v->n = n_p;
+    v->operand = kQ[(operand - 3) % 4];
+    for (int i = 0; i < n_p; ++i) {
+        v->p[i] = p[i];
+        if (!down || !p[i].key) continue;
+        if (std::strcmp(p[i].key, "N") == 0) v->p[i].ival = K;
+        if (std::strcmp(p[i].key, "K") == 0) v->p[i].ival = N / 2;
+    }
+    return RAD_OK;
+}
+}  /* namespace */
+
+extern "C" int r4d_rad_layout_moe_ffn(const RadParam* p, int n_p, int operand,
+                                      const RadEncoding* enc, const int* sel, const RadTensor* pl,
+                                      int n, RadLayout* out) {
+    MoeView v;
+    const int rc = ffn_view(p, n_p, operand, &v);
+    return rc != RAD_OK ? rc : moe_a16_layout(v.p, v.n, v.operand, enc, sel, pl, n, out);
+}
+extern "C" int r4d_rad_relayout_moe_ffn(const RadParam* p, int n_p, int operand,
+                                        const RadEncoding* enc, const int* sel,
+                                        const RadTensor* pl, int n, void* dst, int64_t dst_bytes) {
+    MoeView v;
+    const int rc = ffn_view(p, n_p, operand, &v);
+    return rc != RAD_OK ? rc : r4d_rad_relayout_moe_a16(v.p, v.n, v.operand, enc, sel, pl, n, dst,
+                                                        dst_bytes);
