+/* A page box's bf16 elements a token of its page: 2 * head_dim code bytes and a 4-byte step over
+ * `page` tokens, as a cache slot of K and V (inkling2loop's kv_box). */
+static int64_t box_slot(int64_t head_dim, int64_t page) {
+    return 2 * ((head_dim + 2 + 2 * page - 1) / (2 * page));
+}
