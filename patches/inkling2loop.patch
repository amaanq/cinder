diff --git a/tests/r4d_emu/test_relsink.cpp b/tests/r4d_emu/test_relsink.cpp
new file mode 100644
index 0000000000..1ea4eb069c
--- /dev/null
+++ b/tests/r4d_emu/test_relsink.cpp
@@ -0,0 +1,209 @@ typedef int (*LaunchFn)(const RadArgs*, RadStream);
+/* tests/r4d_emu: attn_paged_rel_sink (r4d_inkling.hip) on the host SIMT emulator, over the bf16 and
+ * the int8 cache, against libref's ref_attn_paged_rel_sink when $RADIANCE_HOME holds one (ctest
+ * sets it). The cases reach both forms: a decode's rows cut by span (more than kNearSpans spans,
+ * scratch present) and a prefill's tile kernel, with a window, a missing block and ragged
+ * sequences. Each output is held to rel_l2 2e-2 against libref, rad-kbench's bound for a bf16
+ * attention; the decode rows of a case are also run again in a launch of their own, whose bytes
+ * the tile form must equal (prefill against decode). */
+#include "rad_abi.h"
+#include "rad_plugin.h"
+#include "r4d_plugin.h"
+#include "ref_host.h"
+
+#include <dlfcn.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+typedef int (*LaunchFn)(const RadArgs*, RadStream);
+
+static LaunchFn load_libref() {
+    const char* home = std::getenv("RADIANCE_HOME");
+    if (!home || !*home) return nullptr;
+    void* h = dlopen((std::string(home) + "/kernels/libref.so").c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!h) return nullptr;
+    auto open = (int (*)(void))dlsym(h, "rad_plugin_open");
+    if (open && open() < 0) return nullptr;
+    auto cnt = (int (*)(void))dlsym(h, "rad_kernel_count");
+    auto at = (const RadKernelInfo* (*)(int))dlsym(h, "rad_kernel_at");
+    if (!cnt || !at) return nullptr;
+    for (int i = 0; i < cnt(); ++i) {
+        const RadKernelInfo* k = at(i);
+        if (k && k->op && !std::strcmp(k->op, "attn_paged_rel_sink")) return k->launch;
+    }
+    return nullptr;
+}
+
+struct Case {
+    const char* name;
+    bool i8;
+    int window;
+    std::vector<int> q_len, ctx;   /* a sequence each */
+    bool hole;                     /* the first sequence's second block unmapped */
+};
+
+enum { HD = 128, GQA = 3, KVH = 2, NH = GQA * KVH, DREL = 16, EXT = 1024, BS = 16 };
+
+static void tensor(RadTensor& t, void* d, uint32_t dt, std::initializer_list<int64_t> s) {
+    t = RadTensor{};
+    t.data = d;
+    t.dtype = dt;
+    t.rank = (uint32_t)s.size();
+    int i = 0;
+    for (int64_t e : s) t.shape[i++] = e;
+    int64_t st = 1;
+    for (int k = (int)t.rank - 1; k >= 0; --k) { t.stride[k] = st; st *= t.shape[k]; }
+}
+
+static void put_i8(uint8_t* row, const float* x, int half) {
+    float am = 0.0f;
+    for (int d = 0; d < HD; ++d) am = std::fmax(am, std::fabs(x[d]));
+    const uint16_t h = rad_f32_to_f16(std::fmin(am / 127.0f, 515.0f));
+    const float sc = rad_f16_to_f32(h);
+    for (int d = 0; d < HD; ++d) {
+        const float q = sc > 0.0f ? std::nearbyint(x[d] / sc) : 0.0f;
+        row[half * HD + d] = (uint8_t)(int8_t)std::fmin(std::fmax(q, -127.0f), 127.0f);
+    }
+    std::memcpy(row + 2 * HD + 2 * half, &h, 2);
+}
+
+/* One launch of `fn` over sequences [s0, s1) of the case's rows; out is [rows, NH * HD]. */
+struct Problem {
+    std::vector<uint16_t> q, rel, proj, sinks;
+    std::vector<uint8_t> kv;
+    std::vector<int32_t> bt, su, cu;
+    int n_seq = 0, max_blocks = 0, n_blocks = 0, rows = 0;
+};
+
+static int run(LaunchFn fn, bool device, const Case& c, const Problem& P, int s0, int s1,
+               std::vector<uint16_t>* out) {
+    const int ns = s1 - s0, slot = c.i8 ? 2 * HD + 4 : 2 * HD;
+    const int r0 = P.cu[(size_t)s0], rows = P.cu[(size_t)s1] - r0;
+    std::vector<int32_t> cu((size_t)ns + 1);
+    for (int s = 0; s <= ns; ++s) cu[(size_t)s] = P.cu[(size_t)(s0 + s)] - r0;
+    out->assign((size_t)rows * NH * HD, 0x7fc0);
+    RadTensor t[11]{};
+    tensor(t[0], (void*)(P.q.data() + (size_t)r0 * NH * HD), RAD_BF16, {rows, NH * HD});
+    tensor(t[1], (void*)P.kv.data(), c.i8 ? RAD_I8 : RAD_BF16, {P.n_blocks, KVH, BS, slot});
+    tensor(t[2], (void*)(P.bt.data() + (size_t)s0 * P.max_blocks), RAD_I32, {ns, P.max_blocks});
+    tensor(t[3], (void*)(P.su.data() + s0), RAD_I32, {ns});
+    tensor(t[6], cu.data(), RAD_I32, {ns + 1});
+    tensor(t[7], (void*)(P.rel.data() + (size_t)r0 * NH * DREL), RAD_BF16, {rows, NH * DREL});
+    tensor(t[8], (void*)P.proj.data(), RAD_BF16, {DREL, EXT});
+    tensor(t[9], (void*)(P.sinks.data() + (size_t)r0 * NH), RAD_BF16, {rows, NH});
+    tensor(t[10], out->data(), RAD_BF16, {rows, NH * HD});
+    RadParam p[10]{};
+    int np = 0;
+    auto pi = [&](const char* k, long long v) { p[np].key = k; p[np].kind = RAD_P_INT; p[np].ival = v; ++np; };
+    pi("head_dim", HD); pi("gqa", GQA); pi("causal", 1); pi("window", c.window);
+    pi("d_rel", DREL); pi("rel_extent", EXT); pi("block_size", BS); pi("n_head", NH);
+    pi("max_ctx", P.max_blocks * BS); pi("q_len", rows);
+    RadArgs a{};
+    a.t = t; a.n_t = 11; a.p = p; a.n_p = np;
+    std::vector<char> scratch;
+    if (device) {
+        const int64_t sb = r4d_rad_attn_rel_sink_scratch(&a);
+        if (sb < 0) return (int)sb;
+        scratch.assign((size_t)sb + 64, (char)0x5a);
+        a.scratch = scratch.data() + ((16 - ((uintptr_t)scratch.data() & 15)) & 15);
+        a.scratch_bytes = sb;
+    }
+    return fn(&a, nullptr);
+}
+
+int main() {
+    const LaunchFn ref = load_libref();
+    if (!ref) std::printf("libref not found ($RADIANCE_HOME): checking prefill against decode only\n");
+    const Case cases[] = {
+        {"bf16 decode 1 seq", false, 0, {1}, {1500}, false},
+        {"bf16 decode 1 seq short", false, 0, {1}, {40}, false},
+        {"bf16 decode 3 seqs, spans", false, 0, {1, 1, 1}, {1500, 700, 33}, true},
+        {"i8 decode 3 seqs, spans", true, 0, {1, 1, 1}, {1500, 700, 33}, true},
+        {"bf16 prefill 80 + decode", false, 0, {80, 1}, {300, 1300}, false},
+        {"i8 prefill 80 + decode", true, 0, {80, 1}, {300, 1300}, false},
+        {"i8 window 100, ragged", true, 100, {70, 1, 5}, {400, 900, 260}, true},
+        {"bf16 window 100, ragged", false, 100, {70, 1, 5}, {400, 900, 260}, true},
+    };
+    std::mt19937 rng(11);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    int fails = 0;
+    for (const Case& c : cases) {
+        Problem P;
+        P.n_seq = (int)c.q_len.size();
+        int maxc = 0;
+        for (int x : c.ctx) maxc = std::max(maxc, x);
+        P.max_blocks = (maxc + BS - 1) / BS;
+        P.n_blocks = P.n_seq * P.max_blocks + 1;
+        P.cu.push_back(0);
+        for (int s = 0; s < P.n_seq; ++s) {
+            P.cu.push_back(P.cu.back() + c.q_len[(size_t)s]);
+            P.su.push_back(c.ctx[(size_t)s]);
+        }
+        P.rows = P.cu.back();
+        std::vector<int32_t> perm((size_t)P.n_blocks);
+        for (int i = 0; i < P.n_blocks; ++i) perm[(size_t)i] = i;
+        std::shuffle(perm.begin(), perm.end(), rng);
+        P.bt.assign((size_t)P.n_seq * P.max_blocks, -1);
+        for (int s = 0, k = 0; s < P.n_seq; ++s)
+            for (int b = 0; b < (c.ctx[(size_t)s] + BS - 1) / BS; ++b) P.bt[(size_t)s * P.max_blocks + b] = perm[(size_t)k++];
+        if (c.hole) P.bt[1] = -1;
+        const int slot = c.i8 ? 2 * HD + 4 : 2 * HD, esz = c.i8 ? 1 : 2;
+        P.kv.assign((size_t)P.n_blocks * KVH * BS * slot * esz, 0);
+        std::vector<float> x(2 * HD);
+        for (size_t r = 0; r < (size_t)P.n_blocks * KVH * BS; ++r) {
+            for (auto& v : x) v = nd(rng);
+            uint8_t* row = P.kv.data() + r * slot * esz;
+            if (c.i8) {
+                put_i8(row, x.data(), 0);
+                put_i8(row, x.data() + HD, 1);
+            } else {
+                for (int d = 0; d < 2 * HD; ++d) ((uint16_t*)row)[d] = f2b(x[(size_t)d]);
+            }
+        }
+        P.q.resize((size_t)P.rows * NH * HD);
+        for (auto& v : P.q) v = f2b(0.3f * nd(rng));
+        P.rel.resize((size_t)P.rows * NH * DREL);
+        for (auto& v : P.rel) v = f2b(nd(rng));
+        P.proj.resize((size_t)DREL * EXT);
+        for (auto& v : P.proj) v = f2b(0.3f * nd(rng));
+        P.sinks.resize((size_t)P.rows * NH);
+        for (auto& v : P.sinks) v = f2b(nd(rng));
+
+        const LaunchFn dev = c.i8 ? r4d_rad_attn_rel_sink_h128_i8 : r4d_rad_attn_rel_sink_h128_bf16;
+        std::vector<uint16_t> all, want;
+        int rc = run(dev, true, c, P, 0, P.n_seq, &all);
+        bool ok = rc == RAD_OK;
+        double num = 0, den = 0;
+        if (ok && ref) {
+            ok = run(ref, false, c, P, 0, P.n_seq, &want) == RAD_OK;
+            for (size_t i = 0; ok && i < all.size(); ++i) {
+                const double d = (double)b2f(all[i]) - b2f(want[i]);
+                num += d * d;
+                den += (double)b2f(want[i]) * b2f(want[i]);
+            }
+        }
+        const double rel = den > 0 ? std::sqrt(num / den) : 0.0;
+        if (!(rel <= 2e-2) || std::isnan(rel)) ok = false;
+        /* Each sequence alone, a decode row then the same bytes. */
+        int same = 1;
+        for (int s = 0; ok && s < P.n_seq; ++s) {
+            std::vector<uint16_t> one;
+            if (run(dev, true, c, P, s, s + 1, &one) != RAD_OK) { ok = false; break; }
+            const size_t off = (size_t)P.cu[(size_t)s] * NH * HD;
+            if (std::memcmp(one.data(), all.data() + off, one.size() * 2) != 0) same = 0;
+        }
+        if (!same) ok = false;
+        std::printf("%-34s rc %d rel_l2 %.3e alone-identical %d %s\n", c.name, rc, rel, same,
+                    ok ? "ok" : "FAIL");
+        fails += !ok;
+    }
+    std::printf("attn_paged_rel_sink: %zu cases, %d failure(s)\n", sizeof cases / sizeof cases[0],
+                fails);
+    return fails != 0;
+}
