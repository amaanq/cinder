diff --git a/arch/inkling2loop/dspark.h b/arch/inkling2loop/dspark.h
new file mode 100644
index 0000000000..d71336d4ae
--- /dev/null
+++ b/arch/inkling2loop/dspark.h
@@ -0,0 +1,936 @@ static int64_t slots_of(int64_t V, int world) {
+/* inkling2loop/dspark.h -- the DSpark drafter Inkling 2 Mini ships beside its weights:
+ * `mtp.safetensors`, described by the config's `mtp_config`, which the checkpoint reader puts
+ * under `mtp.`.
+ *
+ * The reference is vLLM's (vllm/models/inkling2/nvidia/dspark.py, its ops/dspark.py and
+ * speculator.py, on the DFlash speculator's input layout); transformers has no drafter.
+ *
+ * ============================== THE TAPS ==============================
+ *
+ * `target_layer_ids` names layer visits of the unrolled loop, 48 for Inkling 2 Mini: visit v is
+ * the v-th layer application (prelude, three passes over the core, coda), and its tap is that
+ * application's input, the running partial block. The last id, the visit count, is the final
+ * norm's output, the row the lm_head reads. The trunk copies each into one column slice of `src`
+ * as it passes, on every step, prefill and verify alike.
+ *
+ * ============================== THE CONTEXT PASS ==============================
+ *
+ * One row per token the trunk just ran. Each drafter layer mixes the taps with its own softmaxed
+ * row of `fuse_weight` and its own norm (`tap_mix`), and projects the mix into K (normed a head,
+ * then rotated) and V with weights of its own (`k_proj_ctx`, `v_proj_ctx`), into its own cache.
+ * The recurrent head's context, the last row of `fuse_weight` and its own norm, is mixed for every
+ * row too; the query pass reads it at the anchor's row.
+ *
+ * ============================== THE QUERY PASS ==============================
+ *
+ * `block` rows a sequence: the anchor (the token the sampler just chose, at the committed end),
+ * embedded and normed as the trunk embeds it, then `block - 1` rows of `mask_embed`. The anchor
+ * predicts nothing: the core stages the block with `mask_id` behind it, a padding id no tokenizer
+ * produces, and `fill_rows` puts the mask vector there. Three dense layers with a bf16 residual
+ * (vLLM's fused add-norm), q and k normed a head and rotated (theta `rope_theta`), each row
+ * attending to its whole block and the context before it; a layer in `local_layer_ids` sees only
+ * the `sliding_window_size` positions before the anchor.
+ *
+ * ============================== THE HEAD ==============================
+ *
+ * Mask row j predicts the token at its own position. Its base logits are the target's lm_head over
+ * the row; `dspark_rnn_greedy` then walks the rows in order with a recurrent state that reads the
+ * row, the anchor's context mix and the token chosen before, and biases the base logits through
+ * the lm_head folded with the head's `hidden_out` (one [vocab, rank] table, folded at convert,
+ * RAD_MAP_MATMUL), under the target's softcap.
+ *
+ * At tp > 1 the drafter's heads and ffn columns are sharded as the trunk's, its two sums a layer
+ * all-reduced exactly so every rank drafts the same tokens. The walk is three ops a position
+ * there: the step, the scores over this rank's span of whole 64-id tiles (its own rows of the
+ * lm_head and the fold, `span`), and an all-gather of the tile winners, which is the walk's bytes
+ * (the fold is 102 MB a position at 200058 ids).
+ *
+ * The walk also counts how many of its tokens its margins vouch for (`kept`, docs/OPS.md), which
+ * --draft-window confident verifies in place of a fixed count. kKnee and kBudget are fitted on
+ * four replies of the 5-bit container at tp 2 on two R9700 (code and prose, behind 100 and 7,700
+ * prompt tokens), where a draft row costs 1.03 ms of an 18.2 ms step. The adaptive window runs
+ * them at 190.4 / 123.2 / 126.7 / 110.6 tok/s. Knee 4 budget 4 gives 194.5 / 128.0 / 125.9 /
+ * 115.3, knee 3 budget 5 gives 192.1 / 126.3 / 129.5 / 113.1 and knee 6 budget 9 gives 193.1 /
+ * 127.8 / 126.0 / 114.4.
+ *
+ * ============================== COUPLING ==============================
+ *
+ * The walk is greedy unless the deployment sets `draft-coupling: on`. Then `dspark_rnn_couple`
+ * samples each draft from Q, the softmax of the position's eight best tile winners at the request's
+ * temperature and cuts (abi/rad_spechub.h), and the sampler accepts it with min(1, p/q) and
+ * resamples a rejection from (p - q)+ (`mtp_couple_verify`), as vLLM's `draft_sample_method:
+ * probabilistic` does. A greedy request keeps the greedy walk and the agreement rule. Q at the
+ * request's own temperature led offline at 0.6, 0.8 and 1.0; at 1.0, Q at 0.75 to 1.05 moved tokens
+ * a verify by under 1%. At tp > 1 the step is `dspark_walk_couple`, which draws from the gathered
+ * winners, so every rank samples the token the whole walk would.
+ *
+ * ============================== NOT DONE ==============================
+ *
+ *   The drafter's cache is one full group: its local layers keep every position though they read
+ *   only the last `sliding_window_size`.
+ */
+#ifndef INKLING2LOOP_DSPARK_H
+#define INKLING2LOOP_DSPARK_H
+
+#include <arch/rad_arch.h>
+#include "rad_spechub.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace inkling2loop {
+
+using namespace rad::arch;
+
+struct Dspark {
+    enum { MAX_LAYERS = 4, MAX_TAPS = 8, kMaxSteps = 16 };
+    static constexpr double kKnee = 4.0, kBudget = 4.0;
+
+    /* The trunk's buffers and weights the drafter reads. */
+    struct Trunk {
+        rad_buf    x = 0, states = 0, mix = 0;   /* the stream, the block states, an f32 scratch */
+        int64_t    n_state = 0;
+        rad_weight tok = 0, tok_norm = 0, final_query = 0, out_norm = 0, lm_head = 0;
+        int64_t    n_head_vocab = 0;
+        double     softcap = 0.0;
+    };
+
+    bool    on = false;
+    Geom    g{};
+    Trunk   t{};
+    int     n_tap = 0, visit[MAX_TAPS] = {};
+    bool    local[MAX_LAYERS] = {};
+    int64_t block = 0, rank = 0, window = 0, crows = 0, qrows = 0, srows = 0;
+    int32_t mask_id = 0;
+    int     base = 0;
+    rad_kvgroup kv = 0;
+
+    rad_buf src = 0, ctx = 0, ck = 0, cv = 0, frnn = 0;
+    rad_buf x = 0, h = 0, q = 0, k = 0, v = 0, attn = 0, o = 0, gu = 0, ff = 0;
+    rad_buf hsel = 0, fsel = 0, dlog = 0, tile_score = 0, tile_token = 0, tokens = 0, kept = 0;
+    /* tp > 1: this rank's tiles and every rank's, as (score, id) pairs, and the walk's state */
+    rad_buf wins_part = 0, wins = 0, walk = 0;
+    int64_t slots = 0;   /* tiles a rank scores, its span's padded to even */
+    bool    phased = false;
+    rad_buf couple_draws = 0, couple_state = 0;
+
+    rad_weight w_fuse[MAX_LAYERS + 1] = {}, w_cnorm[MAX_LAYERS] = {}, w_kc[MAX_LAYERS] = {};
+    rad_weight w_vc[MAX_LAYERS] = {}, w_kcn[MAX_LAYERS] = {}, w_in[MAX_LAYERS] = {};
+    rad_weight w_post[MAX_LAYERS] = {}, w_q[MAX_LAYERS] = {}, w_k[MAX_LAYERS] = {};
+    rad_weight w_v[MAX_LAYERS] = {}, w_qn[MAX_LAYERS] = {}, w_kn[MAX_LAYERS] = {};
+    rad_weight w_o[MAX_LAYERS] = {}, w_gu[MAX_LAYERS] = {}, w_dn[MAX_LAYERS] = {};
+    /* The scale and zero planes of a linear the container holds as 4-bit affine codes (u4, an f16
+     * scale and a zero per 128 of K), read by gemm_nt_q at w4a16_asym; 0 for int8 or bf16. */
+    rad_weight w_q_s[MAX_LAYERS] = {}, w_k_s[MAX_LAYERS] = {}, w_v_s[MAX_LAYERS] = {};
+    rad_weight w_o_s[MAX_LAYERS] = {}, w_gu_s[MAX_LAYERS] = {}, w_dn_s[MAX_LAYERS] = {};
+    rad_weight w_mnorm = 0, w_mask = 0, w_norm = 0, w_proj = 0, w_pbias = 0, w_embed = 0;
+    rad_weight w_fold = 0, w_fold_b = 0, w_fold_s = 0;
+    /* RADIANCE_INKLING2_DSPARK_SHORT=N: the head and the walk read the first N rows of the
+     * container's short tables, the head's rows of the kShort ids most often generated (ids in
+     * `w_ids`), in place of the whole vocabulary. Verify still reads the whole head. */
+    static constexpr int64_t kShort = 65536;
+    int64_t    short_n = 0;
+    rad_weight w_head = 0, w_ids = 0;
+
+    rad_op op_tap = 0, op_final_mix = 0, op_final_norm = 0;
+    rad_op op_cmix[MAX_LAYERS + 1] = {}, op_ck[MAX_LAYERS] = {}, op_cv[MAX_LAYERS] = {};
+    rad_op op_ckn[MAX_LAYERS] = {}, op_crope = 0, op_cstore = 0;
+    rad_op op_embed = 0, op_enorm = 0, op_fill = 0, op_in0 = 0;
+    rad_op op_in[MAX_LAYERS] = {}, op_post[MAX_LAYERS] = {}, op_q[MAX_LAYERS] = {};
+    rad_op op_k[MAX_LAYERS] = {}, op_v[MAX_LAYERS] = {}, op_qn[MAX_LAYERS] = {};
+    rad_op op_kn[MAX_LAYERS] = {}, op_o[MAX_LAYERS] = {}, op_gu[MAX_LAYERS] = {};
+    rad_op op_qkr[MAX_LAYERS] = {};
+    rad_op op_dn[MAX_LAYERS] = {}, op_norm = 0;
+    rad_op op_qrope = 0, op_krope = 0, op_store = 0, op_attn_local = 0, op_attn_full = 0;
+    rad_op op_act = 0, op_sel = 0, op_fsel = 0, op_logits = 0, op_walk = 0;
+    rad_op op_ar = 0;   /* o's partial sums over the ranks' heads or ffn columns, at tp > 1 */
+    rad_op op_wstep[kMaxSteps + 1] = {}, op_wscore[kMaxSteps] = {}, op_wgather = 0;
+
+    /* Rank `rank`'s ids of the walk's `V`: whole 64-id tiles, an even count a rank so a rank's
+     * winners are whole 16-byte words of the gather. */
+    static int64_t slots_of(int64_t V, int world) {
+        const int64_t per = ((V + 63) / 64 + world - 1) / world;
+        return (per + 1) / 2 * 2;
+    }
+    static void span(int64_t V, int rank, int world, int64_t* lo, int64_t* hi) {
+        const int64_t w = slots_of(V, world) * 64;
+        *lo = std::min(V, rank * w);
+        *hi = std::min(V, (rank + 1) * w);
+    }
+
+    /* Before the trunk's layers, so the taps outlive every trunk temporary (the planner keeps a
+     * buffer from its first declared op to its last). */
+    int declare_taps(RadBuilder* b, Names& nm, const RadModelMeta* meta, const RadBuildCtx* bc,
+                     const Geom& trunk, int n_visit, rad_buf stream);
+    /* After the trunk's head: the final norm over every row, then the drafter. */
+    int declare(RadBuilder* b, Names& nm, const RadModelMeta* meta, const RadBuildCtx* bc,
+                const Geom& tg, const Trunk& trunk, int base_layer);
+
+    /* The trunk's input to visit `v`, kept if it is a tap. */
+    void tap(RadCtx* c, int v, int64_t T) const;
+    /* The final norm's output over all T rows, the last tap. */
+    void tap_final(RadCtx* c, int64_t T) const;
+    void context(RadCtx* c, const RadBatch* batch) const;
+    void step(RadCtx* c, const RadBatch* batch) const;
+};
+
+/* The drafter's block length, 0 when the container carries none. The release's config.json
+ * describes the drafter whether or not mtp.safetensors came with it, and the checkpoint reader
+ * sets `radiance.speculator` when it did. */
+inline int64_t dspark_block(const RadModelMeta* meta) {
+    if (rad_meta_geti(meta, "mtp_config.num_hidden_layers", 0) <= 0) return 0;
+    const char* sp = rad_meta_gets(meta, "radiance.speculator", "");
+    if (!sp || std::strcmp(sp, "mtp.safetensors") != 0) return 0;
+    return rad_meta_geti(meta, "mtp_config.block_size", 0);
+}
+
+inline int Dspark::declare_taps(RadBuilder* b, Names& nm, const RadModelMeta* meta,
+                                const RadBuildCtx* bc, const Geom& trunk, int n_visit,
+                                rad_buf stream) {
+    on = false;
+    if (bc->max_spec <= 0 || dspark_block(meta) <= 0) return RAD_OK;
+    n_tap = parse_layer_ids(rad_meta_gets(meta, "mtp_config.target_layer_ids", ""), n_visit + 1,
+                            visit, MAX_TAPS);
+    if (n_tap < 2 || visit[n_tap - 1] != n_visit) {
+        fprintf(stderr, "radiance: inkling2loop: mtp_config.target_layer_ids names %d visit(s) and "
+                        "must end at %d, the final norm's output\n", n_tap, n_visit);
+        return RAD_E_FORMAT;
+    }
+    const int64_t E = trunk.n_embd;
+    src = decl_b(b, nm.f("ds_taps"), RAD_BF16, {trunk.max_tok, n_tap * E});
+    if (!src) return RAD_E_INVAL;
+    op_tap = rw(b, RAD_OP(b, "cast",
+                    RAD_PARAMS(RAD_RANGE("M", 1, trunk.max_tok), RAD_INT("n", E),
+                               RAD_STR("from", "bf16"), RAD_STR("to", "bf16")),
+                    RAD_NOWEIGHTS),
+                {stream}, {src});
+    if (!op_tap) return RAD_E_INVAL;
+    on = true;
+    return RAD_OK;
+}
+
+inline int Dspark::declare(RadBuilder* b, Names& nm, const RadModelMeta* meta,
+                           const RadBuildCtx* bc, const Geom& tg, const Trunk& trunk,
+                           int base_layer) {
+    if (!on) return RAD_OK;
+    t = trunk;
+    base = base_layer;
+    char key[96];
+    auto mi = [&](const char* name) {
+        std::snprintf(key, sizeof key, "mtp_config.%s", name);
+        return rad_meta_geti(meta, key, 0);
+    };
+    g.n_layer = mi("num_hidden_layers");
+    g.head_dim = mi("head_dim");
+    g.n_head_all = mi("num_attention_heads");
+    g.n_head_kv_all = mi("num_key_value_heads");
+    g.n_ff_all = mi("intermediate_size");
+    g.rank = tg.rank;
+    g.world = tg.world;
+    g.eps = (float)rad_meta_getf(meta, "mtp_config.rms_norm_eps", 0.0);
+    g.theta = (float)rad_meta_getf(meta, "mtp_config.rope_theta", 0.0);
+    block = mi("block_size");
+    rank = mi("markov_rank");
+    const int64_t swa = mi("sliding_window_size");
+    const char* head = rad_meta_gets(meta, "mtp_config.markov_head_type", "");
+    const int64_t E = mi("hidden_size");
+    if (g.n_layer <= 0 || g.n_layer > MAX_LAYERS || g.head_dim <= 0 || g.n_head_all <= 0 ||
+        g.n_head_kv_all <= 0 || g.n_head_all % g.n_head_kv_all || g.n_ff_all <= 0 ||
+        !(g.eps > 0.0f) ||
+        !(g.theta > 0.0f) || block < 2 || rank <= 0 || swa <= 0 || E != tg.n_embd ||
+        std::strcmp(head, "rnn_hidden") != 0 || rad_meta_geti(meta, "mtp_config.q_bias", 0) ||
+        rad_meta_geti(meta, "mtp_config.o_bias", 0)) {
+        fprintf(stderr, "radiance: inkling2loop: mtp_config describes no drafter this file serves "
+                        "(%lld layers, heads %lld / %lld x %lld, ffn %lld, block %lld, rank %lld, "
+                        "window %lld, width %lld, head '%s'); it serves the rnn_hidden DSpark "
+                        "head at the target's width\n",
+                (long long)g.n_layer, (long long)g.n_head_all, (long long)g.n_head_kv_all,
+                (long long)g.head_dim, (long long)g.n_ff_all, (long long)block, (long long)rank,
+                (long long)swa, (long long)E, head);
+        return RAD_E_UNSUPPORTED;
+    }
+    RAD_ARCH_TRY(divide_or_fail(g.n_head_kv_all, g.world, "mtp num_key_value_heads",
+                                &g.n_head_kv));
+    RAD_ARCH_TRY(divide_or_fail(g.n_head_all, g.world, "mtp num_attention_heads", &g.n_head));
+    RAD_ARCH_TRY(divide_or_fail(g.n_ff_all, g.world, "mtp intermediate_size", &g.n_ff));
+    if ((int64_t)bc->max_spec != block - 1) {
+        fprintf(stderr, "radiance: inkling2loop: the drafter fills a block of %lld, an anchor and "
+                        "%lld draft tokens, and this serve asks for %d\n", (long long)block,
+                (long long)(block - 1), bc->max_spec);
+        return RAD_E_UNSUPPORTED;
+    }
+    int ids[MAX_LAYERS] = {};
+    const int n_local = parse_layer_ids(rad_meta_gets(meta, "mtp_config.local_layer_ids", ""),
+                                        g.n_layer, ids, MAX_LAYERS);
+    for (int i = 0; i < n_local; ++i) local[ids[i]] = true;
+    /* attn_paged_anchor_window sees anchor - key < window: the `swa` positions before it. */
+    window = swa + 1;
+
+    g.n_embd = E;
+    g.max_tok = tg.max_tok;
+    g.max_seqs = tg.max_seqs;
+    g.max_ctx = tg.max_ctx;
+    g.n_vocab = g.n_vocab_all = tg.n_vocab_all;
+    g.dtype = "bf16";
+    g.yarn = RadYarn{};
+    mask_id = (int32_t)(tg.n_vocab_all - 1);
+    if (mask_id < trunk.n_head_vocab) {
+        fprintf(stderr, "radiance: inkling2loop: the embedding has no padding row past the "
+                        "lm_head's %lld for the drafter's mask positions\n",
+                (long long)trunk.n_head_vocab);
+        return RAD_E_FORMAT;
+    }
+
+    RadKVGroupDecl kd{};
+    kd.kind      = RAD_KV_FULL;
+    kd.dtype     = rad_kv_cache_dtype(bc, RAD_BF16);
+    kd.n_head_kv = g.n_head_kv;
+    kd.head_dim  = g.head_dim;
+    kv = rad_decl_kv_group(b, nm.f("kv_draft"), &kd);
+    if (!kv) return RAD_E_INVAL;
+    for (int64_t l = 0; l < g.n_layer; ++l) RAD_ARCH_TRY(rad_bind_layer_kv(b, base + (int)l, kv));
+    g.kv_dtype = rad_dtype_name(kd.dtype);
+
+    const int64_t qd = g.q_dim(), kvd = g.kv_dim(), F = g.n_ff, hd = g.head_dim;
+    if (const char* se = std::getenv("RADIANCE_INKLING2_DSPARK_SHORT")) short_n = std::atoll(se);
+    if (short_n < 0 || short_n % 64 || short_n > kShort || short_n > t.n_head_vocab) {
+        fprintf(stderr, "radiance: inkling2loop: RADIANCE_INKLING2_DSPARK_SHORT=%lld is not a "
+                        "multiple of 64 up to %lld\n", (long long)short_n,
+                (long long)kShort);
+        return RAD_E_UNSUPPORTED;
+    }
+    const int64_t V = short_n ? short_n : t.n_head_vocab, tiles = (V + 63) / 64, steps = block - 1;
+    crows = g.max_tok;
+    qrows = std::min<int64_t>(g.max_seqs * block, g.max_tok);
+    srows = g.max_seqs * steps;
+    ctx  = decl_b(b, nm.f("ds_ctx"), RAD_BF16, {crows, E});
+    ck   = decl_b(b, nm.f("ds_ck"), RAD_BF16, {crows, kvd});
+    cv   = decl_b(b, nm.f("ds_cv"), RAD_BF16, {crows, kvd});
+    frnn = decl_b(b, nm.f("ds_frnn"), RAD_BF16, {crows, E});
+    x    = decl_b(b, nm.f("ds_x"), RAD_BF16, {qrows, E});
+    h    = decl_b(b, nm.f("ds_h"), RAD_BF16, {qrows, E});
+    q    = decl_b(b, nm.f("ds_q"), RAD_BF16, {qrows, qd});
+    k    = decl_b(b, nm.f("ds_k"), RAD_BF16, {qrows, kvd});
+    v    = decl_b(b, nm.f("ds_v"), RAD_BF16, {qrows, kvd});
+    attn = decl_b(b, nm.f("ds_attn"), RAD_BF16, {qrows, qd});
+    o    = decl_b(b, nm.f("ds_o"), RAD_BF16, {qrows, E});
+    gu   = decl_b(b, nm.f("ds_gate_up"), RAD_BF16, {qrows, 2 * F});
+    ff   = decl_b(b, nm.f("ds_ff"), RAD_BF16, {qrows, F});
+    hsel = decl_b(b, nm.f("ds_hsel"), RAD_BF16, {srows, E});
+    fsel = decl_b(b, nm.f("ds_fsel"), RAD_BF16, {g.max_seqs, E});
+    int64_t v_lo = 0, v_hi = V;
+    phased = g.world > 1;
+    if (phased) {
+        span(V, g.rank, g.world, &v_lo, &v_hi);
+        slots = slots_of(V, g.world);
+        if (v_hi <= v_lo || steps > kMaxSteps) {
+            fprintf(stderr, "radiance: inkling2loop: the drafter's walk cannot split %lld ids and "
+                            "%lld steps over %d ranks\n", (long long)V, (long long)steps, g.world);
+            return RAD_E_UNSUPPORTED;
+        }
+        auto up = [](int64_t x) { return (x + 255) / 256 * 256; };
+        const int64_t M = g.max_seqs, wb = up(M * steps * 3 * rank * 4) + up(2 * M * rank * 4) +
+                                           up(M * rank * 4) + up(M * 4);
+        wins = decl_b(b, nm.f("ds_wins"), RAD_I32, {M, 2 * slots * g.world});
+        wins_part = g.world > 1 ? decl_b(b, nm.f("ds_wins_part"), RAD_I32, {M, 2 * slots}) : wins;
+        walk = decl_b(b, nm.f("ds_walk"), RAD_F32, {wb / 4});
+        if (!wins_part || !wins || !walk) return RAD_E_INVAL;
+    }
+    const int64_t VL = v_hi - v_lo;
+    dlog = decl_b(b, nm.f("ds_logits"), RAD_F32, {srows, VL});
+    if (!phased) {
+        tile_score = decl_b(b, nm.f("ds_tile_score"), RAD_F32, {g.max_seqs, tiles});
+        tile_token = decl_b(b, nm.f("ds_tile_token"), RAD_I32, {g.max_seqs, tiles});
+        if (!tile_score || !tile_token) return RAD_E_INVAL;
+    }
+    /* The proposal buffer (RadDrafterDecl::proposal). */
+    tokens = decl_b(b, nm.f("ds_tokens"), RAD_I32, {g.max_seqs, steps});
+    kept = decl_b(b, nm.f("ds_kept"), RAD_I32, {g.max_seqs});
+    if (!ctx || !ck || !cv || !frnn || !x || !h || !q || !k || !v || !attn || !o || !gu || !ff ||
+        !hsel || !fsel || !dlog || !tokens || !kept)
+        return RAD_E_INVAL;
+
+    /* ---- weights. bf16 as shipped, or int8 codes where the container holds them: the layers'
+     * linears (gemm_i8w_nt) and the fold computed at convert (the walk). */
+    auto is_w4 = [&](const char* name) {
+        RadEncoding e{};
+        if (!weight_enc(b, name, &e) || !rad_enc_is(&e, "affine") || e.n_planes != 3) return false;
+        const RadEncPlane *sc = rad_enc_plane(&e, "scale"), *zp = rad_enc_plane(&e, "zero");
+        return e.plane[0].dtype == RAD_U4 && sc && zp && sc->dtype == RAD_F16 &&
+               sc->block[1] == 128 && zp->block[1] == 128;
+    };
+    /* A linear as its codes, plus `scale` set when they are 4-bit affine. */
+    auto lin_w = [&](rad_weight* out, rad_weight* scale, const char* name,
+                     std::initializer_list<int64_t> shape, int shard, RadWeightGroup grp,
+                     const int64_t* parts = nullptr, int n_parts = 0) -> int {
+        if (scale && is_w4(name)) {
+            *out = decl_view(b, name, nullptr, "codes", RAD_U4, shape, RAD_ACCESS_PER_TOKEN,
+                             shard, grp, parts, n_parts);
+            *scale = decl_view(b, nm.f("%s.sz", name), name, "scale,zero", RAD_F16, shape,
+                               RAD_ACCESS_PER_TOKEN, shard, grp, parts, n_parts);
+            return *out && *scale ? RAD_OK : RAD_E_INVAL;
+        }
+        *out = decl_w_n(b, name, weight_codes_dtype(b, name, RAD_BF16), shape,
+                        RAD_ACCESS_PER_TOKEN, shard, grp, 0, parts, n_parts);
+        return *out ? RAD_OK : RAD_E_INVAL;
+    };
+    auto wt = [&](rad_weight* out, const char* name, const char* from, RadWeightGroup grp,
+                  std::initializer_list<int64_t> shape, int access = RAD_ACCESS_PER_TOKEN,
+                  int shard = RAD_SHARD_NONE, rad_weight* scale = nullptr) -> int {
+        RAD_ARCH_TRY(map_copy(b, name, nm.ckpt("mtp.%s", from)));
+        if (scale) return lin_w(out, scale, name, shape, shard, grp);
+        *out = decl_w(b, name, weight_codes_dtype(b, name, RAD_BF16), shape, access, shard, grp);
+        return *out ? RAD_OK : RAD_E_INVAL;
+    };
+    for (int i = 0; i <= (int)g.n_layer; ++i) {
+        const char* name = nm.f("dspark.fuse.%d", i);
+        RAD_ARCH_TRY(map_rows(b, name, { { nm.ckpt("mtp.fuse_weight"), i, 1 } }));
+        w_fuse[i] = decl_w(b, name, RAD_BF16, {n_tap}, RAD_ACCESS_PER_TOKEN, RAD_SHARD_NONE,
+                           grp_model());
+        if (!w_fuse[i]) return RAD_E_INVAL;
+    }
+    for (int i = 0; i < (int)g.n_layer; ++i) {
+        const RadWeightGroup grp = grp_layer(base + i);
+        auto lw = [&](rad_weight* out, const char* name, const char* from,
+                      std::initializer_list<int64_t> shape, int shard = RAD_SHARD_NONE,
+                      rad_weight* scale = nullptr) -> int {
+            return wt(out, nm.f("dspark.blk.%d.%s", i, name), nm.ckpt("layers.%d.%s", i, from),
+                      grp, shape, RAD_ACCESS_PER_TOKEN, shard, scale);
+        };
+        RAD_ARCH_TRY(lw(&w_cnorm[i], "ctx_norm.weight", "dflare_norm.weight", {E}));
+        RAD_ARCH_TRY(lw(&w_kc[i], "ctx_k.weight", "self_attn.k_proj_ctx.weight", {kvd, E},
+                        RAD_SHARD_ROW));
+        RAD_ARCH_TRY(lw(&w_vc[i], "ctx_v.weight", "self_attn.v_proj_ctx.weight", {kvd, E},
+                        RAD_SHARD_ROW));
+        RAD_ARCH_TRY(lw(&w_kcn[i], "ctx_k_norm.weight", "self_attn.k_norm_ctx.weight", {hd}));
+        RAD_ARCH_TRY(lw(&w_in[i], "attn_norm.weight", "input_layernorm.weight", {E}));
+        RAD_ARCH_TRY(lw(&w_post[i], "ffn_norm.weight", "post_attention_layernorm.weight", {E}));
+        RAD_ARCH_TRY(lw(&w_q[i], "attn_q.weight", "self_attn.q_proj.weight", {qd, E},
+                        RAD_SHARD_ROW, &w_q_s[i]));
+        RAD_ARCH_TRY(lw(&w_k[i], "attn_k.weight", "self_attn.k_proj.weight", {kvd, E},
+                        RAD_SHARD_ROW, &w_k_s[i]));
+        RAD_ARCH_TRY(lw(&w_v[i], "attn_v.weight", "self_attn.v_proj.weight", {kvd, E},
+                        RAD_SHARD_ROW, &w_v_s[i]));
+        RAD_ARCH_TRY(lw(&w_qn[i], "attn_q_norm.weight", "self_attn.q_norm.weight", {hd}));
+        RAD_ARCH_TRY(lw(&w_kn[i], "attn_k_norm.weight", "self_attn.k_norm.weight", {hd}));
+        RAD_ARCH_TRY(lw(&w_o[i], "attn_output.weight", "self_attn.o_proj.weight", {E, qd},
+                        RAD_SHARD_COL, &w_o_s[i]));
+        RAD_ARCH_TRY(lw(&w_dn[i], "ffn_down.weight", "mlp.down_proj.weight", {E, F},
+                        RAD_SHARD_COL, &w_dn_s[i]));
+        const char* name = nm.f("dspark.blk.%d.ffn_gate_up.weight", i);
+        RAD_ARCH_TRY(map_concat(b, name, { nm.ckpt("mtp.layers.%d.mlp.gate_proj.weight", i),
+                                           nm.ckpt("mtp.layers.%d.mlp.up_proj.weight", i) }));
+        const int64_t gu_parts[2] = { F, F };
+        RAD_ARCH_TRY(lin_w(&w_gu[i], &w_gu_s[i], name, {2 * F, E}, RAD_SHARD_ROW, grp, gu_parts,
+                           2));
