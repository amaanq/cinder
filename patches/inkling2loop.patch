+// The exact sum for a decode-sized message with the flag in the word. Each 8-byte store to the
+// peer carries 4 bytes of the message and the launch's number, and the reader polls its own copy
+// until every word it owns carries the number. A word is one PCIe write, so its bytes cannot land
+// after its flag, and the kernel needs no release, no separate flag and no push check. On 2x R9700,
+// back to back at 2304 bf16 behind 1 MiB of dirty L2, a launch takes 8.7 us against the exact
+// kernel's 11.0 (an empty launch there: 6.5); in Inkling 2 Mini's tp 2 decode step the attention
+// all-reduce adds 3.0 us to the step against 4.2.
+//
+// Slots alternate by the launch's parity on the exact kernel's counters, so the two can share an
+// instance. A stale word could pass only if its slot last held this index 2^32 launches ago.
+template <class CH>
+__global__ void r4d_ar_ll_2rank_kernel(const unsigned* __restrict__ in, unsigned* __restrict__ out,
+                                       unsigned long long* peer_ll, const unsigned long long* my_ll,
+                                       unsigned int* seq_ctrs, unsigned int nbw, int n4,
+                                       int slot_words, int dtype) {
+  if (CH::on) r4d_chain_wait();
+  __shared__ unsigned int s_launch;
+  r4d_ar_seq_launch(seq_ctrs, nbw, s_launch);
+  const unsigned int L = s_launch;
+  const size_t off = (size_t)(L & 1u) * slot_words;
+  unsigned long long* const pw = peer_ll + off;
+  const unsigned long long* const mw = my_ll + off;
+  const int stride = gridDim.x * blockDim.x;
+  const int i0 = blockIdx.x * blockDim.x + threadIdx.x;
+  const unsigned long long tag = (unsigned long long)L << 32;
+  for (int i = i0; i < n4; i += stride)
+    __hip_atomic_store(&pw[i], tag | in[i], __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
+  const unsigned long long t0 = wall_clock64();
+  for (int i = i0; i < n4; i += stride) {
+    unsigned long long w;
+    while (((w = __hip_atomic_load(&mw[i], __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM)) >> 32) != L)
+      if (wall_clock64() - t0 > R4D_ARCHK_DEADLINE) __builtin_trap();
+    const unsigned a = in[i], p = (unsigned)w;
+    unsigned r;
+    if (dtype == 2) {
+      r = __float_as_uint(__uint_as_float(a) + __uint_as_float(p));
+    } else {
+      int4 va = make_int4((int)a, 0, 0, 0), vp = make_int4((int)p, 0, 0, 0);
+      r = (unsigned)(dtype == 0 ? vadd<__hip_bfloat16, 2>(va, vp) : vadd<__half, 2>(va, vp)).x;
+    }
+    out[i] = r;
+  }
+  if (CH::on) r4d_chain_done();
+}
