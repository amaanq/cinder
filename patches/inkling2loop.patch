+# container over 19,545 positions of held-out code chat: mean 0.0049, top-1 97.97%; layer 0's q
+# alone at int8 gives 0.0043, the floor the routing's near-ties set. At effort low, 8192 tokens:
+# 51/92 code and 31/40 reasoning problems against bf16's 55/92 and 28/40.
+
+blk.*.attn_q.weight              gptq  codes=u5 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.16 damp=0.01 calib=$CALIB tcq_order=1
+blk.*.attn_output_gate.weight    gptq  codes=u5 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.16 damp=0.01 calib=$CALIB tcq_order=1
+blk.*.attn_k.weight              gptq  codes=u5 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.16 damp=0.01 calib=$CALIB tcq_order=1
+blk.*.attn_v.weight              gptq  codes=u5 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.16 damp=0.01 calib=$CALIB tcq_order=1
+blk.*.attn_output.weight         gptq  codes=u5 tcq=16 tcq_code=mad tcq_rows=256 group=128 scale=bf16 dyn=1 transform=fwht128 tcq_gain=1.2 damp=0.01 calib=$CALIB
