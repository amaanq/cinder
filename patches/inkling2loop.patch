+/* add and mul with operands of both dtypes, as a model issues them that keeps a branch in f32
+ * beside a bf16 stream: every mix with an f32 operand, against the same f32 arithmetic. kbench
+ * describes one dtype for all three, so only this reaches the mixes. */
+void binary_mixed_cases(const Plugin& pl, const char* row, bool mul) {
+    const RadKernelInfo* r = find(pl, row);
+    if (!r) { ok(row, false, "row absent"); return; }
+    const int64_t M = 37, n = 300, ld = 310;
+    for (int mix = 1; mix < 8; ++mix) {
+        const bool af = mix & 1, bf = mix & 2, yf = mix & 4;
+        const double div = !mul && (mix == 3 || mix == 5) ? std::sqrt(5.0) : 1.0;
+        std::vector<float> a = randv((size_t)(M * ld), 2.0f), b = randv((size_t)(M * n), 2.0f);
+        void* da = af ? up_f32(a) : up_bf16(a);
+        void* db = bf ? up_f32(b) : up_bf16(b);
+        const bool alias = af && yf;
+        void* dy = alias ? da : dalloc((size_t)(M * ld) * 4);
+        RadTensor ta = T(da, af ? RAD_F32 : RAD_BF16, { M, n });
+        RadTensor ty = T(dy, yf ? RAD_F32 : RAD_BF16, { M, n });
+        ta.stride[0] = ty.stride[0] = ld;
+        std::vector<RadParam> ps = { PI("M", M), PI("n", n), PS("dtype", "f32") };
+        if (div != 1.0) ps.push_back(PF("div", div));
+        const std::string nm = fmt("%s %s %c %s -> %s%s%s", row, af ? "f32" : "bf16",
+                                   mul ? '*' : '+', bf ? "f32" : "bf16", yf ? "f32" : "bf16",
+                                   div != 1.0 ? ", div sqrt(5)" : "", alias ? ", in place" : "");
+        const int rc = launch(r, { ta, T(db, bf ? RAD_F32 : RAD_BF16, { M, n }), ty }, ps);
+        if (rc != RAD_OK) { ok(nm.c_str(), false, "rc " + std::to_string(rc)); continue; }
+        const std::vector<float> got = yf ? down_f32(dy, (size_t)(M * ld))
+                                          : down_bf16(dy, (size_t)(M * ld));
+        int64_t bad = 0;
+        for (int64_t m = 0; m < M; ++m)
+            for (int64_t i = 0; i < n; ++i) {
+                const float u = a[(size_t)(m * ld + i)], v = b[(size_t)(m * n + i)];
+                float s = mul ? u * v : u + v;
+                if (div != 1.0) s = (yf ? s : bfr(s)) / (float)div;
+                const float want = yf ? s : bfr(s);
+                bad += std::memcmp(&got[(size_t)(m * ld + i)], &want, 4) != 0;
+            }
+        ok((nm + " exact").c_str(), bad == 0, fmt("%lld elements differ", (long long)bad));
+    }
+}
