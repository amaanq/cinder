index 0000000000..89e2575c15
--- /dev/null
+++ b/core/sample/reply_walk.h
@@ -0,0 +1,176 @@ LoopSeen get(uint64_t h) const {
+/* reply_walk.h -- the chat reply policy (SamplingParams::answer_temp and on), token by token.
+ *
+ * Where a reply stands decides how its next position is sampled: inside the reasoning block at
+ * the request's temperature and top-p, past it at the answer's; from the budget on, the close
+ * sequence forced a token a position; and the loop guard watching the block. Every decision is a
+ * function of the tokens before the position, so a draft row is judged by the committed reply
+ * plus the drafts before it, and a reply is the same with or without speculation.
+ *
+ * Loop guard: an n-gram inside the block whose last three occurrences are equally spaced bans, at
+ * the next position, the token that followed its previous occurrence and samples the next n
+ * positions at max(temp + kLoopBoost, 1). Nothing fires for those n positions. The next trigger
+ * starts the close sequence, as the budget does. Equal spacing, not a count: on Inkling 2's
+ * temperature-1 coding replies an n-gram of 12 seen three times anywhere fires in 23 of 40 solved
+ * replies, equal spacing in 3 of 40, each once; a greedy loop fires it hundreds of times.
+ */
+#pragma once
+#include "../rad_core.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace rad {
+
+constexpr int   kLoopMaxN    = 64;
+constexpr float kLoopBoost   = 0.3f;
+
+/* An n-gram's latest two occurrences, by the block position of their last token. */
+struct LoopSeen {
+    int64_t last = -1;
+    int64_t prev = -1;
+    int32_t next = -1;   /* the token after the latest occurrence */
+};
+
+/* The block's n-grams: the committed reply's, and over them a draft row's own. */
+class LoopCounts {
+public:
+    using Map = std::unordered_map<uint64_t, LoopSeen>;
+    using Overlay = std::vector<std::pair<uint64_t, LoopSeen>>;
+
+    LoopCounts(Map* base, Overlay* over) : base_(base), over_(over) {}
+
+    LoopSeen get(uint64_t h) const {
+        if (over_)
+            for (const auto& [k, v] : *over_)
+                if (k == h) return v;
+        const auto it = base_->find(h);
+        return it == base_->end() ? LoopSeen{} : it->second;
+    }
+    void put(uint64_t h, LoopSeen s) {
+        if (!over_) {
+            (*base_)[h] = s;
+            return;
+        }
+        for (auto& [k, v] : *over_)
+            if (k == h) {
+                v = s;
+                return;
+            }
+        over_->emplace_back(h, s);
+    }
+
+private:
+    Map*     base_;
+    Overlay* over_;
+};
+
+struct ReplyWalk {
+    enum Event : uint8_t { None, LoopBan, LoopClose, BudgetClose };
+
+    ReasoningCount think;
+    int32_t  closing = -1;      /* the close sequence's next index while it is forced, else -1 */
+    bool     ban_open = false;  /* the close sequence just ended: the block may not reopen */
+    int32_t  ban_tok = -1;      /* the loop guard's ban for the next position */
+    int32_t  boost = 0;         /* positions left at the raised temperature */
+    int32_t  cool = 0;          /* positions before the guard may fire again */
+    uint8_t  fired = 0;
+    bool     forced = false;    /* a close sequence ran to its end */
+    Event    event = None;      /* what the last push started */
+    bool     have_prev = false;
+    uint64_t prev_h = 0;        /* the n-gram ending at the previous body token */
+    int32_t  ring[kLoopMaxN] = {};
+
+    static int32_t close_len(const SamplingParams& sp) {
+        return sp.close_seq.empty() ? 1 : (int32_t)sp.close_seq.size();
+    }
+    static int32_t close_at(const SamplingParams& sp, int32_t i) {
+        return sp.close_seq.empty() ? sp.reasoning.close : sp.close_seq[(size_t)i];
+    }
+
+    void start(const SamplingParams& sp) {
+        *this = ReplyWalk{};
+        think.start(sp.reasoning);
+        settle(sp);
+    }
+
+    /* Past the block: its close was emitted. The lead and header before it are the block's. */
+    bool answering() const { return think.st == ReasoningCount::Done; }
+
+    void push(const SamplingParams& sp, LoopCounts& counts, int32_t tok) {
+        event = None;
+        const bool was_inside = think.inside();
+        think.push(sp.reasoning, tok);
+        ban_open = false;
+        ban_tok = -1;
+        if (closing >= 0) {
+            if (tok != close_at(sp, closing)) {
+                closing = -1;
+            } else if (++closing == close_len(sp)) {
+                closing = -1;
+                forced = true;
+                ban_open = sp.reasoning.lead >= 0 && sp.reasoning.open >= 0;
+            }
+        }
+        if (boost > 0) --boost;
+        if (cool > 0) --cool;
+
+        const int n = sp.loop_guard;
+        if (n > 0 && was_inside && think.inside()) {
+            const int64_t at = think.body - 1;
+            ring[at % kLoopMaxN] = tok;
+            if (think.body >= n) {
