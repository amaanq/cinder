+/* attn_paged_rel_sink's operands, then the page boxes and the box table. The boxes are drawn,
+ * which bounds nothing but gives the selection and its libr4d form the same scores to rank. */
+int ref_attn_paged_rel_sink_sparse_shape(const RadParam* p, int n_p, int operand,
