+/* A block drafter's count of drafts worth verifying (rad_builder.h). */
+int Builder::drafter_kept(rad_buf kept) {
+    if (finished_) {
+        err(RAD_E_STATE, "drafter_kept after declare finished");
+        return RAD_E_STATE;
+    }
+    if (prog_.drafter.kind != RAD_DRAFT_BLOCK || prog_.drafter_tree) {
+        err(RAD_E_STATE, "drafter_kept: %s. Only a BLOCK drafter proposing a chain cuts its "
+                         "proposal; declare it with rad_declare_drafter first.",
+            prog_.drafter.kind == RAD_DRAFT_NONE ? "no drafter is declared"
+            : prog_.drafter_tree                 ? "the declared drafter proposes a tree"
+                                                 : "the declared drafter is a SERIAL head");
+        return RAD_E_STATE;
+    }
+    if (kept == RAD_NULL_HANDLE || (size_t)kept >= prog_.buffers.size()) {
+        err(RAD_E_INVAL, "drafter_kept '%s': buffer %u is not a declared buffer",
+            prog_.drafter_name.c_str(), (unsigned)kept);
+        return RAD_E_INVAL;
+    }
+    if (prog_.buffers[kept].decl.dtype != RAD_I32) {
+        err(RAD_E_DTYPE, "drafter_kept '%s': buffer '%s' is not i32", prog_.drafter_name.c_str(),
+            prog_.buffers[kept].name.c_str());
+        return RAD_E_DTYPE;
+    }
+    prog_.drafter_kept = kept;
+    return RAD_OK;
+}
