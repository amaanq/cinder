+static int ar_gather_of(const RadArgs* a, uint32_t rows, uint32_t n, ArGather* g) {
+    const RadTensor* ye = r4d_opt(a, 9);
+    const RadTensor* ew = r4d_opt(a, 10);
+    const RadTensor* so = r4d_opt(a, 11);
+    *g = ArGather{};
+    if (!ye && !ew && !so) return RAD_OK;
+    if (!ye || !ew || !so) return R4D_NO(RAD_E_INVAL);
