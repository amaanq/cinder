+    o.t_idx_dt((uint32_t)RAD_I32, { M, tiles }, nv, -1, 0);    /* tile_tokens */
+    o.t_idx_dt((uint32_t)RAD_I32, { M, steps }, nv, -1, 0);    /* tokens */
+    o.t((uint32_t)RAD_I32, { M });                             /* kept */
+    if (couple) {
+        o.t((uint32_t)RAD_I32, { M });                                         /* seq_ids */
+        o.t((uint32_t)RAD_U32, { M, (int64_t)RAD_MTP_COUPLE_DRAW_WORDS });      /* draw */
+        o.t((uint32_t)RAD_U32, { steps, M, (int64_t)RAD_MTP_COUPLE_STATE_WORDS }); /* state */
+    }
+    if (fold_i8) o.t(B, { nv, R / 128 });                      /* fold_scale */
+    else o.skip();
+    o.skip();                                                  /* ids */
+    return o.finish(couple ? "dspark_rnn_couple" : "dspark_rnn_greedy", operand, out);
+}
+
+int ref_dspark_rnn_greedy_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    return dspark_shape(p, n_p, operand, out, false);
+}
+int ref_dspark_rnn_couple_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    return dspark_shape(p, n_p, operand, out, true);
+}
+
+/* The walk state's floats at the band's M: libr4d's walk scratch layout. */
+static int64_t walk_floats(int64_t M, int64_t steps, int64_t R) {
+    auto up = [](int64_t b) { return (b + 255) / 256 * 256; };
+    return (up(M * steps * 3 * R * 4) + up(2 * M * R * 4) + up(M * R * 4) + up(M * 4)) / 4;
+}
+
+static int walk_step_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out,
+                           bool couple) {
+    const int64_t M = gi(p, n_p, "M", 0), steps = gi(p, n_p, "steps", 0);
+    const int64_t R = gi(p, n_p, "rank", 0), n = gi(p, n_p, "n", 0);
+    const int64_t slots = gi(p, n_p, "slots", 0), astr = gi(p, n_p, "anchor_stride", 1);
+    const int64_t ne = gi(p, n_p, "n_embed", 0);
+    if (M <= 0 || steps <= 0 || R <= 0 || n <= 0 || slots <= 0 || astr <= 0 || ne <= 0)
+        return RAD_E_UNSUPPORTED;
+    const uint32_t B = (uint32_t)RAD_BF16;
+    Opd o;
+    /* tiles: pairs of small ids read as scores too, every one an embedding row */
+    o.t_idx_dt((uint32_t)RAD_I32, { M, 2 * slots }, ne, -1, 0);
+    o.t(B, { M * steps, n });                                  /* hidden */
+    o.t(B, { M, n });                                          /* ctx */
+    o.t_idx_dt((uint32_t)RAD_I32, { M * astr }, ne, -1, 0);    /* anchor */
+    o.t(B, { 3 * R, 2 * R + 2 * n });                          /* proj */
+    o.t(B, { 3 * R });                                         /* bias */
+    o.t(B, { ne, R });                                         /* embed */
+    o.t((uint32_t)RAD_F32, { walk_floats(M, steps, R) });      /* walk */
+    o.t_idx_dt((uint32_t)RAD_I32, { M, steps }, ne, -1, 0);    /* tokens */
+    o.t_idx_dt((uint32_t)RAD_I32, { M }, steps + 1, -1, 0);    /* kept */
+    if (couple) {
+        o.t((uint32_t)RAD_I32, { M });                                         /* seq_ids */
+        o.t((uint32_t)RAD_U32, { M, (int64_t)RAD_MTP_COUPLE_DRAW_WORDS });      /* draw */
+        o.t((uint32_t)RAD_U32, { steps, M, (int64_t)RAD_MTP_COUPLE_STATE_WORDS }); /* state */
+    }
+    return o.finish(couple ? "dspark_walk_couple" : "dspark_walk_step", operand, out);
+}
+
+int ref_dspark_walk_step_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    return walk_step_shape(p, n_p, operand, out, false);
+}
+int ref_dspark_walk_couple_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    return walk_step_shape(p, n_p, operand, out, true);
+}
+
+int ref_dspark_walk_score_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    const int64_t M = gi(p, n_p, "M", 0), steps = gi(p, n_p, "steps", 0);
+    const int64_t R = gi(p, n_p, "rank", 0), nv = gi(p, n_p, "n_vocab", 0);
+    const int64_t slots = gi(p, n_p, "slots", 0);
+    const bool fold_i8 = gi(p, n_p, "fold_i8", 0) != 0;
+    if (M <= 0 || steps <= 0 || R <= 0 || nv <= 0 || slots * 64 < nv || (fold_i8 && R % 128))
+        return RAD_E_UNSUPPORTED;
+    const uint32_t B = (uint32_t)RAD_BF16;
+    Opd o;
+    o.t((uint32_t)RAD_F32, { M * steps, nv });                 /* logits */
+    o.t((uint32_t)RAD_F32, { walk_floats(M, steps, R) });      /* walk */
+    o.t(fold_i8 ? (uint32_t)RAD_I8 : B, { nv, R });            /* fold */
+    o.t(B, { nv });                                            /* fold_bias */
+    o.t((uint32_t)RAD_I32, { M, 2 * slots });                  /* tiles */
+    if (fold_i8) o.t(B, { nv, R / 128 });                      /* fold_scale */
+    else o.skip();
+    o.skip();                                                  /* ids */
+    return o.finish("dspark_walk_score", operand, out);
+}
+
