diff --git a/libr4d/r4d_gemm_i8w_nt.hip b/libr4d/r4d_gemm_i8w_nt.hip
new file mode 100644
index 0000000000..e47e5e0b5a
--- /dev/null
+++ b/libr4d/r4d_gemm_i8w_nt.hip
@@ -0,0 +1,180 @@ namespace {
+// r4d_gemm_i8w_nt.hip - gemm_nt over an int8 weight with a bf16 activation, gfx1201.
+//
+// C[M,N] = A[M,K] @ (q[N,K] * s[N,K/128])^T, bf16 A and C, fp32 accumulate. The weight is the int8
+// head's row (r4d_fp8_lm.h): K i8 codes, then a bf16 scale per 128 of K, the row padded to 16 bytes.
+// gemm_bf16_nt_m64's grid (WV column tiles x SK k-splits a block, splits reduced in LDS in wave
+// order) at half its weight bytes, for the small decode-time linears that do not fill the
+// machine with logits_gemm_i8's 128-row workgroups.
+//
+// A lane's sixteen K of a WMMA step are labelled 64h + 8u + j (h = lane >> 4, step u of a 128-K
+// group), the same on both operands, so a lane reads its 64 weight bytes of a group as four b128
+// loads and each activation fragment as one. Each group's partial is scaled once: the lane's eight
+// accumulators are one output column, one weight row, one scale.
+#include "r4d.h"
+#include "r4d_gemm_args.h"
+#include "r4d_gdn_wmma.h"
+#include "r4d_fp8_lm.h"
+#include "r4d_fp8_wmma.h"
+#include "r4d_chain.h"
+#include <hip/hip_bf16.h>
+#include <cstdint>
+#include <stdexcept>
+
+namespace {
+
+constexpr int kWave = 32;
+constexpr int kGroup = 128;
+
+typedef unsigned i8w_u4v __attribute__((ext_vector_type(4)));
+
+__device__ __forceinline__ uint32_t i8_bf16_pair(uint32_t p, int sh) {
+    const float lo = (float)(int8_t)(p >> sh), hi = (float)(int8_t)(p >> (sh + 8));
+    return __builtin_amdgcn_perm(__float_as_uint(hi), __float_as_uint(lo), 0x07060302u);
+}
+
+__device__ __forceinline__ v8bf i8x8_bf16(uint32_t lo, uint32_t hi) {
+    i8w_u4v r;
+    r.x = i8_bf16_pair(lo, 0);
+    r.y = i8_bf16_pair(lo, 16);
+    r.z = i8_bf16_pair(hi, 0);
+    r.w = i8_bf16_pair(hi, 16);
+    return __builtin_bit_cast(v8bf, r);
+}
+
+template <int MT>
+__device__ __forceinline__ void gemm_i8w_body(
+    const unsigned short* __restrict__ A, const uint8_t* __restrict__ W,
+    __hip_bfloat16* __restrict__ C, int M, int K, int N, int w_ld, int WV, int SK) {
+    extern __shared__ float red[];
+    const int tid = threadIdx.x, wave = tid / kWave, lane = tid % kWave;
+    const int col_local = wave / SK, ksplit = wave % SK;
+    const int n0 = (blockIdx.x * WV + col_local) * 16;
+    const int mt0 = blockIdx.y * MT;
+    const int groups = K / kGroup / SK, g0 = ksplit * groups, h = lane >> 4;
+
+    v8f acc[MT];
+#pragma unroll
+    for (int i = 0; i < MT; i++) acc[i] = (v8f)(0.f);
+
+    if (n0 < N) {
+        const int nr = min(n0 + (lane & 15), N - 1);
+        const uint8_t* wr = W + (size_t)nr * w_ld + 64 * h;
+        const uint16_t* sr = (const uint16_t*)(W + (size_t)nr * w_ld + K);
+        const unsigned short* ar[MT];
+#pragma unroll
+        for (int i = 0; i < MT; i++)
+            ar[i] = A + (size_t)min((mt0 + i) * 16 + (lane & 15), M - 1) * K + 64 * h;
+
+        /* The next group's weight bytes and scale load while this group's WMMAs run. */
+        uint4 wq[4], wn[4];
+        uint16_t sn = 0;
+#pragma unroll
+        for (int j = 0; j < 4; j++) wq[j] = *(const uint4*)(wr + g0 * kGroup + 16 * j);
+        uint16_t sq = sr[g0];
+        for (int g = g0; g < g0 + groups; ++g) {
+            const int k0 = g * kGroup;
+            if (g + 1 < g0 + groups) {
+#pragma unroll
+                for (int j = 0; j < 4; j++) wn[j] = *(const uint4*)(wr + k0 + kGroup + 16 * j);
+                sn = sr[g + 1];
+            }
+            v8f part[MT];
+#pragma unroll
+            for (int i = 0; i < MT; i++) part[i] = (v8f)(0.f);
+#pragma unroll
+            for (int u = 0; u < 8; u++) {
+                const uint4 q = wq[u >> 1];
+                const v8bf b = (u & 1) ? i8x8_bf16(q.z, q.w) : i8x8_bf16(q.x, q.y);
+#pragma unroll
+                for (int i = 0; i < MT; i++)
+                    part[i] = mma(*(const v8bf*)(ar[i] + k0 + 8 * u), b, part[i]);
+            }
+            const float sc = r4d_fp8::bscale(sq);
+#pragma unroll
+            for (int i = 0; i < MT; i++)
+#pragma unroll
+                for (int e = 0; e < 8; e++) acc[i][e] = fmaf(part[i][e], sc, acc[i][e]);
+#pragma unroll
+            for (int j = 0; j < 4; j++) wq[j] = wn[j];
+            sq = sn;
+        }
+    }
+
+    const int slot = (col_local * SK + ksplit) * 256;
+    const int nthreads = WV * SK * kWave;
+#pragma unroll
+    for (int i = 0; i < MT; i++) {
+        __syncthreads();
+#pragma unroll
+        for (int e = 0; e < 8; e++) red[slot + e * kWave + lane] = acc[i][e];
+        __syncthreads();
+        for (int idx = tid; idx < WV * 256; idx += nthreads) {
+            const int col = idx >> 8, off = idx & 255;
+            float v = 0.f;
+            for (int s = 0; s < SK; s++) v += red[(col * SK + s) * 256 + off];
+            const int l = off & 31;
+            const int n = (blockIdx.x * WV + col) * 16 + (l & 15);
+            const int m = (mt0 + i) * 16 + 8 * (l >> 4) + (off >> 5);
+            if (n < N && m < M) C[(size_t)m * N + n] = (__hip_bfloat16)v;
+        }
+    }
+}
+
+#define R4D_I8W_PARAMS const unsigned short* __restrict__ A, const uint8_t* __restrict__ W,      \
+    __hip_bfloat16* __restrict__ C, int M, int K, int N, int w_ld, int WV, int SK
+template <int MT>
+__global__ __launch_bounds__(1024) void gemm_i8w_kernel(R4D_I8W_PARAMS) {
+    gemm_i8w_body<MT>(A, W, C, M, K, N, w_ld, WV, SK);
+}
+template <int MT>
+__global__ __launch_bounds__(1024) void r4dchain_gemm_i8w(R4D_I8W_PARAMS) {
+    r4d_chain_wait();
+    gemm_i8w_body<MT>(A, W, C, M, K, N, w_ld, WV, SK);
+    r4d_chain_done();
+}
+#undef R4D_I8W_PARAMS
+
+/* SK: the fewest 128-K splits (a divisor of K / 128, at most 32) that put 2048 waves on the
+ * machine. WV: column tiles a block, up to 8 waves. */
+void gemm_i8w_launch(long a, long w, long c, int M, int K, int N, int w_ld, long stream,
+                     bool chain) {
+    const int groups = K / kGroup, ntiles = (N + 15) / 16, mtiles = (M + 15) / 16;
+    const int MT = mtiles >= 4 ? 4 : mtiles >= 2 ? 2 : 1;
+    const int mblocks = (mtiles + MT - 1) / MT;
+    if (mblocks > 65535) throw std::runtime_error("r4d gemm_i8w_nt: M too large");
+    int SK = 1;
+    for (int s = 1; s <= groups && s <= 32; ++s) {
+        if (groups % s) continue;
+        SK = s;
+        if ((long)ntiles * s * mblocks >= 2048) break;
+    }
+    const int WV = SK >= 8 ? 1 : 8 / SK;
+    dim3 grid((ntiles + WV - 1) / WV, mblocks), block(WV * SK * kWave);
+    const size_t smem = (size_t)WV * SK * 256 * sizeof(float);
+    const auto Ap = (const unsigned short*)a;
+    const auto Wp = (const uint8_t*)w;
+    const auto Cp = (__hip_bfloat16*)c;
+    const hipStream_t st = (hipStream_t)stream;
+#define R4D_I8W(MTV)                                                                             \
+    hipLaunchKernelGGL((chain ? r4dchain_gemm_i8w<MTV> : gemm_i8w_kernel<MTV>), grid, block, smem,  \
+                       st, Ap, Wp, Cp, M, K, N, w_ld, WV, SK)
+    if (MT == 4) R4D_I8W(4);
+    else if (MT == 2) R4D_I8W(2);
+    else R4D_I8W(1);
+#undef R4D_I8W
+    if (hipGetLastError() != hipSuccess) throw std::runtime_error("r4d gemm_i8w_nt: launch failed");
+}
+
+}  // namespace
+
+extern "C" int r4d_rad_gemm_i8w(const RadArgs* a, RadStream s) {
+    GemmOps g;
+    int rc = gemm_ops(a, &g, 0);
+    if (rc != RAD_OK) return rc;
+    if (g.K % kGroup || g.b->dtype != RAD_I8) return R4D_NO(RAD_E_SHAPE);
