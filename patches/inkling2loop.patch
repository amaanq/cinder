+                    a16[q] = (float)d;
+                }
+                const float v = red16(a16, lane);
+                if (lane < 16u) s_sum[kb - u0][m][red16_row(lane)] = BIAS ? kRbBiasF + v : v;
+            }
+            cur = nxt;
+        }
+        __syncthreads();
+        if (tid < 16u * MT) {
+            const float* xs_row = XS + (size_t)tok[0] * xs_ld;
+#pragma unroll
+            for (uint32_t m = 1; m < MT; ++m)
+                if (fm == m) xs_row = XS + (size_t)tok[m] * xs_ld;
+            for (uint32_t u = u0; u < u1; ++u) {
+                const float as = xs_row[u];
+                const float raw = s_sum[u - u0][fm][fr];
+                if constexpr (BIAS) {
+                    if (u % kRbFlush == 0u && u) {
+                        acc = __builtin_fmaf(-kRbBiasF, cor, acc);
+                        cor = 0.0f;
+                    }
+                    const float ws = fold_f32<F>(c, row0, u);
+                    cor = __builtin_fmaf(ws, as, cor);
+                    acc = __builtin_fmaf(raw, ws * as, acc);
+                } else {
+                    acc = __builtin_fmaf(raw, as * fold_f32<F>(c, row0 + fr, u), acc);
+                }
+            }
+        }
+        if (u1 < c.nkb) __syncthreads();
+    }
+    if (tid < 16u * MT && fm < M) {
+        float v = BIAS ? __builtin_fmaf(-kRbBiasF, cor, acc) : acc;
+        if constexpr (F::SC == kRowF32) v *= row_scale<F>(c, row0 + fr);
+        Y[(size_t)fm * N + row0 + fr] = f32_to_bf16(v);
+    }
+    if (CH::on) r4d_chain_done();
+}
