+    if (operand < 11) return ref_attn_paged_rel_sink_shape(p, n_p, operand, out);
+    const int64_t M   = gi(p, n_p, "q_len", 0), hd = gi(p, n_p, "head_dim", 0);
+    const int64_t gqa = gi(p, n_p, "gqa", 1), nh = gi(p, n_p, "n_head", gqa);
+    const int64_t pg  = gi(p, n_p, "box_page", 0);
+    if (M <= 0 || hd <= 0 || nh <= 0 || nh % gqa || pg <= 0) return RAD_E_UNSUPPORTED;
+    int64_t ctx = gi(p, n_p, "ctx", 0);
