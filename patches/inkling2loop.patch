+ *          dist < rel_extent, and none past it;
+ *   sinks  [rows, q_heads]: one logit a (row, head) in the softmax's maximum and denominator,
+ *          with no value, as attn_paged_sink's.
+ *
+ * The reference model runs this eagerly in the activation dtype, so each tensor it stores is a
+ * rounding here, `rd` to q's dtype: the score, rd(rd(dot) * scale); the bias, rd of its f32 sum;
+ * their sum, rd; and each probability of the f32 softmax before it weights its value. At the int8
+ * cache a key's K and V elements are its codes times its scales, as in attn_paged. */
+/* `keep`, when given, holds a byte per (query row, kv head, block of the table): a block whose byte
+ * is 0 is skipped as a missing one is (attn_paged_rel_sink_sparse). */
+static int rel_sink_impl(const RadArgs* a, const uint8_t* keep) {
+    if (!a || a->n_t < 11) return RAD_E_INVAL;
+    const RadTensor *q = &a->t[0], *kv = &a->t[1], *bt = &a->t[2], *su = &a->t[3];
+    const RadTensor *rel = &a->t[7], *proj = &a->t[8], *sinks = &a->t[9], *o = &a->t[10];
+    const RadTensor* cus = t_in(a, 6);
+    if (!q->data || !kv->data || !bt->data || !su->data || !rel->data || !proj->data ||
+        !sinks->data || !o->data)
+        return RAD_E_INVAL;
+    if (t_in(a, 4) || t_in(a, 5) || p_int(a, "causal", 1) != 1) return RAD_E_UNSUPPORTED;
+
+    const int64_t head_dim   = p_int(a, "head_dim", 0);
+    const int64_t gqa        = p_int(a, "gqa", 1);
+    const int64_t block_size = p_int(a, "block_size", kv->rank == 4 ? kv->shape[2] : 0);
+    const int64_t window     = p_int(a, "window", 0);
+    const int64_t d_rel      = p_int(a, "d_rel", 0);
+    const int64_t extent     = p_int(a, "rel_extent", 0);
+    if (head_dim <= 0 || gqa <= 0 || block_size <= 0 || window < 0 || d_rel <= 0 || extent <= 0)
+        return RAD_E_SHAPE;
+    if (head_dim > REF_HD_MAX || d_rel > REF_HD_MAX) return RAD_E_UNSUPPORTED;
+
+    const int64_t kv_heads = kv->rank == 4 ? kv->shape[1] : 0;
+    if (kv_heads <= 0 || kv->shape[2] != block_size || kv->shape[3] < 2 * head_dim)
+        return RAD_E_SHAPE;
+    const bool i8 = kv->dtype == RAD_I8;
+    if (i8 && (kv->shape[3] != 2 * head_dim + 4 || kv->stride[3] != 1)) return RAD_E_SHAPE;
+    const int64_t q_heads = gqa * kv_heads;
+    const int64_t n_seq   = numel(su);
+    const int64_t rows    = numel(q) / (q_heads * head_dim);
+    if (n_seq <= 0 || rows <= 0 || (!cus && rows % n_seq != 0) ||
+        (cus && numel(cus) != n_seq + 1))
+        return RAD_E_SHAPE;
+    if (numel(o) < rows * q_heads * head_dim || numel(rel) < rows * q_heads * d_rel ||
+        numel(sinks) < rows * q_heads || numel(proj) != d_rel * extent)
+        return RAD_E_SHAPE;
+    const int64_t q_len = cus ? 0 : rows / n_seq;
+
+    const int64_t max_blocks = bt->rank >= 2 ? bt->shape[bt->rank - 1] : numel(bt) / n_seq;
+    const int64_t bt_rs = bt->rank >= 2 ? bt->stride[bt->rank - 2] : max_blocks;
+    const int64_t bt_cs = bt->rank >= 2 ? bt->stride[bt->rank - 1] : 1;
+    const KVView kvv = kv_view(kv, head_dim, block_size, kv_heads);
+
+    const int64_t q_ds = q->rank >= 2 ? q->stride[q->rank - 1] : 1;
+    const int64_t q_hs = q->rank >= 3 ? q->stride[q->rank - 2] : head_dim * q_ds;
+    const int64_t q_rs = row_stride(q, q_heads * head_dim);
+    const int64_t o_ds = o->rank >= 2 ? o->stride[o->rank - 1] : 1;
+    const int64_t o_hs = o->rank >= 3 ? o->stride[o->rank - 2] : head_dim * o_ds;
+    const int64_t o_rs = row_stride(o, q_heads * head_dim);
+    const int64_t r_ds = rel->rank >= 2 ? rel->stride[rel->rank - 1] : 1;
+    const int64_t r_hs = rel->rank >= 3 ? rel->stride[rel->rank - 2] : d_rel * r_ds;
+    const int64_t r_rs = row_stride(rel, q_heads * d_rel);
+    const int64_t s_hs = laststride(sinks), s_rs = row_stride(sinks, q_heads);
+    const int64_t p_rs = rowoff(proj, 1, extent), p_cs = laststride(proj);
+
+    const uint32_t dt = q->dtype;
+    const float scale = p_f32(a, "scale", 1.0f / std::sqrt((float)head_dim));
+    const int64_t jcap = max_blocks * block_size;
+    const int64_t span = window > 0 ? std::min(window, jcap) : jcap;
+
+    REF_PAR_REGION(rows * q_heads * head_dim * 64)
+    {
+        float* const sc = ws_get((size_t)std::max<int64_t>(span + extent, 1));
+        float* const bias = sc + span;
+        REF_FOR_DYN
+        for (int64_t idx = 0; idx < rows * q_heads; ++idx) {
+            const int64_t h = idx % q_heads, tok = idx / q_heads, kh = h / gqa;
+            int64_t s = 0, qlen = q_len, i = 0;
+            if (cus) {
+                s = seq_of(cus, n_seq, tok);
+                qlen = cu_at(cus, s + 1) - cu_at(cus, s);
+                i = tok - cu_at(cus, s);
+            } else {
+                s = tok / q_len;
+                i = tok - s * q_len;
+            }
+            if (qlen <= 0) continue;
+            const int64_t pos = ld_int(su->dtype, su->data, offlin(su, s)) - qlen + i;
+            const int64_t qb = tok * q_rs + h * q_hs, ob = tok * o_rs + h * o_hs;
+            const int64_t rb = tok * r_rs + h * r_hs;
+
+            /* Keys [j0, j1): causal, inside the window, inside the block table. */
+            const int64_t j1 = std::min(pos + 1, jcap);
+            const int64_t j0 = window > 0 ? std::max<int64_t>(pos - window + 1, 0) : 0;
+            auto key_at = [&](int64_t j) -> int64_t {
+                if (keep && !keep[(tok * kv_heads + kh) * max_blocks + j / block_size]) return -1;
+                const int64_t blk =
+                    ld_int(bt->dtype, bt->data, s * bt_rs + (j / block_size) * bt_cs);
+                return blk < 0 ? -1 : blk * kvv.sb + kh * kvv.sh + (j % block_size) * kvv.so;
+            };
+
+            const int64_t nb = std::min(extent, pos - j0 + 1);
+            for (int64_t dist = 0; dist < nb; ++dist) {
+                float acc = 0.0f;
+                for (int64_t c = 0; c < d_rel; ++c)
+                    acc += ldt(rel, rb + c * r_ds) * ldt(proj, c * p_rs + dist * p_cs);
+                bias[dist] = round_dt(dt, acc);
+            }
+
+            float qf[REF_HD_MAX];
+            for (int64_t d = 0; d < head_dim; ++d) qf[d] = ldt(q, qb + d * q_ds);
+
+            float mx = ldt(sinks, tok * s_rs + h * s_hs);
+            const float sk = mx;
+            for (int64_t j = j0; j < j1; ++j) {
+                const int64_t kb = key_at(j);
+                if (kb < 0) continue;
+                const float km = i8 ? kv_i8_scale(kv->data, kb, head_dim, 0) : 1.0f;
+                float dot = 0.0f;
+                for (int64_t d = 0; d < head_dim; ++d)
+                    dot += qf[d] * (ld_dt(kv->dtype, kv->data, kb + d * kvv.sd) * km);
+                float sj = round_dt(dt, round_dt(dt, dot) * scale);
+                if (pos - j < extent) sj = round_dt(dt, sj + bias[pos - j]);
+                sc[j - j0] = sj;
+                if (sj > mx) mx = sj;
+            }
+
+            float sum = ref_exp(sk - mx);
+            for (int64_t j = j0; j < j1; ++j)
+                if (key_at(j) >= 0) { sc[j - j0] = ref_exp(sc[j - j0] - mx); sum += sc[j - j0]; }
+
+            float acc[REF_HD_MAX];
+            for (int64_t d = 0; d < head_dim; ++d) acc[d] = 0.0f;
+            for (int64_t j = j0; j < j1; ++j) {
+                const int64_t kb = key_at(j);
+                if (kb < 0) continue;
+                const float w = round_dt(dt, sc[j - j0] / sum);
+                const float vm = i8 ? kv_i8_scale(kv->data, kb, head_dim, 1) : 1.0f;
+                const int64_t vb = kb + head_dim * kvv.sd;
+                for (int64_t d = 0; d < head_dim; ++d)
+                    acc[d] += w * (ld_dt(kv->dtype, kv->data, vb + d * kvv.sd) * vm);
+            }
+            for (int64_t d = 0; d < head_dim; ++d) stt(o, ob + d * o_ds, acc[d]);
+        }
+    }
+    return RAD_OK;
+}
+
+int ref_attn_paged_rel_sink(const RadArgs* a, RadStream) { return rel_sink_impl(a, nullptr); }
+
+/* ------------------------------------------------------------------ page boxes */
+/* A box is a head's elementwise K range over the `block_size` tokens of a page in int8 steps:
+ * box[page, head] holds head_dim codes lo, head_dim codes hi and an f32 step s, the page's
+ * largest |K| times kBoxStep, with lo_d the largest code and hi_d the smallest such that
+ * lo_d s <= K_d <= hi_d s (f32 products) over the page. So q . k <= s / 2 sum_d q_d (lo_d + hi_d)
+ * + |q_d| (hi_d - lo_d) for every key of the page (Quest's bound). An empty page is all zero. The
+ * box is those bytes in a bf16 tensor. */
+constexpr float kBoxStep = 1.0f / 126.0f;
+
+/* Rows of sequence s in a step: cu's span, or q_len a sequence. */
+static inline void seq_rows(const RadTensor* cus, int64_t q_len, int64_t s, int64_t* r0,
+                            int64_t* n) {
+    if (cus) {
+        *r0 = ld_int(cus->dtype, cus->data, s);
+        *n = ld_int(cus->dtype, cus->data, s + 1) - *r0;
+    } else {
+        *r0 = s * q_len;
+        *n = q_len;
+    }
+}
+
+/* kv_page_box: the boxes of every page whose last token this step wrote. */
+int ref_kv_page_box(const RadArgs* a, RadStream) {
+    if (!a || a->n_t < 6) return RAD_E_INVAL;
+    const RadTensor *kv = &a->t[0], *bt = &a->t[1], *su = &a->t[2], *box = &a->t[4],
+                    *pt = &a->t[5];
+    const RadTensor* cus = t_in(a, 3);
+    if (!kv->data || !bt->data || !su->data || !box->data || !pt->data) return RAD_E_INVAL;
+    const int64_t head_dim = p_int(a, "head_dim", 0), page = p_int(a, "block_size", 0);
+    const int64_t kblock = p_int(a, "kv_block", 0), M = p_int(a, "M", 0);
+    if (head_dim <= 0 || page <= 0 || kblock <= 0 || page % kblock || kv->rank != 4 ||
+        box->rank != 4 || box->dtype != RAD_BF16)
+        return RAD_E_SHAPE;
+    const int64_t kv_heads = kv->shape[1];
+    if (kv->shape[2] != kblock || box->shape[1] != kv_heads ||
+        box->shape[2] * box->shape[3] < head_dim + 2 || box->stride[3] != 1 ||
+        box->stride[2] != box->shape[3])
+        return RAD_E_SHAPE;
+    const bool i8 = kv->dtype == RAD_I8;
+    const int64_t n_seq = numel(su);
+    if (n_seq <= 0 || (!cus && (M <= 0 || M % n_seq))) return RAD_E_SHAPE;
+    const int64_t q_len = cus ? 0 : M / n_seq;
+    const KVView kvv = kv_view(kv, head_dim, kblock, kv_heads);
+    const int64_t bt_rs = bt->stride[0], pt_rs = pt->stride[0];
+    uint8_t* const bx = (uint8_t*)box->data;
+
+    for (int64_t s = 0; s < n_seq; ++s) {
+        int64_t r0 = 0, n = 0;
+        seq_rows(cus, q_len, s, &r0, &n);
+        const int64_t used = ld_int(su->dtype, su->data, s);
+        if (n <= 0 || used <= 0) continue;
+        for (int64_t p = (used - n) / page; p < used / page; ++p) {
+            const int64_t phys = ld_int(pt->dtype, pt->data, s * pt_rs + p);
+            if (phys < 0) continue;
+            for (int64_t h = 0; h < kv_heads; ++h) {
+                float lo[REF_HD_MAX], hi[REF_HD_MAX];
+                for (int64_t d = 0; d < head_dim; ++d) lo[d] = INFINITY, hi[d] = -INFINITY;
+                for (int64_t j = p * page; j < (p + 1) * page; ++j) {
+                    const int64_t blk = ld_int(bt->dtype, bt->data, s * bt_rs + j / kblock);
+                    if (blk < 0) continue;
+                    const int64_t kb = blk * kvv.sb + h * kvv.sh + (j % kblock) * kvv.so;
+                    const float km = i8 ? kv_i8_scale(kv->data, kb, head_dim, 0) : 1.0f;
+                    for (int64_t d = 0; d < head_dim; ++d) {
+                        const float x = ld_dt(kv->dtype, kv->data, kb + d * kvv.sd) * km;
+                        lo[d] = std::fmin(lo[d], x);
+                        hi[d] = std::fmax(hi[d], x);
+                    }
+                }
+                uint8_t* const o = bx + 2 * (phys * box->stride[0] + h * box->stride[1]);
+                float mx = 0.0f;
+                for (int64_t d = 0; d < head_dim; ++d)
+                    if (lo[d] != INFINITY)
+                        mx = std::fmax(mx, std::fmax(std::fabs(lo[d]), std::fabs(hi[d])));
+                const float st = mx * kBoxStep;
+                for (int64_t d = 0; d < head_dim; ++d) {
+                    int ql = 0, qh = 0;
+                    if (st > 0.0f && lo[d] != INFINITY) {
+                        while (ql > -127 && (float)ql * st > lo[d]) --ql;
+                        while (ql < 127 && (float)(ql + 1) * st <= lo[d]) ++ql;
+                        while (qh < 127 && (float)qh * st < hi[d]) ++qh;
+                        while (qh > -127 && (float)(qh - 1) * st >= hi[d]) --qh;
+                    }
+                    o[d] = (uint8_t)(int8_t)ql;
+                    o[head_dim + d] = (uint8_t)(int8_t)qh;
+                }
+                std::memcpy(o + 2 * head_dim, &st, sizeof st);
+            }
+        }
+    }
+    return RAD_OK;
+}
+
+/* attn_paged_rel_sink over the blocks a page selection keeps. A row at pos keeps its first page,
+ * every block from page P_r = max(pos - max(sparse_last, rel_extent), 0) / box_page through pos,
+ * and of pages 1 .. P_r - 1 the sparse_budget / box_page whose box bound max over the kv head's
+ * query heads of s / 2 times sum_d q_d (lo_d + hi_d) + |q_d| (hi_d - lo_d) (an f32 sum, d in
+ * order; libr4d sums on the matrix cores) is largest, a tie to the lower page. With no more
+ * candidates than that it keeps every block. No kept page is within rel_extent of the row, so no
+ * bias is lost, and each row keeps what it would keep decoding alone. */
+int ref_attn_paged_rel_sink_sparse(const RadArgs* a, RadStream) {
+    if (!a || a->n_t < 13) return RAD_E_INVAL;
+    const RadTensor *q = &a->t[0], *kv = &a->t[1], *bt = &a->t[2], *su = &a->t[3];
+    const RadTensor *box = &a->t[11], *pt = &a->t[12];
+    const RadTensor* cus = t_in(a, 6);
+    if (!q->data || !kv->data || !bt->data || !su->data || !box->data || !pt->data)
+        return RAD_E_INVAL;
+    const int64_t head_dim = p_int(a, "head_dim", 0), gqa = p_int(a, "gqa", 1);
+    const int64_t block_size = p_int(a, "block_size", kv->rank == 4 ? kv->shape[2] : 0);
+    const int64_t extent = p_int(a, "rel_extent", 0), page = p_int(a, "box_page", 0);
+    const int64_t budget = p_int(a, "sparse_budget", 0), last = p_int(a, "sparse_last", 0);
+    if (head_dim <= 0 || head_dim > REF_HD_MAX || block_size <= 0 || page <= 0 ||
+        page % block_size || budget < 0 || last < 0 || kv->rank != 4 || box->rank != 4)
+        return RAD_E_SHAPE;
+    if (p_int(a, "window", 0) != 0) return RAD_E_UNSUPPORTED;
+    const int64_t kv_heads = kv->shape[1], q_heads = gqa * kv_heads;
+    const int64_t n_seq = numel(su), rows = numel(q) / (q_heads * head_dim);
+    if (n_seq <= 0 || rows <= 0 || (!cus && rows % n_seq)) return RAD_E_SHAPE;
+    const int64_t q_len = cus ? 0 : rows / n_seq;
+    const int64_t max_blocks = bt->shape[bt->rank - 1];
+    const int64_t q_ds = q->rank >= 2 ? q->stride[q->rank - 1] : 1;
+    const int64_t q_hs = q->rank >= 3 ? q->stride[q->rank - 2] : head_dim * q_ds;
+    const int64_t q_rs = row_stride(q, q_heads * head_dim);
+    const int64_t per = page / block_size, k_pages = budget / page;
+    const uint8_t* const bx = (const uint8_t*)box->data;
+
+    std::vector<uint8_t> keep((size_t)(rows * kv_heads * max_blocks), 0);
+    std::vector<float> sc;
+    std::vector<int64_t> order;
+    for (int64_t s = 0; s < n_seq; ++s) {
+        int64_t r0 = 0, n = 0;
+        seq_rows(cus, q_len, s, &r0, &n);
+        const int64_t used = ld_int(su->dtype, su->data, s);
+        for (int64_t r = r0; r < r0 + n; ++r) {
+            const int64_t pos = used - n + r - r0;
+            const int64_t nblk = std::min((pos + block_size) / block_size, max_blocks);
+            const int64_t pr = std::max<int64_t>(pos - std::max(last, extent), 0) / page;
+            for (int64_t h = 0; h < kv_heads; ++h) {
+                uint8_t* const kp = keep.data() + (r * kv_heads + h) * max_blocks;
+                if (pr - 1 <= k_pages) {
+                    std::fill(kp, kp + nblk, (uint8_t)1);
+                    continue;
+                }
+                sc.assign((size_t)pr, -INFINITY);
+                for (int64_t p = 1; p < pr; ++p) {
+                    const int64_t phys = ld_int(pt->dtype, pt->data, s * pt->stride[0] + p);
+                    if (phys < 0) continue;
+                    const uint8_t* const b = bx + 2 * (phys * box->stride[0] + h * box->stride[1]);
+                    float st;
+                    std::memcpy(&st, b + 2 * head_dim, sizeof st);
+                    float best = -INFINITY;
+                    for (int64_t g = 0; g < gqa; ++g) {
+                        const int64_t qb = r * q_rs + (h * gqa + g) * q_hs;
+                        float acc = 0.0f;
+                        for (int64_t d = 0; d < head_dim; ++d) {
+                            const float qd = ldt(q, qb + d * q_ds);
+                            const int lo = (int8_t)b[d], hi = (int8_t)b[head_dim + d];
+                            acc += qd * (float)(lo + hi);
+                            acc += std::fabs(qd) * (float)(hi - lo);
+                        }
+                        best = std::fmax(best, acc * (0.5f * st));
+                    }
+                    sc[(size_t)p] = best;
+                }
+                order.clear();
+                for (int64_t p = 1; p < pr; ++p) order.push_back(p);
+                std::stable_sort(order.begin(), order.end(), [&](int64_t x, int64_t y) {
+                    return sc[(size_t)x] > sc[(size_t)y];
+                });
+                for (int64_t i = 0; i < k_pages; ++i)
+                    for (int64_t b = order[(size_t)i] * per; b < (order[(size_t)i] + 1) * per; ++b)
+                        kp[b] = 1;
+                for (int64_t b = 0; b < std::min(per, nblk); ++b) kp[b] = 1;
+                for (int64_t b = pr * per; b < nblk; ++b) kp[b] = 1;
+            }
+        }
+    }
+    return rel_sink_impl(a, keep.data());
+}
