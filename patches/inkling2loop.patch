+        if (on && it != b.end() && !it->is_null() && !named) named = k;
+    };
+    auto in_range = [&](const char* k, double v) {
+        std::string why;
+        if (sampler_value_ok(k, v, &why)) return true;
+        *err = err_bad(k, why);
+        return false;
+    };
+
+    double v = sp.answer_temp;
+    if (!get_num(b, "answer_temperature", &v, err)) return RAD_E_INVAL;
+    if (v >= 0.0 && !in_range("answer_temperature", v)) return RAD_E_INVAL;
+    sp.answer_temp = v < 0.0 ? -1.0f : (float)v;
+    names("answer_temperature", v >= 0.0);
+
+    v = sp.answer_top_p;
+    if (!get_num(b, "answer_top_p", &v, err)) return RAD_E_INVAL;
+    if (v >= 0.0 && !in_range("answer_top_p", v)) return RAD_E_INVAL;
+    sp.answer_top_p = v < 0.0 ? -1.0f : (float)v;
+    names("answer_top_p", v >= 0.0);
+
+    if (!get_str(b, "reasoning_close_cue", &sp.reasoning_cue, err)) return RAD_E_INVAL;
+    names("reasoning_close_cue", !sp.reasoning_cue.empty());
