+}
+
+/* attn_paged_rel_sink_sparse: rel_sink's operands, then the boxes and their table. */
+enum { RS_BOX = 11, RS_PT };
+
+template <bool I8>
+static int rel_sink_sparse_h128(const RadArgs* a, RadStream stream) {
+    RelSinkArgs A{};
+    long long jcap = 0;
+    const int rc = rel_sink_args(a, 128, A, &jcap);
+    if (rc != RAD_OK) return rc;
+    if (A.gqa > kTq) return R4D_NO(RAD_E_UNSUPPORTED);
+    if ((r4d_opt(a, RS_KV)->dtype == RAD_I8) != I8) return R4D_NO(RAD_E_DTYPE);
+    const RadTensor* box = r4d_opt(a, RS_BOX);
+    const RadTensor* pt = r4d_opt(a, RS_PT);
+    if (!box || !pt) return R4D_NO(RAD_E_INVAL);
+    if (box->dtype != RAD_BF16 || pt->dtype != RAD_I32) return R4D_NO(RAD_E_DTYPE);
+    if (box->rank != 4 || box->shape[1] != A.kv_heads || box->shape[2] * box->shape[3] < 128 + 2 ||
+        box->stride[3] != 1 || box->stride[2] != box->shape[3] || pt->rank != 2 ||
+        pt->shape[0] < A.n_seq || !r4d_contig(pt))
+        return R4D_NO(RAD_E_SHAPE);
+    SparseGeom G;
+    if (!sparse_geom(a, std::min<long long>(A.rows, kSplitRows), G) ||
+        box->shape[2] != G.page)
+        return R4D_NO(RAD_E_SHAPE);
+    SparseArgs S{};
+    S.box = (const uint8_t*)r4d_p(box);
+    S.box_ps = box->stride[0] * 2;
+    S.box_hs = box->stride[1] * 2;
+    S.pt = (const int*)r4d_p(pt);
+    S.pt_pitch = (int)pt->shape[1];
+    S.list_pitch = (int)G.list_pitch;
+    S.box_page = (int)G.page;
+    S.per = (int)G.per;
+    S.kpages = (int)G.kpages;
+    S.reach = (int)G.reach;
+    return r4d_geti_or(a, "chain", 0) != 0 && A.rows <= 64
+               ? rel_sink_emit<I8, r4dchain>(a, stream, A, jcap, &S)
+               : rel_sink_emit<I8, R4dUnchained>(a, stream, A, jcap, &S);
+}
+
+extern "C" int r4d_rad_attn_rel_sink_sparse_h128_bf16(const RadArgs* a, RadStream stream) {
+    return rel_sink_sparse_h128<false>(a, stream);
+}
