+    float temp(const SamplingParams& sp) const {
+        if (answering()) return sp.answer_temp >= 0.0f && !sp.greedy() ? sp.answer_temp : sp.temp;
+        return boost > 0 ? std::max(sp.temp + kLoopBoost, 1.0f) : sp.temp;
+    }
+    float top_p(const SamplingParams& sp) const {
+        return answering() && sp.answer_top_p >= 0.0f && !sp.greedy() ? sp.answer_top_p
+                                                                        : sp.top_p;
+    }
