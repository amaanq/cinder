+    if (ye->dtype != RAD_BF16 || ew->dtype != RAD_F32 || so->dtype != RAD_I32)
+        return R4D_NO(RAD_E_DTYPE);
+    if (k <= 0 || ye->rank != 2 || ye->shape[1] != n || ew->rank != 2 || ew->shape[1] < k ||
+        ew->shape[0] < rows || ye->shape[0] != r4d_numel(so) || r4d_numel(so) < (long long)rows * k)
