+private:
+    void settle(const SamplingParams& sp) {
+        if (closing < 0 && think.inside() && sp.thinking_budget >= 0 &&
+            think.body >= sp.thinking_budget) {
+            closing = 0;
+            if (event == None) event = BudgetClose;
+        }
+    }
+};
