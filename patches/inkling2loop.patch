+// moe_gemm_q over routed experts kept as a release ships them, against a bf16 activation. The
+// dtype `nvfp4a16` is NVFP4 (e2m1 codes, an E4M3 scale per (row, 16 of K), one f32 an expert) and
+// `mxfp8a16` is MXFP8 (E4M3 values, an E8M0 exponent per (row, 32 of K)). The codes stay packed in
+// VRAM and are decoded where they are read.
+//
+// A weight is its code times its group's scale, and that product is exact in bf16. An e2m1 code
+// has two significant bits and an E4M3 scale four, and an E4M3 value has four under a power of two
+// (exact wherever the product is a normal bf16, 2^-126 and up). So a wave decodes each 64 of K of
+// its sixteen weight rows into bf16 WMMA fragments, through f32 whose high half is the bf16, and
+// the bf16 WMMA sums them against the run's activation rows in f32 over all of K. NVFP4's f32 an
+// expert meets a row's sum once, at the store. libref scales each group's sub-sum by the product of
+// its two levels, so the two differ by f32 rounding and by the WMMA's order within a step.
+//
+// With `a_scale` present, which a float activation's graph does not issue but the op allows, each
+// scale group's steps are summed apart and folded under the activation's scale for the group.
+//
+// One kernel, r4d_moe_iqr.hip's tile path at these codes. A block serves one run of sorted rows of
+// one expert against four 16-row tiles of that expert's weight, a wave a tile down all of its K,
+// with no shared staging and no barrier in the K loop. The weight comes straight to registers and
+// the activation's fragments from global memory, where a run's rows sit in L2. The x grid is
+// r4d_moe_iqr.hip's (tile, run) slots inside r4d_moe.hip's decode band and, above it, the entries
+// of the run map moe_blockmap_kernel builds in the op's scratch at 64 rows an entry, so a wave
+// decodes its 64 of K once for up to four token tiles.
+
+#include "r4d.h"
+#include "r4d_args.h"
+#include "r4d_chain.h"
+#include "r4d_emit.h"
+#include "r4d_fp8_wmma.h"
+#include "r4d_moe_gather.h"
+#include "r4d_moe_sort.h"
+#include "r4d_mxfp4.h"
+
+#include <cstring>
+
+/* r4d_moe.hip's run map of a grouped GEMM at `fm` rows a block, built in `scratch` by one
+ * launch, with its entry count bound and the bytes it takes. */
+long long r4d_moe_blockmap_cap(long long T, long long n_expert, long long fm);
+long long r4d_moe_blockmap_bytes(long long cap);
+int r4d_moe_blockmap_emit(RadStream s, const int32_t* off, uint32_t n_expert, uint32_t T,
+                          uint32_t fm, uint32_t cap, uint32_t* map);
+/* Whether T sorted rows over n_expert experts are served by the decode grid. */
+bool r4d_moe_in_decode_band(long long T, long long n_expert);
+
+namespace {
+
+using namespace r4d_fp8;
+using r4d_moesort::kMaxExpert;
+using r4d_moesort::wave_incl_scan_i32;
+
+constexpr uint32_t kWave = 32;
+/* Sorted rows a token tile holds, and the weight tiles (waves) a block. */
+constexpr uint32_t kRows = 16, kTiles = 4;
+/* K a wave decodes at a time, four WMMA steps. */
+constexpr uint32_t kBK = 64;
+/* Where a sorted row's activation is: its slot's token row, its own row, or the only row, which
+ * keeps the first activation load off the `sorted` round trip. */
+constexpr uint32_t kTokenRows = 0, kSortedRows = 1, kOneToken = 2;
+/* A run-map entry that owns no expert (r4d_moe.hip's kMapTail). Its rows are dropped slots. */
+constexpr uint32_t kTail = 0xffffffffu;
+
+#define R4D_MOEA16_CHK() do { hipError_t e_ = hipGetLastError();                    \
+                              if (e_ != hipSuccess) return -100 - (int)e_; } while (0)
+
+typedef __bf16 bf8v __attribute__((ext_vector_type(8)));
+typedef uint32_t u32x2 __attribute__((ext_vector_type(2)));
+
+__device__ __forceinline__ f8v mma16(bf8v a, bf8v b, f8v c) {
+    return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
+}
+
+/* One class of experts (r4d_moe.hip's MoeCls). Expert e is entry e / 2 of class e & 1. `w` and
+ * `s` are pointer arrays where their stride is 0 and stacked planes otherwise, and the pitches
+ * are a row's bytes. */
+struct A16Cls {
+    const void* const* w;
+    const void* const* s;
+    size_t w_s0, s_s0;
+    uint32_t w_ld, s_ld;
+};
+
+__device__ __forceinline__ const uint8_t* entry(const void* const* tab, size_t stride0,
+                                                uint32_t e) {
+    if (stride0 == 0) return (const uint8_t*)tab[e];
+    return (const uint8_t*)tab + (size_t)e * stride0;
+}
+
+/* Routed slot f's token, f / top_k, by the launch's reciprocal `inv_k` (0: top_k is 1), as
+ * r4d_moe_iqr.hip's. */
+__device__ __forceinline__ uint32_t slot_token(uint32_t f, uint32_t inv_k) {
+    return inv_k ? __umulhi(f, inv_k) : f;
+}
+
+/* A wave-uniform pointer held in scalar registers, as r4d_moe_iqr.hip's. */
+template <class T>
+__device__ __forceinline__ T* uniform(T* p) {
+    const uint64_t u = (uint64_t)p;
+    const uint64_t lo = (uint32_t)__builtin_amdgcn_readfirstlane((uint32_t)u);
+    const uint64_t hi = (uint32_t)__builtin_amdgcn_readfirstlane((uint32_t)(u >> 32));
+    return (T*)(hi << 32 | lo);
+}
+
+/* A lane's share of 64 of K of its weight row, as stored. Step s is K 16 s + 8 h .. + 7 of the
+ * block for the lane's half h, the eight elements a WMMA fragment holds, so a step is one NVFP4
+ * scale group and half an MXFP8 one. `s` is the block's scales, a byte a group. */
+template <bool NV>
+struct Raw {
+    uint32_t c[NV ? 4 : 8];
+    uint32_t s;
+};
+
+/* The expert tables' pointers pass through `uniform`, which loses their address space, and a
+ * generic pointer's load is a flat load on both the load and the LDS counters. */
+template <class T>
+__device__ __forceinline__ T ldg(const uint8_t* p) {
+    return *(__attribute__((address_space(1))) const T*)p;
+}
+
+/* `wrow` is the lane's first code of its tile's first block and `wsr` its row's first scale
+ * (NVFP4), or the lane's row at its half's first element and the row's scales (MXFP8). */
+template <bool NV>
+__device__ __forceinline__ Raw<NV> fetch(const uint8_t* wrow, const uint8_t* wsr, uint32_t kb) {
+    Raw<NV> r;
+    if constexpr (NV) {
+        const r4d_u32x4 v = ldg<r4d_u32x4>(wrow + kb * 512u);
+#pragma unroll
+        for (uint32_t s = 0; s < 4; ++s) r.c[s] = v[s];
+        r.s = ldg<uint32_t>(wsr + kb * 64u);
+    } else {
+#pragma unroll
+        for (uint32_t s = 0; s < 4; ++s) {
+            const u32x2 v = ldg<u32x2>(wrow + kb * kBK + s * 16u);
+            r.c[2 * s] = v[0];
+            r.c[2 * s + 1] = v[1];
+        }
+        r.s = ldg_u16((const uint16_t*)(wsr + kb * 2u));
+    }
+    return r;
+}
+
+/* The block's four fragments, each code times its group's scale in f32, kept as the bf16 that
+ * product is. An E8M0 of 0 is 2^-127, as rad_e8m0_to_f32 reads it. */
+template <bool NV>
+__device__ __forceinline__ void decode(const Raw<NV>& r, bf8v (&a)[4]) {
+    float sc[4];
+    if constexpr (NV) {
+        const v2f lo = e4m3_pk<false>(r.s), hi = e4m3_pk<true>(r.s);
+        sc[0] = lo.x;
+        sc[1] = lo.y;
+        sc[2] = hi.x;
+        sc[3] = hi.y;
+    } else {
+#pragma unroll
+        for (uint32_t g = 0; g < 2; ++g) {
+            const uint32_t e = (r.s >> (8u * g)) & 0xffu;
+            sc[2 * g] = sc[2 * g + 1] = __uint_as_float(e ? e << 23 : 0x00400000u);
+        }
+    }
+#pragma unroll
+    for (uint32_t s = 0; s < 4; ++s) {
+        uint32_t lo, hi;
+        if constexpr (NV) {
+            r4d_mxfp4_unpack8_exact(r.c[s], &lo, &hi);
+        } else {
+            lo = r.c[2 * s];
+            hi = r.c[2 * s + 1];
+        }
+        const v2f p[4] = { e4m3_pk<false>(lo), e4m3_pk<true>(lo), e4m3_pk<false>(hi),
+                           e4m3_pk<true>(hi) };
+        r4d_u32x4 q;
+#pragma unroll
+        for (uint32_t i = 0; i < 4; ++i)
+            q[i] = bf16_pack_hi(__float_as_uint(p[i].x * sc[s]), __float_as_uint(p[i].y * sc[s]));
+        a[s] = __builtin_bit_cast(bf8v, q);
+    }
+}
+
+/* moe_ffn_q's two phases in one grid (moe_ffn_kernel). A gate/up block writes the activation of
+ * its run's rows for 32 columns of `eff`, then counts itself in `ready` for its grid column; a down
+ * block of that column waits for all `n_gate` of them, and the last of its `n_down` resets both
+ * counters for the next launch. */
+struct FfnX {
+    uint16_t* eff;
+    uint32_t* ready;
+    uint32_t* done;
+    uint32_t  n_gate, n_down, F;
+    float     gcap, ucap;
+};
+/* FF: 0 the plain op, 1 the fused op's gate/up and activation, 2 its down projection. */
+enum : uint32_t { kPlain = 0, kGateUp = 1, kDown = 2 };
+
+/* NV is NVFP4, else MXFP8. AS is a present `a_scale`. MAP is the run-map grid, whose block serves
+ * NT token tiles of its run. */
+#define R4D_MOEA16_PARAMS                                                                         \
+    const uint16_t* __restrict__ X, const float* __restrict__ XS, const A16Cls c_0,               \
+    const A16Cls c_1, const int32_t* __restrict__ sorted, const int32_t* __restrict__ off,        \
+    uint16_t* __restrict__ Y, const uint32_t* __restrict__ map, uint32_t T, uint32_t K,           \
+    uint32_t n_expert, uint32_t inv_k, uint32_t x_ld, uint32_t xs_ld, uint32_t y_ld,              \
+    uint32_t a_mode
+template <bool NV, bool AS, bool MAP, uint32_t NT, uint32_t FF = kPlain>
+__device__ __forceinline__ void moe_a16_body(R4D_MOEA16_PARAMS, uint32_t yb, const FfnX& fx) {
+    static_assert(NT == 1u || MAP, "several token tiles a block need the run map's grid");
+    static_assert(FF == kPlain || (!AS && (!MAP || FF == kGateUp)),
+                  "the fused op has no a_scale, and its down blocks are the decode band's");
+    constexpr uint32_t NTHR = kTiles * kWave, kCols = kTiles * 16u;
+    /* WMMA steps a scale group, and the groups a block. */
+    constexpr uint32_t kGS = NV ? 1u : 2u, kGB = 4u / kGS;
+    __shared__ uint32_t s_sel[4];
+    const uint32_t tid = threadIdx.x, lane = tid & (kWave - 1);
+    const uint32_t wave = __builtin_amdgcn_readfirstlane(tid / kWave);
+    const uint32_t ycol0 = yb * kCols;
+    auto zero_rows = [&](uint32_t ra, uint32_t rb) {
+        for (uint32_t x = tid; x < (rb - ra) * kCols; x += NTHR)
+            Y[(size_t)(ra + x / kCols) * y_ld + ycol0 + x % kCols] = 0;
+    };
+
+    /* The block's run is expert e over sorted rows [rs, re). */
+    uint32_t e, rs, re;
+    if constexpr (MAP) {
+        if (blockIdx.x >= map[0]) return;
+        e = map[1 + 2 * blockIdx.x];
+        rs = map[2 + 2 * blockIdx.x];
+        if (e == kTail) {
+            if (FF == kPlain) zero_rows(rs, rs + kRows * NT < T ? rs + kRows * NT : T);
+            return;
+        }
+        const uint32_t oe = (uint32_t)off[e + 1];
+        re = oe < T ? oe : T;
+        if (re > rs + kRows * NT) re = rs + kRows * NT;
+    } else {
+        /* r4d_moe_iqr.hip's run search. The block's first wave holds kMaxExpert / 32 consecutive
+         * experts' offsets a lane, clamped to the tile's rows, numbers the runs that meet the tile
+         * in expert order, and the lane holding run `jrun` hands over its expert and bounds. */
+        constexpr uint32_t NPT = kMaxExpert / kWave;
+        static_assert(kMaxExpert % kWave == 0 && NPT <= 16, "a lane's experts in one mask");
+        const uint32_t r0 = (blockIdx.x / kRows) * kRows, jrun = blockIdx.x % kRows;
+        if (r0 >= T) return;
+        const uint32_t rN = r0 + kRows < T ? r0 + kRows : T;
+        /* Asked for ahead of the search, so its round trip is the search's, not one after it. */
+        const uint32_t live = (uint32_t)off[n_expert];
+        if (wave == 0u) {
+            uint32_t cv[NPT + 1];
+#pragma unroll
+            for (uint32_t k = 0; k <= NPT; ++k) {
+                const uint32_t x = lane * NPT + k;
+                const uint32_t o = (uint32_t)off[x < n_expert ? x : n_expert];
+                cv[k] = o < r0 ? r0 : o > rN ? rN : o;
+            }
+            uint32_t pm = 0;
+#pragma unroll
+            for (uint32_t k = 0; k < NPT; ++k) pm |= (cv[k] < cv[k + 1] ? 1u : 0u) << k;
+            const uint32_t cnt = (uint32_t)__builtin_popcount(pm);
+            const uint32_t inc = (uint32_t)wave_incl_scan_i32((int32_t)cnt, lane);
+            if (lane == kWave - 1) s_sel[3] = inc;
+            const uint32_t before = inc - cnt;
+            if (jrun >= before && jrun < before + cnt) {
+                uint32_t rem = jrun - before, pos = 0, bits = pm;
+#pragma unroll
+                for (uint32_t h = NPT / 2u; h; h >>= 1) {
+                    const uint32_t c = (uint32_t)__builtin_popcount(bits & ((1u << h) - 1u));
+                    const bool up = rem >= c;
+                    rem -= up ? c : 0u;
+                    pos += up ? h : 0u;
+                    bits = up ? bits >> h : bits;
+                }
+                const uint32_t ex = lane * NPT + pos;
+                const uint32_t oa = (uint32_t)off[ex], ob = (uint32_t)off[ex + 1];
+                s_sel[0] = ex;
+                s_sel[1] = oa > r0 ? oa : r0;
+                s_sel[2] = ob < rN ? ob : rN;
+            }
+        }
+        lds_barrier();
+        /* One of the tile's blocks zeroes its dropped slots. */
+        if (FF != kGateUp && jrun == 0 && live < rN) zero_rows(r0 > live ? r0 : live, rN);
+        if (jrun >= s_sel[3]) return;
+        e = s_sel[0];
+        rs = s_sel[1];
+        re = s_sel[2];
+    }
+    e = __builtin_amdgcn_readfirstlane(e);
+    rs = __builtin_amdgcn_readfirstlane(rs);
+    re = __builtin_amdgcn_readfirstlane(re);
+    const uint32_t nrows = re - rs;
+    /* As r4d_chain_wait: one lane polls, then the block acquires the gate/up blocks' rows. */
+    auto wait_ready = [&]() {
+        if (tid == 0) {
+            int n = 0;
+            while (__hip_atomic_load(fx.ready + blockIdx.x, __ATOMIC_RELAXED,
+                                     __HIP_MEMORY_SCOPE_AGENT) < fx.n_gate) {
+                if (n++ < 8) __builtin_amdgcn_s_sleep(1);
+                else __builtin_amdgcn_s_sleep(16);
+            }
+        }
+        __syncthreads();
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+    };
+
+    /* The weight is the WMMA's A operand, so a lane holds one weight row's K half and eight
+     * weight rows of its token column's sums. */
+    const A16Cls& C = (e & 1u) ? c_1 : c_0;
+    const uint8_t* W = uniform(entry(C.w, C.w_s0, e >> 1));
+    const uint8_t* S = uniform(entry(C.s, C.s_s0, e >> 1));
+    /* A gate/up block's waves 0 and 1 take gate rows and 2 and 3 the up rows F further on. */
+    const uint32_t col = frag_c(lane);
+    const uint32_t row0 = FF == kGateUp ? (wave & 1u) * 16u + yb * 32u + (wave >> 1) * fx.F
+                                        : ycol0 + wave * 16u;
+    /* NVFP4's tile of 16 rows is its rows' bytes laid out tile-major (r4d_layout.cpp's
+     * r4d.nvfp4.tile): a block's codes are 512 bytes, sixteen a lane, and its scales 64, four a
+     * row. */
+    const uint8_t* wrow = NV ? W + (size_t)row0 * C.w_ld + lane * 16u
+                             : W + (size_t)(row0 + col) * C.w_ld + frag_k0(lane);
+    const uint8_t* wsr = NV ? S + R4D_NVFP4_LEVEL_BYTES + (size_t)row0 * C.s_ld + col * 4u
+                            : S + (size_t)(row0 + col) * C.s_ld;
+    /* Asked for before the K loop, where its round trip overlaps the weights' rather than
+     * following the last WMMA. */
+    const float level = NV ? ldg<float>(S) : 1.0f;
+
+    /* Token tile j is the run's rows 16 j .. 16 j + 15, and a lane's token in it is its fragment
+     * column's sorted row, the run's last row past the run (those columns are not stored). */
+    const uint16_t* xrow[NT];
+    const float* xsr[NT];
+    bool okr[NT];
+#pragma unroll
+    for (uint32_t j = 0; j < NT; ++j) {
+        const uint32_t rj = j * kRows + col;
+        const uint32_t sr = rs + (rj < nrows ? rj : nrows - 1u);
+        const int32_t f = sorted[sr];
+        const uint32_t tok = a_mode == kOneToken ? 0u
+                           : a_mode == kSortedRows ? sr
+                           : (f < 0 ? 0u : slot_token((uint32_t)f, inv_k));
+        xrow[j] = X + (size_t)tok * x_ld + frag_k0(lane);
+        xsr[j] = XS + (size_t)tok * xs_ld;
+        okr[j] = f >= 0;
+    }
+    auto bload = [&](uint32_t j, uint32_t kb, bf8v (&b)[4]) {
+#pragma unroll
+        for (uint32_t s = 0; s < 4; ++s) b[s] = *(const bf8v*)(xrow[j] + kb * kBK + s * 16u);
+    };
+
+    /* The weight and the first tile's activation fragments are asked for kAhead blocks ahead,
+     * a wider run's tiles one block ahead. A decode wave walks all of
+     * K alone, so one block ahead left it waiting a memory latency a block. Inkling 2 Mini's
+     * gate_up at two ranks and an 8-row verify went from 115.8 to 92.7 us; one row's 30.3 us and
+     * the down projection's are unchanged. */
+    constexpr uint32_t kAhead = 4;
+    f8v out[NT];
+#pragma unroll
+    for (uint32_t j = 0; j < NT; ++j) out[j] = acc_zero();
+    const uint32_t nkb = K / kBK;
+    Raw<NV> wq[kAhead];
+    bf8v xq[kAhead][4];
+    /* Token tile j's WMMA steps for block kb, its weight fragments `a` and activation `b`. */
+    auto tile_mma = [&](uint32_t j, uint32_t kb, const bf8v(&a)[4], const bf8v(&b)[4]) {
+        if constexpr (AS) {
+#pragma unroll
+            for (uint32_t g = 0; g < kGB; ++g) {
+                f8v sub = acc_zero();
+#pragma unroll
+                for (uint32_t s = g * kGS; s < (g + 1u) * kGS; ++s) sub = mma16(a[s], b[s], sub);
+                const float sa = xsr[j][kb * kGB + g];
+#pragma unroll
+                for (uint32_t t = 0; t < 8; ++t) out[j][t] = __builtin_fmaf(sub[t], sa, out[j][t]);
+            }
+        } else {
+#pragma unroll
+            for (uint32_t s = 0; s < 4; ++s) out[j] = mma16(a[s], b[s], out[j]);
+        }
+    };
+    if (NT == 1u || nrows <= kRows) {
+        /* One token tile, every run of a batch of up to 16 tokens. Every load is issued
+         * unconditionally, past the last block at the last block's address: the load counter
+         * returns in order, and a load under a branch left the waits after the merge draining
+         * the whole queue once a group. A slot is asked for again only once its registers are
+         * read, the weight's after the decode and the activation's after the WMMAs, with the
+         * scheduler fenced off from hoisting the activation's: a load into a copy left the loop
+         * rotating pending registers with moves, each of which waited for every older load. */
+        auto clampkb = [&](uint32_t kb) { return kb < nkb ? kb : nkb - 1u; };
+        /* A down block asks for its weights before it waits for the activation. */
+#pragma unroll
+        for (uint32_t p = 0; p < kAhead; ++p) {
+            wq[p] = fetch<NV>(wrow, wsr, clampkb(p));
+            if (FF != kDown) bload(0u, clampkb(p), xq[p]);
+        }
+        if constexpr (FF == kDown) {
+            wait_ready();
+#pragma unroll
+            for (uint32_t p = 0; p < kAhead; ++p) bload(0u, clampkb(p), xq[p]);
+        }
+        auto step = [&](uint32_t kb, uint32_t p, bool more) {
+            bf8v a[4];
+            decode<NV>(wq[p], a);
+            if (more) wq[p] = fetch<NV>(wrow, wsr, clampkb(kb + kAhead));
+            tile_mma(0u, kb, a, xq[p]);
+            if (more) {
+                __builtin_amdgcn_sched_barrier(0);
+                bload(0u, clampkb(kb + kAhead), xq[p]);
+            }
+        };
+        uint32_t kb0 = 0;
+        for (; kb0 + kAhead <= nkb; kb0 += kAhead) {
+#pragma unroll
+            for (uint32_t p = 0; p < kAhead; ++p) step(kb0 + p, p, true);
+        }
+#pragma unroll
+        for (uint32_t p = 0; p < kAhead; ++p)
+            if (kb0 + p < nkb) step(kb0 + p, p, false);
+    } else {
+        if constexpr (FF == kDown) wait_ready();
+        /* Every token tile's activation one block ahead, each tile's asked for again once its
+         * WMMA steps have read it, so a block's loads run under the block before. */
+        bf8v xt[NT][4];
+#pragma unroll
+        for (uint32_t p = 0; p < kAhead; ++p)
+            if (p < nkb) wq[p] = fetch<NV>(wrow, wsr, p);
+#pragma unroll
+        for (uint32_t j = 0; j < NT; ++j)
+            if (j * kRows < nrows) bload(j, 0u, xt[j]);
+        for (uint32_t kb0 = 0; kb0 < nkb; kb0 += kAhead) {
+#pragma unroll
+            for (uint32_t p = 0; p < kAhead; ++p) {
+                const uint32_t kb = kb0 + p;
+                if (kb >= nkb) break;
+                bf8v a[4];
+                decode<NV>(wq[p], a);
+                if (kb + kAhead < nkb) wq[p] = fetch<NV>(wrow, wsr, kb + kAhead);
+#pragma unroll
+                for (uint32_t j = 0; j < NT; ++j) {
+                    if (j * kRows < nrows) {
+                        tile_mma(j, kb, a, xt[j]);
+                        if (kb + 1u < nkb) {
+                            __builtin_amdgcn_sched_barrier(0);
+                            bload(j, kb + 1u, xt[j]);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    const uint32_t a0 = acc_row(lane, 0);
+    if constexpr (FF == kGateUp) {
+        /* The bf16 gate_up values the plain op stores, met in LDS, through capped_glu_kernel's
+         * arithmetic (r4d_inkling.hip), so `eff` holds the bytes capped_sigmoid_glu writes. */
+        __shared__ uint4 s_up[NT][2][kWave];
+        auto pack = [&](uint32_t j) {
+            float v[8];
+#pragma unroll
+            for (uint32_t t = 0; t < 8; ++t) v[t] = okr[j] ? out[j][t] * level : 0.0f;
+            return make_uint4(bf16x2_rne(v[0], v[1]), bf16x2_rne(v[2], v[3]),
+                              bf16x2_rne(v[4], v[5]), bf16x2_rne(v[6], v[7]));
+        };
+        if (wave >= 2u)
+#pragma unroll
+            for (uint32_t j = 0; j < NT; ++j) s_up[j][wave - 2u][lane] = pack(j);
+        lds_barrier();
+        if (wave < 2u) {
+#pragma unroll
+            for (uint32_t j = 0; j < NT; ++j) {
+                const uint32_t rj = j * kRows + col;
+                if (rj >= nrows) continue;
+                const uint4 q = pack(j), uq = s_up[j][wave][lane];
+                const uint32_t gw[4] = { q.x, q.y, q.z, q.w }, uw[4] = { uq.x, uq.y, uq.z, uq.w };
+                uint16_t* dst = fx.eff + (size_t)(rs + rj) * fx.F + row0 + a0;
+#pragma unroll
+                for (uint32_t t = 0; t < 8; ++t) {
+                    const float g = bf16_to_f32((uint16_t)(gw[t / 2] >> (16 * (t & 1)))),
+                                u = bf16_to_f32((uint16_t)(uw[t / 2] >> (16 * (t & 1))));
+                    const float cg = fx.gcap * tanhf(g / fx.gcap),
+                                cu = fx.ucap * tanhf(u / fx.ucap);
+                    const float a = 1.0f / (1.0f + expf(-g));
+                    const float ag = a * cg;
+                    dst[t] = f32_to_bf16(ag * cu);
+                }
+            }
+        }
+        if constexpr (!MAP) {
+            __threadfence();
+            __syncthreads();
+            if (tid == 0)
+                __hip_atomic_fetch_add(fx.ready + blockIdx.x, 1u, __ATOMIC_RELEASE,
+                                       __HIP_MEMORY_SCOPE_AGENT);
+        }
+        return;
+    }
+#pragma unroll
+    for (uint32_t j = 0; j < NT; ++j) {
+        const uint32_t rj = j * kRows + col;
+        if (rj < nrows) {
+            float v[8];
+#pragma unroll
+            for (uint32_t t = 0; t < 8; ++t) v[t] = okr[j] ? out[j][t] * level : 0.0f;
+            *(uint4*)(Y + (size_t)(rs + rj) * y_ld + row0 + a0) =
+                make_uint4(bf16x2_rne(v[0], v[1]), bf16x2_rne(v[2], v[3]),
+                           bf16x2_rne(v[4], v[5]), bf16x2_rne(v[6], v[7]));
+        }
+    }
+    if constexpr (FF == kDown) {
+        __syncthreads();
+        if (tid == 0 && __hip_atomic_fetch_add(fx.done + blockIdx.x, 1u, __ATOMIC_RELAXED,
+                                               __HIP_MEMORY_SCOPE_AGENT) + 1u == fx.n_down) {
+            __hip_atomic_store(fx.ready + blockIdx.x, 0u, __ATOMIC_RELAXED,
+                               __HIP_MEMORY_SCOPE_AGENT);
+            __hip_atomic_store(fx.done + blockIdx.x, 0u, __ATOMIC_RELAXED,
+                               __HIP_MEMORY_SCOPE_AGENT);
+        }
+    }
+}
+
+template <bool NV, bool AS, bool MAP, uint32_t NT, class CH>
+__global__ __launch_bounds__(kTiles * kWave)
+void moe_a16_kernel(R4D_MOEA16_PARAMS) {
+    if (CH::on) r4d_chain_wait();
+    moe_a16_body<NV, AS, MAP, NT>(X, XS, c_0, c_1, sorted, off, Y, map, T, K, n_expert, inv_k,
+                                  x_ld, xs_ld, y_ld, a_mode, blockIdx.y, FfnX{});
+    if (CH::on) r4d_chain_done();
+}
+#undef R4D_MOEA16_PARAMS
+
+/* moe_gather into `x` and the all-reduce's push after moe_ffn (moe_ffn_q_ar_causal_conv1d): the
+ * last down block of each column band, counted in `band`, sums its columns' routed rows a token
+ * as ar_conv_kernel's gather does and writes each pair to `x` and, tagged with the all-reduce's
+ * next launch (`par` + 1), to the peer's LL slot. */
+struct FfnPush {
+    uint16_t* x;
+    const float* ew;
+    unsigned long long* peer;
+    const unsigned int* par;
+    uint32_t* band;
+    uint32_t ew_ld, top_k, rows, P, slot_words;
+};
+
+/* moe_ffn_q: grid rows [0, n_gate) are gate/up blocks, the rest down blocks, so every gate/up
+ * block is dispatched before a down block can wait on it. */
+struct FfnArgs {
+    const uint16_t* X;
+    A16Cls gu[2], dn[2];
+    const int32_t* sorted;
+    const int32_t* off;
+    uint16_t* Y;
+    uint32_t T, E, n_expert, inv_k, x_ld, y_ld, a_mode;
+    FfnX fx;
+    FfnPush pu;
+};
+
+__device__ __forceinline__ void moe_push_tail(const FfnArgs& A, uint32_t yb) {
+    constexpr uint32_t NTHR = kTiles * kWave, kPairs = kTiles * 8u, kGk = 8;
+    const FfnPush& pu = A.pu;
+    __shared__ uint32_t s_last;
+    __shared__ int32_t s_i[r4d_moegather::kGatherSlots];
+    __shared__ float s_w[r4d_moegather::kGatherSlots];
+    const uint32_t tid = threadIdx.x;
+    __syncthreads();
+    __threadfence();
+    if (tid == 0)
+        s_last = __hip_atomic_fetch_add(pu.band + yb, 1u, __ATOMIC_ACQ_REL,
+                                        __HIP_MEMORY_SCOPE_AGENT) + 1u == gridDim.x;
+    __syncthreads();
+    if (!s_last) return;
+    if (tid == 0) __hip_atomic_store(pu.band + yb, 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+    const uint32_t ns = pu.rows * pu.top_k;
+    for (uint32_t j = tid; j < ns; j += NTHR) s_i[j] = -1;
+    __syncthreads();
+    for (uint32_t i = tid; i < pu.P; i += NTHR) {
+        const int32_t f = A.sorted[i];
+        if (f >= 0 && (uint32_t)f < ns) s_i[f] = (int32_t)i;
+    }
+    for (uint32_t j = tid; j < ns; j += NTHR)
+        s_w[j] = pu.ew[(size_t)(j / pu.top_k) * pu.ew_ld + j % pu.top_k];
+    __syncthreads();
+    const uint32_t launch =
+        __hip_atomic_load(pu.par, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) + 1u;
+    unsigned long long* const pw = pu.peer + (size_t)(launch & 1u) * pu.slot_words;
+    const unsigned long long tag = (unsigned long long)launch << 32;
+    const uint32_t half = A.E / 2, p = yb * kPairs + tid % kPairs;
+    for (uint32_t r = tid / kPairs; r < pu.rows; r += NTHR / kPairs) {
+        float lo = 0.0f, hi = 0.0f;
+        for (uint32_t j0 = 0; j0 < pu.top_k; j0 += kGk) {
+            int32_t ix[kGk];
+            uint32_t e[kGk];
+#pragma unroll
+            for (uint32_t u = 0; u < kGk; ++u) {
+                ix[u] = j0 + u < pu.top_k ? s_i[r * pu.top_k + j0 + u] : -1;
+                e[u] = ix[u] < 0 ? 0u : *(const uint32_t*)(A.Y + (size_t)ix[u] * A.y_ld + 2 * p);
+            }
+#pragma unroll
+            for (uint32_t u = 0; u < kGk; ++u) {
+                if (ix[u] < 0) continue;
+                const float sw = s_w[r * pu.top_k + j0 + u];
+                lo = fmaf(sw, bf16_to_f32((uint16_t)e[u]), lo);
+                hi = fmaf(sw, bf16_to_f32((uint16_t)(e[u] >> 16)), hi);
+            }
+        }
+        const uint32_t w = (uint32_t)f32_to_bf16(lo) | ((uint32_t)f32_to_bf16(hi) << 16);
+        ((uint32_t*)pu.x)[r * half + p] = w;
+        __hip_atomic_store(&pw[r * half + p], tag | w, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
+    }
+}
+template <bool NV, class CH>
+__global__ __launch_bounds__(kTiles * kWave) void moe_ffn_kernel(FfnArgs A) {
+    if (CH::on) r4d_chain_wait();
+    if (blockIdx.y < A.fx.n_gate)
+        moe_a16_body<NV, false, false, 1, kGateUp>(
+            A.X, nullptr, A.gu[0], A.gu[1], A.sorted, A.off, nullptr, nullptr, A.T, A.E,
+            A.n_expert, A.inv_k, A.x_ld, 0, 0, A.a_mode, blockIdx.y, A.fx);
+    else {
+        moe_a16_body<NV, false, false, 1, kDown>(
+            A.fx.eff, nullptr, A.dn[0], A.dn[1], A.sorted, A.off, A.Y, nullptr, A.T, A.fx.F,
+            A.n_expert, A.inv_k, A.fx.F, 0, A.y_ld, kSortedRows, blockIdx.y - A.fx.n_gate, A.fx);
+        if (A.pu.x) moe_push_tail(A, blockIdx.y - A.fx.n_gate);
+    }
+    if (CH::on) r4d_chain_done();
+}
+
+/* Token tiles a block of the run map's grid, so a run of up to 64 rows decodes its expert once. */
+constexpr uint32_t kMapTiles = 4;
+
+/* A prefill's moe_ffn_q gate/up and activation on the run map's grid, before a plain down launch. */
+template <bool NV>
+__global__ __launch_bounds__(kTiles * kWave) void moe_glu_map_kernel(FfnArgs A,
+                                                                     const uint32_t* map) {
+    moe_a16_body<NV, false, true, kMapTiles, kGateUp>(
+        A.X, nullptr, A.gu[0], A.gu[1], A.sorted, A.off, nullptr, map, A.T, A.E, A.n_expert,
+        A.inv_k, A.x_ld, 0, 0, A.a_mode, blockIdx.y, A.fx);
+}
+
+/* A layer's two expert classes at [N, K], from their code and scale tables. */
+template <bool NV>
+int a16_classes(const RadTensor* const (&Wc)[2], const RadTensor* const (&Sc)[2], long long N,
+                long long K, long long n_expert, A16Cls (&c)[2]) {
+    const long long group = NV ? 16 : R4D_MXFP4_GROUP;
+    for (int q = 0; q < 2; ++q) {
+        const long long cnt = (n_expert + 1 - q) / 2;
+        const RadTensor* w = Wc[q];
+        const RadTensor* s = Sc[q];
+        if (!w || !s) return R4D_NO(RAD_E_INVAL);
+        if (w->dtype != (NV ? (uint32_t)RAD_FP4E2M1 : (uint32_t)RAD_F8E4M3) ||
+            s->dtype != (NV ? (uint32_t)R4D_DT_NVFP4_S : (uint32_t)RAD_E8M0))
+            return R4D_NO(RAD_E_DTYPE);
+        if (w->rank != 3 || s->rank != 3 || w->shape[0] < cnt || s->shape[0] < cnt ||
+            w->shape[1] < N || w->shape[2] < K || (cnt > 0 && (!w->data || !s->data)))
+            return R4D_NO(RAD_E_SHAPE);
+        if (w->stride[2] != 1 || (NV ? w->stride[1] != K : 0)) return R4D_NO(RAD_E_STRIDE);
+        c[q].w = (const void* const*)w->data;
+        c[q].s = (const void* const*)s->data;
+        c[q].w_s0 = (size_t)(w->stride[0] / (NV ? 2 : 1));
+        c[q].w_ld = (uint32_t)(w->stride[1] / (NV ? 2 : 1));
+        if constexpr (NV) {
+            c[q].s_s0 = s->stride[0] ? (size_t)(R4D_NVFP4_LEVEL_BYTES + N * (K / group)) : 0;
+            c[q].s_ld = (uint32_t)(K / group);
+        } else {
+            if (s->shape[1] < N || s->shape[2] < K / group || s->stride[2] != 1)
+                return R4D_NO(RAD_E_SHAPE);
+            c[q].s_s0 = (size_t)s->stride[0];
+            c[q].s_ld = (uint32_t)s->stride[1];
+        }
+    }
+    return RAD_OK;
+}
+
+/* moe_gemm_q's operands are [0] a [1] a_scale [2] w [3] w_scale [4] sorted [5] off [6] w_odd
+ * [7] w_odd_scale [8] y (r4d_moe.hip's moe_gemm_launch). Both classes hold one geometry. */
+template <bool NV>
+int moe_a16_launch(const RadArgs* a, RadStream stream) {
+    const RadTensor* A      = r4d_opt(a, 0);
+    const RadTensor* As     = r4d_opt(a, 1);
+    const RadTensor* sorted = r4d_opt(a, 4);
+    const RadTensor* off    = r4d_opt(a, 5);
+    const RadTensor* Wc[2]  = { r4d_opt(a, 2), r4d_opt(a, 6) };
+    const RadTensor* Sc[2]  = { r4d_opt(a, 3), r4d_opt(a, 7) };
+    const RadTensor* Y      = r4d_opt(a, 8);
+    if (!A || !sorted || !off || !Y) return R4D_NO(RAD_E_INVAL);
+    if (!A->data || !sorted->data || !off->data || !Y->data) return R4D_NO(RAD_E_INVAL);
+    const char* dt = r4d_gets(a, "dtype");
+    if (!dt || std::strcmp(dt, NV ? "nvfp4a16" : "mxfp8a16")) return R4D_NO(RAD_E_DTYPE);
+
+    const long long group = NV ? 16 : R4D_MXFP4_GROUP;
+    const long long N = r4d_geti_or(a, "N", 0);
+    const long long K = r4d_geti_or(a, "K", 0);
+    const long long n_expert = r4d_geti_or(a, "n_expert", 0);
+    const long long top_k = r4d_geti_or(a, "top_k", 0);
+    if (N <= 0 || K <= 0 || n_expert <= 0 || top_k <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (n_expert > (long long)kMaxExpert) return R4D_NO(RAD_E_UNSUPPORTED);
+    if (N % (kTiles * 16) || K % (long long)kBK) return R4D_NO(RAD_E_SHAPE);
+    if (r4d_geti_or(a, "N_odd", N) != N || r4d_geti_or(a, "K_odd", K) != K)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    if (r4d_geti_or(a, "group", group) != group || r4d_geti_or(a, "a_group", group) != group)
+        return R4D_NO(RAD_E_SHAPE);
+    if (A->dtype != RAD_BF16 || Y->dtype != RAD_BF16 || sorted->dtype != RAD_I32 ||
+        off->dtype != RAD_I32 || (As && As->dtype != RAD_F32))
+        return R4D_NO(RAD_E_DTYPE);
+
+    /* Every activation and output access is sixteen bytes, as r4d_rad_moe_gemm_bf16's. */
+    long long T = 0, M = 0, Ms = 0;
+    const long long y_ld = r4d_rows_pitch(Y, N, &T);
+    if (y_ld < 0 || T <= 0 || y_ld % 8 || ((uintptr_t)Y->data % 16)) return R4D_NO(RAD_E_STRIDE);
+    const long long a_ld = r4d_rows_pitch(A, K, &M);
+    if (a_ld < 0 || M <= 0 || a_ld % 8 || ((uintptr_t)A->data % 16)) return R4D_NO(RAD_E_STRIDE);
+    const long long as_ld = As ? r4d_rows_pitch(As, K / group, &Ms) : 0;
+    if (As && (!As->data || as_ld < 0 || Ms < M)) return R4D_NO(RAD_E_STRIDE);
+    if (r4d_numel(sorted) < T || r4d_numel(off) < n_expert + 1) return R4D_NO(RAD_E_SHAPE);
+    const char* ord = r4d_gets(a, "a_order");
+    const bool a_sorted = ord && !std::strcmp(ord, "sorted");
+    if (ord && !a_sorted && std::strcmp(ord, "token")) return R4D_NO(RAD_E_UNSUPPORTED);
+    if (M < (a_sorted ? T : (T + top_k - 1) / top_k)) return R4D_NO(RAD_E_SHAPE);
+    if (top_k * T > (long long)1 << 31) return R4D_NO(RAD_E_SHAPE);
+
+    /* NVFP4's codes and scales are the layout hook's tiles of 16 dense rows (r4d_layout.cpp), and
+     * the scales' entry, whose size the core cannot derive, is strided here when stacked. MXFP8's
+     * codes are [N][K] row-major as stored and its scales the stored [N][K / 32] plane. */
+    A16Cls c[2];
+    const int crc = a16_classes<NV>(Wc, Sc, N, K, n_expert, c);
+    if (crc != RAD_OK) return crc;
+
+    const uint32_t a_mode = a_sorted ? kSortedRows : M == 1 ? kOneToken : kTokenRows;
+    const uint32_t inv_k = top_k == 1 ? 0u : (uint32_t)(((uint64_t)1 << 32) / (uint64_t)top_k + 1u);
+    uint32_t* map = nullptr;
+    uint32_t gx = (uint32_t)T;
+    if (!r4d_moe_in_decode_band(T, n_expert)) {
+        const long long cap = r4d_moe_blockmap_cap(T, n_expert, kRows * kMapTiles);
+        if (!a->scratch || a->scratch_bytes < r4d_moe_blockmap_bytes(cap))
+            return R4D_NO(RAD_E_SCRATCH);
+        map = (uint32_t*)a->scratch;
+        const int rc = r4d_moe_blockmap_emit(stream, (const int32_t*)off->data, (uint32_t)n_expert,
+                                             (uint32_t)T, kRows * kMapTiles, (uint32_t)cap, map);
+        if (rc != RAD_OK) return rc;
+        gx = (uint32_t)cap;
+    }
+
+    int rc;
+#define R4D_MOEA16_E(as_, map_, nt_, ch_)                                                         \
+    rc = R4D_EMIT(stream, (moe_a16_kernel<NV, as_, map_, nt_, ch_>),                              \
+                  dim3(gx, (uint32_t)(N / (kTiles * 16))), dim3(kTiles * kWave), 0,               \
+                  (const uint16_t*)A->data, As ? (const float*)As->data : nullptr, c[0], c[1],    \
+                  (const int32_t*)sorted->data, (const int32_t*)off->data, (uint16_t*)Y->data,    \
+                  (const uint32_t*)map, (uint32_t)T, (uint32_t)K, (uint32_t)n_expert, inv_k,      \
+                  (uint32_t)a_ld, (uint32_t)as_ld, (uint32_t)y_ld, a_mode)
+    const bool ch = !map && r4d_geti_or(a, "chain", 0) != 0;
+    if (map) {
+        if (As) R4D_MOEA16_E(true, true, kMapTiles, R4dUnchained);
+        else    R4D_MOEA16_E(false, true, kMapTiles, R4dUnchained);
+    } else if (ch) {
+        if (As) R4D_MOEA16_E(true, false, 1u, r4dchain);
+        else    R4D_MOEA16_E(false, false, 1u, r4dchain);
+    } else {
+        if (As) R4D_MOEA16_E(true, false, 1u, R4dUnchained);
+        else    R4D_MOEA16_E(false, false, 1u, R4dUnchained);
+    }
+#undef R4D_MOEA16_E
+    if (rc != RAD_OK) return rc;
+    R4D_MOEA16_CHK();
+    return RAD_OK;
+}
+
+/* moe_ffn_q's operands: [0] a [1] sorted_tok [2] expert_offset [3..6] gate_up's w, w_scale, w_odd,
+ * w_odd_scale [7..10] down's [11] y. N is gate_up's width, 2 F, and K the hidden width E, so down
+ * is [E, F]. Its counters are the instance's (init); `eff` is the scratch. */
+struct FfnInst {
+    uint32_t* ctr = nullptr;
+    uint32_t  slots = 0;
+};
+
+/* r4d_moe_ffn_push's request to the decode band's launch it reaches, one call deep. */
+thread_local const FfnPush* t_moe_push = nullptr;
+thread_local bool t_moe_pushed = false;
+
+long long ffn_slots(long long n_expert) { return 3 * n_expert / 2; }
+
+template <bool NV>
+int moe_ffn_launch(const RadArgs* a, RadStream stream) {
+    const RadTensor* A = r4d_opt(a, 0);
+    const RadTensor* sorted = r4d_opt(a, 1);
+    const RadTensor* off = r4d_opt(a, 2);
+    const RadTensor* Y = r4d_opt(a, 11);
+    const FfnInst* inst = (const FfnInst*)a->instance;
+    if (!A || !sorted || !off || !Y || !A->data || !sorted->data || !off->data || !Y->data)
+        return R4D_NO(RAD_E_INVAL);
+    if (!inst || !inst->ctr) return R4D_NO(RAD_E_STATE);
+    const char* dt = r4d_gets(a, "dtype");
+    if (!dt || std::strcmp(dt, NV ? "nvfp4a16" : "mxfp8a16")) return R4D_NO(RAD_E_DTYPE);
+    const long long N = r4d_geti_or(a, "N", 0), E = r4d_geti_or(a, "K", 0), F = N / 2;
+    const long long n_expert = r4d_geti_or(a, "n_expert", 0);
+    const long long top_k = r4d_geti_or(a, "top_k", 0);
+    const float gcap = (float)r4d_getf(a, "gate_cap", 0.0);
+    const float ucap = (float)r4d_getf(a, "up_cap", 0.0);
+    if (N <= 0 || E <= 0 || n_expert <= 0 || top_k <= 0 || !(gcap > 0.0f) || !(ucap > 0.0f))
+        return R4D_NO(RAD_E_SHAPE);
+    if (n_expert > (long long)kMaxExpert) return R4D_NO(RAD_E_UNSUPPORTED);
+    if (F % 32 || E % (kTiles * 16) || E % (long long)kBK || F % (long long)kBK)
+        return R4D_NO(RAD_E_SHAPE);
+    const long long group = NV ? 16 : R4D_MXFP4_GROUP;
+    if (r4d_geti_or(a, "group", group) != group) return R4D_NO(RAD_E_SHAPE);
+    if (A->dtype != RAD_BF16 || Y->dtype != RAD_BF16 || sorted->dtype != RAD_I32 ||
+        off->dtype != RAD_I32)
+        return R4D_NO(RAD_E_DTYPE);
+    long long T = 0, M = 0;
+    const long long y_ld = r4d_rows_pitch(Y, E, &T);
+    if (y_ld < 0 || T <= 0 || y_ld % 8 || ((uintptr_t)Y->data % 16)) return R4D_NO(RAD_E_STRIDE);
+    const long long a_ld = r4d_rows_pitch(A, E, &M);
+    if (a_ld < 0 || M <= 0 || a_ld % 8 || ((uintptr_t)A->data % 16)) return R4D_NO(RAD_E_STRIDE);
+    if (r4d_numel(sorted) < T || r4d_numel(off) < n_expert + 1) return R4D_NO(RAD_E_SHAPE);
