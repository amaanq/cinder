+ * sum the WMMA slot would hold; after a barrier lanes 0 .. 16 MT - 1 fold the stash in ascending
+ * unit order with iqr_m16_body's EXACT factors and flushes. The 16-token tile's stash of 16 x 16
+ * slots a unit held three blocks a WGP; this one holds 16 MT. */
+constexpr uint32_t kX1Units = 32;
+template <class F, uint32_t KW, uint32_t MT, class CH>
+__device__ __forceinline__ void iqr_x1_body(const Ctx& c0, const int8_t* __restrict__ X,
+                                            const float* __restrict__ XS, uint16_t* __restrict__ Y,
+                                            uint32_t N, uint32_t M, uint32_t x_ld, uint32_t xs_ld,
+                                            uint32_t rt) {
+    static_assert(tiles_form<F>() && MT * 16u <= kWave, "one folding wave");
+    using D = Dec<F, true>;
+    constexpr bool BIAS = F::SC == kRowF32;
+    __shared__ float s_sum[kX1Units][MT][16];
+    const uint32_t tid = threadIdx.x, lane = tid & (kWave - 1);
+    const uint32_t wave = __builtin_amdgcn_readfirstlane(tid / kWave);
+    const Ctx& c = c0;
+    const uint32_t row0 = rt * 16u;
+    uint32_t tok[MT];
+#pragma unroll
+    for (uint32_t m = 0; m < MT; ++m) tok[m] = min(m, M - 1u);
