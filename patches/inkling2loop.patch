+    typename D::Raw cur = D::fetch(c, rt, wave, lane, wave < c.nkb), nxt;
+    if (CH::on) r4d_chain_wait();
+    uint32_t kb = wave;
+    for (uint32_t u0 = 0; u0 < c.nkb; u0 += kX1Units) {
+        const uint32_t u1 = min(u0 + kX1Units, c.nkb);
+        for (; kb < u1; kb += KW) {
+            if (kb + KW < c.nkb) nxt = D::fetch(c, rt, kb + KW, lane, true);
+            uint32_t h[16][4];
+            D::hashes(cur, c, h);
+#pragma unroll
+            for (uint32_t m = 0; m < MT; ++m) {
+                const uint32_t xv = *(const uint32_t*)(X + (size_t)tok[m] * x_ld + kb * kBlock + 4u * lane);
+                uint32_t xs[4];
+#pragma unroll
+                for (uint32_t e = 0; e < 4; ++e) xs[e] = __builtin_amdgcn_perm(0u, xv, e * 0x01010101u);
+                const int b0 = -__builtin_amdgcn_sudot4(true, (int)xv, false, 0x7E7E7E7E, 0, false);
+                float a16[16];
+#pragma unroll
+                for (uint32_t q = 0; q < 16; ++q) {
+                    int d = b0;
+#pragma unroll
+                    for (uint32_t e = 0; e < 4; ++e)
