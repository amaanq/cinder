+/* ar_causal_conv1d's launch (r4d_ar_entry.hip passes its instance's LL slots and counters, `nbw` of
+ * the latter): causal_conv1d's operands, `x` the message. Refused, for the caller to issue the pair,
+ * where the message is no LL one or its rows span more than one of the conv's token tiles. `mode` 1:
+ * the op before already wrote and pushed x's words; 2: only whether it would launch. */
+extern "C" int r4d_ar_causal_conv1d_ll(const RadArgs* a, RadStream s, long peer_ll, long my_ll,
+                                       long seq_ctrs, long slot_bytes, unsigned nbw, int mode) {
+    if (r4d_geti_or(a, "dilation", 1) != 1) return R4D_NO(RAD_E_INVAL);
+    /* Zeroed with its padding: the pass recorder compares a launch's argument bytes. */
+    PcCall c;
+    memset(&c, 0, sizeof c);
+    const int rc = conv_prepare(a, false, r4d_opt(a, CC_X), r4d_opt(a, CC_W), r4d_opt(a, CC_CS),
+                                r4d_opt(a, CC_CU), nullptr, r4d_opt(a, CC_CIDX),
+                                r4d_opt(a, CC_HINIT), r4d_opt(a, CC_NACC), r4d_opt(a, CC_Y), nullptr,
+                                nullptr, r4d_opt(a, CC_SKIP), &c);
+    if (rc != RAD_OK) return rc;
+    const uint32_t nb = (c.n + kArConvCh - 1) / kArConvCh;
+    if (!peer_ll || !my_ll || c.n % 2 || c.xld != c.n || c.tb != 1 || nb > nbw)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    if ((long)c.rows * c.n * 2 > slot_bytes / 2 || ((uintptr_t)c.x % 4))
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    ArLl L;
+    memset(&L, 0, sizeof L);
+    L.peer = (unsigned long long*)peer_ll;
+    L.mine = (const unsigned long long*)my_ll;
+    L.seq = (unsigned int*)seq_ctrs;
+    L.nbw = nbw;
+    L.slot_words = (uint32_t)(slot_bytes / 8);
+    L.pushed = mode == 1 ? 1u : 0u;
