+/* ==================================================================== gemm_nt_q_multi's segments
+ *
+ * Segment i's weight (operand 2 + 5i) and scales (3 + 5i) are gemm_nt_q's, stored as that row
+ * stores them, at the segment's `N<i>`. */
+namespace {
+int multi_geom(const RadParam* p, int n_p, int operand, RadParam (&q)[4], int* il) {
+    if (operand < 2 || operand >= 20 || (operand % 5 != 2 && operand % 5 != 3))
+        return RAD_E_UNSUPPORTED;
+    static const char* kN[] = { "N0", "N1", "N2", "N3" };
+    std::memset(q, 0, sizeof q);
+    q[0].key = "N";
+    q[0].kind = RAD_P_INT;
+    q[0].ival = r4d_pgeti_or(p, n_p, kN[operand / 5], 0);
+    q[1].key = "K";
+    q[1].kind = RAD_P_INT;
+    q[1].ival = r4d_pgeti_or(p, n_p, "K", 0);
+    q[2].key = "group";
+    q[2].kind = RAD_P_INT;
+    q[2].ival = r4d_pgeti_or(p, n_p, "group", 128);
+    q[3].key = "dtype";
+    q[3].kind = RAD_P_STR;
+    q[3].sval = r4d_pgets(p, n_p, "dtype");
+    *il = operand % 5 == 2 ? IL_B : IL_BSCALE;
+    return RAD_OK;
+}
