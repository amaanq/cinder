+                           std::to_string(x % N) + ": " + std::to_string(gf) + " for " +
+                           std::to_string(want);
+        }
+        ok(label.c_str(), bad == 0,
+           std::to_string(bad) + " of " + std::to_string(Tr * N) + " elements off" + firstbad);
+        std::printf("        rel_l2 %.3e, worst element %.3f of the tolerance\n",
+                    den > 0.0 ? std::sqrt(num / den) : 0.0, rel_max);
+    }
+    dfree_all();
+}
