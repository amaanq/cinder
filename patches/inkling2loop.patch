+    constexpr int SLOT = 2 * HD * ESZ + (KV8 == 2 ? 4 : 0);
+    constexpr int VSTR = 32;   /* f16 a dim row of V^T: 16 keys, and every other eight rows 16 on */
+    static_assert(R == 32 && HD * VSTR * 2 >= 32 * NC * 8 * 4, "two row groups; V^T's LDS holds the sums");
+    __shared__ __align__(16) uint16_t s_v[kSplitWaves][HD * VSTR];
+    __shared__ float s_ml[kSplitWaves][2][32];
+    __shared__ int s_scan[kSplitWaves];
+    __shared__ int s_res[2];
+
+    const int lane = (int)threadIdx.x & 31, wave = (int)threadIdx.x >> 5;
+    const int n = lane & 15, h = lane >> 4;
+    const int tile = (int)blockIdx.x, kh = (int)blockIdx.y;
+    const int rg = (int)blockIdx.z & 1, z = (int)blockIdx.z >> 1;
+    uint16_t* sv = s_v[wave];
+    auto vcol = [](int col) { return col * VSTR + ((col >> 3) & 1) * 16; };
+
+    int s = -1, lt = 0;
+    if (A.cu) {
+        find_tile<BQ, kSplitWaves * 32>(A.cu, A.n_seq, tile, s_scan, s_res, s, lt);
+    } else {
+        s = tile / A.tps;
+        lt = tile - s * A.tps;
+        if (s >= A.n_seq) s = -1;
+    }
+    int qlen = 0, tokb = 0, ctx = 0;
+    if (s >= 0) {
+        if (A.cu) { tokb = A.cu[s]; qlen = A.cu[s + 1] - tokb; }
+        else      { tokb = s * A.q_len; qlen = A.q_len; }
+        ctx = A.seqused[s];
+    }
+    const int pfirst = lt * BQ;
+    const int npos = s >= 0 ? imax(0, imin(BQ, qlen - pfirst)) : 0;
+    if (kh == 0 && z == 0 && threadIdx.x == 0) {
+        A.tinfo[2 * tile] = tokb + pfirst;
+        A.tinfo[2 * tile + 1] = npos;
+    }
+    if (npos <= 0) return;
+
+    const int tok0 = tokb + pfirst, qbase = ctx - qlen + pfirst, plast = qbase + npos - 1;
+    const int causal = A.causal, window = A.window, tbase = ctx - qlen;
+    const bool shared = A.shared_window != 0;
+    int hi = causal ? (shared ? tbase + 1 : plast + 1) : ctx;
+    if (!causal && window > 0 && !shared && !A.ahead) hi = imin(hi, plast + window);
+    hi = imin(imin(hi, ctx), A.max_blocks * 16);
+    const int lo = window > 0 ? imax(0, (shared ? tbase : qbase) - window + 1) : 0;
+    const int lo_a = lo & ~15;
+    const int nkt = hi > lo_a ? (hi - lo_a + 15) / 16 : 0;
+    const int per = (nkt + A.n_split - 1) / A.n_split;
+    const int kz_lo = imin(nkt, z * per), kz_hi = imin(nkt, kz_lo + per);
+    const int kps = (kz_hi - kz_lo + kSplitWaves - 1) / kSplitWaves;
+    const int kt_lo = imin(kz_hi, kz_lo + wave * kps), kt_hi = imin(kz_hi, kt_lo + kps);
+
+    /* a group with no row of the tile reads nothing: a decode's second */
+    if (rg * 16 >= npos * GQA) return;
+    const int r = rg * 16 + n, p = r / GQA, g = r - p * GQA;
+    const bool rval = p < npos;
+    const int pos = qbase + p;
+    const float kds = A.kdes ? A.kdes[(long long)s * A.kv_heads + kh] : 1.0f;
+    const float vds = A.vdes ? A.vdes[(long long)s * A.kv_heads + kh] : 1.0f;
+    const float sscale = A.qscale * kds;
+
+    win_v8s qf[NC];
+    {
+        const uint16_t* qp = A.q + (long long)(tok0 + (rval ? p : 0)) * A.q_rs +
+                             (long long)(kh * GQA + (rval ? g : 0)) * A.q_hs + 8 * h;
+#pragma unroll
+        for (int c = 0; c < NC; ++c) qf[c] = __builtin_bit_cast(win_v8s, *(const uint4*)(qp + 16 * c));
+    }
+
+    /* Key n's K or V columns 16c + 8h .. + 7, as loaded: a uint4 of bf16 or two words of codes. */
+    typedef typename std::conditional<KV8 != 0, uint2, uint4>::type Raw;
+    auto blk_of = [&](int kt) {
+        const int lb = (lo_a >> 4) + kt;
+        return lb < A.max_blocks && (lb << 4) < hi ? A.bt[(long long)s * A.bt_rs + lb] : -1;
+    };
+    auto fetch = [&](int blk, int off, Raw (&reg)[NC]) {
+        const unsigned char* kp = A.kv + ((long long)(blk >= 0 ? blk : 0) * A.kv_sb +
+                                          (long long)kh * A.kv_sh) * ESZ +
+                                  n * SLOT + (off + 8 * h) * ESZ;
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            if constexpr (KV8) {
+                const unsigned* w = (const unsigned*)(kp + 16 * c);
+                reg[c] = make_uint2(w[0], w[1]);
+            } else {
+                reg[c] = *(const uint4*)(kp + 32 * c);
+            }
+        }
+    };
