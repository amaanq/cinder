+extern "C" int r4d_rad_attn_rel_sink_h128_i8(const RadArgs* a, RadStream stream) {
+    return rel_sink_h128<true>(a, stream);
+}
+
+extern "C" int r4d_rad_attn_rel_sink_gq_h128_bf16(const RadArgs* a, RadStream stream) {
+    return rel_sink_h128<false, true>(a, stream);
+}
+
+extern "C" int r4d_rad_attn_rel_sink_gq_h128_i8(const RadArgs* a, RadStream stream) {
