+// The same product into an f32 `y`, `a` and `b` each bf16 or f32: the activation stays in f32 (y's
+// dtype), so of the rounding above only quick_gelu's bf16 constant remains. `y` may be `b`: each
+// element is read before it is written, by the same thread.
+__device__ __forceinline__ float am_f32(uint16_t v) { return bf2f(v); }
+__device__ __forceinline__ float am_f32(float v) { return v; }
+
+template <typename TA, typename TB, class CH>
+__global__ __launch_bounds__(kThreads) void act_mul_f32_kernel(
+    const TA* __restrict__ a, const TB* b, float* y, uint32_t n, uint32_t a_ld, uint32_t b_ld,
+    uint32_t y_ld, uint32_t M, int act) {
+    if (CH::on) r4d_chain_wait();
+    const uint32_t i = blockIdx.x * kThreads + threadIdx.x;
+    for (uint32_t m = blockIdx.y; i < n && m < M; m += gridDim.y) {
+        const float g = am_f32(a[(size_t)m * a_ld + i]);
+        const float v = act == 0 ? act_of<0>(g) : act == 1 ? act_of<1>(g) : act == 2 ? act_of<2>(g)
+                      : act == 3 ? act_of<3>(g) : act == 5 ? act_of<5>(g)
+                                 : act_of<3>(g * bf2f(f32_to_bf16(1.702f)));
+        y[(size_t)m * y_ld + i] = v * am_f32(b[(size_t)m * b_ld + i]);
+    }
+    if (CH::on) r4d_chain_done();
+}
