+constexpr uint32_t kThr = 256;
+constexpr uint32_t kWave = 32;
+/* Columns of a row a thread keeps, so a row of tap_mix or rmsnorm_add is one workgroup. */
+constexpr uint32_t kCols = 16;
+constexpr long long kMaxRow = kThr * kCols;
+constexpr int kMaxTaps = 8;
+
+__device__ __forceinline__ float ld_bf(const uint16_t* p) { return bf16_to_f32((uint16_t)ldg_u16(p)); }
+/* Rounded to bf16 and back, a NaN kept quiet (rad_f32_to_bf16). */
+__device__ __forceinline__ float bf(float v) { return __uint_as_float(bf16_hi_rne_nan(v) & 0xffff0000u); }
+__device__ __forceinline__ uint16_t bf_bits(float v) { return (uint16_t)(bf16_hi_rne_nan(v) >> 16); }
+
+__device__ __forceinline__ float block_sum(float v, float* lds) {
+    v = r4d_wave_sum(v);
+    const uint32_t lane = threadIdx.x & (kWave - 1), wave = threadIdx.x / kWave;
+    if (lane == 0) lds[wave] = v;
+    __syncthreads();
+    float s = 0.0f;
+#pragma unroll
+    for (uint32_t w = 0; w < kThr / kWave; ++w) s += lds[w];
+    return s;
+}
+
+/* ------------------------------------------------------------------ tap_mix */
+struct TapArgs {
+    const uint16_t* x;  const uint16_t* lg;  const uint16_t* w;  uint16_t* y;
+    long long x_rs, y_rs;
+    uint32_t n, taps, M;
+    float eps;
+};
+
+__device__ __forceinline__ void tap_mix_body(const TapArgs& A) {
+    __shared__ float s_red[kThr / kWave];
+    __shared__ float s_e[kMaxTaps];
+    const uint32_t m = blockIdx.x, tid = threadIdx.x;
+    if (m >= A.M) return;
+    float mx = -INFINITY;
+    for (uint32_t t = 0; t < A.taps; ++t) mx = fmaxf(mx, ld_bf(A.lg + t));
+    if (tid < A.taps) s_e[tid] = (float)exp((double)(ld_bf(A.lg + tid) - mx));
+    __syncthreads();
+    float sum = 0.0f;
+    for (uint32_t t = 0; t < A.taps; ++t) sum += s_e[t];
+    float p[kMaxTaps];
+#pragma unroll
+    for (int t = 0; t < kMaxTaps; ++t) p[t] = t < (int)A.taps ? __fdiv_rn(s_e[t], sum) : 0.0f;
+
+    const uint16_t* xr = A.x + (long long)m * A.x_rs;
+    float v[kCols];
+    float sq = 0.0f;
+#pragma unroll
+    for (uint32_t c = 0; c < kCols; ++c) {
+        const uint32_t i = tid + c * kThr;
+        float u = 0.0f;
+#pragma unroll
+        for (int t = 0; t < kMaxTaps; ++t)
+            if (i < A.n && t < (int)A.taps) u += p[t] * ld_bf(xr + t * A.n + i);
+        v[c] = u;
+        sq += u * u;
+    }
+    sq = block_sum(sq, s_red);
+    const float inv = __fdiv_rn(1.0f, __fsqrt_rn(sq / (float)A.n + A.eps));
+    uint16_t* yr = A.y + (long long)m * A.y_rs;
+#pragma unroll
+    for (uint32_t c = 0; c < kCols; ++c) {
+        const uint32_t i = tid + c * kThr;
+        if (i < A.n) yr[i] = bf_bits(v[c] * inv * ld_bf(A.w + i));
+    }
+}
+
+/* ------------------------------------------------------------------ fill_rows */
+template <class CH>
+__global__ __launch_bounds__(kThr) void fill_rows_kernel(const int* tok, const uint16_t* w,
+                                                         uint16_t* x, long long x_rs, uint32_t n,
+                                                         uint32_t M, int id) {
+    if constexpr (CH::on) r4d_chain_wait();
+    const uint32_t m = blockIdx.x;
+    if (m < M && tok[m] == id) {
+        uint16_t* xr = x + (long long)m * x_rs;
+        for (uint32_t i = threadIdx.x; i < n; i += kThr) xr[i] = (uint16_t)ldg_u16(w + i);
+    }
+    if constexpr (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ rmsnorm_add */
+/* `residual_out` may be `residual`: each element is read and written by one thread. */
+struct NormAddArgs {
+    const uint16_t* x;  const uint16_t* res;  const void* w;  uint16_t* y;  uint16_t* ro;
+    long long x_rs, r_rs, y_rs, o_rs;
+    uint32_t n, M;
+    float eps, wadd;
+};
+
+template <bool WF32>
+__device__ __forceinline__ void rmsnorm_add_body(const NormAddArgs& A) {
+    __shared__ float s_red[kThr / kWave];
+    const uint32_t m = blockIdx.x, tid = threadIdx.x;
+    if (m >= A.M) return;
+    const uint16_t* xr = A.x + (long long)m * A.x_rs;
+    const uint16_t* rr = A.res + (long long)m * A.r_rs;
+    uint16_t* orow = A.ro + (long long)m * A.o_rs;
+    float v[kCols];
+    float sq = 0.0f;
+#pragma unroll
+    for (uint32_t c = 0; c < kCols; ++c) {
+        const uint32_t i = tid + c * kThr;
+        float u = 0.0f;
+        if (i < A.n) {
+            u = ld_bf(xr + i) + ld_bf(rr + i);
+            orow[i] = bf_bits(u);
+        }
+        v[c] = u;
+        sq += u * u;
+    }
+    sq = block_sum(sq, s_red);
+    const float s = __fdiv_rn(1.0f, __fsqrt_rn(sq / (float)A.n + A.eps));
+    uint16_t* yr = A.y + (long long)m * A.y_rs;
+#pragma unroll
+    for (uint32_t c = 0; c < kCols; ++c) {
+        const uint32_t i = tid + c * kThr;
+        if (i >= A.n) continue;
+        const float g = WF32 ? ((const float*)A.w)[i] : ld_bf((const uint16_t*)A.w + i);
+        yr[i] = bf_bits(bf(v[c]) * s * (g + A.wadd));
+    }
+}
+
+/* CH is r4dchain (r4d_chain.h) where the row resolved with `chain`, R4dUnchained otherwise. */
+template <class CH>
+__global__ __launch_bounds__(kThr) void tap_mix_kernel(TapArgs A) {
+    if constexpr (CH::on) r4d_chain_wait();
+    tap_mix_body(A);
+    if constexpr (CH::on) r4d_chain_done();
+}
+template <bool WF32, class CH>
+__global__ __launch_bounds__(kThr) void rmsnorm_add_kernel(NormAddArgs A) {
+    if constexpr (CH::on) r4d_chain_wait();
+    rmsnorm_add_body<WF32>(A);
+    if constexpr (CH::on) r4d_chain_done();
+}
+
+/* ------------------------------------------------------------------ dspark_rnn_greedy */
+constexpr int kTile = 64;          /* vocabulary ids a tile winner covers (libref's) */
+constexpr int kScoreRows = 128;    /* vocabulary rows a score_tiles workgroup folds, one a thread */
+constexpr int kScoreK = 64;        /* fold columns staged at a time */
+constexpr int kSeqGroup = 8;       /* sequences a score_tiles workgroup scores */
+constexpr int kPreRows = 16;       /* projection rows a pre workgroup sums, for every position */
+constexpr int kPreK = 256;
+constexpr int kMaxSteps = 16;
+constexpr int kStepR = 16;         /* state lanes an rnn_step workgroup advances */
+constexpr int kStepK = 128;
+constexpr uint32_t kStepThr = 128;
+constexpr int kMaxRank = 256;
+
+struct WalkArgs {
+    const float*    logits;  long long l_rs;       /* [M * steps, V] */
+    const uint16_t* hidden;  long long h_rs;       /* [M * steps, n] */
+    const uint16_t* ctx;     long long c_rs;       /* [M, n] */
+    const int*      anchor;  long long astr;
+    const uint16_t* proj;                          /* [3R, 2R + 2n] */
+    const uint16_t* bias;                          /* [3R] */
+    const uint16_t* embed;   int n_embed;          /* [n_embed, R] */
+    const uint16_t* fold;                          /* [V, R] */
+    /* An int8 fold instead: [V, R] codes and a bf16 scale per 128 of a row, [V, R / 128]. */
+    const uint8_t*  fold8;
+    const uint16_t* fold_s;
+    const uint16_t* fold_b;                        /* [V] */
+    float* tile_s;  long long ts_rs;
+    int*   tile_t;  long long tt_rs;
+    int    t_es;                                   /* a tile's elements apart: 1, or 2 as pairs */
+    int    v0;                                     /* the id of the logits' and fold's row 0 */
+    const int* ids;                                /* row r's token id, when not v0 + r */
+    int    qv;                                     /* Q's id bound: the vocabulary's */
+    int*   out;     long long o_rs;
+    float* pre;                                    /* scratch: [M, steps, 3R] */
+    float* state;                                  /* scratch: [2, M, R], by step parity */
+    float* latent;                                 /* scratch: [M, R] */
+    float* debt;                                   /* scratch: [M] */
+    int*   kept;                                   /* [M] */
+    int M, steps, R, n, V, n_tiles;
+    int vec_in;                                    /* hidden and ctx rows load 16 bytes at a time */
+    int stop;
+    float cap, knee, budget;
+    /* dspark_rnn_couple only. */
+    const int*      card;                          /* [M] RadBatch::seq_ids */
+    const uint32_t* draw;    long long dr_rs;      /* [M, DRAW_WORDS] RadMtpCoupleDraw */
+    uint32_t*       cstate;  long long cs_round, cs_row;   /* [rounds, >= M, STATE_WORDS] */
+};
+
+/* Sixteen bf16 of global memory (16-byte aligned) as eight words into LDS, `dst` word-aligned. */
+__device__ __forceinline__ void stage8(const uint16_t* src, uint32_t* dst) {
+    const r4d_u32x4 w = *(const r4d_u32x4*)src;
+    dst[0] = w[0]; dst[1] = w[1]; dst[2] = w[2]; dst[3] = w[3];
+}
+
+/* pre[m, l, o] = bias[o] + hidden[m * steps + l] . proj[o, 2R : 2R + n] + ctx[m] . proj[o, 2R + n :],
+ * summed in that order. A workgroup owns kPreRows rows of proj for every position of one sequence:
+ * thread (l, o) is tid = l * kPreRows + o. */
+__device__ __forceinline__ void pre_body(const WalkArgs& A) {
+    constexpr int KW = kPreK / 2 + 1;                /* words a staged row, one of padding */
+    __shared__ uint32_t s_w[kPreRows * KW];
+    __shared__ float s_in[kMaxSteps * kPreK];
+    const int tid = (int)threadIdx.x, nthr = (int)blockDim.x;
+    const int o0 = (int)blockIdx.x * kPreRows, m = (int)blockIdx.y;
+    const int l = tid / kPreRows, ol = tid - l * kPreRows, o = o0 + ol;
+    const int rows3 = 3 * A.R, width = 2 * A.R + 2 * A.n, K = 2 * A.n;
+    float acc = o < rows3 ? ld_bf(A.bias + o) : 0.0f;
+    for (int k0 = 0; k0 < K; k0 += kPreK) {
+        __syncthreads();
+        for (int i = tid; i < kPreRows * (kPreK / 8); i += nthr) {
+            const int r = i / (kPreK / 8), c = (i - r * (kPreK / 8)) * 8;
+            uint32_t* dst = s_w + r * KW + c / 2;
+            if (o0 + r < rows3) {
+                stage8(A.proj + (long long)(o0 + r) * width + 2 * A.R + k0 + c, dst);
+            } else {
+                dst[0] = dst[1] = dst[2] = dst[3] = 0u;
+            }
+        }
+        if (A.vec_in) {
+            for (int i = tid; i < A.steps * (kPreK / 8); i += nthr) {
+                const int ll = i / (kPreK / 8), c = (i - ll * (kPreK / 8)) * 8, k = k0 + c;
+                const uint16_t* src = k < A.n
+                                    ? A.hidden + (long long)(m * A.steps + ll) * A.h_rs + k
+                                    : A.ctx + (long long)m * A.c_rs + (k - A.n);
+                const r4d_u32x4 w = *(const r4d_u32x4*)src;
+                float* d = s_in + ll * kPreK + c;
+#pragma unroll
+                for (int q = 0; q < 4; ++q) {
+                    d[2 * q] = bf16w_lo(w[q]);
+                    d[2 * q + 1] = bf16w_hi(w[q]);
+                }
+            }
+        } else {
+            for (int i = tid; i < A.steps * kPreK; i += nthr) {
+                const int ll = i / kPreK, k = k0 + (i - ll * kPreK);
+                const uint16_t* src = k < A.n
+                                    ? A.hidden + (long long)(m * A.steps + ll) * A.h_rs + k
+                                    : A.ctx + (long long)m * A.c_rs + (k - A.n);
+                s_in[i] = ld_bf(src);
+            }
+        }
+        __syncthreads();
+        const uint32_t* wr = s_w + ol * KW;
+        const float* in = s_in + l * kPreK;
+        for (int k = 0; k < kPreK; k += 2) {
+            const uint32_t w = wr[k / 2];
+            acc += in[k] * bf16w_lo(w);
+            acc += in[k + 1] * bf16w_hi(w);
+        }
+    }
+    if (o < rows3) A.pre[((long long)m * A.steps + l) * rows3 + o] = acc;
+}
+
+/* (score, id) pairs: the greater score, the lower id on a tie. */
+__device__ __forceinline__ bool better(float s, int t, float bs, int bt) {
+    return s > bs || (s == bs && t < bt);
+}
+
+/* dspark_rnn_couple's token for position l - 1 of sequence m, from its tile winners: the eight
+ * best (score descending, lower id on a tie), then rad_dspark_couple_step on one thread, which
+ * workgroup 0 also stores as round l's state. Each thread keeps the eight best of its own winners,
+ * and eight block reductions over the threads' current heads pick the eight, so the winners are
+ * read from memory once. Winners are distinct ids, so a thread knows its head won by its id.
+ * `s_sc` and `s_id` are the caller's kStepThr-wide reduction arrays. */
+__device__ int couple_pick(const WalkArgs& A, int l, int m, int greedy, float* s_sc, int* s_id) {
+    __shared__ float s_ws[8];
+    __shared__ int s_wt[8];
+    __shared__ int s_x;
+    const int tid = (int)threadIdx.x;
+    const RadMtpCoupleDraw d =
+        *reinterpret_cast<const RadMtpCoupleDraw*>(A.draw + (long long)m * A.dr_rs);
+    int n = 0;
+    if (d.mode == 1) {
+        float ls[8];
+        int lt[8];
+#pragma unroll
+        for (int i = 0; i < 8; ++i) { ls[i] = -INFINITY; lt[i] = INT_MAX; }
+        for (int t = tid; t < A.n_tiles; t += kStepThr) {
+            float s = A.tile_s[(long long)m * A.ts_rs + (long long)t * A.t_es];
+            int tk = A.tile_t[(long long)m * A.tt_rs + (long long)t * A.t_es];
+            if (!better(s, tk, ls[7], lt[7])) continue;
+#pragma unroll
+            for (int i = 0; i < 8; ++i)
+                if (better(s, tk, ls[i], lt[i])) {
+                    const float ts = ls[i];
+                    const int tt = lt[i];
+                    ls[i] = s; lt[i] = tk; s = ts; tk = tt;
+                }
+        }
+        int h = 0;
+        for (; n < 8; ++n) {
+            float hs = -INFINITY;
+            int ht = INT_MAX;
+#pragma unroll
+            for (int i = 0; i < 8; ++i)
+                if (i == h) { hs = ls[i]; ht = lt[i]; }
+            __syncthreads();
+            s_sc[tid] = hs;
+            s_id[tid] = ht;
+            __syncthreads();
+            for (int k = kStepThr / 2; k > 0; k >>= 1) {
+                if (tid < k && better(s_sc[tid + k], s_id[tid + k], s_sc[tid], s_id[tid])) {
+                    s_sc[tid] = s_sc[tid + k];
+                    s_id[tid] = s_id[tid + k];
+                }
+                __syncthreads();
+            }
+            if (s_id[0] == INT_MAX) break;
+            if (tid == 0) { s_ws[n] = s_sc[0]; s_wt[n] = s_id[0]; }
+            if (ht == s_id[0]) ++h;
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        RadMtpCoupleState st;
+        s_x = rad_dspark_couple_step(s_wt, s_ws, n, d, d.card == A.card[m], l, A.qv, greedy, &st);
+        if (blockIdx.x == 0)
+            *reinterpret_cast<RadMtpCoupleState*>(A.cstate + (long long)(l - 1) * A.cs_round +
+                                                  (long long)m * A.cs_row) = st;
+    }
+    __syncthreads();
+    return s_x;
+}
+
+/* Step `l` of every sequence: the token of position l - 1 from its tile winners (the anchor at
+ * l = 0), written out with the sequence's `kept` so far (the winner's margin over the next tile's
+ * joins the debt), then the state advanced with it and position l's latent. A workgroup owns
+ * kStepR lanes of the state, so it sums the 3 * kStepR rows of proj that feed them over the
+ * previous state and the token's embedding. Every workgroup of a sequence reduces the tiles
+ * itself: 3k winners, against a launch to share them. A thread loads eight winners ahead of their
+ * comparisons (a (-inf, INT_MAX) pad changes neither best nor next), where one at a time waited a
+ * round trip each.
+ *
+ * COUPLE (dspark_rnn_couple): the token is rad_dspark_couple_step's over the eight best winners,
+ * found in eight more reductions, and its state row is written; `kept` still reads the greedy
+ * margins. Every workgroup of a sequence draws the same token from the same winners. */
+template <bool COUPLE>
+__device__ __forceinline__ void rnn_step_body(const WalkArgs& A, int l) {
+    constexpr int KW = kMaxRank + 1;
+    __shared__ uint32_t s_w[3 * kStepR * KW];
+    __shared__ float s_in[2 * kMaxRank];
+    __shared__ float s_raw[3 * kStepR];
+    __shared__ float s_best[kStepThr];
+    __shared__ float s_next[kStepThr];
+    __shared__ int s_tok[kStepThr];
+    const int tid = (int)threadIdx.x, r0 = (int)blockIdx.x * kStepR, m = (int)blockIdx.y;
+    const int R = A.R, width = 2 * R + 2 * A.n;
+    if (A.stop && l >= 2 && A.kept[m] < l - 1) {
+        if (blockIdx.x == 0 && tid == 0) A.out[(long long)m * A.o_rs + l - 1] = -1;
+        return;
+    }
+    /* The rows of proj do not depend on the token, so all of them stage in one round, issued
+     * before the tiles reduce. */
+    if (l < A.steps) {
+        constexpr int kMaxLoads = 3 * kStepR * (2 * kMaxRank / 8) / (int)kStepThr;
+        const int loads = 3 * kStepR * (2 * R / 8), per = 2 * R / 8;
+        r4d_u32x4 v[kMaxLoads];
+#pragma unroll
+        for (int u = 0; u < kMaxLoads; ++u) {
+            const int i = min(tid + u * (int)kStepThr, loads - 1);
+            const int j = i / per, c = (i - j * per) * 8;
+            v[u] = *(const r4d_u32x4*)(A.proj + (long long)((j / kStepR) * R + r0 + j % kStepR) *
+                                                    width + c);
+        }
+#pragma unroll
+        for (int u = 0; u < kMaxLoads; ++u) {
+            const int i = tid + u * (int)kStepThr;
+            if (i >= loads) continue;
+            const int j = i / per, c = (i - j * per) * 8;
+            uint32_t* dst = s_w + j * KW + c / 2;
+            dst[0] = v[u][0]; dst[1] = v[u][1]; dst[2] = v[u][2]; dst[3] = v[u][3];
+        }
+    }
+
+    int prev;
+    if (l == 0) {
+        prev = A.anchor[(long long)m * A.astr];
+    } else {
+        float best = -INFINITY, next = -INFINITY;
+        int bt = INT_MAX;
+        constexpr int kU = 8;
+        for (int t0 = tid; t0 < A.n_tiles; t0 += kU * (int)kStepThr) {
+            float sv[kU];
+            int tv[kU];
+#pragma unroll
+            for (int u = 0; u < kU; ++u) {
+                const int t = t0 + u * (int)kStepThr;
+                const bool in = t < A.n_tiles;
+                sv[u] = in ? A.tile_s[(long long)m * A.ts_rs + (long long)t * A.t_es] : -INFINITY;
+                tv[u] = in ? A.tile_t[(long long)m * A.tt_rs + (long long)t * A.t_es] : INT_MAX;
+            }
+#pragma unroll
+            for (int u = 0; u < kU; ++u) {
+                if (better(sv[u], tv[u], best, bt)) { next = best; best = sv[u]; bt = tv[u]; }
+                else if (sv[u] > next) next = sv[u];
+            }
+        }
+        s_best[tid] = best;
+        s_next[tid] = next;
+        s_tok[tid] = bt;
+        __syncthreads();
+        for (int h = kStepThr / 2; h > 0; h >>= 1) {
+            if (tid < h) {
+                const float ob = s_best[tid + h], rest = fmaxf(s_next[tid], s_next[tid + h]);
+                if (better(ob, s_tok[tid + h], s_best[tid], s_tok[tid])) {
+                    s_next[tid] = fmaxf(s_best[tid], rest);
+                    s_best[tid] = ob;
+                    s_tok[tid] = s_tok[tid + h];
+                } else {
+                    s_next[tid] = fmaxf(ob, rest);
+                }
+            }
+            __syncthreads();
+        }
+        const float margin = s_best[0] - s_next[0];
+        prev = s_tok[0];
+        if constexpr (COUPLE) prev = couple_pick(A, l, m, prev, s_best, s_tok);
+        if (blockIdx.x == 0 && tid == 0) {
+            const int pos = l - 1;
+            float debt = pos == 0 ? 0.0f : A.debt[m];
+            int keep = pos == 0 ? A.steps : A.kept[m];
+            const float short_by = A.knee - margin;
+            if (short_by > 0.0f) debt += short_by;
+            if (pos > 0 && pos < keep && debt > A.budget) keep = pos;
+            A.out[(long long)m * A.o_rs + pos] = A.stop && keep == pos ? -1 : prev;
+            A.debt[m] = A.stop && keep < A.steps ? NAN : debt;
+            A.kept[m] = keep;
+        }
+    }
+    if (l == A.steps) return;
+
+    const float* st = A.state + (long long)(l & 1) * A.M * R + (long long)m * R;
+    const bool prev_ok = prev >= 0 && prev < A.n_embed;
+    for (int i = tid; i < R; i += kStepThr) {
+        s_in[i] = l == 0 ? 0.0f : st[i];
+        s_in[R + i] = prev_ok ? ld_bf(A.embed + (long long)prev * R + i) : 0.0f;
+    }
+    /* Row j of the 3 * kStepR is gate, candidate or output (j / kStepR) of lane r0 + j % kStepR. */
+    const int jo = tid < 3 * kStepR ? (tid / kStepR) * R + r0 + tid % kStepR : 0;
+    float acc = tid < 3 * kStepR ? A.pre[((long long)m * A.steps + l) * 3 * R + jo] : 0.0f;
+    __syncthreads();
+    if (tid < 3 * kStepR) {
+        const uint32_t* wr = s_w + tid * KW;
+        for (int k = 0; k < 2 * R; k += 2) {
+            const uint32_t w = wr[k / 2];
+            acc += s_in[k] * bf16w_lo(w);
+            acc += s_in[k + 1] * bf16w_hi(w);
+        }
+    }
+    if (tid < 3 * kStepR) s_raw[tid] = bf(acc);
+    __syncthreads();
+    if (tid < kStepR) {
+        const int r = r0 + tid;
+        const float e = (float)exp(-(double)s_raw[tid]);
+        const float gate = bf(__fdiv_rn(1.0f, 1.0f + e));
+        const float cand = bf((float)tanh((double)s_raw[kStepR + tid]));
+        const float keep = bf(gate * s_in[r]);
+        const float update = bf(bf(1.0f - gate) * cand);
+        A.state[(long long)((l + 1) & 1) * A.M * R + (long long)m * R + r] = bf(keep + update);
+        A.latent[(long long)m * R + r] = bf((float)tanh((double)s_raw[2 * kStepR + tid]));
+    }
+}
+
+/* Position l's scores over kScoreRows vocabulary rows for up to kSeqGroup sequences, and each
+ * 64-id tile's winner. b = fold_bias[t] + fold[t] . latent is one thread's sum over the rank;
+ * score = bf16(cap * tanh(bf16(bf16(logit) + bf16(b)) / cap)).
+ *
+ * The score is monotone in x = bf16(logit) + bf16(b), so a candidate ties the tile's best only if
+ * its f32 score is within a few bf16 steps of the best's (the margin, four steps of the best's
+ * binade, is 2^16 times tanhf's error). Only those are scored exactly, and tanhf rounds to libref's
+ * bf16 unless it lands within 64 f32 steps of a bf16 rounding boundary, where the double tanh
+ * decides. */
+template <bool I8>
+__device__ __forceinline__ void score_tiles_body(const WalkArgs& A, int l) {
+    constexpr int KW = kScoreK / 2 + 1;
+    constexpr int NW = kScoreRows / kWave;
+    __shared__ uint32_t s_w[I8 ? 1 : kScoreRows * KW];
+    __shared__ float4 s_lat4[kSeqGroup * kMaxRank / 4];
+    float* const s_lat = (float*)s_lat4;
+    __shared__ float s_red[NW];
+    __shared__ int s_rt[NW];
+    const int tid = (int)threadIdx.x, lane = tid & (kWave - 1), wave = tid / kWave;
+    const int t0 = (int)blockIdx.x * kScoreRows, t = t0 + tid;
+    const int m0 = (int)blockIdx.y * kSeqGroup;
+    const int nm = A.M - m0 < kSeqGroup ? A.M - m0 : kSeqGroup;
+    const int R = A.R;
+    unsigned live = (1u << nm) - 1u;
+    if (A.stop && l >= 1)
+        for (int j = 0; j < nm; ++j)
+            if (isnan(A.debt[m0 + j])) live &= ~(1u << j);
+    if (!live) return;
+    for (int i = tid; i < nm * R; i += kScoreRows) s_lat[i] = A.latent[(long long)m0 * R + i];
+
+    float acc[kSeqGroup], lg[kSeqGroup];
+    const float b0 = t < A.V ? ld_bf(A.fold_b + t) : 0.0f;
+#pragma unroll
+    for (int j = 0; j < kSeqGroup; ++j) {
+        acc[j] = b0;
+        const long long at = ((long long)(m0 + j) * A.steps + l) * A.l_rs + t;
+        lg[j] = j < nm && t < A.V ? A.logits[at] : 0.0f;
+    }
+    if constexpr (I8) {
+        /* A thread's row straight from memory, every load issued at once: one round trip a
+         * workgroup, where staging through LDS took one a scale group. */
+        const long long tr = t < A.V ? t : A.V - 1;
+        const uint8_t* row = A.fold8 + tr * R;
+        r4d_u32x4 q[kMaxRank / 16];
+#pragma unroll
+        for (int u = 0; u < kMaxRank / 16; ++u)
+            q[u] = *(const r4d_u32x4*)(row + 16 * (u < R / 16 ? u : R / 16 - 1));
+        float sc[kMaxRank / 128];
+#pragma unroll
+        for (int g = 0; g < kMaxRank / 128; ++g)
+            sc[g] = ld_bf(A.fold_s + tr * (R / 128) + (g < R / 128 ? g : 0));
+        __syncthreads();
+#pragma unroll
+        for (int j = 0; j < kSeqGroup; ++j) {
+            if (j >= nm) break;
+            if (!(live >> j & 1u)) continue;
+            const float4* lat = (const float4*)(s_lat + j * R);
+#pragma unroll
+            for (int g = 0; g < kMaxRank / 128; ++g) {
+                if (g >= R / 128) break;
+                float p = 0.0f;
+#pragma unroll
+                for (int k = 0; k < 32; ++k) {
+                    const float4 v = lat[g * 32 + k];
+                    const uint32_t w = q[g * 8 + k / 4][k % 4];
+                    p += v.x * (float)(int8_t)w;
+                    p += v.y * (float)(int8_t)(w >> 8);
+                    p += v.z * (float)(int8_t)(w >> 16);
+                    p += v.w * (float)(int8_t)(w >> 24);
+                }
+                acc[j] += p * sc[g];
+            }
+        }
+    } else {
+        for (int k0 = 0; k0 < R; k0 += kScoreK) {
+            __syncthreads();
+            for (int i = tid; i < kScoreRows * (kScoreK / 8); i += kScoreRows) {
+                const int r = i / (kScoreK / 8), c = (i - r * (kScoreK / 8)) * 8;
+                uint32_t* dst = s_w + r * KW + c / 2;
+                if (t0 + r >= A.V) dst[0] = dst[1] = dst[2] = dst[3] = 0u;
+                else stage8(A.fold + (long long)(t0 + r) * R + k0 + c, dst);
+            }
+            __syncthreads();
+            uint32_t w[kScoreK / 2];
+#pragma unroll
+            for (int k = 0; k < kScoreK / 2; ++k) w[k] = s_w[tid * KW + k];
+#pragma unroll
+            for (int j = 0; j < kSeqGroup; ++j) {
+                if (j >= nm) break;
+                if (!(live >> j & 1u)) continue;
+                const float4* lat = (const float4*)(s_lat + j * R + k0);
+                float a = acc[j];
+#pragma unroll
+                for (int k = 0; k < kScoreK / 4; ++k) {
+                    const float4 v = lat[k];
+                    a += v.x * bf16w_lo(w[2 * k]);
+                    a += v.y * bf16w_hi(w[2 * k]);
+                    a += v.z * bf16w_lo(w[2 * k + 1]);
+                    a += v.w * bf16w_hi(w[2 * k + 1]);
+                }
+                acc[j] = a;
+            }
+        }
+    }
+
+    /* A tile is two waves: wave 2q and 2q + 1 make tile q of this workgroup. */
+    const int tile = t0 / kTile + wave / 2;
+    for (int j = 0; j < nm; ++j) {
+        if (!(live >> j & 1u)) continue;
+        const int m = m0 + j;
+        float x = NAN, fs = NAN;
+        if (t < A.V) {
+            x = bf(bf(lg[j]) + bf(acc[j]));
+            fs = A.cap * tanhf(__fdiv_rn(x, A.cap));
+        }
+        float mx = fs;
+#pragma unroll
+        for (int d = 16; d >= 1; d >>= 1) mx = fmaxf(mx, __shfl_xor(mx, d));
+        __syncthreads();
+        if (lane == 0) s_red[wave] = mx;
+        __syncthreads();
+        const float fmax = fmaxf(s_red[wave & ~1], s_red[wave | 1]);
+        const float mag = fmaxf(fabsf(fmax), 1e-30f);
+        const float margin = __uint_as_float(__float_as_uint(mag) & 0x7f800000u) * 0x1p-5f;
+        float s = -INFINITY;
+        int tk = INT_MAX;
+        if (fs >= fmax - margin) {
+            const int edge = (int)(__float_as_uint(fs) & 0xffffu) - 0x8000;
+            float y = fs;
+            if (edge <= 64 && edge >= -64) y = A.cap * (float)tanh((double)__fdiv_rn(x, A.cap));
+            s = bf(y);
+            tk = A.ids ? A.ids[A.v0 + t] : A.v0 + t;
+        }
+#pragma unroll
+        for (int d = 16; d >= 1; d >>= 1) {
+            const float os = __shfl_xor(s, d);
+            const int ot = __shfl_xor(tk, d);
+            if (better(os, ot, s, tk)) { s = os; tk = ot; }
+        }
+        __syncthreads();
+        if (lane == 0) { s_red[wave] = s; s_rt[wave] = tk; }
+        __syncthreads();
+        if ((wave & 1) == 0 && lane == 0 && tile < A.n_tiles) {
+            float bs = s_red[wave];
+            int bt = s_rt[wave];
+            if (better(s_red[wave + 1], s_rt[wave + 1], bs, bt)) {
+                bs = s_red[wave + 1];
+                bt = s_rt[wave + 1];
+            }
+            if (bs == -INFINITY) bt = A.v0 + tile * kTile;
+            A.tile_s[(long long)m * A.ts_rs + (long long)tile * A.t_es] = bs;
+            A.tile_t[(long long)m * A.tt_rs + (long long)tile * A.t_es] = bt;
+        }
+    }
+}
+
+/* The walk's kernels in both forms: CH is r4dchain (r4d_chain.h) where the row resolved with
+ * `chain`, R4dUnchained otherwise. */
+template <class CH>
+__global__ __launch_bounds__(kPreRows * kMaxSteps) void pre_kernel(WalkArgs A) {
+    if constexpr (CH::on) r4d_chain_wait();
+    pre_body(A);
+    if constexpr (CH::on) r4d_chain_done();
+}
+template <bool COUPLE, class CH>
+__global__ __launch_bounds__(kStepThr) void rnn_step_kernel(WalkArgs A, int l) {
+    if constexpr (CH::on) r4d_chain_wait();
+    rnn_step_body<COUPLE>(A, l);
+    if constexpr (CH::on) r4d_chain_done();
+}
+template <bool I8, class CH>
+__global__ __launch_bounds__(kScoreRows) void score_tiles_kernel(WalkArgs A, int l) {
+    if constexpr (CH::on) r4d_chain_wait();
+    score_tiles_body<I8>(A, l);
+    if constexpr (CH::on) r4d_chain_done();
+}
+
+}  /* namespace r4d_dspark */
+
+using namespace r4d_dspark;
+
+/* Scratch for dspark_rnn_greedy: the projections, the state twice, the latent and the debt,
+ * 256-byte aligned each. */
+static long long walk_scratch(long long M, long long steps, long long R, long long* pre_b,
+                              long long* st_b, long long* lat_b) {
+    auto up = [](long long b) { return (b + 255) / 256 * 256; };
+    *pre_b = up(M * steps * 3 * R * (long long)sizeof(float));
+    *st_b = up(2 * M * R * (long long)sizeof(float));
+    *lat_b = up(M * R * (long long)sizeof(float));
+    return *pre_b + *st_b + *lat_b + up(M * (long long)sizeof(float));
+}
+
+/* The fold operand: bf16 [V, R], or int8 codes [V, R] with `fs` their bf16 scales, one per 128
+ * of a row, for a rank a multiple of 128. */
+static int set_fold(WalkArgs& A, const RadTensor* f, const RadTensor* fs, long long V,
+                    long long R) {
+    if (f->dtype == RAD_BF16) {
+        if (!r4d_contig(f)) return RAD_E_STRIDE;
+        if (r4d_numel(f) != V * R) return RAD_E_SHAPE;
+        if (!r4d_aligned(f->data, 16)) return RAD_E_ALIGN;
+        A.fold = (const uint16_t*)r4d_p(f);
+        return RAD_OK;
+    }
+    if (f->dtype != RAD_I8 || !fs || fs->dtype != RAD_BF16) return RAD_E_DTYPE;
+    if (R % 128) return RAD_E_UNSUPPORTED;
+    if (!r4d_contig(f) || !r4d_contig(fs)) return RAD_E_STRIDE;
+    if (r4d_numel(f) != V * R || r4d_numel(fs) != V * (R / 128)) return RAD_E_SHAPE;
+    if (!r4d_aligned(f->data, 16)) return RAD_E_ALIGN;
+    A.fold8 = (const uint8_t*)r4d_p(f);
+    A.fold_s = (const uint16_t*)r4d_p(fs);
+    return RAD_OK;
+}
+
+extern "C" {
+
+int r4d_rad_tap_mix(const RadArgs* a, RadStream stream) {
+    const RadTensor* x = r4d_opt(a, 0);
+    const RadTensor* lg = r4d_opt(a, 1);
+    const RadTensor* w = r4d_opt(a, 2);
+    const RadTensor* y = r4d_opt(a, 3);
+    if (!x || !lg || !w || !y) return R4D_NO(RAD_E_INVAL);
+    if (x->dtype != RAD_BF16 || lg->dtype != RAD_BF16 || w->dtype != RAD_BF16 ||
+        y->dtype != RAD_BF16)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), taps = r4d_geti_or(a, "taps", 0);
+    if (n <= 0 || taps <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (n > kMaxRow || taps > kMaxTaps) return R4D_NO(RAD_E_UNSUPPORTED);
+    long long M = 0, Mx = 0;
+    TapArgs A{};
+    A.x_rs = r4d_rows_pitch(x, taps * n, &Mx);
+    A.y_rs = r4d_rows_pitch(y, n, &M);
+    if (A.x_rs < 0 || A.y_rs < 0 || !r4d_contig(lg) || !r4d_contig(w)) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Mx < M || r4d_numel(lg) != taps || r4d_numel(w) != n) return R4D_NO(RAD_E_SHAPE);
+    A.x = (const uint16_t*)r4d_p(x);
+    A.lg = (const uint16_t*)r4d_p(lg);
+    A.w = (const uint16_t*)r4d_p(w);
+    A.y = (uint16_t*)r4d_wp(y);
+    A.n = (uint32_t)n; A.taps = (uint32_t)taps; A.M = (uint32_t)M;
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    auto* const k = r4d_geti_or(a, "chain", 0) ? tap_mix_kernel<r4dchain>
+                                                : tap_mix_kernel<R4dUnchained>;
+    const dim3 grid(r4d_cliff_rows((uint32_t)M, 1, kThr / kWave));
+    return R4D_EMIT(stream, k, grid, dim3(kThr), 0, A);
+}
+
+int r4d_rad_fill_rows(const RadArgs* a, RadStream stream) {
+    const RadTensor* tok = r4d_opt(a, 0);
+    const RadTensor* w = r4d_opt(a, 1);
+    const RadTensor* x = r4d_opt(a, 2);
+    if (!tok || !w || !x) return R4D_NO(RAD_E_INVAL);
+    if (tok->dtype != RAD_I32 || w->dtype != RAD_BF16 || x->dtype != RAD_BF16)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0), id = r4d_geti_or(a, "id", -1);
+    if (n <= 0 || id < 0 || id > INT_MAX) return R4D_NO(RAD_E_SHAPE);
+    long long M = 0;
+    const long long x_rs = r4d_rows_pitch(x, n, &M);
+    if (x_rs < 0 || !r4d_contig(tok) || !r4d_contig(w)) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || r4d_numel(tok) < M || r4d_numel(w) != n) return R4D_NO(RAD_E_SHAPE);
+    auto* const k = r4d_geti_or(a, "chain", 0) ? fill_rows_kernel<r4dchain>
+                                                : fill_rows_kernel<R4dUnchained>;
+    return R4D_EMIT(stream, k, dim3((uint32_t)M), dim3(kThr), 0,
+                    (const int*)r4d_p(tok), (const uint16_t*)r4d_p(w), (uint16_t*)r4d_wp(x), x_rs,
+                    (uint32_t)n, (uint32_t)M, (int)id);
+}
+
+int r4d_rad_rmsnorm_add(const RadArgs* a, RadStream stream) {
+    const RadTensor* x = r4d_opt(a, 0);
+    const RadTensor* res = r4d_opt(a, 1);
+    const RadTensor* w = r4d_opt(a, 2);
+    const RadTensor* y = r4d_opt(a, 3);
+    const RadTensor* ro = r4d_opt(a, 4);
+    if (!x || !res || !w || !y || !ro) return R4D_NO(RAD_E_INVAL);
+    if (x->dtype != RAD_BF16 || res->dtype != RAD_BF16 || y->dtype != RAD_BF16 ||
+        ro->dtype != RAD_BF16 || (w->dtype != RAD_BF16 && w->dtype != RAD_F32))
+        return R4D_NO(RAD_E_DTYPE);
+    const long long n = r4d_geti_or(a, "n", 0);
+    if (n <= 0) return R4D_NO(RAD_E_SHAPE);
+    if (n > kMaxRow) return R4D_NO(RAD_E_UNSUPPORTED);
+    long long M = 0, Mr = 0, My = 0, Mo = 0;
+    NormAddArgs A{};
+    A.x_rs = r4d_rows_pitch(x, n, &M);
+    A.r_rs = r4d_rows_pitch(res, n, &Mr);
+    A.y_rs = r4d_rows_pitch(y, n, &My);
+    A.o_rs = r4d_rows_pitch(ro, n, &Mo);
+    if (A.x_rs < 0 || A.r_rs < 0 || A.y_rs < 0 || A.o_rs < 0 || !r4d_contig(w))
+        return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || Mr < M || My < M || Mo < M || r4d_numel(w) < n) return R4D_NO(RAD_E_SHAPE);
+    A.x = (const uint16_t*)r4d_p(x);
+    A.res = (const uint16_t*)r4d_p(res);
+    A.w = r4d_p(w);
+    A.y = (uint16_t*)r4d_wp(y);
+    A.ro = (uint16_t*)r4d_wp(ro);
+    A.n = (uint32_t)n; A.M = (uint32_t)M;
+    A.eps = (float)r4d_getf(a, "eps", 1e-6);
+    A.wadd = (float)r4d_getf(a, "wadd", 0.0);
+    const dim3 grid(r4d_cliff_rows((uint32_t)M, 1, kThr / kWave)), thr(kThr);
+    const bool chain = r4d_geti_or(a, "chain", 0) != 0;
+    auto* const k = w->dtype == RAD_F32
+                        ? (chain ? rmsnorm_add_kernel<true, r4dchain>
+                                 : rmsnorm_add_kernel<true, R4dUnchained>)
+                        : (chain ? rmsnorm_add_kernel<false, r4dchain>
+                                 : rmsnorm_add_kernel<false, R4dUnchained>);
+    return R4D_EMIT(stream, k, grid, thr, 0, A);
+}
+
+/* Operand indices, from oDsparkRnn and oDsparkCouple in r4d_rows.cpp. The int8 fold's scales
+ * come last in either. */
+enum { DW_LOGITS = 0, DW_HIDDEN, DW_CTX, DW_ANCHOR, DW_PROJ, DW_BIAS, DW_EMBED, DW_FOLD,
+       DW_FOLD_B, DW_TILE_S, DW_TILE_T, DW_OUT, DW_KEPT, DW_N,
+       DW_CARD = DW_N, DW_DRAW, DW_STATE, DW_NC };
+
+}  /* extern "C" */
+
+static int dspark_walk(const RadArgs* a, RadStream stream, bool couple) {
+    const RadTensor* t[DW_NC] = {};
+    for (int i = 0; i < (couple ? DW_NC : DW_N); ++i)
+        if (!(t[i] = r4d_opt(a, i))) return R4D_NO(RAD_E_INVAL);
+    if (t[DW_LOGITS]->dtype != RAD_F32 || t[DW_TILE_S]->dtype != RAD_F32 ||
+        t[DW_ANCHOR]->dtype != RAD_I32 || t[DW_TILE_T]->dtype != RAD_I32 ||
+        t[DW_OUT]->dtype != RAD_I32 || t[DW_KEPT]->dtype != RAD_I32)
+        return R4D_NO(RAD_E_DTYPE);
+    for (int i : { DW_HIDDEN, DW_CTX, DW_PROJ, DW_BIAS, DW_EMBED, DW_FOLD_B })
+        if (t[i]->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+
+    const long long steps = r4d_geti_or(a, "steps", 0), R = r4d_geti_or(a, "rank", 0);
+    const long long n = r4d_geti_or(a, "n", 0), V = r4d_geti_or(a, "n_vocab", 0);
+    const long long astr = r4d_geti_or(a, "anchor_stride", 1);
+    const double cap = r4d_getf(a, "cap", 0.0);
+    if (steps <= 0 || R <= 0 || n <= 0 || V <= 0 || astr <= 0 || !(cap > 0.0))
+        return R4D_NO(RAD_E_SHAPE);
+    if (R % (kStepK / 2) || R > kMaxRank || (2 * n) % kPreK || steps > kMaxSteps ||
+        V > INT_MAX - kScoreRows)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+
+    WalkArgs A{};
+    long long M = 0, rows = 0, hrows = 0, crows = 0, ts_rows = 0, tt_rows = 0;
+    const long long n_tiles = (V + kTile - 1) / kTile;
+    A.o_rs = r4d_rows_pitch(t[DW_OUT], steps, &M);
+    A.l_rs = r4d_rows_pitch(t[DW_LOGITS], V, &rows);
+    A.h_rs = r4d_rows_pitch(t[DW_HIDDEN], n, &hrows);
+    A.c_rs = r4d_rows_pitch(t[DW_CTX], n, &crows);
+    A.ts_rs = r4d_rows_pitch(t[DW_TILE_S], n_tiles, &ts_rows);
+    A.tt_rs = r4d_rows_pitch(t[DW_TILE_T], n_tiles, &tt_rows);
+    if (A.o_rs < 0 || A.l_rs < 0 || A.h_rs < 0 || A.c_rs < 0 || A.ts_rs < 0 || A.tt_rs < 0)
+        return R4D_NO(RAD_E_STRIDE);
+    for (int i : { DW_ANCHOR, DW_PROJ, DW_BIAS, DW_EMBED, DW_FOLD_B, DW_KEPT })
+        if (!r4d_contig(t[i])) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || M > 65535 || rows < M * steps || hrows < M * steps || crows < M ||
+        ts_rows < M || tt_rows < M || r4d_numel(t[DW_KEPT]) < M ||
+        r4d_numel(t[DW_ANCHOR]) < (M - 1) * astr + 1 ||
+        r4d_numel(t[DW_PROJ]) != 3 * R * (2 * R + 2 * n) || r4d_numel(t[DW_BIAS]) != 3 * R ||
+        r4d_numel(t[DW_EMBED]) % R || r4d_numel(t[DW_FOLD_B]) != V)
+        return R4D_NO(RAD_E_SHAPE);
+    if (!r4d_aligned(t[DW_PROJ]->data, 16)) return R4D_NO(RAD_E_ALIGN);
+    const RadTensor* fs = r4d_opt(a, couple ? DW_NC : DW_N);
+    if (const int frc = set_fold(A, t[DW_FOLD], fs && fs->data ? fs : nullptr, V, R);
+        frc != RAD_OK)
+        return R4D_NO(frc);
+    long long pre_b = 0, st_b = 0, lat_b = 0;
+    const long long need = walk_scratch(M, steps, R, &pre_b, &st_b, &lat_b);
+    if (!a->scratch || a->scratch_bytes < need || !r4d_aligned(a->scratch, 256))
+        return R4D_NO(RAD_E_INVAL);
+
+    A.logits = (const float*)r4d_p(t[DW_LOGITS]);
+    A.hidden = (const uint16_t*)r4d_p(t[DW_HIDDEN]);
+    A.ctx = (const uint16_t*)r4d_p(t[DW_CTX]);
+    A.vec_in = A.h_rs % 8 == 0 && A.c_rs % 8 == 0 && r4d_aligned(A.hidden, 16) &&
+               r4d_aligned(A.ctx, 16);
+    A.anchor = (const int*)r4d_p(t[DW_ANCHOR]);
+    A.astr = astr;
+    A.proj = (const uint16_t*)r4d_p(t[DW_PROJ]);
+    A.bias = (const uint16_t*)r4d_p(t[DW_BIAS]);
+    A.embed = (const uint16_t*)r4d_p(t[DW_EMBED]);
+    A.n_embed = (int)(r4d_numel(t[DW_EMBED]) / R);
+    A.fold_b = (const uint16_t*)r4d_p(t[DW_FOLD_B]);
+    A.tile_s = (float*)r4d_wp(t[DW_TILE_S]);
+    A.tile_t = (int*)r4d_wp(t[DW_TILE_T]);
+    A.out = (int*)r4d_wp(t[DW_OUT]);
+    A.kept = (int*)r4d_wp(t[DW_KEPT]);
+    char* sc = (char*)a->scratch;
+    A.pre = (float*)sc;
+    A.state = (float*)(sc + pre_b);
+    A.latent = (float*)(sc + pre_b + st_b);
+    A.debt = (float*)(sc + pre_b + st_b + lat_b);
+    A.M = (int)M; A.steps = (int)steps; A.R = (int)R; A.n = (int)n; A.V = (int)V;
+    A.qv = (int)V;
+    if (const RadTensor* ids = r4d_opt(a, (couple ? DW_NC : DW_N) + 1); ids && ids->data) {
+        if (ids->dtype != RAD_I32) return R4D_NO(RAD_E_DTYPE);
+        if (r4d_numel(ids) < V) return R4D_NO(RAD_E_SHAPE);
+        A.ids = (const int*)r4d_p(ids);
+        A.qv = INT_MAX;
+    }
+    A.n_tiles = (int)n_tiles;
+    A.t_es = 1;
+    A.cap = (float)cap;
+    A.knee = (float)r4d_getf(a, "knee", 0.0);
+    A.budget = (float)r4d_getf(a, "budget", 0.0);
+    A.stop = !couple && r4d_geti_or(a, "stop", 0) != 0;
+
+    if (couple) {
+        const RadTensor *card = t[DW_CARD], *draw = t[DW_DRAW], *st = t[DW_STATE];
+        if (card->dtype != RAD_I32 || draw->dtype != RAD_U32 || st->dtype != RAD_U32)
+            return R4D_NO(RAD_E_DTYPE);
+        long long dr_rows = 0;
+        A.dr_rs = r4d_rows_pitch(draw, (long long)RAD_MTP_COUPLE_DRAW_WORDS, &dr_rows);
+        if (A.dr_rs < 0 || !r4d_contig(card) || st->rank != 3 ||
+            st->stride[2] != 1 || st->stride[1] < (int64_t)RAD_MTP_COUPLE_STATE_WORDS ||
+            st->stride[1] % 2 || st->stride[0] % 2)
+            return R4D_NO(RAD_E_STRIDE);
+        if (dr_rows < M || r4d_numel(card) < M || st->shape[0] < steps || st->shape[1] < M ||
+            st->shape[2] != (int64_t)RAD_MTP_COUPLE_STATE_WORDS)
+            return R4D_NO(RAD_E_SHAPE);
+        if (!r4d_aligned(draw->data, 8) || !r4d_aligned(st->data, 8)) return R4D_NO(RAD_E_ALIGN);
+        A.card = (const int*)r4d_p(card);
+        A.draw = (const uint32_t*)r4d_p(draw);
+        A.cstate = (uint32_t*)r4d_wp(st);
+        A.cs_round = st->stride[0];
+        A.cs_row = st->stride[1];
+    }
+
+    const dim3 pre_grid((unsigned)((3 * R + kPreRows - 1) / kPreRows), (unsigned)M);
+    using U = R4dUnchained;
+    int rc = R4D_EMIT(stream, pre_kernel<U>, pre_grid, dim3((unsigned)(steps * kPreRows)), 0, A);
+    const dim3 step_grid((unsigned)(R / kStepR), (unsigned)M), step_thr(kStepThr);
+    const dim3 score_grid((unsigned)((V + kScoreRows - 1) / kScoreRows),
+                          (unsigned)((M + kSeqGroup - 1) / kSeqGroup));
+    auto* const step = couple ? rnn_step_kernel<true, U> : rnn_step_kernel<false, U>;
+    auto* const score = A.fold8 ? score_tiles_kernel<true, U> : score_tiles_kernel<false, U>;
+    for (int l = 0; rc == RAD_OK && l <= steps; ++l) {
+        rc = R4D_EMIT(stream, step, step_grid, step_thr, 0, A, l);
+        if (rc == RAD_OK && l < steps)
+            rc = R4D_EMIT(stream, score, score_grid, dim3(kScoreRows), 0, A, l);
+    }
+    return rc;
+}
+
+extern "C" {
+
+int r4d_rad_dspark_rnn_greedy(const RadArgs* a, RadStream stream) {
+    return dspark_walk(a, stream, false);
+}
+
+int r4d_rad_dspark_rnn_couple(const RadArgs* a, RadStream stream) {
+    return dspark_walk(a, stream, true);
+}
+
+/* Called at declare with the band's upper bound. */
+int64_t r4d_rad_dspark_rnn_greedy_scratch(const RadArgs* a) {
+    long long pre_b = 0, st_b = 0, lat_b = 0;
+    return walk_scratch(r4d_geti_or(a, "M", 0), r4d_geti_or(a, "steps", 0),
+                        r4d_geti_or(a, "rank", 0), &pre_b, &st_b, &lat_b);
+}
+
+/* The walk's state between dspark_walk_step and dspark_walk_score, in walk_scratch's layout at the
+ * band's M: the `walk` operand (docs/OPS.md). */
+static bool walk_state(WalkArgs& A, const RadTensor* w, long long Mb) {
+    long long pre_b = 0, st_b = 0, lat_b = 0;
+    const long long need = walk_scratch(Mb, A.steps, A.R, &pre_b, &st_b, &lat_b);
+    if (w->dtype != RAD_F32 || !r4d_contig(w) || r4d_numel(w) * 4 < need ||
+        !r4d_aligned(w->data, 256))
+        return false;
+    char* sc = (char*)r4d_wp(w);
+    A.pre = (float*)sc;
+    A.state = (float*)(sc + pre_b);
+    A.latent = (float*)(sc + pre_b + st_b);
+    A.debt = (float*)(sc + pre_b + st_b + lat_b);
+    return true;
+}
+
+/* Operand indices, from oDsparkWalkStep and oDsparkWalkCouple in r4d_rows.cpp. */
+enum { WS_TILES = 0, WS_HIDDEN, WS_CTX, WS_ANCHOR, WS_PROJ, WS_BIAS, WS_EMBED, WS_WALK, WS_OUT,
+       WS_KEPT, WS_N, WS_CARD = WS_N, WS_DRAW, WS_STATE, WS_NC };
+
+}  /* extern "C" */
+
+/* Position l's step: the token of l - 1 from the gathered winners (none at l = 0, where the
+ * projections run first), then the state advanced. At l = steps only the last token. */
+static int dspark_walk_step(const RadArgs* a, RadStream stream, bool couple) {
+    const RadTensor* t[WS_NC] = {};
+    for (int i = 0; i < (couple ? WS_NC : WS_N); ++i)
+        if (!(t[i] = r4d_opt(a, i))) return R4D_NO(RAD_E_INVAL);
+    if (t[WS_TILES]->dtype != RAD_I32 || t[WS_ANCHOR]->dtype != RAD_I32 ||
+        t[WS_OUT]->dtype != RAD_I32 || t[WS_KEPT]->dtype != RAD_I32)
+        return R4D_NO(RAD_E_DTYPE);
+    for (int i : { WS_HIDDEN, WS_CTX, WS_PROJ, WS_BIAS, WS_EMBED })
+        if (t[i]->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+    const long long steps = r4d_geti_or(a, "steps", 0), R = r4d_geti_or(a, "rank", 0);
+    const long long n = r4d_geti_or(a, "n", 0), l = r4d_geti_or(a, "l", -1);
+    const long long slots = r4d_geti_or(a, "slots", 0), Mb = r4d_geti_or(a, "M", 0);
+    const long long astr = r4d_geti_or(a, "anchor_stride", 1);
+    if (steps <= 0 || R <= 0 || n <= 0 || l < 0 || l > steps || slots <= 0 || astr <= 0)
+        return R4D_NO(RAD_E_SHAPE);
+    if (R % (kStepK / 2) || R > kMaxRank || (2 * n) % kPreK || steps > kMaxSteps)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    WalkArgs A{};
+    long long M = 0, hrows = 0, crows = 0, trows = 0;
+    A.o_rs = r4d_rows_pitch(t[WS_OUT], steps, &M);
+    A.h_rs = r4d_rows_pitch(t[WS_HIDDEN], n, &hrows);
+    A.c_rs = r4d_rows_pitch(t[WS_CTX], n, &crows);
+    A.ts_rs = A.tt_rs = r4d_rows_pitch(t[WS_TILES], 2 * slots, &trows);
+    if (A.o_rs < 0 || A.h_rs < 0 || A.c_rs < 0 || A.ts_rs < 0) return R4D_NO(RAD_E_STRIDE);
+    for (int i : { WS_ANCHOR, WS_PROJ, WS_BIAS, WS_EMBED, WS_KEPT })
+        if (!r4d_contig(t[i])) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || M > 65535 || M > Mb || hrows < M * steps || crows < M || trows < M ||
+        r4d_numel(t[WS_KEPT]) < M || r4d_numel(t[WS_ANCHOR]) < (M - 1) * astr + 1 ||
+        r4d_numel(t[WS_PROJ]) != 3 * R * (2 * R + 2 * n) || r4d_numel(t[WS_BIAS]) != 3 * R ||
+        r4d_numel(t[WS_EMBED]) % R)
+        return R4D_NO(RAD_E_SHAPE);
+    if (!r4d_aligned(t[WS_PROJ]->data, 16)) return R4D_NO(RAD_E_ALIGN);
+    A.M = (int)M; A.steps = (int)steps; A.R = (int)R; A.n = (int)n;
+    if (!walk_state(A, t[WS_WALK], Mb)) return R4D_NO(RAD_E_SHAPE);
+    A.hidden = (const uint16_t*)r4d_p(t[WS_HIDDEN]);
+    A.ctx = (const uint16_t*)r4d_p(t[WS_CTX]);
+    A.vec_in = A.h_rs % 8 == 0 && A.c_rs % 8 == 0 && r4d_aligned(A.hidden, 16) &&
+               r4d_aligned(A.ctx, 16);
+    A.anchor = (const int*)r4d_p(t[WS_ANCHOR]);
+    A.astr = astr;
+    A.proj = (const uint16_t*)r4d_p(t[WS_PROJ]);
+    A.bias = (const uint16_t*)r4d_p(t[WS_BIAS]);
+    A.embed = (const uint16_t*)r4d_p(t[WS_EMBED]);
+    A.n_embed = (int)(r4d_numel(t[WS_EMBED]) / R);
+    A.tile_s = (float*)r4d_p(t[WS_TILES]);
+    A.tile_t = (int*)r4d_p(t[WS_TILES]) + 1;
+    A.t_es = 2;
+    A.n_tiles = (int)slots;
+    A.out = (int*)r4d_wp(t[WS_OUT]);
+    A.kept = (int*)r4d_wp(t[WS_KEPT]);
+    A.knee = (float)r4d_getf(a, "knee", 0.0);
+    A.budget = (float)r4d_getf(a, "budget", 0.0);
+    A.stop = !couple && r4d_geti_or(a, "stop", 0) != 0;
+    if (couple) {
+        const RadTensor *card = t[WS_CARD], *draw = t[WS_DRAW], *st = t[WS_STATE];
+        const long long V = r4d_geti_or(a, "n_vocab", 0);
+        if (card->dtype != RAD_I32 || draw->dtype != RAD_U32 || st->dtype != RAD_U32)
+            return R4D_NO(RAD_E_DTYPE);
+        long long dr_rows = 0;
+        A.dr_rs = r4d_rows_pitch(draw, (long long)RAD_MTP_COUPLE_DRAW_WORDS, &dr_rows);
+        if (A.dr_rs < 0 || !r4d_contig(card) || st->rank != 3 || st->stride[2] != 1 ||
+            st->stride[1] < (int64_t)RAD_MTP_COUPLE_STATE_WORDS || st->stride[1] % 2 ||
+            st->stride[0] % 2)
+            return R4D_NO(RAD_E_STRIDE);
+        if (V <= 0 || V > INT_MAX || dr_rows < M || r4d_numel(card) < M || st->shape[0] < steps ||
+            st->shape[1] < M || st->shape[2] != (int64_t)RAD_MTP_COUPLE_STATE_WORDS)
+            return R4D_NO(RAD_E_SHAPE);
+        if (!r4d_aligned(draw->data, 8) || !r4d_aligned(st->data, 8)) return R4D_NO(RAD_E_ALIGN);
+        A.V = (int)V;
+        A.qv = (int)V;
+        A.card = (const int*)r4d_p(card);
+        A.draw = (const uint32_t*)r4d_p(draw);
+        A.cstate = (uint32_t*)r4d_wp(st);
+        A.cs_round = st->stride[0];
+        A.cs_row = st->stride[1];
+    }
+    const bool chain = r4d_geti_or(a, "chain", 0) != 0;
+    int rc = RAD_OK;
+    if (l == 0) {
+        const dim3 pre_grid((unsigned)((3 * R + kPreRows - 1) / kPreRows), (unsigned)M);
+        const dim3 pre_thr((unsigned)(steps * kPreRows));
+        rc = chain ? R4D_EMIT(stream, pre_kernel<r4dchain>, pre_grid, pre_thr, 0, A)
+                   : R4D_EMIT(stream, pre_kernel<R4dUnchained>, pre_grid, pre_thr, 0, A);
+    }
+    const dim3 grid((unsigned)(R / kStepR), (unsigned)M), thr(kStepThr);
+    if (rc != RAD_OK) return rc;
+    auto* const step = couple ? (chain ? rnn_step_kernel<true, r4dchain>
+                                       : rnn_step_kernel<true, R4dUnchained>)
+                              : (chain ? rnn_step_kernel<false, r4dchain>
+                                       : rnn_step_kernel<false, R4dUnchained>);
+    return R4D_EMIT(stream, step, grid, thr, 0, A, (int)l);
+}
+
+extern "C" {
+
+int r4d_rad_dspark_walk_step(const RadArgs* a, RadStream stream) {
+    return dspark_walk_step(a, stream, false);
+}
+
+int r4d_rad_dspark_walk_couple(const RadArgs* a, RadStream stream) {
+    return dspark_walk_step(a, stream, true);
+}
+
+/* Operand indices, from oDsparkWalkScore in r4d_rows.cpp. */
+enum { WC_LOGITS = 0, WC_WALK, WC_FOLD, WC_FOLD_B, WC_TILES, WC_N, WC_FOLD_S = WC_N, WC_IDS };
+
+/* Position l's winners over this rank's `n_vocab` rows, ids from `v0`, into `slots` pairs a
+ * sequence; slots past the rows hold -inf. */
+int r4d_rad_dspark_walk_score(const RadArgs* a, RadStream stream) {
+    const RadTensor* t[WC_N];
+    for (int i = 0; i < WC_N; ++i)
+        if (!(t[i] = r4d_opt(a, i))) return R4D_NO(RAD_E_INVAL);
+    if (t[WC_LOGITS]->dtype != RAD_F32 || t[WC_TILES]->dtype != RAD_I32 ||
+        t[WC_FOLD_B]->dtype != RAD_BF16)
+        return R4D_NO(RAD_E_DTYPE);
+    const long long steps = r4d_geti_or(a, "steps", 0), R = r4d_geti_or(a, "rank", 0);
+    const long long V = r4d_geti_or(a, "n_vocab", 0), l = r4d_geti_or(a, "l", -1);
+    const long long slots = r4d_geti_or(a, "slots", 0), Mb = r4d_geti_or(a, "M", 0);
+    const long long v0 = r4d_geti_or(a, "v0", 0);
+    const double cap = r4d_getf(a, "cap", 0.0);
+    if (steps <= 0 || R <= 0 || V <= 0 || l < 0 || l >= steps || !(cap > 0.0) || v0 < 0 ||
+        v0 % kTile || slots * kTile < V)
+        return R4D_NO(RAD_E_SHAPE);
+    if (R % (kStepK / 2) || R > kMaxRank || steps > kMaxSteps || v0 + slots * kTile > INT_MAX)
+        return R4D_NO(RAD_E_UNSUPPORTED);
+    WalkArgs A{};
+    long long M = 0, rows = 0;
+    A.ts_rs = A.tt_rs = r4d_rows_pitch(t[WC_TILES], 2 * slots, &M);
+    A.l_rs = r4d_rows_pitch(t[WC_LOGITS], V, &rows);
+    if (A.ts_rs < 0 || A.l_rs < 0 || !r4d_contig(t[WC_FOLD_B])) return R4D_NO(RAD_E_STRIDE);
+    if (M <= 0 || M > Mb || rows < M * steps || r4d_numel(t[WC_FOLD_B]) != V)
+        return R4D_NO(RAD_E_SHAPE);
+    const RadTensor* fs = r4d_opt(a, WC_FOLD_S);
+    if (const int frc = set_fold(A, t[WC_FOLD], fs && fs->data ? fs : nullptr, V, R);
+        frc != RAD_OK)
+        return R4D_NO(frc);
+    A.M = (int)M; A.steps = (int)steps; A.R = (int)R; A.V = (int)V;
+    if (!walk_state(A, t[WC_WALK], Mb)) return R4D_NO(RAD_E_SHAPE);
+    A.logits = (const float*)r4d_p(t[WC_LOGITS]);
+    A.fold_b = (const uint16_t*)r4d_p(t[WC_FOLD_B]);
+    A.tile_s = (float*)r4d_wp(t[WC_TILES]);
+    A.tile_t = (int*)r4d_wp(t[WC_TILES]) + 1;
+    A.t_es = 2;
+    A.v0 = (int)v0;
+    if (const RadTensor* ids = r4d_opt(a, WC_IDS); ids && ids->data) {
+        if (ids->dtype != RAD_I32) return R4D_NO(RAD_E_DTYPE);
+        if (r4d_numel(ids) < v0 + V) return R4D_NO(RAD_E_SHAPE);
+        A.ids = (const int*)r4d_p(ids);
+    }
+    A.n_tiles = (int)slots;
+    A.cap = (float)cap;
+    A.stop = r4d_geti_or(a, "stop", 0) != 0;
+    const dim3 grid((unsigned)((slots * kTile + kScoreRows - 1) / kScoreRows),
+                    (unsigned)((M + kSeqGroup - 1) / kSeqGroup));
+    const bool chain = r4d_geti_or(a, "chain", 0) != 0;
+    auto* const score = A.fold8 ? (chain ? score_tiles_kernel<true, r4dchain>
+                                         : score_tiles_kernel<true, R4dUnchained>)
+                                : (chain ? score_tiles_kernel<false, r4dchain>
+                                         : score_tiles_kernel<false, R4dUnchained>);
+    return R4D_EMIT(stream, score, grid, dim3(kScoreRows), 0, A, (int)l);
+}
+
+}  /* extern "C" */
