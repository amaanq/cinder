+/* kv_page_box at head_dim 128: kv_cache, block_table, seqused, cu_seqlens?, box, box_table. */
+template <bool I8>
+static int page_box_h128(const RadArgs* a, RadStream stream) {
+    enum { HD = 128 };
+    const RadTensor* kv = r4d_opt(a, 0);
+    const RadTensor* bt = r4d_opt(a, 1);
+    const RadTensor* su = r4d_opt(a, 2);
+    const RadTensor* cu = r4d_opt(a, 3);
+    const RadTensor* box = r4d_opt(a, 4);
+    const RadTensor* pt = r4d_opt(a, 5);
+    if (!kv || !bt || !su || !box || !pt) return R4D_NO(RAD_E_INVAL);
+    if ((kv->dtype == RAD_I8) != I8 || (!I8 && kv->dtype != RAD_BF16) || box->dtype != RAD_BF16 ||
+        bt->dtype != RAD_I32 || su->dtype != RAD_I32 || pt->dtype != RAD_I32 ||
+        (cu && cu->dtype != RAD_I32))
+        return R4D_NO(RAD_E_DTYPE);
+    const long long page = r4d_geti_or(a, "block_size", 0), kb = r4d_geti_or(a, "kv_block", 0);
+    const long long M = r4d_geti_or(a, "M", 0), slot = I8 ? 2 * HD + 4 : 2 * HD;
+    if (r4d_geti_or(a, "head_dim", 0) != HD || page <= 0 || kb != kBlock || page % kb || M <= 0)
+        return R4D_NO(RAD_E_SHAPE);
+    if (kv->rank != 4 || kv->shape[2] != kb || kv->shape[3] != slot || kv->stride[3] != 1 ||
+        kv->stride[2] != slot || bt->rank != 2 || pt->rank != 2 || box->rank != 4 ||
+        box->shape[1] != kv->shape[1] || box->shape[2] != page ||
+        box->shape[2] * box->shape[3] < HD + 2 || box->stride[3] != 1 ||
+        box->stride[2] != box->shape[3] || !r4d_contig(bt) || !r4d_contig(pt) || !r4d_contig(su))
+        return R4D_NO(RAD_E_SHAPE);
+    const long long n_seq = r4d_numel(su);
+    if (n_seq <= 0 || (cu && r4d_numel(cu) != n_seq + 1) || (!cu && M % n_seq))
+        return R4D_NO(RAD_E_SHAPE);
+    const long long esz = I8 ? 1 : 2;
+    PageBoxArgs P{};
+    P.kv = (const uint8_t*)r4d_p(kv);
+    P.kv_bs = kv->stride[0] * esz;
+    P.kv_hs = kv->stride[1] * esz;
+    P.bt = (const int*)r4d_p(bt);
+    P.bt_pitch = (int)bt->shape[1];
+    P.su = (const int*)r4d_p(su);
+    P.cu = (const int*)r4d_p(cu);
+    P.n_seq = (int)n_seq;
+    P.q_len = cu ? 0 : (int)(M / n_seq);
+    P.page = (int)page;
+    P.kblock = (int)kb;
+    P.box = (uint8_t*)r4d_wp(box);
+    P.box_ps = box->stride[0] * 2;
+    P.box_hs = box->stride[1] * 2;
+    P.pt = (const int*)r4d_p(pt);
+    P.pt_pitch = (int)pt->shape[1];
+    const dim3 grid((uint32_t)(M / page + n_seq), (uint32_t)kv->shape[1]), thr(HD);
+    return r4d_geti_or(a, "chain", 0) != 0
+               ? R4D_EMIT(stream, (page_box_kernel<HD, I8, r4dchain>), grid, thr, 0, P)
+               : R4D_EMIT(stream, (page_box_kernel<HD, I8, R4dUnchained>), grid, thr, 0, P);
+}
+
+extern "C" int r4d_rad_kv_page_box_h128_bf16(const RadArgs* a, RadStream stream) {
+    return page_box_h128<false>(a, stream);
+}
+
+extern "C" int r4d_rad_kv_page_box_h128_i8(const RadArgs* a, RadStream stream) {
+    return page_box_h128<true>(a, stream);
+}
