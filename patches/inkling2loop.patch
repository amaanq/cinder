+/* ------------------------------------------------------------------ depth_mix */
+/* As libref: each of a row's `states` runs of n in `states`, then its row of x, normalised with no
+ * gain, and for every query the softmax of its scaled dots with them weighting their sum. The
+ * queries are widened once; parallel over rows. */
+AVX_KERNEL(depth_mix) {
+    if (!rad_args_have(a, 4)) return RAD_E_INVAL;
+    const RadTensor *st = &a->t[0], *x = &a->t[1], *q = &a->t[2], *y = &a->t[3];
+    const int64_t n = p_int(a, "n", 0), S = p_int(a, "states", 0), Q = p_int(a, "queries", 0);
+    const float eps = p_f32(a, "eps", 1e-6f);
+    if (n <= 0 || S <= 0 || Q <= 0) return RAD_E_SHAPE;
+    const int64_t rows = rows_of(x, n);
+    if (rows <= 0 || numel(st) < rows * S * n || numel(q) != Q * n || numel(y) < rows * Q * n)
+        return RAD_E_SHAPE;
+    const float scale = 1.0f / std::sqrt((float)n);
+
+    float* qf = (float*)scratch_raw((size_t)(Q * n) * sizeof(float));
+    for (int64_t k = 0; k < Q; ++k) {
+        const float* row = in_row(q, rowoff(q, k, n), n, qf + k * n);
+        if (row != qf + k * n) std::memcpy(qf + k * n, row, (size_t)n * sizeof(float));
+    }
+
+    AVX_PARALLEL_FOR_IF(rows * (S + 1) * n >= AVX_PAR_MIN)
+    for (int64_t r = 0; r < rows; ++r) {
+        float* u = scratch_f32((size_t)((S + 1) * n + S + 1));
+        float* p = u + (S + 1) * n;
+        float* sx = scratch_f32_b((size_t)n);
+        float* sy = scratch_f32_c((size_t)n);
+        const int64_t sb = rowoff(st, r, S * n), ss = laststride(st);
+        for (int64_t s = 0; s <= S; ++s) {
+            const float* v = s < S ? in_row(st, sb + s * n * ss, n, sx)
+                                   : in_row(x, rowoff(x, r, n), n, sx);
+            const float inv = 1.0f / std::sqrt(row_sumsq(v, n) / (float)n + eps);
+            for (int64_t i = 0; i < n; ++i) u[s * n + i] = v[i] * inv;
+        }
+        for (int64_t k = 0; k < Q; ++k) {
+            float mx = -INFINITY, sum = 0.0f;
+            for (int64_t s = 0; s <= S; ++s) {
+                p[s] = dotf(qf + k * n, u + s * n, n) * scale;
+                if (p[s] > mx) mx = p[s];
+            }
+            for (int64_t s = 0; s <= S; ++s) { p[s] = sc_exp(p[s] - mx); sum += p[s]; }
+            for (int64_t i = 0; i < n; ++i) sy[i] = 0.0f;
+            for (int64_t s = 0; s <= S; ++s) {
+                const float w = p[s] / sum;
+                for (int64_t i = 0; i < n; ++i) sy[i] += w * u[s * n + i];
