+        if constexpr (KV8 != 2) return 0u;
+        return *(const unsigned*)(A.kv + ((long long)(blk >= 0 ? blk : 0) * A.kv_sb +
+                                          (long long)kh * A.kv_sh) * ESZ + n * SLOT + 2 * HD);
+    };
+
+    win_v8f acc[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c)
