+            ps += (float)ph;
+            pf[e] = KV8 == 2 ? (_Float16)((float)ph * vsc[e]) : ph;
+        }
+        l = l * corr + ps;
+        m = mn;
+        if (__builtin_amdgcn_ballot_w32(corr != 1.0f) != 0) {
+#pragma unroll
+            for (int c = 0; c < NC; ++c) acc[c] *= corr;
+        }
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const uint4 u = *(const uint4*)&sv[vcol(16 * c + n) + 8 * h];
+            acc[c] = wmma_f16(__builtin_bit_cast(win_v8h, u), pf, acc[c]);
+        }
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            kc[c] = kn[c];
+            vc[c] = vn[c];
+        }
+        bc = bn;
+        wc = wn;
+    }
+    l += shfl_xor(l, 16);
+
+    /* the waves' sums onto wave 0's in wave order, through the V^T LDS they are done with */
+    __syncthreads();
+    float* sx = (float*)sv;
+#pragma unroll
+    for (int c = 0; c < NC; ++c)
+#pragma unroll
+        for (int e = 0; e < 8; ++e) sx[(c * 8 + e) * 32 + lane] = acc[c][e];
+    s_ml[wave][0][lane] = m;
+    s_ml[wave][1][lane] = l;
+    __syncthreads();
+    if (wave != 0) return;
+    float mt = m;
+    for (int w = 1; w < kSplitWaves; ++w) mt = __builtin_fmaxf(mt, s_ml[w][0][lane]);
+    if (mt != -__builtin_inff()) {
+        const float a0 = ex2(m - mt);
+        l *= a0;
+#pragma unroll
+        for (int c = 0; c < NC; ++c) acc[c] *= a0;
+        for (int w = 1; w < kSplitWaves; ++w) {
+            const float mw = s_ml[w][0][lane];
+            if (mw == -__builtin_inff()) continue;
+            const float aw = ex2(mw - mt);
+            const float* xw = (const float*)s_v[w];
+            l = __builtin_fmaf(s_ml[w][1][lane], aw, l);
+#pragma unroll
+            for (int c = 0; c < NC; ++c)
+#pragma unroll
+                for (int e = 0; e < 8; ++e)
+                    acc[c][e] = __builtin_fmaf(xw[(c * 8 + e) * 32 + lane], aw, acc[c][e]);
+        }
+    }
+    m = mt;
+
+    if (!rval) return;
+    const long long slot = (((long long)tile * A.kv_heads + kh) * A.n_split + z) * R + r;
+    float* pp = A.part + slot * (HD + 4);
+    if (h == 0) { pp[HD] = m; pp[HD + 1] = l; }
+    if (m == -__builtin_inff()) return;
+    const float os = KV8 == 2 ? vds / kVsUp : vds;
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        *(float4*)(pp + 16 * c + 8 * h) =
+            make_float4(acc[c][0] * os, acc[c][1] * os, acc[c][2] * os, acc[c][3] * os);
+        *(float4*)(pp + 16 * c + 8 * h + 4) =
+            make_float4(acc[c][4] * os, acc[c][5] * os, acc[c][6] * os, acc[c][7] * os);
+    }
+}
+template <int GQA, int KV8>
+__global__ __launch_bounds__(kSplitWaves * 32) void attn_wsplit_kernel(AttnArgs A) {
+    attn_wsplit_body<GQA, KV8>(A);
