+    if (kt_lo < kt_hi) {
+        fetch(bc, 0, kc);
+        fetch(bc, HD, vc);
+        wc = fetch_sc(bc);
+    }
+    for (int kt = kt_lo; kt < kt_hi; ++kt) {
