+/* ================================================================== DSpark's coupled walk
+ *
+ * `dspark_rnn_couple`: dspark_rnn_greedy's recurrent walk, sampled. At each draft position the
+ * walk's softcapped scores reduce to 64-id tile winners as in the greedy walk, and
+ *
+ *     Q_l = the FP64 softmax of score / draw.temp over the eight best winners (score
+ *           descending, lower id on a tie), cut by the request's top_k, then top_p, then min_p in
+ *           the sampler's order and renormalised; x_l ~ Q_l at (seed, base, KEY_DRAFT + l + 1),
+ *           and x_l is the token the state advances with.
+ *
+ * Q follows the request's own law, so a sharper request samples a sharper draft. The winners are
+ * per tile, so two strong ids in one tile give Q one of them; Q is stored exactly either way. */
+static inline RAD_SPECHUB_HD void rad_dspark_couple_cut(RadMtpCoupleState* s,
+                                                        const RadMtpCoupleDraw& d) {
+    int n = s->count;
+    if (d.top_k > 0 && d.top_k < n) n = d.top_k;
+    double sum = 0;
+    for (int i = 0; i < n; ++i) sum += s->q[i];
+    if (d.top_p < 1.0f) {
+        double c = 0;
+        for (int i = 0; i < n; ++i) {
+            c += s->q[i] / sum;
+            if (c >= (double)d.top_p) { n = i + 1; break; }
+        }
+    }
+    if (d.min_p > 0.0f) {
+        const double floor_q = (double)d.min_p * s->q[0];
+        int k = 1;
+        while (k < n && s->q[k] >= floor_q) ++k;
+        n = k;
+    }
+    sum = 0;
+    for (int i = 0; i < n; ++i) sum += s->q[i];
+    for (int i = 0; i < 8; ++i) {
+        if (i < n) { s->q[i] /= sum; continue; }
+        s->ids[i] = -1;
+        s->q[i] = 0;
+    }
+    s->count = n;
+}
+
+/* One position: the `n` best winners in order, `id` and `sc`. Fills `*s` as rad_dflash_couple_step
+ * does and returns the token the walk continues from: `greedy_x` (the best winner) for a mode-0
+ * draw (status 0) or a row whose card or Q is unusable (status -1), else x ~ Q (status 1). */
+static inline RAD_SPECHUB_HD int32_t rad_dspark_couple_step(const int32_t* id, const float* sc,
+                                                            int n, const RadMtpCoupleDraw& d,
+                                                            bool card_ok, int round, int64_t vocab,
+                                                            int32_t greedy_x, RadMtpCoupleState* s) {
+    s->draw = d;
+    s->pos = 0;
+    s->round = round;
+    s->count = 0;
+    s->x = greedy_x;
+    for (int i = 0; i < 8; ++i) { s->ids[i] = -1; s->q[i] = 0; }
+    if (d.mode != 1) {
+        s->status = 0;
+        return greedy_x;
+    }
+    s->status = -1;
+    if (!card_ok || n <= 0 || !(d.temp > 0.0f)) return greedy_x;
+    int32_t kid[8];
+    float   kv[8];
+    for (int i = 0; i < 8; ++i) {
+        kid[i] = i < n ? id[i] : -1;
+        kv[i] = i < n ? sc[i] / d.temp : -INFINITY;
+    }
+    if (!rad_mtp_couple_build_q(kid, kv, vocab, s)) {
+        s->count = 0;
+        for (int i = 0; i < 8; ++i) { s->ids[i] = -1; s->q[i] = 0; }
+        return greedy_x;
+    }
+    rad_dspark_couple_cut(s, d);
+    const double u = rad_spechub_uniform(d.seed, d.base, RAD_MTP_COUPLE_KEY_DRAFT + (uint64_t)round);
+    s->x = s->ids[rad_mtp_couple_pick(*s, u)];
+    s->status = 1;
+    return s->x;
+}
+
 #undef RAD_SPECHUB_HD
 #endif  /* __cplusplus */
 #endif  /* RAD_SPECHUB_H */
