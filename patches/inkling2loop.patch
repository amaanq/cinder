+      arrived = __hip_atomic_fetch_add(&A.ctr[S.ctr + cell], 1u, __ATOMIC_ACQ_REL,
+                                       __HIP_MEMORY_SCOPE_AGENT);
+    arrived = __builtin_amdgcn_readfirstlane(arrived);
+    if (arrived + 1u == (unsigned)S.sk) {
+      if (lane == 0)
+        __hip_atomic_store(&A.ctr[S.ctr + cell], 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+      __threadfence();
+      // Every partial is loaded before the first add: a load an add apart, the sixteen splits'
+      // L2 round trips would follow one another.
+      float r[kSetMaxSk][8];
+#pragma unroll
+      for (int q = 0; q < kSetMaxSk; q++)
+#pragma unroll
+        for (int e = 0; e < 8; e++) r[q][e] = q < S.sk ? pp[q * 256 + e * WAVE32 + lane] : 0.f;
+#pragma unroll
+      for (int e = 0; e < 8; e++) {
+        float v = 0.f;
+#pragma unroll
+        for (int q = 0; q < kSetMaxSk; q++)
+          if (q < S.sk) v += r[q][e];
+        if (n < N && m0 + e < M) S.c[(size_t)(m0 + e) * N + n] = (__hip_bfloat16)v;
+      }
+    }
+  }
+  if (CH::on) r4d_chain_done();
+}
+
+// Operand order: a0, a1?, a2?, then w_i, y_i a segment.
+enum { GS_A0 = 0, GS_W0 = 3 };
+
+struct SetPlan {
+  int n_seg = 0, M = 0, K = 0, mtiles = 0, blocks = 0;
+  int N[kSetSegs] = {}, src[kSetSegs] = {}, sk[kSetSegs] = {}, tiles[kSetSegs] = {};
+  long long parts = 0, ctrs = 0;
+};
+
+const char* const kSetN[kSetSegs] = { "N0", "N1", "N2", "N3", "N4", "N5", "N6", "N7" };
+const char* const kSetSrc[kSetSegs] = { "src0", "src1", "src2", "src3",
+                                        "src4", "src5", "src6", "src7" };
+
+// The segments, splits and scratch at the launch's row count M. Each segment's split is
+// r4d_rad_gemm_bf16_m64's at WV 1.
+int set_plan(const RadArgs* a, long long M, long long K, SetPlan* P) {
+  P->M = (int)M;
+  P->K = (int)K;
+  P->mtiles = (int)((M + 15) / 16);
+  if (M < 1 || M > 64 || K < 16 || K % 16) return R4D_NO(RAD_E_SHAPE);
+  for (int i = 0; i < kSetSegs; ++i) {
+    const long long N = r4d_geti_or(a, kSetN[i], 0);
+    if (N <= 0) break;
+    const long long src = r4d_geti_or(a, kSetSrc[i], 0);
+    if (src < 0 || src > 2) return R4D_NO(RAD_E_SHAPE);
+    if (!r4d_bf16_gemm_chunk_rows(M, N, K, 16, 16)) return R4D_NO(RAD_E_SHAPE);
+    const long long tiles = (N + 15) / 16;
+    const int sk = pick_sk(tiles, K, 16, 1, block_bound(BR_FLAT, 1, 1));
+    if (sk > kSetMaxSk) return R4D_NO(RAD_E_UNSUPPORTED);
+    P->N[i] = (int)N;
+    P->src[i] = (int)src;
+    P->sk[i] = sk;
+    P->tiles[i] = (int)tiles;
+    P->blocks += (int)(tiles * sk);
+    if (sk > 1) {
+      P->parts += tiles * sk * P->mtiles;
+      P->ctrs += tiles * P->mtiles;
+    }
+    P->n_seg = i + 1;
+  }
+  if (P->n_seg == 0 || P->ctrs > kSetCtrs) return R4D_NO(RAD_E_UNSUPPORTED);
+  return RAD_OK;
+}
+
+}  // namespace
+
+extern "C" int64_t r4d_rad_gemm_nt_multi_scratch(const RadArgs* a) {
+  SetPlan P;
+  const long long M = std::max(1LL, std::min(64LL, r4d_geti_or(a, "M", 1)));
+  if (set_plan(a, M, r4d_geti_or(a, "K", 0), &P) != RAD_OK) return R4D_NO(RAD_E_INVAL);
+  return P.parts * 256 * (int64_t)sizeof(float);
+}
+
+extern "C" int r4d_rad_gemm_nt_multi(const RadArgs* a, RadStream stream) {
+  const RadTensor* a0 = r4d_opt(a, GS_A0);
+  if (!a0) return R4D_NO(RAD_E_INVAL);
+  if (a0->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
+  if (a0->rank != 2) return R4D_NO(RAD_E_SHAPE);
+  const long long M = a0->shape[0], K = a0->shape[1];
+  SetPlan P;
+  int rc = set_plan(a, M, K, &P);
+  if (rc != RAD_OK) return rc;
+  SetArgs A{};
+  A.n_seg = P.n_seg;
+  A.M = P.M;
+  A.K = P.K;
+  A.mtiles = P.mtiles;
+  int first = 0, part = 0, ctr = 0;
+  for (int i = 0; i < P.n_seg; ++i) {
+    const RadTensor* x = r4d_opt(a, GS_A0 + P.src[i]);
+    const RadTensor* w = r4d_opt(a, GS_W0 + 2 * i);
+    const RadTensor* y = r4d_opt(a, GS_W0 + 2 * i + 1);
+    if (!x || !w || !y) return R4D_NO(RAD_E_INVAL);
+    if (x->dtype != RAD_BF16 || w->dtype != RAD_BF16 || y->dtype != RAD_BF16)
+      return R4D_NO(RAD_E_DTYPE);
+    if (x->rank != 2 || x->shape[0] != M || x->shape[1] != K || y->rank != 2 ||
+        y->shape[0] != M || y->shape[1] != P.N[i] || r4d_numel(w) != (int64_t)P.N[i] * K)
+      return R4D_NO(RAD_E_SHAPE);
+    if (!r4d_contig(x) || !r4d_contig(y) || !r4d_contig(w)) return R4D_NO(RAD_E_STRIDE);
+    if (!r4d_aligned(x->data, 16) || !r4d_aligned(w->data, 16)) return R4D_NO(RAD_E_ALIGN);
+    SetSeg& S = A.s[i];
+    S.a = (const unsigned short*)r4d_p(x);
+    S.w = (const unsigned short*)r4d_p(w);
+    S.c = (__hip_bfloat16*)r4d_wp(y);
+    S.N = P.N[i];
+    S.sk = P.sk[i];
+    S.tiles = P.tiles[i];
+    S.first = first;
+    S.part = part;
+    S.ctr = ctr;
+    first += P.tiles[i] * P.sk[i];
+    if (P.sk[i] > 1) {
+      part += P.tiles[i] * P.sk[i] * P.mtiles;
+      ctr += P.tiles[i] * P.mtiles;
+    }
+  }
+  if (P.parts > 0) {
+    if (!a->scratch || a->scratch_bytes < P.parts * 256 * (int64_t)sizeof(float))
+      return R4D_NO(RAD_E_SCRATCH);
+    A.part = (float*)a->scratch;
+    A.ctr = r4d::keyed_block(r4d::Keyed::GemmSet, stream, r4d_p(r4d_opt(a, GS_W0 + 1)),
+                             (size_t)kSetCtrs * sizeof(unsigned));
+    if (!A.ctr) return R4D_NO(RAD_E_DEVICE);
+  }
+  const dim3 grid((unsigned)P.blocks, (unsigned)P.mtiles), block(WAVE32);
+  const bool chain = r4d_geti_or(a, "chain", 0) != 0;
+  hipLaunchKernelGGL((chain ? gemm_set_kernel<r4dchain> : gemm_set_kernel<R4dUnchained>), grid, block, 0,
+                     (hipStream_t)stream, A);
+  return hipGetLastError() == hipSuccess ? RAD_OK : R4D_NO(RAD_E_DEVICE);
+}
