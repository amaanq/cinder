+    if (rows <= 0 || numel(X) < rows * n || numel(M) < rows * n || numel(R) < rows * k ||
+        numel(D) != k * 2 * n || numel(F) != n * k || numel(G) != n * k)
+        return RAD_E_SHAPE;
